]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000004"><Properties><string name="Name">Monetization</string><ProtectedString name="Source"><![CDATA[--[[
	Monetization.luau — central place for every Gamepass / Developer Product.

	IDs are created in the Roblox Creator Dashboard (Monetization > Passes / Developer Products).
	An id of 0 means "not registered yet": the shop shows the item as unavailable and the server
	never grants it. Fill the ids after creating them — see docs/CREATOR_DASHBOARD_SETUP.md.
]]

local Monetization = {}

Monetization.Gamepasses = {
	VIP = { id = 0, price = 299, name = "VIP", icon = "Crown",
		desc = "Tag VIP, aura dourada, +15% de GOLD, recompensa diária exclusiva e decoração VIP na base." },
	DoubleMoney = { id = 0, price = 299, name = "2X MONEY", icon = "Coins",
		desc = "Dobra permanentemente a renda de todos os seus pets." },
	DoubleGrowth = { id = 0, price = 199, name = "2X GROWTH SPEED", icon = "Egg",
		desc = "Reduz pela metade o tempo de incubação de todos os ovos." },
	AutoCollect = { id = 0, price = 149, name = "AUTO COLLECT", icon = "Magnet",
		desc = "O GOLD dos seus pets vai direto para o seu saldo, sem precisar coletar." },
	ExtraBase = { id = 0, price = 199, name = "EXTRA BASE", icon = "Nest",
		desc = "+4 espaços de incubação extras na sua base." },
	DoubleTraining = { id = 0, price = 249, name = "2X SPEED TRAINING", icon = "Bolt",
		desc = "Dobra a Speed recebida na esteira." },
}

-- kind decides how MonetizationService grants the product.
Monetization.Products = {
	GoldSmall   = { id = 0, price = 49,  name = "Bolsa de GOLD",     kind = "Gold", seconds = 600,   minimum = 1000,     desc = "10 minutos da sua renda atual (mín. 1K)." },
	GoldMedium  = { id = 0, price = 149, name = "Baú de GOLD",       kind = "Gold", seconds = 2400,  minimum = 10000,    desc = "40 minutos da sua renda atual (mín. 10K)." },
	GoldLarge   = { id = 0, price = 399, name = "Tesouro de GOLD",   kind = "Gold", seconds = 8000,  minimum = 100000,   desc = "~2h13 da sua renda atual (mín. 100K)." },
	GoldMega    = { id = 0, price = 999, name = "Cofre dos Deuses",  kind = "Gold", seconds = 24000, minimum = 1000000,  desc = "~6h40 da sua renda atual (mín. 1M)." },
	MoneyBoost  = { id = 0, price = 99,  name = "2X Money Boost",    kind = "Boost", boost = "money",    seconds = 900, desc = "Dobra a renda dos pets por 15 minutos (acumula tempo)." },
	SpeedBoost  = { id = 0, price = 79,  name = "Speed Boost",       kind = "Boost", boost = "training", seconds = 900, desc = "Dobra os ganhos de treinamento por 15 minutos." },
	EventBoost  = { id = 0, price = 79,  name = "Event Boost",       kind = "Boost", boost = "event",    seconds = 900, desc = "Ovos de evento: dobra a chance de tamanho/mutação melhores por 15 min." },
	BaseShield  = { id = 0, price = 59,  name = "Base Shield",       kind = "Boost", boost = "shield",   seconds = 600, desc = "Ninguém pode roubar ovos da sua base por 10 minutos." },
	HatchInstant= { id = 0, price = 29,  name = "Hatch Instantly",   kind = "HatchInstant", desc = "Choca imediatamente o ovo com mais tempo restante." },
	DivineReliquary = { id = 0, price = 199, name = "Divine Reliquary", kind = "Reliquary",
		desc = "Uma relíquia mitológica aleatória. Todas as probabilidades são exibidas antes da compra." },
}

-- Exact odds for the Divine Reliquary. Must sum to 100. Shown in the shop BEFORE purchase.
-- Rewards never depend on luck modifiers, so the displayed odds are always the real odds.
Monetization.ReliquaryTable = {
	{ reward = "GoldHour",      label = "1 hora de renda em GOLD (mín. 25K)",          chance = 40 },
	{ reward = "MoneyBoost30",  label = "2X Money Boost por 30 minutos",               chance = 25 },
	{ reward = "TrainingBoost30", label = "Speed Boost por 30 minutos",               chance = 20 },
	{ reward = "SpecialEgg",    label = "Ovo Divino do seu bioma mais alto (no slot livre)", chance = 12 },
	{ reward = "CollectorTrail",label = "Collector Trail (6x) — ou 3h de renda se já possuir", chance = 3 },
}

-- Free alternative for players whose policy restricts paid random items:
-- Reliquary Keys are earned from Index milestones and the daily login; one key opens one reliquary.
Monetization.FreeReliquaryKeyDailyChance = 1 -- one key every daily login

function Monetization.isRegistered(entry)
	return entry ~= nil and typeof(entry.id) == "number" and entry.id > 0
end

return Monetization
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX00000007"><Properties><string name="Name">Factory</string></Properties><Item class="ModuleScript" referent="RBX00000006"><Properties><string name="Name">ModelFactory</string><ProtectedString name="Source"><![CDATA[--[[
	ModelFactory — builds every gameplay model procedurally (stylized, low part count, Roblox-native).

	Used by the server (world/pets/eggs/guardians/treadmills) and by the client (ViewportFrames in
	the Index/Inventory). Blender-authored meshes can replace any builder later: put a Model named
	after the species/egg/treadmill into ReplicatedStorage.Assets.<Category> and the factory will
	clone it instead (see docs/ASSET_PIPELINE.md).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")

local Shared = script.Parent.Parent
local Creatures = require(Shared.Config.Creatures)
local Formulas = require(Shared.Util.Formulas)

local ModelFactory = {}

local C3 = Color3.fromRGB
local EYE = C3(20, 20, 28)

local function rgb(arr)
	if typeof(arr) == "Color3" then
		return arr
	end
	return C3(arr[1], arr[2], arr[3])
end
ModelFactory.rgb = rgb

-- ---------- primitive helpers ----------
local function newPart(model: Model, name: string, shape: Enum.PartType?, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?)
	local p = Instance.new("Part")
	p.Name = name
	p.Shape = shape or Enum.PartType.Block
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Anchored = true
	p.CastShadow = false
	p.Parent = model
	return p
end
ModelFactory.newPart = newPart

local function ball(model, name, d, cf, color, mat)
	return newPart(model, name, Enum.PartType.Ball, Vector3.new(d, d, d), cf, color, mat)
end
local function block(model, name, size, cf, color, mat)
	return newPart(model, name, Enum.PartType.Block, size, cf, color, mat)
end
local function cyl(model, name, size, cf, color, mat)
	return newPart(model, name, Enum.PartType.Cylinder, size, cf, color, mat)
end
local function wedge(model, name, size, cf, color, mat)
	local w = Instance.new("WedgePart")
	w.Name = name
	w.Size = size
	w.CFrame = cf
	w.Color = color
	w.Material = mat or Enum.Material.SmoothPlastic
	w.Anchored = true
	w.CanCollide = false
	w.CanQuery = false
	w.CanTouch = false
	w.CastShadow = false
	w.Parent = model
	return w
end
local function ellipsoid(model, name, size, cf, color, mat)
	local p = newPart(model, name, Enum.PartType.Block, size, cf, color, mat)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = p
	return p
end
ModelFactory.ellipsoid = ellipsoid

local function eyes(model, headCF: CFrame, spacing: number, d: number, forward: number)
	ball(model, "EyeL", d, headCF * CFrame.new(-spacing, 0.1, -forward), EYE)
	ball(model, "EyeR", d, headCF * CFrame.new(spacing, 0.1, -forward), EYE)
	-- tiny shine
	ball(model, "ShineL", d * 0.35, headCF * CFrame.new(-spacing + d * 0.15, 0.1 + d * 0.15, -forward - d * 0.35), C3(255, 255, 255), Enum.Material.Neon)
	ball(model, "ShineR", d * 0.35, headCF * CFrame.new(spacing + d * 0.15, 0.1 + d * 0.15, -forward - d * 0.35), C3(255, 255, 255), Enum.Material.Neon)
end

local function finalize(model: Model, root: BasePart)
	model.PrimaryPart = root
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") and d ~= root then
			local w = Instance.new("WeldConstraint")
			w.Part0 = root
			w.Part1 = d
			w.Parent = d
		end
	end
	return model
end

local function addLight(part: BasePart, color: Color3, range: number, brightness: number?)
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = range
	l.Brightness = brightness or 1.5
	l.Shadows = false
	l.Parent = part
	return l
end
ModelFactory.addLight = addLight

local function addParticles(part: BasePart, color: Color3, rate: number, opts)
	opts = opts or {}
	local pe = Instance.new("ParticleEmitter")
	pe.Color = ColorSequence.new(color, opts.color2 or color)
	pe.LightEmission = opts.lightEmission or 0.8
	pe.Rate = rate
	pe.Lifetime = NumberRange.new(opts.life or 0.8, (opts.life or 0.8) * 1.6)
	pe.Speed = NumberRange.new(opts.speed or 1.5, (opts.speed or 1.5) * 2)
	pe.SpreadAngle = Vector2.new(180, 180)
	pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, opts.size or 0.25), NumberSequenceKeypoint.new(1, 0) })
	pe.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
	pe.Texture = opts.texture or "rbxasset://textures/particles/sparkles_main.dds"
	pe.Parent = part
	CollectionService:AddTag(pe, "VFX")
	return pe
end
ModelFactory.addParticles = addParticles

-- ---------- archetype builders ----------
-- Each returns (root, headCF, handCF). Model extends from y=0 (feet) upward, facing -Z.
local Arch = {}

function Arch.Humanoid(m, p, s, a)
	local root = block(m, "Root", Vector3.new(1.4, 0.4, 1), CFrame.new(0, 0.2, 0), s)
	block(m, "LegL", Vector3.new(0.55, 1.1, 0.6), CFrame.new(-0.36, 0.75, 0), s)
	block(m, "LegR", Vector3.new(0.55, 1.1, 0.6), CFrame.new(0.36, 0.75, 0), s)
	block(m, "Torso", Vector3.new(1.5, 1.35, 0.85), CFrame.new(0, 1.95, 0), p)
	block(m, "Belt", Vector3.new(1.55, 0.2, 0.9), CFrame.new(0, 1.35, 0), a)
	block(m, "ArmL", Vector3.new(0.45, 1.25, 0.5), CFrame.new(-1.0, 1.95, 0) * CFrame.Angles(0, 0, math.rad(-8)), p)
	block(m, "ArmR", Vector3.new(0.45, 1.25, 0.5), CFrame.new(1.0, 1.95, 0) * CFrame.Angles(0, 0, math.rad(8)), p)
	ball(m, "HandL", 0.5, CFrame.new(-1.1, 1.25, 0), s)
	ball(m, "HandR", 0.5, CFrame.new(1.1, 1.25, 0), s)
	local headCF = CFrame.new(0, 3.25, 0)
	ball(m, "Head", 1.45, headCF, s)
	block(m, "Hair", Vector3.new(1.35, 0.45, 1.3), headCF * CFrame.new(0, 0.5, 0.1), p)
	eyes(m, headCF, 0.3, 0.26, 0.6)
	return root, headCF, CFrame.new(1.1, 1.25, -0.1)
end

function Arch.Quadruped(m, p, s, a)
	local root = block(m, "Root", Vector3.new(1.2, 0.3, 2), CFrame.new(0, 0.15, 0), p)
	ellipsoid(m, "Body", Vector3.new(1.9, 1.5, 2.8), CFrame.new(0, 1.45, 0), p)
	for i, off in { Vector3.new(-0.6, 0.5, -0.9), Vector3.new(0.6, 0.5, -0.9), Vector3.new(-0.6, 0.5, 0.9), Vector3.new(0.6, 0.5, 0.9) } do
		block(m, "Leg" .. i, Vector3.new(0.45, 1.0, 0.45), CFrame.new(off), s)
	end
	local headCF = CFrame.new(0, 2.2, -1.55)
	ball(m, "Head", 1.3, headCF, p)
	ellipsoid(m, "Snout", Vector3.new(0.75, 0.55, 0.6), headCF * CFrame.new(0, -0.2, -0.6), s)
	ball(m, "Nose", 0.22, headCF * CFrame.new(0, -0.1, -0.92), EYE)
	eyes(m, headCF, 0.3, 0.22, 0.5)
	block(m, "EarL", Vector3.new(0.25, 0.45, 0.15), headCF * CFrame.new(-0.45, 0.6, 0.1), s)
	block(m, "EarR", Vector3.new(0.25, 0.45, 0.15), headCF * CFrame.new(0.45, 0.6, 0.1), s)
	block(m, "Tail", Vector3.new(0.25, 0.25, 1.0), CFrame.new(0, 1.8, 1.7) * CFrame.Angles(math.rad(30), 0, 0), a)
	return root, headCF, CFrame.new(0, 2.2, 0)
end

function Arch.Canine(m, p, s, a)
	local root, headCF, hand = Arch.Quadruped(m, p, s, a)
	-- pointed ears + longer snout
	for _, n in { "EarL", "EarR" } do
		local e = m:FindFirstChild(n) :: BasePart
		e.Size = Vector3.new(0.3, 0.7, 0.2)
		e.CFrame = e.CFrame * CFrame.new(0, 0.15, 0)
	end
	local snout = m:FindFirstChild("Snout") :: BasePart
	snout.Size = Vector3.new(0.7, 0.55, 1.0)
	snout.CFrame = snout.CFrame * CFrame.new(0, 0, -0.2)
	return root, headCF, hand
end

function Arch.Feline(m, p, s, a)
	local root, headCF, hand = Arch.Quadruped(m, p, s, a)
	local body = m:FindFirstChild("Body") :: BasePart
	body.Size = Vector3.new(1.6, 1.3, 2.7)
	for _, n in { "EarL", "EarR" } do
		local e = m:FindFirstChild(n) :: BasePart
		e:Destroy()
	end
	wedge(m, "EarL", Vector3.new(0.2, 0.55, 0.45), headCF * CFrame.new(-0.4, 0.7, 0.05), p)
	wedge(m, "EarR", Vector3.new(0.2, 0.55, 0.45), headCF * CFrame.new(0.4, 0.7, 0.05), p)
	local tail = m:FindFirstChild("Tail") :: BasePart
	tail.Size = Vector3.new(0.22, 0.22, 1.6)
	tail.CFrame = CFrame.new(0, 2.2, 1.9) * CFrame.Angles(math.rad(55), 0, 0)
	return root, headCF, hand
end

function Arch.Horse(m, p, s, a)
	local root = block(m, "Root", Vector3.new(1.2, 0.3, 2), CFrame.new(0, 0.15, 0), p)
	ellipsoid(m, "Body", Vector3.new(1.6, 1.5, 3.0), CFrame.new(0, 2.0, 0), p)
	for i, off in { Vector3.new(-0.5, 0.75, -1.0), Vector3.new(0.5, 0.75, -1.0), Vector3.new(-0.5, 0.75, 1.0), Vector3.new(0.5, 0.75, 1.0) } do
		block(m, "Leg" .. i, Vector3.new(0.4, 1.5, 0.4), CFrame.new(off), p)
		block(m, "Hoof" .. i, Vector3.new(0.45, 0.25, 0.45), CFrame.new(off.X, 0.12, off.Z), s)
	end
	block(m, "Neck", Vector3.new(0.7, 1.4, 0.8), CFrame.new(0, 3.0, -1.35) * CFrame.Angles(math.rad(-25), 0, 0), p)
	local headCF = CFrame.new(0, 3.75, -1.9)
	block(m, "Head", Vector3.new(0.8, 0.8, 1.4), headCF, p)
	block(m, "Mane", Vector3.new(0.25, 1.6, 0.6), CFrame.new(0, 3.3, -1.1) * CFrame.Angles(math.rad(-25), 0, 0), a)
	eyes(m, headCF * CFrame.new(0, 0.1, 0.2), 0.42, 0.2, 0.2)
	block(m, "Tail", Vector3.new(0.3, 1.4, 0.3), CFrame.new(0, 1.9, 1.7) * CFrame.Angles(math.rad(25), 0, 0), a)
	return root, headCF, CFrame.new(0, 2.8, 0)
end

function Arch.Bird(m, p, s, a)
	local root = block(m, "Root", Vector3.new(1, 0.3, 1), CFrame.new(0, 0.15, 0), s)
	block(m, "LegL", Vector3.new(0.18, 0.8, 0.18), CFrame.new(-0.3, 0.5, 0), a)
	block(m, "LegR", Vector3.new(0.18, 0.8, 0.18), CFrame.new(0.3, 0.5, 0), a)
	ellipsoid(m, "Body", Vector3.new(1.6, 1.8, 2.0), CFrame.new(0, 1.7, 0), p)
	ellipsoid(m, "Belly", Vector3.new(1.2, 1.3, 0.6), CFrame.new(0, 1.55, -0.75), s)
	local headCF = CFrame.new(0, 2.95, -0.35)
	ball(m, "Head", 1.15, headCF, p)
	wedge(m, "Beak", Vector3.new(0.3, 0.3, 0.6), headCF * CFrame.new(0, -0.1, -0.75) * CFrame.Angles(0, math.rad(180), 0), a)
	eyes(m, headCF, 0.28, 0.2, 0.45)
	block(m, "WingL", Vector3.new(0.2, 1.3, 1.6), CFrame.new(-0.95, 1.9, 0.1) * CFrame.Angles(0, 0, math.rad(-20)), p)
	block(m, "WingR", Vector3.new(0.2, 1.3, 1.6), CFrame.new(0.95, 1.9, 0.1) * CFrame.Angles(0, 0, math.rad(20)), p)
	wedge(m, "TailFeathers", Vector3.new(0.9, 0.2, 1.0), CFrame.new(0, 1.4, 1.2), s)
	return root, headCF, CFrame.new(0, 2, 0)
end

function Arch.Serpent(m, p, s, a)
	local root = block(m, "Root", Vector3.new(1.2, 0.3, 1.2), CFrame.new(0, 0.15, 0), p)
	local coils = { { 1.7, Vector3.new(0, 0.85, 0.6) }, { 1.5, Vector3.new(0.6, 1.3, 0.1) }, { 1.3, Vector3.new(0.1, 1.9, -0.3) }, { 1.1, Vector3.new(-0.3, 2.55, -0.45) } }
	for i, c in coils do
		ball(m, "Coil" .. i, c[1], CFrame.new(c[2]), (i % 2 == 0) and s or p)
	end
	local headCF = CFrame.new(-0.2, 3.25, -0.75)
	ellipsoid(m, "Head", Vector3.new(1.0, 0.8, 1.3), headCF, p)
	block(m, "Tongue", Vector3.new(0.08, 0.04, 0.5), headCF * CFrame.new(0, -0.2, -0.8), C3(220, 40, 60))
	eyes(m, headCF, 0.3, 0.2, 0.45)
	ball(m, "TailTip", 0.6, CFrame.new(-0.7, 0.4, 1.3), a)
	return root, headCF, CFrame.new(0, 2, 0)
end

function Arch.Golem(m, p, s, a)
	local root = block(m, "Root", Vector3.new(1.8, 0.4, 1.4), CFrame.new(0, 0.2, 0), s)
	block(m, "LegL", Vector3.new(0.8, 1.2, 0.8), CFrame.new(-0.55, 0.8, 0), s)
	block(m, "LegR", Vector3.new(0.8, 1.2, 0.8), CFrame.new(0.55, 0.8, 0), s)
	block(m, "Torso", Vector3.new(2.3, 1.8, 1.4), CFrame.new(0, 2.3, 0), p)
	block(m, "Core", Vector3.new(0.6, 0.6, 0.2), CFrame.new(0, 2.4, -0.72), a, Enum.Material.Neon)
	block(m, "ArmL", Vector3.new(0.8, 1.9, 0.8), CFrame.new(-1.6, 2.0, 0), p)
	block(m, "ArmR", Vector3.new(0.8, 1.9, 0.8), CFrame.new(1.6, 2.0, 0), p)
	local headCF = CFrame.new(0, 3.65, -0.1)
	block(m, "Head", Vector3.new(1.1, 0.9, 1.0), headCF, s)
	ball(m, "EyeL", 0.25, headCF * CFrame.new(-0.25, 0.05, -0.5), a, Enum.Material.Neon)
	ball(m, "EyeR", 0.25, headCF * CFrame.new(0.25, 0.05, -0.5), a, Enum.Material.Neon)
	return root, headCF, CFrame.new(1.6, 1.1, 0)
end

function Arch.Dragon(m, p, s, a)
	local root, headCF, hand = Arch.Quadruped(m, p, s, a)
	local snout = m:FindFirstChild("Snout") :: BasePart
	snout.Size = Vector3.new(0.8, 0.5, 1.1)
	snout.CFrame = snout.CFrame * CFrame.new(0, 0, -0.25)
	block(m, "WingL", Vector3.new(1.8, 0.15, 1.2), CFrame.new(-1.4, 2.4, 0) * CFrame.Angles(0, 0, math.rad(25)), a)
	block(m, "WingR", Vector3.new(1.8, 0.15, 1.2), CFrame.new(1.4, 2.4, 0) * CFrame.Angles(0, 0, math.rad(-25)), a)
	for i = 1, 3 do
		wedge(m, "Spike" .. i, Vector3.new(0.15, 0.4, 0.4), CFrame.new(0, 2.25, -0.6 + i * 0.5), a)
	end
	return root, headCF, hand
end

function Arch.Spirit(m, p, s, a)
	local root = block(m, "Root", Vector3.new(0.8, 0.2, 0.8), CFrame.new(0, 0.1, 0), s)
	root.Transparency = 1
	local core = ball(m, "Body", 1.8, CFrame.new(0, 1.9, 0), p, Enum.Material.Neon)
	core.Transparency = 0.15
	ball(m, "Inner", 1.1, CFrame.new(0, 1.9, 0), s, Enum.Material.Neon)
	local headCF = CFrame.new(0, 3.1, 0)
	ball(m, "Head", 1.1, headCF, p)
	eyes(m, headCF, 0.25, 0.22, 0.45)
	for i = 1, 3 do
		local ang = math.rad(i * 120)
		ball(m, "Wisp" .. i, 0.4, CFrame.new(math.cos(ang) * 1.3, 1.6, math.sin(ang) * 1.3), a, Enum.Material.Neon)
	end
	addLight(core, p, 8, 1)
	return root, headCF, CFrame.new(0, 2, 0)
end

function Arch.Insect(m, p, s, a)
	local root = block(m, "Root", Vector3.new(1.2, 0.3, 1.6), CFrame.new(0, 0.15, 0), s)
	ellipsoid(m, "Shell", Vector3.new(2.0, 1.3, 2.4), CFrame.new(0, 1.1, 0.2), p, Enum.Material.Glass)
	block(m, "ShellLine", Vector3.new(0.08, 1.32, 2.42), CFrame.new(0, 1.1, 0.2), a)
	local headCF = CFrame.new(0, 1.1, -1.2)
	ball(m, "Head", 0.9, headCF, s)
	eyes(m, headCF, 0.22, 0.2, 0.35)
	for i = 1, 3 do
		local z = -0.6 + (i - 1) * 0.6
		block(m, "LegL" .. i, Vector3.new(0.9, 0.12, 0.12), CFrame.new(-1.1, 0.45, z) * CFrame.Angles(0, 0, math.rad(30)), s)
		block(m, "LegR" .. i, Vector3.new(0.9, 0.12, 0.12), CFrame.new(1.1, 0.45, z) * CFrame.Angles(0, 0, math.rad(-30)), s)
	end
	block(m, "HornA", Vector3.new(0.12, 0.6, 0.12), headCF * CFrame.new(-0.2, 0.5, -0.1), a)
	block(m, "HornB", Vector3.new(0.12, 0.6, 0.12), headCF * CFrame.new(0.2, 0.5, -0.1), a)
	return root, headCF, CFrame.new(0, 1.5, 0)
end

-- ---------- accessories ----------
local function accessory(m: Model, kind: string, headCF: CFrame, handCF: CFrame, colors, mythology: string)
	local p, s, a = colors[1], colors[2], colors[3]
	local gold = C3(255, 205, 70)
	if kind == "horns" then
		wedge(m, "HornL", Vector3.new(0.2, 0.7, 0.4), headCF * CFrame.new(-0.45, 0.75, 0) * CFrame.Angles(0, 0, math.rad(20)), C3(240, 230, 210))
		wedge(m, "HornR", Vector3.new(0.2, 0.7, 0.4), headCF * CFrame.new(0.45, 0.75, 0) * CFrame.Angles(0, 0, math.rad(-20)), C3(240, 230, 210))
	elseif kind == "wings" then
		local w1 = block(m, "WingL", Vector3.new(0.15, 1.6, 1.2), headCF * CFrame.new(-0.9, -1.0, 0.7) * CFrame.Angles(0, math.rad(-25), math.rad(-25)), C3(255, 255, 255), Enum.Material.SmoothPlastic)
		local w2 = block(m, "WingR", Vector3.new(0.15, 1.6, 1.2), headCF * CFrame.new(0.9, -1.0, 0.7) * CFrame.Angles(0, math.rad(25), math.rad(25)), C3(255, 255, 255), Enum.Material.SmoothPlastic)
		w1.Transparency = 0.05
		w2.Transparency = 0.05
	elseif kind == "crown" then
		cyl(m, "Crown", Vector3.new(0.35, 1.0, 1.0), headCF * CFrame.new(0, 0.75, 0) * CFrame.Angles(0, 0, math.rad(90)), gold, Enum.Material.Metal)
		ball(m, "Gem", 0.25, headCF * CFrame.new(0, 0.8, -0.5), a, Enum.Material.Neon)
	elseif kind == "helmet" then
		ball(m, "Helmet", 1.55, headCF * CFrame.new(0, 0.12, 0.05), C3(190, 190, 200), Enum.Material.Metal)
		block(m, "Crest", Vector3.new(0.18, 0.6, 1.4), headCF * CFrame.new(0, 0.85, 0.1), a)
		-- re-add eyes in front of helmet
		eyes(m, headCF, 0.3, 0.24, 0.72)
	elseif kind == "halo" then
		local h = cyl(m, "Halo", Vector3.new(0.1, 1.3, 1.3), headCF * CFrame.new(0, 1.0, 0) * CFrame.Angles(0, 0, math.rad(90)), C3(255, 250, 180), Enum.Material.Neon)
		addLight(h, C3(255, 240, 160), 6, 1)
	elseif kind == "trident" then
		block(m, "Shaft", Vector3.new(0.15, 3.2, 0.15), handCF * CFrame.new(0, 0.9, 0), gold, Enum.Material.Metal)
		for i = -1, 1 do
			block(m, "Prong" .. i, Vector3.new(0.12, 0.6, 0.12), handCF * CFrame.new(i * 0.25, 2.7, 0), gold, Enum.Material.Metal)
		end
	elseif kind == "lightning" then
		local bolt = block(m, "Bolt", Vector3.new(0.2, 1.4, 0.2), handCF * CFrame.new(0, 0.8, 0) * CFrame.Angles(0, 0, math.rad(20)), C3(255, 245, 120), Enum.Material.Neon)
		block(m, "Bolt2", Vector3.new(0.2, 0.9, 0.2), handCF * CFrame.new(0.15, 1.7, 0) * CFrame.Angles(0, 0, math.rad(-30)), C3(255, 245, 120), Enum.Material.Neon)
		addLight(bolt, C3(255, 240, 120), 7, 1.5)
	elseif kind == "sun" then
		local disk = cyl(m, "SunDisk", Vector3.new(0.15, 1.6, 1.6), headCF * CFrame.new(0, 1.0, 0.45) * CFrame.Angles(0, math.rad(90), 0), C3(255, 170, 40), Enum.Material.Neon)
		addLight(disk, C3(255, 180, 60), 8, 1.4)
	elseif kind == "ankh" then
		block(m, "AnkhStem", Vector3.new(0.15, 1.0, 0.15), handCF * CFrame.new(0, 0.6, 0), gold, Enum.Material.Metal)
		block(m, "AnkhBar", Vector3.new(0.6, 0.15, 0.15), handCF * CFrame.new(0, 1.0, 0), gold, Enum.Material.Metal)
		cyl(m, "AnkhLoop", Vector3.new(0.12, 0.45, 0.45), handCF * CFrame.new(0, 1.35, 0) * CFrame.Angles(0, math.rad(90), 0), gold, Enum.Material.Metal)
	elseif kind == "mask" then
		block(m, "Mask", Vector3.new(1.0, 0.5, 0.2), headCF * CFrame.new(0, 0.12, -0.62), gold, Enum.Material.Metal)
		block(m, "Headdress", Vector3.new(1.6, 1.2, 0.3), headCF * CFrame.new(0, -0.1, 0.45), a)
	elseif kind == "hammer" then
		block(m, "Handle", Vector3.new(0.15, 1.3, 0.15), handCF * CFrame.new(0, 0.4, 0), C3(110, 70, 40), Enum.Material.Wood)
		block(m, "HammerHead", Vector3.new(0.7, 0.5, 0.45), handCF * CFrame.new(0, 1.1, 0), C3(170, 170, 185), Enum.Material.Metal)
	elseif kind == "spear" then
		block(m, "Spear", Vector3.new(0.12, 3.2, 0.12), handCF * CFrame.new(0, 0.9, 0), C3(140, 100, 60), Enum.Material.Wood)
		wedge(m, "SpearTip", Vector3.new(0.12, 0.5, 0.3), handCF * CFrame.new(0, 2.7, 0), C3(220, 220, 230), Enum.Material.Metal)
	elseif kind == "bow" then
		cyl(m, "Bow", Vector3.new(0.12, 1.8, 1.8), handCF * CFrame.new(0.15, 0.6, 0) * CFrame.Angles(0, math.rad(90), 0), C3(220, 220, 255), Enum.Material.Neon).Transparency = 0.3
	elseif kind == "lyre" then
		block(m, "LyreL", Vector3.new(0.12, 0.9, 0.12), handCF * CFrame.new(-0.2, 0.5, 0), gold, Enum.Material.Metal)
		block(m, "LyreR", Vector3.new(0.12, 0.9, 0.12), handCF * CFrame.new(0.2, 0.5, 0), gold, Enum.Material.Metal)
		block(m, "LyreTop", Vector3.new(0.55, 0.12, 0.12), handCF * CFrame.new(0, 0.95, 0), gold, Enum.Material.Metal)
	elseif kind == "rune" then
		local r = block(m, "Rune", Vector3.new(0.45, 0.6, 0.12), headCF * CFrame.new(0.9, 0.6, 0), C3(120, 210, 255), Enum.Material.Neon)
		addLight(r, C3(120, 200, 255), 5, 1)
	elseif kind == "flame" then
		local f = ball(m, "Flame", 0.5, headCF * CFrame.new(0, 0.85, 0), C3(255, 140, 40), Enum.Material.Neon)
		addParticles(f, C3(255, 150, 40), 6, { color2 = C3(255, 60, 20), speed = 2, size = 0.35 })
		addLight(f, C3(255, 130, 40), 7, 1.2)
	elseif kind == "crystal" then
		for i = -1, 1 do
			wedge(m, "Crystal" .. i, Vector3.new(0.25, 0.7, 0.35), headCF * CFrame.new(i * 0.35, 0.75, 0.1), C3(160, 230, 255), Enum.Material.Glass)
		end
	elseif kind == "fins" then
		wedge(m, "FinTop", Vector3.new(0.15, 0.6, 1.0), headCF * CFrame.new(0, 0.65, 0.3), a)
	elseif kind == "flower" then
		ball(m, "Flower", 0.45, headCF * CFrame.new(0.45, 0.6, 0), C3(255, 150, 200), Enum.Material.Neon)
		ball(m, "FlowerCore", 0.22, headCF * CFrame.new(0.45, 0.6, -0.15), C3(255, 230, 80))
	end
end

-- Mythology flourish (small, cheap) so every pantheon reads differently.
local function mythologyFlourish(m: Model, root: BasePart, mythology: string)
	if mythology == "Greek" then
		ball(m, "Laurel", 0.25, root.CFrame * CFrame.new(0, 0.3, 0.6), C3(120, 200, 90))
	elseif mythology == "Norse" then
		block(m, "RuneMark", Vector3.new(0.3, 0.3, 0.05), root.CFrame * CFrame.new(0, 0.3, 0.55), C3(120, 210, 255), Enum.Material.Neon)
	elseif mythology == "Egyptian" then
		block(m, "GoldBand", Vector3.new(0.9, 0.1, 0.9), root.CFrame * CFrame.new(0, 0.3, 0), C3(255, 205, 70), Enum.Material.Metal)
	end
end

-- ---------- mutation + rarity visuals ----------
local SKIP_RECOLOR = { EyeL = true, EyeR = true, ShineL = true, ShineR = true, Nose = true, Tongue = true }

function ModelFactory.applyMutation(model: Model, mutationName: string?)
	local mut = Formulas.mutation(mutationName)
	model:SetAttribute("Mutation", mut.name)
	if mut.name == "None" or not mut.color then
		return
	end
	local mc = rgb(mut.color)
	local strength = 0.6
	local material = nil
	if mut.name == "Golden" then
		material = Enum.Material.Metal
		strength = 0.75
	elseif mut.name == "Silver" then
		material = Enum.Material.Metal
	elseif mut.name == "Shadow" or mut.name == "Void" then
		strength = 0.8
	elseif mut.name == "Radiant" then
		material = Enum.Material.Neon
		strength = 0.45
	elseif mut.name == "Cosmic" then
		material = Enum.Material.Glass
	end
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") and not SKIP_RECOLOR[d.Name] and d.Transparency < 1 then
			d.Color = d.Color:Lerp(mc, strength)
			if material and d.Material ~= Enum.Material.Neon then
				d.Material = material
			end
		end
	end
	local root = model.PrimaryPart
	if root then
		local fx = {
			Golden = { C3(255, 220, 80), 4 }, Silver = { C3(230, 235, 255), 3 }, Shadow = { C3(120, 60, 200), 4 },
			Celestial = { C3(150, 210, 255), 5 }, Radiant = { C3(255, 250, 200), 6 }, Cosmic = { C3(150, 100, 255), 6 },
			Void = { C3(60, 0, 90), 6 }, Rainbow = { C3(255, 120, 220), 7 },
		}
		local e = fx[mut.name]
		if e then
			addParticles(root, e[1], e[2], { size = 0.3, speed = 1 })
		end
		if mut.name == "Rainbow" then
			CollectionService:AddTag(model, "RainbowModel")
		end
		if mut.name == "Radiant" or mut.name == "Celestial" or mut.name == "Cosmic" then
			addLight(root, mc, 10, 1.2)
		end
	end
end

function ModelFactory.applyRarityAura(model: Model, rarityName: string)
	local r = Formulas.rarity(rarityName)
	local root = model.PrimaryPart
	if not root or r.index < 5 then
		return
	end
	local color = rgb(r.color)
	addParticles(root, color, 2 + (r.index - 5) * 2, { size = 0.35, speed = 0.8, life = 1.2 })
	if r.index >= 8 then
		addLight(root, color, 12, 1.5)
	end
end

-- Optional Blender/mesh override: ReplicatedStorage.Assets.<category>.<name>
local function override(category: string, name: string): Model?
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local folder = assets and assets:FindFirstChild(category)
	local m = folder and folder:FindFirstChild(name)
	if m and m:IsA("Model") then
		return m:Clone()
	end
	return nil
end

-- ---------- public builders ----------
-- Builds a creature. Model is anchored; call ModelFactory.unanchor for followers.
function ModelFactory.creature(speciesId: string, sizeName: string?, mutationName: string?, opts): Model
	opts = opts or {}
	local c = Creatures.ById[speciesId]
	local model = override("Creatures", speciesId)
	if not model then
		model = Instance.new("Model")
		model.Name = speciesId
		local colors = c and c.colors or { C3(200, 200, 200), C3(150, 150, 150), C3(255, 255, 255) }
		local builder = Arch[c and c.arch or "Quadruped"] or Arch.Quadruped
		local root, headCF, handCF = builder(model, colors[1], colors[2], colors[3])
		if c and c.acc and c.acc ~= "none" then
			accessory(model, c.acc, headCF, handCF, colors, c.mythology)
		end
		if c then
			mythologyFlourish(model, root, c.mythology)
		end
		finalize(model, root)
	end
	model:SetAttribute("Species", speciesId)
	if c then
		ModelFactory.applyRarityAura(model, c.rarity)
	end
	ModelFactory.applyMutation(model, mutationName)
	local scale = Formulas.size(sizeName).scale * (opts.scale or 1)
	if scale ~= 1 then
		model:ScaleTo(scale)
	end
	return model
end

-- Egg model. variant: "normal" | "rare" | "special" | "event"
local MYTH_PATTERN = { Greek = C3(255, 215, 90), Norse = C3(120, 210, 255), Egyptian = C3(255, 190, 60) }
function ModelFactory.egg(biomeId: number, sizeName: string?, mutationName: string?, variant: string?, eventColor: Color3?): Model
	local biome = Formulas.biome(math.max(1, biomeId))
	local model = Instance.new("Model")
	model.Name = "Egg"
	local base = rgb(biome.eggColor)
	if variant == "event" and eventColor then
		base = eventColor
	end
	local mythology = biome.mythology
	local shell = ellipsoid(model, "Shell", Vector3.new(2.1, 2.7, 2.1), CFrame.new(0, 1.35, 0), base)
	local root = shell
	local pattern = MYTH_PATTERN[mythology] or C3(255, 255, 255)
	if mythology == "Greek" then
		cyl(model, "Band", Vector3.new(0.25, 2.05, 2.05), CFrame.new(0, 1.35, 0) * CFrame.Angles(0, 0, math.rad(90)), pattern, Enum.Material.Metal)
		for i = 1, 6 do
			local ang = math.rad(i * 60)
			ball(model, "Leaf" .. i, 0.3, CFrame.new(math.cos(ang) * 1.02, 1.65, math.sin(ang) * 1.02), C3(120, 200, 90))
		end
	elseif mythology == "Norse" then
		for i = 1, 4 do
			local ang = math.rad(i * 90 + 45)
			local r = block(model, "Rune" .. i, Vector3.new(0.35, 0.55, 0.08), CFrame.new(math.cos(ang) * 1.0, 1.4, math.sin(ang) * 1.0) * CFrame.Angles(0, -ang + math.rad(90), 0), pattern, Enum.Material.Neon)
			r.Transparency = 0.1
		end
	else
		cyl(model, "Stripe1", Vector3.new(0.18, 1.95, 1.95), CFrame.new(0, 1.05, 0) * CFrame.Angles(0, 0, math.rad(90)), pattern, Enum.Material.Metal)
		cyl(model, "Stripe2", Vector3.new(0.18, 1.85, 1.85), CFrame.new(0, 1.75, 0) * CFrame.Angles(0, 0, math.rad(90)), C3(40, 90, 200))
	end
	ball(model, "Spot1", 0.45, CFrame.new(0.55, 2.0, -0.7), base:Lerp(C3(255, 255, 255), 0.5))
	ball(model, "Spot2", 0.35, CFrame.new(-0.6, 0.8, -0.75), base:Lerp(C3(255, 255, 255), 0.5))
	if variant == "rare" then
		shell.Material = Enum.Material.Metal
		addParticles(shell, C3(255, 230, 120), 5, { size = 0.3 })
		addLight(shell, C3(255, 220, 120), 8, 1)
	elseif variant == "special" then
		shell.Material = Enum.Material.Neon
		shell.Color = C3(255, 245, 200)
		addParticles(shell, C3(255, 240, 150), 12, { size = 0.45, speed = 3 })
		addLight(shell, C3(255, 230, 140), 18, 3)
	elseif variant == "event" then
		shell.Material = Enum.Material.Neon
		addParticles(shell, base, 10, { size = 0.4, speed = 2.5 })
		addLight(shell, base, 14, 2)
	end
	finalize(model, root)
	ModelFactory.applyMutation(model, mutationName)
	local s = Formulas.size(sizeName).scale
	if s ~= 1 then
		model:ScaleTo(s)
	end
	return model
end

function ModelFactory.unanchor(model: Model)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = false
			d.Massless = true
			d.CanCollide = false
		end
	end
end

-- ---------- guardians ----------
ModelFactory.GuardianDefs = {
	[1] = { name = "Cyclops Shepherd", arch = "Golem", colors = { C3(150, 170, 110), C3(200, 170, 130), C3(255, 230, 120) }, acc = "none" },
	[2] = { name = "Scylla Warden", arch = "Serpent", colors = { C3(40, 120, 160), C3(120, 210, 220), C3(255, 120, 90) }, acc = "fins" },
	[3] = { name = "Minotaur Warden", arch = "Humanoid", colors = { C3(110, 60, 35), C3(170, 120, 80), C3(230, 230, 230) }, acc = "horns" },
	[4] = { name = "Bronze Talos", arch = "Golem", colors = { C3(205, 140, 60), C3(150, 95, 40), C3(255, 240, 150) }, acc = "lightning" },
	[5] = { name = "Draugr Chief", arch = "Humanoid", colors = { C3(80, 100, 90), C3(140, 150, 140), C3(120, 220, 255) }, acc = "helmet" },
	[6] = { name = "Frost Jotun", arch = "Golem", colors = { C3(150, 200, 235), C3(220, 240, 255), C3(80, 160, 255) }, acc = "crystal" },
	[7] = { name = "Forge Colossus", arch = "Golem", colors = { C3(70, 60, 60), C3(120, 80, 60), C3(255, 120, 30) }, acc = "flame" },
	[8] = { name = "Einherjar Champion", arch = "Humanoid", colors = { C3(200, 200, 215), C3(255, 210, 90), C3(120, 200, 255) }, acc = "spear" },
	[9] = { name = "Crocodile Sentinel", arch = "Dragon", colors = { C3(60, 110, 60), C3(190, 180, 110), C3(255, 210, 80) }, acc = "crown" },
	[10] = { name = "Mummy Pharaoh", arch = "Humanoid", colors = { C3(225, 215, 190), C3(200, 190, 160), C3(255, 200, 60) }, acc = "mask" },
	[11] = { name = "Duat Devourer", arch = "Canine", colors = { C3(40, 30, 60), C3(120, 80, 200), C3(255, 60, 140) }, acc = "flame" },
	[12] = { name = "Solar Sphinx", arch = "Feline", colors = { C3(230, 190, 110), C3(255, 150, 40), C3(255, 250, 200) }, acc = "sun" },
}

-- Guardian = scaled creature + HumanoidRootPart + Humanoid (moves via Humanoid:MoveTo).
function ModelFactory.guardian(biomeId: number): Model
	local def = ModelFactory.GuardianDefs[biomeId] or ModelFactory.GuardianDefs[1]
	local model = Instance.new("Model")
	model.Name = "Guardian_" .. biomeId
	local builder = Arch[def.arch]
	local root, headCF, handCF = builder(model, def.colors[1], def.colors[2], def.colors[3])
	if def.acc ~= "none" then
		accessory(model, def.acc, headCF, handCF, def.colors, "")
	end
	-- angry brows
	block(model, "Brow", Vector3.new(0.9, 0.12, 0.1), headCF * CFrame.new(0, 0.38, -0.62) * CFrame.Angles(0, 0, 0), C3(30, 20, 20))
	local scale = 2.6
	local _, size = model:GetBoundingBox()
	local height = size.Y
	local hrp = block(model, "HumanoidRootPart", Vector3.new(2, 2, 1), CFrame.new(0, height * 0.5, 0), C3(255, 255, 255))
	hrp.Transparency = 1
	model.PrimaryPart = hrp
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") and d ~= hrp then
			local w = Instance.new("WeldConstraint")
			w.Part0 = hrp
			w.Part1 = d
			w.Parent = d
		end
	end
	model:ScaleTo(scale)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = false
			d.CanCollide = false
			d.CanQuery = false
			d.Massless = d ~= hrp
		end
	end
	hrp.CanCollide = true
	local hum = Instance.new("Humanoid")
	hum.HipHeight = hrp.Position.Y - hrp.Size.Y / 2 -- feet were at y=0
	hum.WalkSpeed = 12
	hum.MaxHealth = math.huge
	hum.Health = math.huge
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	hum.BreakJointsOnDeath = false
	hum.Parent = model
	model:SetAttribute("GuardianName", def.name)
	return model
end

-- ---------- treadmills ----------
local TREADMILL_STYLE = {
	[1] = { frame = C3(120, 125, 135), belt = C3(40, 40, 45), accent = C3(90, 200, 255), mat = Enum.Material.SmoothPlastic },
	[2] = { frame = C3(140, 95, 55), belt = C3(70, 50, 35), accent = C3(200, 160, 100), mat = Enum.Material.WoodPlanks },
	[3] = { frame = C3(150, 155, 165), belt = C3(35, 35, 40), accent = C3(255, 120, 40), mat = Enum.Material.DiamondPlate },
	[4] = { frame = C3(255, 200, 60), belt = C3(60, 45, 20), accent = C3(255, 255, 200), mat = Enum.Material.Metal },
	[5] = { frame = C3(30, 35, 60), belt = C3(20, 20, 35), accent = C3(80, 180, 255), mat = Enum.Material.Metal },
	[6] = { frame = C3(240, 235, 225), belt = C3(60, 50, 40), accent = C3(255, 215, 90), mat = Enum.Material.Marble },
	[7] = { frame = C3(150, 190, 255), belt = C3(20, 20, 50), accent = C3(200, 160, 255), mat = Enum.Material.Glass },
	[8] = { frame = C3(30, 20, 25), belt = C3(15, 10, 10), accent = C3(255, 80, 20), mat = Enum.Material.Basalt },
	[9] = { frame = C3(225, 195, 140), belt = C3(80, 55, 20), accent = C3(255, 170, 40), mat = Enum.Material.Sandstone },
	[10] = { frame = C3(250, 250, 255), belt = C3(30, 20, 50), accent = C3(255, 120, 220), mat = Enum.Material.Glass },
}

-- Returns a Model at origin (front faces -Z). Contains "Belt" (conveyor) and "Stripe#" parts.
function ModelFactory.treadmill(tier: number): Model
	local m = override("Treadmills", "Treadmill" .. tier)
	if m then
		return m
	end
	local style = TREADMILL_STYLE[tier] or TREADMILL_STYLE[1]
	m = Instance.new("Model")
	m.Name = "Treadmill"
	local length, width = 14, 6
	local deck = block(m, "Deck", Vector3.new(width + 1.2, 1, length + 1), CFrame.new(0, 0.5, 0), style.frame, style.mat)
	deck.CanCollide = true
	local belt = block(m, "Belt", Vector3.new(width, 0.3, length), CFrame.new(0, 1.15, 0), style.belt, Enum.Material.Fabric)
	belt.CanCollide = true
	belt.CanQuery = true
	for i = 1, 7 do
		local stripe = block(m, "Stripe" .. i, Vector3.new(width - 0.2, 0.05, 0.25), CFrame.new(0, 1.33, -length / 2 + i * (length / 7) - 1), style.accent, Enum.Material.Neon)
		stripe.Transparency = 0.35
		stripe:SetAttribute("Index", i)
	end
	-- rollers
	cyl(m, "RollerFront", Vector3.new(width + 0.6, 1.1, 1.1), CFrame.new(0, 1.0, -length / 2) , style.accent, Enum.Material.Metal)
	cyl(m, "RollerBack", Vector3.new(width + 0.6, 1.1, 1.1), CFrame.new(0, 1.0, length / 2), style.accent, Enum.Material.Metal)
	-- rails + console
	local railC = style.frame:Lerp(C3(255, 255, 255), 0.15)
	block(m, "RailL", Vector3.new(0.35, 0.35, length * 0.6), CFrame.new(-width / 2 - 0.3, 4, -length * 0.15), railC, style.mat)
	block(m, "RailR", Vector3.new(0.35, 0.35, length * 0.6), CFrame.new(width / 2 + 0.3, 4, -length * 0.15), railC, style.mat)
	block(m, "PostL", Vector3.new(0.4, 3.2, 0.4), CFrame.new(-width / 2 - 0.3, 2.6, -length / 2 + 0.6), railC, style.mat)
	block(m, "PostR", Vector3.new(0.4, 3.2, 0.4), CFrame.new(width / 2 + 0.3, 2.6, -length / 2 + 0.6), railC, style.mat)
	local console = block(m, "Console", Vector3.new(width + 0.8, 1.6, 0.5), CFrame.new(0, 4.6, -length / 2 + 0.6) * CFrame.Angles(math.rad(-20), 0, 0), style.frame, style.mat)
	local screen = block(m, "Screen", Vector3.new(width * 0.7, 1.0, 0.1), console.CFrame * CFrame.new(0, 0, 0.27), style.accent, Enum.Material.Neon)
	screen.Transparency = 0.2
	-- tier decorations
	if tier == 2 then
		for i = -1, 1, 2 do
			cyl(m, "Rope" .. i, Vector3.new(0.25, length * 0.6, 0.25), CFrame.new(i * (width / 2 + 0.3), 3.4, -length * 0.15) * CFrame.Angles(0, math.rad(90), 0), C3(200, 170, 110), Enum.Material.Fabric)
		end
	elseif tier == 3 then
		for i = 1, 6 do
			ball(m, "Rivet" .. i, 0.3, CFrame.new((i % 2 == 0) and width / 2 + 0.55 or -width / 2 - 0.55, 0.8, -length / 2 + i * 2), C3(90, 90, 100), Enum.Material.Metal)
		end
	elseif tier == 4 then
		for i = -1, 1, 2 do
			ball(m, "Gem" .. i, 0.6, CFrame.new(i * (width / 2 + 0.3), 5.6, -length / 2 + 0.6), C3(255, 60, 90), Enum.Material.Neon)
		end
	elseif tier == 5 then
		for i = -1, 1, 2 do
			local rod = block(m, "Rod" .. i, Vector3.new(0.3, 4, 0.3), CFrame.new(i * (width / 2 + 0.6), 3, length / 2 - 0.5), C3(80, 80, 100), Enum.Material.Metal)
			local tip = ball(m, "RodTip" .. i, 0.7, rod.CFrame * CFrame.new(0, 2.2, 0), style.accent, Enum.Material.Neon)
			addLight(tip, style.accent, 10, 2)
			addParticles(tip, style.accent, 6, { speed = 4, size = 0.2 })
		end
	elseif tier == 6 then
		local halo = cyl(m, "Halo", Vector3.new(0.3, 8, 8), CFrame.new(0, 7.5, -length / 2 + 0.5) * CFrame.Angles(0, math.rad(90), 0), style.accent, Enum.Material.Neon)
		halo.Transparency = 0.3
		for i = -1, 1, 2 do
			cyl(m, "Column" .. i, Vector3.new(5, 1.1, 1.1), CFrame.new(i * (width / 2 + 1.1), 3, length / 2 - 1) * CFrame.Angles(0, 0, math.rad(90)), C3(245, 240, 230), Enum.Material.Marble)
		end
	elseif tier == 7 then
		for i = 1, 5 do
			local star = ball(m, "Star" .. i, 0.45, CFrame.new(math.sin(i) * 4, 6 + (i % 3), -length / 2 + i * 2.5), C3(220, 200, 255), Enum.Material.Neon)
			star.Transparency = 0.1
		end
		addParticles(deck, style.accent, 6, { size = 0.25 })
	elseif tier == 8 then
		for i = 1, 6 do
			wedge(m, "Spike" .. i, Vector3.new(0.6, 1.4, 0.8), CFrame.new((i % 2 == 0) and width / 2 + 0.8 or -width / 2 - 0.8, 1.4, -length / 2 + i * 2), C3(40, 30, 30), Enum.Material.Basalt)
		end
		local lava = block(m, "LavaStrip", Vector3.new(width + 1.3, 0.2, 0.6), CFrame.new(0, 1.05, length / 2 + 0.3), style.accent, Enum.Material.Neon)
		addParticles(lava, C3(255, 120, 30), 8, { speed = 3, size = 0.25 })
	elseif tier == 9 then
		local sun = cyl(m, "SunDisk", Vector3.new(0.4, 7, 7), CFrame.new(0, 8, -length / 2 + 0.3) * CFrame.Angles(0, math.rad(90), 0), style.accent, Enum.Material.Neon)
		addLight(sun, style.accent, 18, 2)
		for i = -1, 1, 2 do
			wedge(m, "Obelisk" .. i, Vector3.new(1, 6, 1), CFrame.new(i * (width / 2 + 1.3), 3.5, length / 2 - 1), C3(220, 190, 130), Enum.Material.Sandstone)
		end
	elseif tier == 10 then
		for i = 1, 3 do
			local ring = cyl(m, "Ring" .. i, Vector3.new(0.25, 6 + i * 1.5, 6 + i * 1.5), CFrame.new(0, 7 + i * 0.8, -length / 2 + 1) * CFrame.Angles(math.rad(i * 25), math.rad(90), 0), Color3.fromHSV(i / 3, 0.6, 1), Enum.Material.Neon)
			ring.Transparency = 0.25
			CollectionService:AddTag(ring, "SpinRing")
		end
		addParticles(deck, C3(255, 150, 255), 10, { size = 0.3, speed = 2 })
	end
	m.PrimaryPart = deck
	return m
end

-- ---------- traps ----------
function ModelFactory.trap(): Model
	local m = Instance.new("Model")
	m.Name = "Trap"
	local base = cyl(m, "Base", Vector3.new(0.3, 3.2, 3.2), CFrame.new(0, 0.15, 0) * CFrame.Angles(0, 0, math.rad(90)), C3(90, 90, 100), Enum.Material.Metal)
	for i = 1, 8 do
		local ang = math.rad(i * 45)
		local tooth = wedge(m, "Tooth" .. i, Vector3.new(0.25, 0.6, 0.35), CFrame.new(math.cos(ang) * 1.3, 0.55, math.sin(ang) * 1.3) * CFrame.Angles(0, -ang, 0), C3(200, 200, 210), Enum.Material.Metal)
		tooth:SetAttribute("Angle", ang)
	end
	block(m, "Plate", Vector3.new(1.2, 0.1, 1.2), CFrame.new(0, 0.32, 0), C3(160, 60, 50), Enum.Material.Metal)
	finalize(m, base)
	return m
end

return ModelFactory
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX0000000D"><Properties><string name="Name">Util</string></Properties><Item class="ModuleScript" referent="RBX00000008"><Properties><string name="Name">Formulas</string><ProtectedString name="Source"><![CDATA[--[[
	Formulas — pure balance math shared by server (authoritative) and client (display only).
	Every number comes from Config/Balance.json so designers tune one file.
]]

local Config = script.Parent.Parent:WaitForChild("Config")
local Balance = require(Config:WaitForChild("Balance"))
local Creatures = require(Config:WaitForChild("Creatures"))

local Formulas = {}

local sizeByName = {}
for i, s in ipairs(Balance.sizes) do
	s.index = i
	sizeByName[s.name] = s
end
local mutationByName = {}
for i, m in ipairs(Balance.mutations) do
	m.index = i
	mutationByName[m.name] = m
end
local rarityByName = {}
for i, r in ipairs(Balance.rarities) do
	r.index = i
	rarityByName[r.name] = r
end
local trailById = {}
for _, t in ipairs(Balance.trails) do
	trailById[t.id] = t
end
for _, t in ipairs(Balance.rewardTrails) do
	trailById[t.id] = t
end

Formulas.Balance = Balance

function Formulas.size(name: string?)
	return sizeByName[name or "Normal"] or sizeByName.Normal
end
function Formulas.mutation(name: string?)
	return mutationByName[name or "None"] or mutationByName.None
end
function Formulas.rarity(name: string?)
	return rarityByName[name or "Common"] or rarityByName.Common
end
function Formulas.trail(id: string?)
	if id == nil then
		return nil
	end
	return trailById[id]
end
function Formulas.biome(id: number)
	return Balance.biomes[math.clamp(id, 1, #Balance.biomes)]
end
function Formulas.treadmill(tier: number)
	return Balance.treadmills[math.clamp(tier, 1, #Balance.treadmills)]
end
function Formulas.baseLevel(level: number)
	return Balance.baseLevels[math.clamp(level, 1, #Balance.baseLevels)]
end

-- Highest biome unlocked by a Speed value.
function Formulas.unlockedBiome(speed: number): number
	local unlocked = 1
	for _, b in ipairs(Balance.biomes) do
		if speed >= b.speedRequired then
			unlocked = b.id
		end
	end
	return unlocked
end

-- Movement speed derived from training Speed (log scaled + capped) and carry penalty.
function Formulas.walkSpeed(speed: number, carrySize: string?, penaltyReduction: number?, mult: number?): number
	local cfg = Balance.speed
	local ws = cfg.baseWalkSpeed + cfg.walkLogFactor * math.log10(1 + math.max(0, speed))
	ws = math.min(ws, cfg.maxWalkSpeed)
	if carrySize then
		local penalty = cfg.carryPenaltyBySize[carrySize] or 0.2
		penalty *= 1 - math.clamp(penaltyReduction or 0, 0, 0.9)
		ws *= 1 - penalty
	end
	ws *= mult or 1
	return math.min(ws, cfg.maxWalkSpeed * 1.4)
end

-- Base income of a species (before size/mutation). Event creatures scale with stored tier.
function Formulas.speciesBaseIncome(speciesId: string, tier: number?): number
	local c = Creatures.ById[speciesId]
	if not c then
		return 0
	end
	if c.biome == 0 then
		local b = Formulas.biome(tier or 1)
		return b.baseIncome * Balance.worldEvents.eventIncomeBiomeBonus
	end
	return Formulas.biome(c.biome).baseIncome * Balance.speciesIncomeMultiplier[c.slot]
end

-- Income/s of a single pet record {species, size, mutation, tier}.
function Formulas.petIncome(pet): number
	local c = Creatures.ById[pet.species]
	if not c then
		return 0
	end
	local base = Formulas.speciesBaseIncome(pet.species, pet.tier)
	local mult = Formulas.rarity(c.rarity).mult * Formulas.size(pet.size).mult * Formulas.mutation(pet.mutation).mult
	local dr = Balance.diminishingReturns
	if mult > dr.threshold then
		mult = dr.threshold + (mult - dr.threshold) ^ dr.exponent
	end
	return base * mult
end

-- Sum of global modifiers, capped so stacking never breaks the economy.
function Formulas.globalIncomeMultiplier(mods): number
	local e = Balance.economy
	local m = 1
	if mods.vip then
		m *= e.vipMultiplier
	end
	if mods.moneyPass then
		m *= e.moneyPassMultiplier
	end
	if mods.moneyBoost then
		m *= e.moneyBoostMultiplier
	end
	if mods.abilityMult then
		m *= mods.abilityMult
	end
	return math.min(m, Balance.globalModifierCap)
end

function Formulas.totalIncome(pets, mods): number
	local sum = 0
	for _, pet in pets do
		sum += Formulas.petIncome(pet)
	end
	return sum * Formulas.globalIncomeMultiplier(mods or {})
end

-- Speed gained per treadmill step.
function Formulas.trainGain(treadmillTier: number, trailId: string?, mods): number
	local per = Formulas.treadmill(treadmillTier).perStep
	local trail = Formulas.trail(trailId)
	local m = trail and trail.mult or 1
	local e = Balance.economy
	if mods then
		if mods.trainingPass then
			m *= e.trainingPassMultiplier
		end
		if mods.trainingBoost then
			m *= e.trainingBoostMultiplier
		end
		if mods.abilityMult then
			m *= mods.abilityMult
		end
	end
	return per * m
end

function Formulas.incubationSeconds(biomeId: number, sizeName: string, growthPass: boolean, special: boolean?): number
	local base = special and Balance.specialEgg.incubation or Formulas.biome(biomeId).incubation
	local t = base * Formulas.size(sizeName).incubationMult
	if growthPass then
		t *= Balance.economy.growthPassMultiplier
	end
	return math.max(5, math.floor(t))
end

function Formulas.offlineEarnings(incomePerSecond: number, secondsAway: number): number
	local e = Balance.economy
	local secs = math.clamp(secondsAway, 0, e.offlineCapSeconds)
	return math.floor(incomePerSecond * secs * e.offlineRate)
end

function Formulas.sellValue(pet): number
	return math.floor(Formulas.petIncome(pet) * Balance.economy.sellSecondsOfIncome)
end

-- Dynamic bot population: min(maxBots, max(0, target - realPlayers)).
function Formulas.botCount(realPlayers: number): number
	local b = Balance.bots
	return math.min(b.maxBots, math.max(0, b.targetPopulation - realPlayers))
end

function Formulas.incubatorCount(baseLevel: number, extraBasePass: boolean): number
	local n = Formulas.baseLevel(baseLevel).incubators
	if extraBasePass then
		n += Balance.economy.extraBaseIncubators
	end
	return n
end

return Formulas
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000009"><Properties><string name="Name">Net</string><ProtectedString name="Source"><![CDATA[--[[
	Net — the single remote boundary of the game.

	Remotes are created ONLY by the server (Net.serverInit) inside ReplicatedStorage.Remotes from
	the lists below. Every client->server handler passes through per-player rate limiting and the
	server never trusts payload contents (each handler validates its own arguments).
]]

local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = {}

-- Client -> Server (RemoteEvent), with max calls per second (token bucket).
Net.ClientEvents = {
	TrainPing = 8,
	UseAbility = 3,
	DropEgg = 2,
}
-- Client -> Server request/response (RemoteFunction "Request"): action name -> max per second.
Net.Actions = {
	BuyTreadmill = 3,
	BuyTrail = 3,
	EquipTrail = 4,
	UpgradeBase = 2,
	EquipPet = 4,
	SellPet = 6,
	PlaceTrap = 2,
	RemoveTrap = 3,
	ClaimIndexReward = 3,
	OpenReliquaryKey = 1,
	ClaimVipDaily = 1,
	SaveSettings = 2,
	TutorialStep = 4,
	GetReliquaryInfo = 2,
	GetLeaderboard = 1,
}
-- Server -> Client (RemoteEvent)
Net.ServerEvents = {
	"State", "Notify", "HatchReveal", "Effect", "Knockback", "Trapped", "Announce",
	"OfflineSummary", "Reveal", "WorldState", "Freeze",
}

local folder: Folder? = nil

-- ===================== SERVER =====================
local buckets = {} -- [player][name] = {tokens, last}

local function allow(player: Player, name: string, rate: number): boolean
	local now = os.clock()
	local perPlayer = buckets[player]
	if not perPlayer then
		perPlayer = {}
		buckets[player] = perPlayer
	end
	local b = perPlayer[name]
	if not b then
		b = { tokens = rate, last = now }
		perPlayer[name] = b
	end
	b.tokens = math.min(rate, b.tokens + (now - b.last) * rate)
	b.last = now
	if b.tokens < 1 then
		return false
	end
	b.tokens -= 1
	return true
end

Net.onRateLimited = nil -- optional callback(player, name)

function Net.serverInit()
	assert(RunService:IsServer(), "Net.serverInit is server-only")
	local existing = ReplicatedStorage:FindFirstChild("Remotes")
	if existing then
		existing:Destroy()
	end
	local f = Instance.new("Folder")
	f.Name = "Remotes"
	for name in Net.ClientEvents do
		local r = Instance.new("RemoteEvent")
		r.Name = name
		r.Parent = f
	end
	for _, name in Net.ServerEvents do
		local r = Instance.new("RemoteEvent")
		r.Name = name
		r.Parent = f
	end
	local rf = Instance.new("RemoteFunction")
	rf.Name = "Request"
	rf.Parent = f
	f.Parent = ReplicatedStorage
	folder = f

	game:GetService("Players").PlayerRemoving:Connect(function(p)
		buckets[p] = nil
	end)

	local actionHandlers = {}
	Net._actionHandlers = actionHandlers
	rf.OnServerInvoke = function(player, action, payload)
		if typeof(action) ~= "string" then
			return false, "invalid"
		end
		local rate = Net.Actions[action]
		local handler = actionHandlers[action]
		if not rate or not handler then
			return false, "unknown action"
		end
		if not allow(player, "A_" .. action, rate) then
			if Net.onRateLimited then
				Net.onRateLimited(player, action)
			end
			return false, "Muito rápido! Tente novamente."
		end
		if payload ~= nil and typeof(payload) ~= "table" then
			return false, "invalid payload"
		end
		local ok, a, b = pcall(handler, player, payload or {})
		if not ok then
			warn("[Net] action", action, "failed:", a)
			return false, "Erro interno"
		end
		return a, b
	end
end

function Net.handle(action: string, fn)
	assert(Net.Actions[action], "Unknown action " .. action)
	Net._actionHandlers[action] = fn
end

function Net.on(name: string, fn)
	local rate = Net.ClientEvents[name]
	assert(rate, "Unknown client event " .. name)
	local remote = (folder :: Folder):FindFirstChild(name) :: RemoteEvent
	remote.OnServerEvent:Connect(function(player, ...)
		if not allow(player, "E_" .. name, rate) then
			if Net.onRateLimited then
				Net.onRateLimited(player, name)
			end
			return
		end
		local ok, err = pcall(fn, player, ...)
		if not ok then
			warn("[Net] event", name, "failed:", err)
		end
	end)
end

function Net.fire(player: Player?, name: string, ...)
	if not player or typeof(player) ~= "Instance" or not player:IsA("Player") then
		return -- bots have no client
	end
	local remote = (folder :: Folder):FindFirstChild(name) :: RemoteEvent
	remote:FireClient(player, ...)
end

function Net.fireAll(name: string, ...)
	local remote = (folder :: Folder):FindFirstChild(name) :: RemoteEvent
	remote:FireAllClients(...)
end

-- ===================== CLIENT =====================
local clientFolder: Instance? = nil
local function getFolder()
	if not clientFolder then
		clientFolder = ReplicatedStorage:WaitForChild("Remotes")
	end
	return clientFolder :: Instance
end

function Net.send(name: string, ...)
	(getFolder():WaitForChild(name) :: RemoteEvent):FireServer(...)
end

function Net.request(action: string, payload): (boolean, any)
	local rf = getFolder():WaitForChild("Request") :: RemoteFunction
	local ok, a, b = pcall(rf.InvokeServer, rf, action, payload)
	if not ok then
		return false, "Falha de conexão"
	end
	return a, b
end

function Net.listen(name: string, fn)
	return (getFolder():WaitForChild(name) :: RemoteEvent).OnClientEvent:Connect(fn)
end

return Net
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000A"><Properties><string name="Name">NumberFormatter</string><ProtectedString name="Source"><![CDATA[--[[
	NumberFormatter — compact formatting for very large numbers (K, M, B, T, Qa, Qi, Sx, Sp, Oc, No, Dc ...).
	Pure module; safe on client and server.
]]

local NumberFormatter = {}

local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc", "Ud", "Dd", "Td", "Qad", "Qid" }

local function trimZeros(s: string): string
	if string.find(s, "%.") then
		s = string.gsub(s, "0+$", "")
		s = string.gsub(s, "%.$", "")
	end
	return s
end

-- Formats a number as e.g. 1.25M. decimals defaults to 2.
function NumberFormatter.format(n: number?, decimals: number?): string
	local value = tonumber(n) or 0
	if value ~= value then
		return "0" -- NaN guard
	end
	if value == math.huge then
		return "∞"
	end
	local negative = value < 0
	value = math.abs(value)
	local places = decimals or 2

	local text
	if value < 1000 then
		if value >= 100 or value == math.floor(value) then
			text = tostring(math.floor(value))
		else
			text = trimZeros(string.format("%.1f", value))
		end
	else
		local tier = math.floor(math.log10(value) / 3)
		if tier >= #SUFFIXES then
			text = string.format("%.2e", value)
		else
			local scaled = value / (10 ^ (tier * 3))
			-- floor to avoid showing 1000K due to rounding
			local factor = 10 ^ places
			scaled = math.floor(scaled * factor) / factor
			if scaled >= 1000 and tier + 1 < #SUFFIXES then
				tier += 1
				scaled = scaled / 1000
			end
			text = trimZeros(string.format("%." .. places .. "f", scaled)) .. SUFFIXES[tier + 1]
		end
	end
	return (negative and "-" or "") .. text
end

-- Full number with thousands separators (for small values / tooltips).
function NumberFormatter.commas(n: number): string
	local s = tostring(math.floor(tonumber(n) or 0))
	local out = s
	while true do
		local replaced
		out, replaced = string.gsub(out, "^(-?%d+)(%d%d%d)", "%1.%2")
		if replaced == 0 then
			break
		end
	end
	return out
end

-- Seconds -> "1h 05m", "4m 03s", "12s"
function NumberFormatter.time(seconds: number?): string
	local s = math.max(0, math.floor(tonumber(seconds) or 0))
	local h = s // 3600
	local m = (s % 3600) // 60
	local sec = s % 60
	if h > 0 then
		return string.format("%dh %02dm", h, m)
	elseif m > 0 then
		return string.format("%dm %02ds", m, sec)
	end
	return string.format("%ds", sec)
end

return NumberFormatter
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000B"><Properties><string name="Name">Signal</string><ProtectedString name="Source"><![CDATA[--[[
	Signal — tiny synchronous signal used for cross-system events on the same side.
]]

local Signal = {}
Signal.__index = Signal

function Signal.new()
	return setmetatable({ _handlers = {} }, Signal)
end

function Signal:Connect(fn)
	local handlers = self._handlers
	table.insert(handlers, fn)
	local connection = {}
	function connection.Disconnect()
		local i = table.find(handlers, fn)
		if i then
			table.remove(handlers, i)
		end
	end
	return connection
end

function Signal:Fire(...)
	for _, fn in table.clone(self._handlers) do
		task.spawn(fn, ...)
	end
end

return Signal
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000C"><Properties><string name="Name">WeightedRandom</string><ProtectedString name="Source"><![CDATA[--[[
	WeightedRandom — deterministic-friendly weighted picks.
]]

local WeightedRandom = {}

-- entries: array of items; weightOf: function(item) -> number. rng optional Random.
function WeightedRandom.pick(entries, weightOf, rng: Random?)
	local total = 0
	for _, e in entries do
		total += math.max(0, weightOf(e))
	end
	if total <= 0 then
		return entries[1]
	end
	local r = (rng and rng:NextNumber() or math.random()) * total
	for _, e in entries do
		r -= math.max(0, weightOf(e))
		if r <= 0 then
			return e
		end
	end
	return entries[#entries]
end

-- weights: array of numbers -> returns index
function WeightedRandom.index(weights: { number }, rng: Random?): number
	local total = 0
	for _, w in weights do
		total += w
	end
	local r = (rng and rng:NextNumber() or math.random()) * total
	for i, w in weights do
		r -= w
		if r <= 0 then
			return i
		end
	end
	return #weights
end

return WeightedRandom
]]></ProtectedString></Properties></Item></Item></Item></Item><Item class="ServerScriptService" referent="RBX00000044"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX0000002C"><Properties><string name="Name">Server</string><ProtectedString name="Source"><![CDATA[--[[
	STEAL AN GOD — the single server entry point.

	Two-phase boot (roblox-dev architecture skill):
	  1. build the world (if not already saved in the place)
	  2. require every system, call init(S) on all of them (wiring only, no yielding loops)
	  3. call start() on all of them (loops, connections that depend on other systems)
	Systems talk through the shared registry S (S.Economy, S.Eggs, ...) — no _G, no require cycles.
]]

local ServerScriptService = game:GetService("ServerScriptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Server = script
local Net = require(ReplicatedStorage.Shared.Util.Net)
local WorldBuilder = require(Server.World.WorldBuilder)

-- 1. World
local t0 = os.clock()
WorldBuilder.build(false)
WorldBuilder.ensureRuntime()
print(string.format("[SAG] World ready in %.2fs", os.clock() - t0))

-- 2. Remotes
Net.serverInit()

-- 3. Systems (explicit order = deterministic init/start)
local ORDER = {
	"Security", "Actors", "PlayerData", "Monetization", "Economy", "Bases", "Biomes", "Speed", "Trails",
	"Eggs", "Theft", "Hatch", "Pets", "Guardians", "Abilities", "Traps", "Events", "Collection",
	"Tutorial", "Leaderboard",
}
local BOT_ORDER = { "BotNavigator", "BotAvatar", "BotBrain", "BotPopulation" }

local S = {}
S.WorldBuilder = WorldBuilder
S.Net = Net

for _, name in ORDER do
	S[name] = require(Server.Systems:FindFirstChild(name))
end
for _, name in BOT_ORDER do
	S[name] = require(Server.Bots:FindFirstChild(name))
end

local function each(list, method)
	for _, name in list do
		local sys = S[name]
		if typeof(sys[method]) == "function" then
			if method == "init" then
				sys.init(S)
			else
				task.spawn(sys.start)
			end
		end
	end
end

each(ORDER, "init")
each(BOT_ORDER, "init")
each(ORDER, "start")
each(BOT_ORDER, "start")

ServerScriptService:SetAttribute("SAG_Ready", true)
print("[SAG] STEAL AN GOD server started")
]]></ProtectedString></Properties><Item class="Folder" referent="RBX00000013"><Properties><string name="Name">Bots</string></Properties><Item class="ModuleScript" referent="RBX0000000F"><Properties><string name="Name">BotAvatar</string><ProtectedString name="Source"><![CDATA[--[[
	BotAvatar — builds the character of a simulated participant: an R15 avatar created from a
	HumanoidDescription (random skin/clothing colors + simple accessories), the display name like
	any player's (no "BOT"/"AI"/"NPC" label), and server-side animations driven centrally.

	Clothing asset ids can be added to OUTFITS (only ids you own/are allowed to use).
	If avatar creation fails (e.g. no network in Studio), a stylized fallback rig is used.
]]

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ModelFactory = require(ReplicatedStorage.Shared.Factory.ModelFactory)

local BotAvatar = {}
local S

local C3 = Color3.fromRGB
local SKIN = { C3(255, 220, 177), C3(234, 184, 146), C3(198, 134, 66), C3(141, 85, 36), C3(255, 204, 153), C3(110, 70, 40) }
local SHIRT = { C3(220, 60, 60), C3(60, 120, 220), C3(40, 170, 90), C3(240, 190, 40), C3(150, 70, 200), C3(30, 30, 40), C3(255, 140, 40), C3(240, 240, 240), C3(60, 200, 200) }
local PANTS = { C3(40, 40, 60), C3(30, 60, 120), C3(70, 50, 40), C3(20, 20, 20), C3(90, 90, 100) }
local OUTFITS = {
	-- { Shirt = 0, Pants = 0 }  -- fill with asset ids you are allowed to use
}

-- Default Roblox R15 animations (Roblox-owned, used by the default Animate script).
local ANIMS = {
	idle = "rbxassetid://507766666",
	walk = "rbxassetid://507777826",
	run = "rbxassetid://507767714",
	jump = "rbxassetid://507765000",
	fall = "rbxassetid://507767968",
}

local tracks = {} -- [id] = {idle, walk, run, current}

function BotAvatar.init(sys)
	S = sys
end

local function pick(list, rng: Random)
	return list[rng:NextInteger(1, #list)]
end

local function hat(model: Model, rng: Random)
	local head = model:FindFirstChild("Head") :: BasePart?
	if not head then
		return
	end
	local kind = rng:NextInteger(1, 4)
	local color = pick(SHIRT, rng)
	local p = Instance.new("Part")
	p.CanCollide = false
	p.Massless = true
	p.Color = color
	p.Material = Enum.Material.SmoothPlastic
	if kind == 1 then -- cap
		p.Size = Vector3.new(1.3, 0.45, 1.3)
		p.CFrame = head.CFrame * CFrame.new(0, 0.55, 0)
	elseif kind == 2 then -- spiky hair
		p.Size = Vector3.new(1.25, 0.6, 1.25)
		p.Color = pick({ C3(40, 30, 20), C3(250, 220, 120), C3(200, 80, 40), C3(20, 20, 20) }, rng)
		p.CFrame = head.CFrame * CFrame.new(0, 0.5, 0.05)
	elseif kind == 3 then -- headband
		p.Size = Vector3.new(1.3, 0.2, 1.3)
		p.CFrame = head.CFrame * CFrame.new(0, 0.3, 0)
	else -- laurel / crown
		p.Shape = Enum.PartType.Cylinder
		p.Size = Vector3.new(0.25, 1.3, 1.3)
		p.Color = C3(255, 210, 80)
		p.Material = Enum.Material.Metal
		p.CFrame = head.CFrame * CFrame.new(0, 0.55, 0) * CFrame.Angles(0, 0, math.rad(90))
	end
	local w = Instance.new("WeldConstraint")
	w.Part0 = head
	w.Part1 = p
	w.Parent = p
	p.Parent = model
end

local function fallbackRig(name: string, rng: Random): Model
	local model = ModelFactory.creature("Hermes", "Normal", "None")
	model.Name = name
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.Color = d.Color:Lerp(pick(SHIRT, rng), 0.6)
		end
	end
	local _, size = model:GetBoundingBox()
	local hrp = Instance.new("Part")
	hrp.Name = "HumanoidRootPart"
	hrp.Size = Vector3.new(2, 2, 1)
	hrp.Transparency = 1
	hrp.CFrame = model:GetPivot() * CFrame.new(0, size.Y / 2, 0)
	hrp.Parent = model
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") and d ~= hrp then
			local w = Instance.new("WeldConstraint")
			w.Part0 = hrp
			w.Part1 = d
			w.Parent = d
		end
	end
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = false
			d.CanCollide = d == hrp
			d.Massless = d ~= hrp
		end
	end
	model.PrimaryPart = hrp
	local hum = Instance.new("Humanoid")
	hum.HipHeight = hrp.Position.Y - model:GetPivot().Position.Y - 1
	hum.Parent = model
	return model
end

function BotAvatar.build(id: number, name: string, seed: number): Model
	local rng = Random.new(seed)
	local model: Model? = nil
	local ok, result = pcall(function()
		local desc = Instance.new("HumanoidDescription")
		local skin = pick(SKIN, rng)
		desc.HeadColor = skin
		desc.LeftArmColor = skin
		desc.RightArmColor = skin
		desc.TorsoColor = pick(SHIRT, rng)
		desc.LeftLegColor = pick(PANTS, rng)
		desc.RightLegColor = desc.LeftLegColor
		desc.HeightScale = rng:NextNumber(0.92, 1.05)
		desc.WidthScale = rng:NextNumber(0.9, 1.05)
		if #OUTFITS > 0 then
			local o = pick(OUTFITS, rng)
			desc.Shirt = o.Shirt or 0
			desc.Pants = o.Pants or 0
		end
		return Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
	end)
	if ok and result then
		model = result
		model.Name = name
		hat(model, rng)
		-- shoulders/arms take the shirt color for a "clothed" look
		local torsoColor
		for _, d in model:GetDescendants() do
			if d:IsA("BasePart") and d.Name == "UpperTorso" then
				torsoColor = d.Color
			end
		end
		for _, d in model:GetDescendants() do
			if d:IsA("BasePart") and (d.Name == "LeftUpperArm" or d.Name == "RightUpperArm") and torsoColor then
				d.Color = torsoColor
			end
		end
		local animate = model:FindFirstChild("Animate")
		if animate then
			animate:Destroy() -- LocalScript would not run on a server NPC; we animate centrally
		end
	else
		warn("[BotAvatar] avatar creation failed, using fallback rig:", result)
		model = fallbackRig(name, rng)
	end
	local m = model :: Model
	local hum = m:FindFirstChildOfClass("Humanoid") :: Humanoid
	hum.DisplayName = name
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer
	hum.NameDisplayDistance = 80
	hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	hum.BreakJointsOnDeath = false
	m:SetAttribute("ActorId", id)
	m:SetAttribute("Participant", true)
	return m
end

function BotAvatar.setupAnimations(id: number, model: Model)
	local hum = model:FindFirstChildOfClass("Humanoid")
	if not hum then
		return
	end
	local animator = hum:FindFirstChildOfClass("Animator") or Instance.new("Animator")
	animator.Parent = hum
	local set = {}
	for key, assetId in ANIMS do
		local anim = Instance.new("Animation")
		anim.AnimationId = assetId
		local ok, track = pcall(animator.LoadAnimation, animator, anim)
		if ok and track then
			track.Looped = key ~= "jump"
			set[key] = track
		end
	end
	tracks[id] = set
end

function BotAvatar.forget(id: number)
	local set = tracks[id]
	if set then
		for key, t in set do
			if key ~= "current" then
				pcall(t.Stop, t)
			end
		end
	end
	tracks[id] = nil
end

local function play(set, key: string, speed: number?)
	local t = set[key]
	if not t then
		return
	end
	if set.current ~= key then
		local old = set.current and set[set.current]
		if old then
			old:Stop(0.2)
		end
		t:Play(0.2)
		set.current = key
	end
	if speed then
		t:AdjustSpeed(speed)
	end
end

function BotAvatar.start()
	task.spawn(function()
		while true do
			task.wait(0.15)
			for id, set in tracks do
				local root = S.Actors.root(id)
				local hum = S.Actors.humanoid(id)
				if root and hum then
					local v = root.AssemblyLinearVelocity
					local horizontal = Vector3.new(v.X, 0, v.Z).Magnitude
					local state = hum:GetState()
					if state == Enum.HumanoidStateType.Freefall then
						play(set, "fall")
					elseif hum.MoveDirection.Magnitude > 0.1 or horizontal > 2 then
						if hum.WalkSpeed > 22 then
							play(set, "run", math.clamp(hum.WalkSpeed / 24, 0.8, 2))
						else
							play(set, "walk", math.clamp(hum.WalkSpeed / 14, 0.7, 1.6))
						end
					else
						play(set, "idle")
					end
				end
			end
		end
	end)
end

BotAvatar._workspace = Workspace

return BotAvatar
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000010"><Properties><string name="Name">BotBrain</string><ProtectedString name="Source"><![CDATA[--[[
	BotBrain — utility-based decision making for simulated participants.

	Each bot runs one lightweight coroutine that alternates THINK (score every option with its
	personality weights + jitter + skill-based mistakes) and ACT (a physical action executed with
	BotNavigator and the SAME server APIs players use: Eggs.tryPickup, Speed training, Bases.upgrade,
	Theft.tryStealFromBase, Abilities.use, Traps.place...). No money is ever created for bots.

	States: Idle, Thinking, Training, ChoosingBiome, Exploring, ObservingGuardian, StealingEgg,
	CarryingEgg, ReturningToBase, DepositingEgg, Hatching, CollectingMoney, PurchasingUpgrade,
	ExpandingBase, SearchingRareEgg, RaidingPlayerBase, DefendingBase, UsingAbility, Recovering.
]]

local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local Balance = require(Shared.Config.Balance)
local Creatures = require(Shared.Config.Creatures)
local GameConfig = require(Shared.Config.GameConfig)
local Formulas = require(Shared.Util.Formulas)

local BotBrain = {}
local S
local bots = {} -- [id] = bot record

local ESCAPE_KINDS = { Shockwave = true, Frost = true, Decoy = true, SpeedBurst = true, Dash = true, GuardShield = true, EggShield = true, WeightRelief = true, Leap = true }

function BotBrain.init(sys)
	S = sys
end

local function setState(bot, state: string)
	bot.state = state
	local model = S.Actors.character(bot.id)
	if model then
		model:SetAttribute("BotState", state) -- QA/debug only (not displayed to players)
	end
end

local function wait(bot, seconds: number)
	local t = os.clock() + seconds
	while os.clock() < t do
		if bot.removed then
			return false
		end
		task.wait(0.25)
	end
	return true
end

local function profile(bot)
	return S.PlayerData.get(bot.id)
end

local function interrupted(bot): boolean
	if bot.removed then
		return true
	end
	local st = S.Actors.state(bot.id)
	if bot.defendTarget and not (st and st.carry) then
		return true
	end
	return false
end

local function tryAbility(bot, kinds)
	local ab = S.Abilities.definitionFor(bot.id)
	if not ab or not kinds[ab.kind] then
		return false
	end
	if S.Abilities.cooldownLeft(bot.id) > 0 or bot.rng:NextNumber() > bot.skill then
		return false
	end
	local prev = bot.state
	setState(bot, "UsingAbility")
	local ok = S.Abilities.use(bot.id)
	setState(bot, prev)
	return ok
end

-- Abort predicate used while carrying: also triggers escape abilities when a guardian is close.
local function carryWatch(bot)
	return function()
		if bot.removed then
			return true
		end
		local pos = S.Actors.position(bot.id)
		if pos then
			local d = S.Guardians.threatAt(pos)
			if d < 14 then
				tryAbility(bot, ESCAPE_KINDS)
			end
		end
		local st = S.Actors.state(bot.id)
		return not (st and st.carry)
	end
end

local function basePoint(bot, offset: Vector3): Vector3?
	local cf = S.Bases.anchorCFrame(bot.id)
	return cf and (cf * CFrame.new(offset)).Position or nil
end

-- ===================== ACTIONS =====================
local Actions = {}

function Actions.ReturnToBase(bot)
	setState(bot, "ReturningToBase")
	local goal = basePoint(bot, Vector3.new(bot.rng:NextNumber(-10, 10), 3, -14))
	if not goal then
		return
	end
	S.BotNavigator.moveTo(bot.id, goal, { abort = carryWatch(bot), tolerance = 4 })
	local st = S.Actors.state(bot.id)
	if st and st.carry and S.Bases.isInOwnBase(bot.id) then
		setState(bot, "DepositingEgg")
		wait(bot, 1.2) -- deposit happens via the Eggs loop; base full -> keep it
		if st.carry then
			Actions.ManagePets(bot)
		end
	elseif not (st and st.carry) then
		-- dropped the egg on the way: maybe recover it
		setState(bot, "Recovering")
		local pos = S.Actors.position(bot.id)
		if pos and bot.rng:NextNumber() < bot.P.risk + 0.2 then
			for eid, e in S.Eggs.worldEggs() do
				if e.kind == "ground" and (e.position - pos).Magnitude < 30 then
					local d = S.Guardians.threatAt(e.position)
					if d > 12 then
						if S.BotNavigator.moveTo(bot.id, e.position, { tolerance = 4, timeout = 8 }) then
							wait(bot, 0.5)
							if S.Eggs.tryPickup(bot.id, eid) then
								Actions.ReturnToBase(bot)
							end
						end
					end
					break
				end
			end
		end
	end
end

local function chooseBiome(bot): number
	local p = profile(bot)
	local unlocked = Formulas.unlockedBiome(p.speed)
	local key = bot.personality
	if key == "Beginner" then
		return math.max(1, unlocked - bot.rng:NextInteger(0, 1))
	elseif key == "Explorer" then
		return bot.rng:NextInteger(math.max(1, unlocked - 2), unlocked)
	elseif key == "Collector" then
		for b = unlocked, math.max(1, unlocked - 3), -1 do
			for slot = 1, 4 do
				if not p.index[Creatures.ByBiome[b][slot].id] then
					return b
				end
			end
		end
	end
	return unlocked
end

function Actions.StealEgg(bot)
	setState(bot, "ChoosingBiome")
	local biome = chooseBiome(bot)
	local candidates = {}
	for _, nest in S.Eggs.nests() do
		if nest.biome == biome and nest.egg then
			table.insert(candidates, nest)
		end
	end
	if #candidates == 0 then
		setState(bot, "Exploring")
		wait(bot, bot.rng:NextNumber(1, 3))
		return
	end
	local nest = candidates[bot.rng:NextInteger(1, #candidates)]
	local nestPos = nest.cframe.Position
	setState(bot, "Exploring")
	local staging = Vector3.new(math.sign(nestPos.X) * 12, 1, nestPos.Z + bot.rng:NextNumber(-8, 8))
	if not S.BotNavigator.moveTo(bot.id, staging, { abort = function()
		return interrupted(bot)
	end }) then
		return
	end
	-- watch the guardian and wait for a window (personality + skill)
	setState(bot, "ObservingGuardian")
	local patience = 4 + (1 - bot.P.risk) * 10
	local deadline = os.clock() + patience
	while os.clock() < deadline do
		if interrupted(bot) or not nest.egg then
			return
		end
		local d = S.Guardians.threatAt(nestPos)
		if d > 24 or bot.rng:NextNumber() < bot.P.risk * 0.15 then
			break
		end
		wait(bot, 0.5)
	end
	local eggId = nest.egg
	local e = eggId and S.Eggs.worldEggs()[eggId]
	if not e then
		return
	end
	setState(bot, "StealingEgg")
	if not S.BotNavigator.moveTo(bot.id, e.position, { tolerance = 4, timeout = 12, abort = function()
		return interrupted(bot) or S.Eggs.worldEggs()[eggId] == nil
	end }) then
		return
	end
	wait(bot, bot.rng:NextNumber(0.6, 1.0)) -- "grab" time, same as the player hold prompt
	if S.Eggs.tryPickup(bot.id, eggId) then
		setState(bot, "CarryingEgg")
		Actions.ReturnToBase(bot)
	end
end

function Actions.SearchingRareEgg(bot)
	local sp = S.Events.special
	if not sp then
		bot.specialTarget = nil
		return
	end
	setState(bot, "SearchingRareEgg")
	local eggId = sp.eggId
	if not S.BotNavigator.moveTo(bot.id, sp.position, { tolerance = 4, abort = function()
		return interrupted(bot) or S.Eggs.worldEggs()[eggId] == nil
	end }) then
		bot.specialTarget = nil
		return
	end
	wait(bot, 0.6)
	bot.specialTarget = nil
	if S.Eggs.tryPickup(bot.id, eggId) then
		Actions.ReturnToBase(bot)
	end
end

function Actions.Training(bot)
	setState(bot, "Training")
	local cf = S.Speed.treadmillCFrame(bot.id)
	if not cf then
		return
	end
	if not S.BotNavigator.moveTo(bot.id, (cf * CFrame.new(0, 3, 0)).Position, { tolerance = 2.5, abort = function()
		return interrupted(bot)
	end }) then
		return
	end
	local duration = bot.rng:NextNumber(20, 70) * bot.P.train
	local stopAt = os.clock() + duration
	local hum = S.Actors.humanoid(bot.id)
	while os.clock() < stopAt and hum do
		if interrupted(bot) or bot.specialTarget or bot.leaving then
			break
		end
		local belt = S.Speed.treadmillCFrame(bot.id)
		if not belt then
			break
		end
		hum:MoveTo((belt * CFrame.new(0, 3, -5)).Position)
		if bot.rng:NextNumber() < 0.05 then
			tryAbility(bot, { TrainBoost = true })
		end
		task.wait(0.4)
		if not S.Speed.isOnTreadmill(bot.id) then
			S.BotNavigator.moveTo(bot.id, (belt * CFrame.new(0, 3, 0)).Position, { tolerance = 2.5, timeout = 6 })
		end
	end
end

function Actions.CollectingMoney(bot)
	setState(bot, "CollectingMoney")
	local m = S.Bases.modelOf(bot.id)
	local pad = m and m:FindFirstChild("CollectPad")
	if pad then
		S.BotNavigator.moveTo(bot.id, pad.Position + Vector3.new(0, 3, 0), { tolerance = 2, abort = function()
			return interrupted(bot)
		end })
		wait(bot, 0.8)
	end
	tryAbility(bot, { IncomeBoost = true })
end

local function purchaseOptions(bot)
	local p = profile(bot)
	local opts = {}
	local t = Balance.treadmills[p.treadmillTier + 1]
	if t then
		table.insert(opts, { kind = "Treadmill", price = t.price, kiosk = "Upgrades" })
	end
	local trail = S.Trails.nextTrail(bot.id)
	if trail then
		table.insert(opts, { kind = "Trail", price = trail.price, id = trail.id, kiosk = "Trails" })
	end
	local b = Balance.baseLevels[p.baseLevel + 1]
	if b then
		table.insert(opts, { kind = "Base", price = b.price, kiosk = "Upgrades" })
	end
	return opts
end

local PRIORITY = {
	Investor = { "Base", "Treadmill", "Trail" },
	Competitive = { "Treadmill", "Trail", "Base" },
	Collector = { "Base", "Trail", "Treadmill" },
	Beginner = { "Treadmill", "Base", "Trail" },
	Explorer = { "Trail", "Treadmill", "Base" },
}

local function affordablePurchase(bot)
	local p = profile(bot)
	local opts = purchaseOptions(bot)
	if bot.personality == "Beginner" then
		table.sort(opts, function(a, b)
			return a.price < b.price
		end)
		for _, o in opts do
			if p.gold >= o.price then
				return o
			end
		end
		return nil
	end
	for _, kind in PRIORITY[bot.personality] or PRIORITY.Explorer do
		for _, o in opts do
			if o.kind == kind and p.gold >= o.price then
				return o
			end
		end
	end
	return nil
end

function Actions.PurchasingUpgrade(bot)
	local o = affordablePurchase(bot)
	if not o then
		return
	end
	setState(bot, o.kind == "Base" and "ExpandingBase" or "PurchasingUpgrade")
	local kiosk = Workspace.Map.ShopPlaza:FindFirstChild("Kiosk_" .. o.kiosk)
	if kiosk and kiosk.PrimaryPart then
		local goal = (kiosk.PrimaryPart.CFrame * CFrame.new(0, 2, -6)).Position
		S.BotNavigator.moveTo(bot.id, goal, { tolerance = 4, abort = function()
			return interrupted(bot)
		end })
		wait(bot, bot.rng:NextNumber(1.5, 3.5)) -- browsing the shop
	end
	if o.kind == "Treadmill" then
		S.Speed.buyNext(bot.id)
	elseif o.kind == "Trail" then
		S.Trails.buy(bot.id, o.id)
	elseif o.kind == "Base" then
		S.Bases.upgrade(bot.id)
		local goal = basePoint(bot, Vector3.new(0, 3, -10))
		if goal then
			S.BotNavigator.moveTo(bot.id, goal, { tolerance = 5 }) -- go admire the new base
		end
	end
end

local function raidTarget(bot)
	local best = nil
	for id in S.Actors.all() do
		if id ~= bot.id and not S.Theft.protectionReason(id) then
			local p = S.PlayerData.get(id)
			local basePos = S.Bases.anchorCFrame(id)
			local ownerPos = S.Actors.position(id)
			if p and basePos and (not ownerPos or (ownerPos - basePos.Position).Magnitude > 70) then
				for slot, record in p.eggs do
					if not record.ready and not S.Theft.isBeingStolen(id, slot) then
						-- prefer other simulated participants; humans only for the bolder personalities
						local weight = S.Actors.isBot(id) and 1 or bot.P.raid * 0.5
						if bot.rng:NextNumber() < weight then
							best = { owner = id, slot = slot }
						end
						break
					end
				end
			end
		end
		if best then
			break
		end
	end
	return best
end

function Actions.RaidingPlayerBase(bot)
	local target = raidTarget(bot)
	bot.lastRaid = os.clock()
	if not target then
		return
	end
	setState(bot, "RaidingPlayerBase")
	local cf = S.Bases.slotCFrame(target.owner, tonumber(target.slot) :: number)
	if not cf then
		return
	end
	if not S.BotNavigator.moveTo(bot.id, cf.Position + Vector3.new(0, 3, 0), { tolerance = 5, abort = function()
		return interrupted(bot) or S.Theft.protectionReason(target.owner) ~= nil
	end }) then
		return
	end
	wait(bot, 1.2) -- same hold time as the player's prompt
	if S.Theft.tryStealFromBase(bot.id, target.owner, target.slot) then
		Actions.ReturnToBase(bot)
	end
end

function Actions.DefendingBase(bot)
	local thief = bot.defendTarget
	bot.defendTarget = nil
	if not thief then
		return
	end
	setState(bot, "DefendingBase")
	local hum = S.Actors.humanoid(bot.id)
	local untilT = os.clock() + 20
	tryAbility(bot, { SpeedBurst = true, Dash = true, CatchReach = true })
	while os.clock() < untilT and hum and not bot.removed do
		local st = S.Actors.state(thief)
		if not st or not st.carry or st.carry.origin.owner ~= bot.id then
			break
		end
		local pos = S.Actors.position(thief)
		if not pos then
			break
		end
		hum:MoveTo(pos)
		task.wait(0.25)
	end
end

function Actions.PlaceTrap(bot)
	setState(bot, "Idle")
	local goal = basePoint(bot, Vector3.new(bot.rng:NextNumber(-12, 12), 3, -28))
	if goal and S.BotNavigator.moveTo(bot.id, goal, { tolerance = 3 }) then
		S.Traps.place(bot.id)
		bot.lastTrap = os.clock()
	end
end

function Actions.ManagePets(bot)
	local p = profile(bot)
	-- equip the best companion
	local best = S.Pets.best(bot.id)
	if best and p.equippedPet ~= best.uid and bot.rng:NextNumber() < bot.skill then
		S.Pets.equip(bot.id, best.uid)
	end
	-- make room when full and something is waiting
	local hasReady = false
	for _, e in p.eggs do
		if e.ready then
			hasReady = true
		end
	end
	if (#p.pets >= S.Pets.capacity(bot.id)) and (hasReady or S.Eggs.isCarrying(bot.id)) then
		local worst, wi = nil, math.huge
		for _, pet in p.pets do
			local inc = Formulas.petIncome(pet)
			if inc < wi and pet.uid ~= p.equippedPet then
				worst, wi = pet, inc
			end
		end
		if worst then
			S.Pets.sell(bot.id, worst.uid)
		end
	end
	tryAbility(bot, { HatchBoost = true, IncomeBoost = true })
end

function Actions.Idle(bot)
	setState(bot, "Idle")
	local p = profile(bot)
	local now = os.time()
	local soon = false
	for _, e in p.eggs do
		if e.hatchAt and e.hatchAt - now < 12 then
			soon = true
		end
	end
	if soon then
		setState(bot, "Hatching") -- go watch the egg hatch
		local goal = basePoint(bot, Vector3.new(bot.rng:NextNumber(-12, 12), 3, -10))
		if goal then
			S.BotNavigator.moveTo(bot.id, goal, { tolerance = 4 })
		end
		wait(bot, bot.rng:NextNumber(4, 10))
		return
	end
	local n = math.max(1, math.min(#p.pets, S.Pets.capacity(bot.id)))
	local cf = S.Bases.petCFrame(bot.id, bot.rng:NextInteger(1, n))
	if cf then
		S.BotNavigator.moveTo(bot.id, (cf * CFrame.new(0, 3, -4)).Position, { tolerance = 4, timeout = 15 })
	end
	wait(bot, bot.rng:NextNumber(2, 7) * bot.P.idle)
end

-- ===================== DECISION =====================
local function decide(bot): string
	local p = profile(bot)
	local st = S.Actors.state(bot.id)
	if st and st.carry then
		return "ReturnToBase"
	end
	if bot.defendTarget then
		return "DefendingBase"
	end
	local P = bot.P
	local rng = bot.rng
	local scores = {}
	local income = S.Economy.incomeOf(bot.id)
	local unlocked = Formulas.unlockedBiome(p.speed)

	if bot.specialTarget and S.Events.special and S.Biomes.canEnter(bot.id, S.Events.special.biome) then
		scores.SearchingRareEgg = P.special * 6
	end
	if not S.Monetization.has(bot.id, "AutoCollect") and p.vault >= math.max(40, income * 25) then
		scores.CollectingMoney = P.collect * 2.5
	end
	if affordablePurchase(bot) then
		scores.PurchasingUpgrade = P.upgrade * 4
	end
	local canHold = S.Eggs.freeSlot(bot.id) ~= nil
	if canHold then
		scores.StealEgg = P.steal * (#p.pets < 3 and 5 or 3)
	end
	local nextReq = Balance.biomes[unlocked + 1]
	local trainNeed = nextReq and 1.5 or 0.4
	if not affordablePurchase(bot) and nextReq then
		trainNeed += 1
	end
	scores.Training = P.train * trainNeed * (canHold and 0.8 or 1.6)
	if os.clock() - (bot.lastRaid or 0) > 90 then
		scores.RaidingPlayerBase = P.raid * 1.1
	end
	local incubating = next(p.eggs) ~= nil
	if incubating and S.Traps.activeCount(bot.id) < 2 and os.clock() - (bot.lastTrap or 0) > 120 then
		scores.PlaceTrap = (P.upgrade + P.collect) * 0.35
	end
	scores.ManagePets = (#p.pets >= S.Pets.capacity(bot.id)) and 3 or 0.4
	scores.Idle = P.idle * 0.7

	-- imperfect decisions: sometimes pick something random
	if rng:NextNumber() < (1 - bot.skill) * 0.3 then
		local keys = {}
		for k, v in scores do
			if v > 0 then
				table.insert(keys, k)
			end
		end
		return keys[rng:NextInteger(1, #keys)]
	end
	local best, bestScore = "Idle", -1
	for k, v in scores do
		local s = v * rng:NextNumber(0.6, 1.4)
		if s > bestScore then
			best, bestScore = k, s
		end
	end
	return best
end

local function loop(bot)
	while not bot.removed do
		if not S.Actors.alive(bot.id) then
			task.wait(1)
		else
			local st = S.Actors.state(bot.id)
			if bot.leaving and not (st and st.carry) then
				bot.readyToLeave = true
				setState(bot, "Idle")
				task.wait(1)
			else
				setState(bot, "Thinking")
				wait(bot, bot.rng:NextNumber(0.4, 1.6) * bot.P.idle)
				if bot.removed then
					break
				end
				local action = decide(bot)
				if bot.leaving then
					action = (st and st.carry) and "ReturnToBase" or "Idle"
				end
				local fn = Actions[action]
				if fn then
					local ok, err = pcall(fn, bot)
					if not ok then
						warn("[BotBrain]", bot.name, action, err)
						task.wait(1)
					end
				end
				if bot.rng:NextNumber() < 0.25 then
					pcall(Actions.ManagePets, bot)
				end
			end
		end
	end
end

-- ===================== PUBLIC =====================
function BotBrain.add(bot)
	bot.P = GameConfig.BotPersonalities[bot.personality]
	bot.skill = math.clamp(bot.P.skill + bot.rng:NextNumber(-0.12, 0.12), 0.3, 0.97)
	bots[bot.id] = bot
	task.spawn(loop, bot)
end

function BotBrain.remove(id: number)
	local bot = bots[id]
	if bot then
		bot.removed = true
		bots[id] = nil
	end
end

function BotBrain.get(id: number)
	return bots[id]
end

function BotBrain.all()
	return bots
end

function BotBrain.onBaseRaided(owner: number, thief: number)
	local bot = bots[owner]
	if not bot then
		return
	end
	local ownerPos = S.Actors.position(owner)
	local thiefPos = S.Actors.position(thief)
	-- reaction depends on distance and skill (they do not always notice)
	if ownerPos and thiefPos and (ownerPos - thiefPos).Magnitude < 160 and bot.rng:NextNumber() < 0.4 + bot.skill * 0.5 then
		bot.defendTarget = thief
	end
end

function BotBrain.onSpecialEgg(special)
	for _, bot in bots do
		if S.Biomes.canEnter(bot.id, special.biome) and bot.rng:NextNumber() < 0.35 * bot.P.special then
			bot.specialTarget = special
		end
	end
end

function BotBrain.start() end

return BotBrain
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000011"><Properties><string name="Name">BotNavigator</string><ProtectedString name="Source"><![CDATA[--[[
	BotNavigator — physical movement for simulated participants.

	Strategy (cheap and reliable):
	  1. long trips use the AVENUE LANE (kept obstacle-free by the world builder): step into the
	     avenue, walk along it in 60-stud segments, step out at the destination row
	  2. short/final legs try a direct MoveTo; if the bot gets stuck it jumps, then falls back to
	     PathfindingService (computed only when needed, with a small retry budget)
	Every call can be aborted by a predicate (e.g. "my base is being raided").
]]

local PathfindingService = game:GetService("PathfindingService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)

local BotNavigator = {}
local S
local LANE = GameConfig.World.AvenueWidth / 2 - 6

function BotNavigator.init(sys)
	S = sys
end

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

-- Walks straight to a point; returns true on arrival, false if stuck/aborted/timeout.
local function direct(id: number, goal: Vector3, opts): boolean
	local hum = S.Actors.humanoid(id)
	local root = S.Actors.root(id)
	if not hum or not root then
		return false
	end
	local tolerance = opts.tolerance or 3
	local deadline = os.clock() + (opts.timeout or 30)
	local lastPos = root.Position
	local lastProgress = os.clock()
	local jumps = 0
	while os.clock() < deadline do
		if opts.abort and opts.abort() then
			hum:MoveTo(root.Position)
			return false
		end
		root = S.Actors.root(id)
		if not root or hum.Health <= 0 then
			return false
		end
		if (flat(root.Position) - flat(goal)).Magnitude <= tolerance then
			return true
		end
		hum:MoveTo(goal)
		task.wait(0.25)
		if (root.Position - lastPos).Magnitude > 1 then
			lastPos = root.Position
			lastProgress = os.clock()
		elseif os.clock() - lastProgress > 1.2 and hum.WalkSpeed > 0 then
			jumps += 1
			hum.Jump = true
			lastProgress = os.clock()
			if jumps > 3 then
				return false
			end
		end
	end
	return false
end

local function pathTo(id: number, goal: Vector3, opts): boolean
	local root = S.Actors.root(id)
	if not root then
		return false
	end
	for _ = 1, 3 do
		local path = PathfindingService:CreatePath({ AgentRadius = 2.2, AgentHeight = 5.5, AgentCanJump = true, WaypointSpacing = 6 })
		local ok = pcall(path.ComputeAsync, path, root.Position, goal)
		if not ok or path.Status ~= Enum.PathStatus.Success then
			return false
		end
		local blocked = false
		local conn = path.Blocked:Connect(function()
			blocked = true
		end)
		local success = true
		for _, wp in path:GetWaypoints() do
			if blocked then
				success = false
				break
			end
			local hum = S.Actors.humanoid(id)
			if wp.Action == Enum.PathWaypointAction.Jump and hum then
				hum.Jump = true
			end
			if not direct(id, wp.Position, { tolerance = 2.5, timeout = 6, abort = opts.abort }) then
				success = false
				break
			end
		end
		conn:Disconnect()
		if success then
			return true
		end
		if opts.abort and opts.abort() then
			return false
		end
		root = S.Actors.root(id)
		if not root then
			return false
		end
	end
	return false
end

local function leg(id: number, goal: Vector3, opts): boolean
	if direct(id, goal, opts) then
		return true
	end
	if opts.abort and opts.abort() then
		return false
	end
	if pathTo(id, goal, opts) then
		return true
	end
	return direct(id, goal, { tolerance = (opts.tolerance or 3) + 2, timeout = 6, abort = opts.abort })
end

-- Public: travel anywhere on the map.
function BotNavigator.moveTo(id: number, goal: Vector3, opts): boolean
	opts = opts or {}
	local root = S.Actors.root(id)
	if not root then
		return false
	end
	local from = root.Position
	local dz = math.abs(goal.Z - from.Z)
	if dz > 60 or (math.abs(from.X) > 30 and math.abs(goal.X) > 30 and math.sign(from.X) ~= math.sign(goal.X)) then
		-- 1. into the avenue
		local laneX = math.clamp(from.X, -LANE, LANE)
		if math.abs(from.X) > LANE + 2 then
			if not leg(id, Vector3.new(laneX, from.Y, from.Z), { tolerance = 4, timeout = 15, abort = opts.abort }) then
				if opts.abort and opts.abort() then
					return false
				end
			end
		end
		-- 2. along the avenue
		local x = math.clamp(goal.X, -LANE, LANE) * 0.5 + (opts.laneOffset or 0)
		local z = (S.Actors.root(id) :: BasePart).Position.Z
		local stepDir = goal.Z > z and 1 or -1
		local fails = 0
		while math.abs(goal.Z - z) > 30 do
			z += stepDir * math.min(60, math.abs(goal.Z - z))
			if not direct(id, Vector3.new(x, 1, z), { tolerance = 5, timeout = 12, abort = opts.abort }) then
				if opts.abort and opts.abort() then
					return false
				end
				local r = S.Actors.root(id)
				fails += 1
				if not r or fails > 4 then
					return false
				end
				z = r.Position.Z
			end
		end
	end
	-- 3. final leg
	return leg(id, goal, opts)
end

return BotNavigator
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000012"><Properties><string name="Name">BotPopulation</string><ProtectedString name="Source"><![CDATA[--[[
	BotPopulation — keeps the world feeling alive.

	Target population = 6 participants; bots = min(5, max(0, 6 - realPlayers)):
	  1 real → 5 bots, 2 → 4, 3 → 3, 4 → 2, 5 → 1, 6 → 0, 7 → 0.

	• when a player joins: the target drops; a bot is asked to LEAVE gracefully (finishes carrying
	  its egg home, max 20s). If no base is free for the newcomer, a bot is removed immediately.
	• when a player leaves: new bots arrive gradually (8s apart) with a different personality and
	  a coherent starting progression (based on how far the real players are, never stronger).
	Simulated participants are NOT Players: they never appear in the Roblox player list/count.
]]

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local Balance = require(Shared.Config.Balance)
local Creatures = require(Shared.Config.Creatures)
local GameConfig = require(Shared.Config.GameConfig)
local Formulas = require(Shared.Util.Formulas)
local WeightedRandom = require(Shared.Util.WeightedRandom)

local BotPopulation = {}
local S

local bots = {} -- [id] = bot record
local nextId = -1
local nextSpawnAt = 0
local startedAt = os.clock()
local rng = Random.new()
local usedNames = {}
local PERSONALITIES = { "Beginner", "Collector", "Competitive", "Investor", "Explorer" }

function BotPopulation.init(sys)
	S = sys
end

function BotPopulation.count(includeLeaving: boolean?): number
	local n = 0
	for _, b in bots do
		if includeLeaving or not b.leaving then
			n += 1
		end
	end
	return n
end

function BotPopulation.list()
	return bots
end

local function pickName(): string
	for _ = 1, 30 do
		local base = GameConfig.BotNames[rng:NextInteger(1, #GameConfig.BotNames)]
		local name = rng:NextNumber() < 0.5 and base or (base .. rng:NextInteger(2, 99))
		if not usedNames[name] then
			usedNames[name] = true
			return name
		end
	end
	return "Player" .. rng:NextInteger(100, 999)
end

local function pickPersonality(): string
	local counts = {}
	for _, k in PERSONALITIES do
		counts[k] = 0
	end
	for _, b in bots do
		counts[b.personality] += 1
	end
	local options = {}
	local min = math.huge
	for _, k in PERSONALITIES do
		min = math.min(min, counts[k])
	end
	for _, k in PERSONALITIES do
		if counts[k] == min then
			table.insert(options, k)
		end
	end
	return options[rng:NextInteger(1, #options)]
end

-- Starting progression coherent with the humans in the server (never above the best human).
local function makeSeed()
	local maxUnlocked, sumUnlocked, n, playtime = 1, 0, 0, 0
	for _, player in Players:GetPlayers() do
		local p = S.PlayerData.get(player.UserId)
		if p then
			local u = Formulas.unlockedBiome(p.speed)
			maxUnlocked = math.max(maxUnlocked, u)
			sumUnlocked += u
			n += 1
			playtime += p.playtime
		end
	end
	local avg = n > 0 and sumUnlocked / n or 1
	local minutes = n > 0 and playtime / n / 60 or 0
	local biome = math.clamp(math.floor(avg + rng:NextNumber(-1, 0.3)), 1, maxUnlocked)
	local b = Balance.biomes[biome]
	local nextB = Balance.biomes[biome + 1]
	local speed = b.speedRequired + (nextB and (nextB.speedRequired - b.speedRequired) * rng:NextNumber(0, 0.5) or 0)
	if minutes < 3 then
		speed = rng:NextNumber(0, 90)
	end
	local baseLevel = math.clamp(math.ceil(biome * 0.6 + rng:NextNumber(-0.5, 0.5)), 1, 8)
	local trails = {}
	for i = 1, math.clamp(biome - 1 + rng:NextInteger(-1, 0), 0, #Balance.trails) do
		table.insert(trails, Balance.trails[i].id)
	end
	local petCount = minutes < 3 and rng:NextInteger(0, 2) or rng:NextInteger(2, math.min(Formulas.baseLevel(baseLevel).petSlots - 2, 3 + biome * 2))
	local pets = {}
	for _ = 1, petCount do
		local pb = rng:NextInteger(math.max(1, biome - 2), biome)
		local slot = WeightedRandom.index(Balance.speciesHatchWeights.normal, rng)
		local size = WeightedRandom.pick(Balance.sizes, function(s)
			return s.weight
		end, rng).name
		local mutation = WeightedRandom.pick(Balance.mutations, function(m)
			return m.weight
		end, rng).name
		table.insert(pets, { uid = S.PlayerData.newUid(), species = Creatures.ByBiome[pb][slot].id, size = size, mutation = mutation, at = os.time() })
	end
	return {
		speed = speed,
		treadmillTier = math.clamp(biome + rng:NextInteger(-1, 0), 1, #Balance.treadmills),
		trailsOwned = trails,
		equippedTrail = trails[#trails],
		baseLevel = baseLevel,
		pets = pets,
		gold = Balance.economy.startingGold,
		playtime = 99999,
	}, biome
end

local function placeCharacter(bot)
	local cf = S.Bases.spawnCFrame(bot.id) or CFrame.new(GameConfig.World.SpawnPosition)
	local model = S.BotAvatar.build(bot.id, bot.name, bot.seed)
	model:PivotTo(cf)
	model.Parent = Workspace.Runtime.Bots
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart?
	if root then
		pcall(function()
			root:SetNetworkOwner(nil)
		end)
	end
	local info = S.Actors.get(bot.id)
	if info then
		info.model = model
	end
	bot.model = model
	S.BotAvatar.setupAnimations(bot.id, model)
	S.Actors.CharacterAdded:Fire(bot.id, model)
end

function BotPopulation.spawn(): number?
	if S.Bases.freeCount() == 0 then
		return nil
	end
	local id = nextId
	nextId -= 1
	local name = pickName()
	local seed, biome = makeSeed()
	local profile = S.PlayerData.createBotProfile(id, seed)
	-- index for seeded pets
	for _, pet in profile.pets do
		local e = profile.index[pet.species] or { s = {}, m = {}, n = 0 }
		e.s[pet.size] = true
		e.m[pet.mutation] = true
		e.n += 1
		profile.index[pet.species] = e
	end
	local best = nil
	for _, pet in profile.pets do
		if not best or Formulas.petIncome(pet) > Formulas.petIncome(best) then
			best = pet
		end
	end
	profile.equippedPet = best and best.uid or nil
	S.Actors.register(id, { kind = "Bot", name = name })
	if not S.Bases.assign(id) then
		S.Actors.unregister(id)
		S.PlayerData.removeBotProfile(id)
		usedNames[name] = nil
		return nil
	end
	local bot = { id = id, name = name, personality = pickPersonality(), rng = Random.new(rng:NextInteger(1, 1e9)), seed = rng:NextInteger(1, 1e9) }
	bots[id] = bot
	placeCharacter(bot)
	-- a couple of eggs already incubating, like any player who has been around for a while
	for _ = 1, rng:NextInteger(0, 2) do
		local record = S.Eggs.makeRecord(math.max(1, biome - rng:NextInteger(0, 1)), "normal")
		S.Eggs.deposit(id, record, rng:NextInteger(10, Formulas.biome(record.biome).incubation))
	end
	S.BotBrain.add(bot)
	return id
end

function BotPopulation.despawn(id: number)
	local bot = bots[id]
	if not bot then
		return
	end
	bots[id] = nil
	usedNames[bot.name] = nil
	S.BotBrain.remove(id)
	S.BotAvatar.forget(id)
	S.Actors.unregister(id)
	S.PlayerData.removeBotProfile(id)
	if bot.model then
		bot.model:Destroy()
	end
end

-- Least disruptive bot to remove (not carrying, preferably idle/training).
local function chooseLeaver()
	local best, bestScore = nil, math.huge
	for id, b in bots do
		if not b.leaving then
			local st = S.Actors.state(id)
			local score = (st and st.carry) and 10 or 0
			if b.state == "Idle" or b.state == "Training" or b.state == "Thinking" then
				score -= 2
			end
			score += rng:NextNumber()
			if score < bestScore then
				best, bestScore = id, score
			end
		end
	end
	return best
end

local function reconcile()
	local real = #Players:GetPlayers()
	local target = Formulas.botCount(real)
	local now = os.clock()
	-- graceful leavers
	for id, b in bots do
		if b.leaving then
			local brain = S.BotBrain.get(id)
			if (brain and brain.readyToLeave) or now >= b.leaveDeadline then
				BotPopulation.despawn(id)
			end
		end
	end
	local active = BotPopulation.count(false)
	if active > target then
		for _ = 1, active - target do
			local id = chooseLeaver()
			if id then
				bots[id].leaving = true
				bots[id].leaveDeadline = now + Balance.bots.despawnGraceSeconds
				local brain = S.BotBrain.get(id)
				if brain then
					brain.leaving = true
				end
			end
		end
	elseif active < target and now >= nextSpawnAt and S.Bases.freeCount() > 0 then
		local warmup = now - startedAt < 45 -- first wave fills the world quickly
		nextSpawnAt = now + (warmup and 1.5 or Balance.bots.spawnDelaySeconds * rng:NextNumber(0.6, 1.4))
		BotPopulation.spawn()
	end
	-- respawn bots that fell out of the world
	for id, b in bots do
		local root = S.Actors.root(id)
		if (not root or root.Position.Y < -40 or not b.model or not b.model.Parent) and not b.respawning then
			b.respawning = true
			S.Eggs.dropCarry(id, "died")
			if b.model then
				b.model:Destroy()
			end
			S.BotAvatar.forget(id)
			task.delay(2, function()
				if bots[id] then
					placeCharacter(b)
					b.respawning = false
				end
			end)
		end
	end
end

function BotPopulation.start()
	Players.PlayerAdded:Connect(function()
		-- a real player always gets a base: free one immediately if needed
		if S.Bases.freeCount() == 0 then
			local id = nil
			for bid, b in bots do
				if b.leaving then
					id = bid
				end
			end
			id = id or chooseLeaver()
			if id then
				BotPopulation.despawn(id)
			end
		end
		task.defer(reconcile)
	end)
	Players.PlayerRemoving:Connect(function()
		nextSpawnAt = math.max(nextSpawnAt, os.clock() + Balance.bots.spawnDelaySeconds)
	end)
	-- first wave arrives quickly so the server never looks empty
	startedAt = os.clock()
	nextSpawnAt = os.clock() + 2
	task.spawn(function()
		while true do
			local ok, err = pcall(reconcile)
			if not ok then
				warn("[BotPopulation]", err)
			end
			task.wait(BotPopulation.count(true) < Formulas.botCount(#Players:GetPlayers()) and 1.5 or 2)
		end
	end)
end

return BotPopulation
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX00000028"><Properties><string name="Name">Systems</string></Properties><Item class="ModuleScript" referent="RBX00000014"><Properties><string name="Name">Abilities</string><ProtectedString name="Source"><![CDATA[--[[
	Abilities — the signature system of STEAL AN GOD. The equipped companion grants exactly one
	ability (each of the 52 creatures has its own name, numbers, VFX theme and description).

	Server-authoritative: cooldowns, effects and validations live here; clients only request
	"UseAbility" and render the Effect broadcast. Balance guards:
	  • no teleport to the end of the map, no remote stealing, no infinite money
	  • abilities never stun/disable other PLAYERS (only guardians are affected)
	  • a global ability lockout (1.5s) + per-ability cooldown + immunity windows
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local Creatures = require(Shared.Config.Creatures)
local Net = require(Shared.Util.Net)

local Abilities = {}
local S

function Abilities.init(sys)
	S = sys
end

-- Applies an impulse to an actor (client-owned for players → ask the client).
function Abilities.knockback(id: number, velocity: Vector3)
	local player = S.Actors.player(id)
	local st = S.Actors.state(id)
	if st then
		st.teleportGrace = os.clock() + 1.5
	end
	if player then
		Net.fire(player, "Knockback", velocity)
	else
		local root = S.Actors.root(id)
		if root then
			root.AssemblyLinearVelocity = velocity
		end
	end
end

function Abilities.definitionFor(id: number)
	local pet = S.Pets.equipped(id)
	if not pet then
		return nil, nil
	end
	local c = Creatures.ById[pet.species]
	return c and c.ab or nil, c
end

function Abilities.cooldownLeft(id: number): number
	local st = S.Actors.state(id)
	local ab = Abilities.definitionFor(id)
	if not st or not ab then
		return 0
	end
	local readyAt = st.cooldowns[ab.id] or 0
	return math.max(0, readyAt - os.clock())
end

local function broadcast(id: number, ab, creature, extra)
	local pos = S.Actors.position(id)
	local payload = { kind = "Ability", ability = ab.kind, name = ab.name, mythology = creature.mythology, color = creature.colors[3], position = pos, actor = id }
	if extra then
		for k, v in extra do
			payload[k] = v
		end
	end
	Net.fireAll("Effect", payload)
end

-- Returns ok, message
function Abilities.use(id: number): (boolean, string?)
	local st = S.Actors.state(id)
	local ab, creature = Abilities.definitionFor(id)
	if not st or not ab then
		return false, "Equipe um pet para usar habilidades"
	end
	if not S.Actors.alive(id) then
		return false, "Indisponível"
	end
	local now = os.clock()
	if (st.cooldowns[ab.id] or 0) > now then
		return false, string.format("Recarregando (%.0fs)", st.cooldowns[ab.id] - now)
	end
	if (st.cooldowns._global or 0) > now then
		return false, "Aguarde"
	end
	local p = ab.p
	local pos = S.Actors.position(id) :: Vector3
	local root = S.Actors.root(id)
	local kind = ab.kind
	local extra = nil

	if kind == "SpeedBurst" then
		S.Actors.addBuff(id, "SpeedBurst", p.duration, p.mult)
		if p.carryingOnly then
			S.Actors.addBuff(id, "SpeedBurstCarryOnly", p.duration, true)
		else
			S.Actors.clearBuff(id, "SpeedBurstCarryOnly")
		end
	elseif kind == "Dash" or kind == "Leap" then
		if S.Actors.isStuck(id) then
			return false, "Você está preso!"
		end
		local look = root and root.CFrame.LookVector or Vector3.new(0, 0, 1)
		look = Vector3.new(look.X, 0, look.Z).Unit
		local v = kind == "Dash" and (look * p.power + Vector3.new(0, 18, 0)) or (look * p.power * 0.45 + Vector3.new(0, p.power * 0.75, 0))
		Abilities.knockback(id, v)
	elseif kind == "Reveal" then
		extra = { filter = p.filter, radius = p.radius, duration = p.duration }
		local player = S.Actors.player(id)
		if player then
			Net.fire(player, "Reveal", { filter = p.filter, radius = p.radius, duration = p.duration, position = pos })
		end
		S.Actors.addBuff(id, "Reveal", p.duration, p)
	elseif kind == "Shockwave" then
		local n = S.Guardians.stunNear(pos, p.radius, p.stun)
		extra = { radius = p.radius, hits = n }
	elseif kind == "Frost" then
		local n = S.Guardians.slowNear(pos, p.radius, p.slow, p.duration)
		extra = { radius = p.radius, hits = n }
	elseif kind == "Decoy" then
		S.Guardians.addDecoy(pos, p.duration, id)
	elseif kind == "GuardShield" then
		S.Actors.addBuff(id, "GuardShield", p.duration, true)
	elseif kind == "EggShield" then
		S.Actors.addBuff(id, "EggShield", p.duration, true)
	elseif kind == "WeightRelief" then
		S.Actors.addBuff(id, "WeightRelief", p.duration, p.reduction)
	elseif kind == "TrapWard" then
		S.Actors.addBuff(id, "TrapWard", p.duration, true)
	elseif kind == "Rescue" then
		st.trappedUntil = 0
		st.stunUntil = 0
		S.Traps.releaseActor(id)
		if pos.Y < -15 then
			local cf = S.Bases.spawnCFrame(id)
			local char = S.Actors.character(id)
			if cf and char then
				st.teleportGrace = os.clock() + 2
				char:PivotTo(cf) -- back to your own base, never forward
			end
		end
		S.Actors.addBuff(id, "TrapWard", 3, true)
	elseif kind == "HatchBoost" then
		local n = S.Hatch.reduceAll(id, p.seconds)
		if n == 0 then
			return false, "Nenhum ovo incubando"
		end
		extra = { eggs = n }
	elseif kind == "IncomeBoost" then
		S.Actors.addBuff(id, "IncomeBoost", p.duration, p.mult)
	elseif kind == "TrainBoost" then
		S.Actors.addBuff(id, "TrainBoost", p.duration, p.mult)
	elseif kind == "CatchReach" then
		S.Actors.addBuff(id, "CatchReach", p.duration, p.radius)
	else
		return false, "Habilidade desconhecida"
	end

	st.cooldowns[ab.id] = now + ab.cd
	st.cooldowns._global = now + 1.5
	broadcast(id, ab, creature, extra)
	S.Tutorial.progress(id, "Ability")
	S.PlayerData.dirty(id)
	return true, ab.name
end

function Abilities.start()
	S.Net.on("UseAbility", function(player)
		local ok, msg = Abilities.use(player.UserId)
		Net.fire(player, "Effect", { kind = "AbilityResult", ok = ok, message = msg, cooldown = Abilities.cooldownLeft(player.UserId) })
	end)
end

return Abilities
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000015"><Properties><string name="Name">Actors</string><ProtectedString name="Source"><![CDATA[--[[
	Actors — one registry for everybody who plays: real Players (id = UserId) and simulated
	participants (bots, id = negative number). Every gameplay system works on actor ids, so bots
	go through the exact same rules, prices and validations as humans.

	Also holds per-actor RUNTIME state (never saved): carried egg, buffs, stuns, cooldowns.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Signal = require(ReplicatedStorage.Shared.Util.Signal)

local Actors = {}
Actors.Added = Signal.new()
Actors.Removed = Signal.new()
Actors.CharacterAdded = Signal.new() -- (id, character) for players AND bots

local registry = {} -- [id] = {id, kind, player?, name, model?}
local runtime = {} -- [id] = state table

function Actors.init(_S) end

function Actors.register(id: number, info)
	info.id = id
	registry[id] = info
	runtime[id] = {
		carry = nil,
		buffs = {}, -- [name] = {untilT = os.clock() + d, value = x}
		trappedUntil = 0,
		stunUntil = 0,
		trapImmuneUntil = 0,
		hitImmuneUntil = 0,
		cooldowns = {},
		lastTrainPing = 0,
		lastSafePosition = nil,
		currentBiome = 0,
	}
	Actors.Added:Fire(id, info)
end

function Actors.unregister(id: number)
	if registry[id] then
		local info = registry[id]
		Actors.Removed:Fire(id, info)
		registry[id] = nil
		runtime[id] = nil
	end
end

function Actors.get(id: number)
	return registry[id]
end

function Actors.exists(id: number): boolean
	return registry[id] ~= nil
end

function Actors.state(id: number)
	return runtime[id]
end

function Actors.all()
	return registry
end

function Actors.ids(): { number }
	local list = {}
	for id in registry do
		table.insert(list, id)
	end
	return list
end

function Actors.isBot(id: number): boolean
	local a = registry[id]
	return a ~= nil and a.kind == "Bot"
end

function Actors.player(id: number): Player?
	local a = registry[id]
	return a and a.player or nil
end

function Actors.name(id: number): string
	local a = registry[id]
	if not a then
		return "?"
	end
	if a.player then
		return a.player.DisplayName
	end
	return a.name
end

function Actors.character(id: number): Model?
	local a = registry[id]
	if not a then
		return nil
	end
	if a.player then
		return a.player.Character
	end
	return a.model
end

function Actors.root(id: number): BasePart?
	local c = Actors.character(id)
	return c and c:FindFirstChild("HumanoidRootPart") :: BasePart? or nil
end

function Actors.humanoid(id: number): Humanoid?
	local c = Actors.character(id)
	return c and c:FindFirstChildOfClass("Humanoid") or nil
end

function Actors.position(id: number): Vector3?
	local r = Actors.root(id)
	return r and r.Position or nil
end

function Actors.alive(id: number): boolean
	local h = Actors.humanoid(id)
	return h ~= nil and h.Health > 0 and Actors.root(id) ~= nil
end

function Actors.fromCharacter(model: Instance?): number?
	if not model then
		return nil
	end
	local player = Players:GetPlayerFromCharacter(model)
	if player then
		return registry[player.UserId] and player.UserId or nil
	end
	local botId = model:GetAttribute("ActorId")
	if typeof(botId) == "number" and registry[botId] then
		return botId
	end
	return nil
end

-- ---------- buffs ----------
function Actors.addBuff(id: number, name: string, duration: number, value: any)
	local st = runtime[id]
	if st then
		st.buffs[name] = { untilT = os.clock() + duration, value = value }
	end
end

function Actors.buff(id: number, name: string)
	local st = runtime[id]
	local b = st and st.buffs[name]
	if b and b.untilT > os.clock() then
		return b.value or true
	end
	return nil
end

function Actors.clearBuff(id: number, name: string)
	local st = runtime[id]
	if st then
		st.buffs[name] = nil
	end
end

function Actors.isStuck(id: number): boolean
	local st = runtime[id]
	if not st then
		return false
	end
	local now = os.clock()
	return st.trappedUntil > now or st.stunUntil > now
end

return Actors
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000016"><Properties><string name="Name">Bases</string><ProtectedString name="Source"><![CDATA[--[[
	Bases — 7 plots, automatic assignment (players and bots), level-based visuals, incubator
	pedestals, the gold collect pad, owner signs and the base-upgrade purchase.

	Each upgrade changes the plot visually: fence material, pillars, banners, torches, arches,
	statues and a divine aura at max level — plus more incubators and pet pads.
]]

local Workspace = game:GetService("Workspace")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Balance = require(Shared.Config.Balance)
local GameConfig = require(Shared.Config.GameConfig)
local Formulas = require(Shared.Util.Formulas)
local NumberFormatter = require(Shared.Util.NumberFormatter)
local ModelFactory = require(Shared.Factory.ModelFactory)
local Net = require(Shared.Util.Net)

local Bases = {}
local S

local C3 = Color3.fromRGB
local M = Enum.Material

local owners = {} -- [baseIndex] = actorId
local baseOf = {} -- [actorId] = baseIndex
local lastVaultText = {}

local LEVEL_STYLE = {
	{ fence = C3(140, 100, 60), mat = M.Wood, trim = C3(170, 130, 80) },
	{ fence = C3(150, 150, 155), mat = M.Cobblestone, trim = C3(190, 190, 195) },
	{ fence = C3(230, 225, 215), mat = M.Marble, trim = C3(200, 170, 110) },
	{ fence = C3(235, 230, 220), mat = M.Marble, trim = C3(255, 205, 70) },
	{ fence = C3(70, 80, 110), mat = M.Slate, trim = C3(120, 210, 255) },
	{ fence = C3(225, 195, 135), mat = M.Sandstone, trim = C3(255, 190, 60) },
	{ fence = C3(250, 245, 235), mat = M.Marble, trim = C3(255, 215, 90) },
	{ fence = C3(255, 215, 110), mat = M.Metal, trim = C3(255, 250, 220) },
}

function Bases.init(sys)
	S = sys
end

local function baseModel(index: number): Model?
	local folder = Workspace:FindFirstChild("Bases")
	return folder and folder:FindFirstChild("Base_" .. index) :: Model? or nil
end
Bases.model = baseModel

function Bases.baseIndexOf(id: number): number?
	return baseOf[id]
end

function Bases.ownerOf(index: number): number?
	return owners[index]
end

function Bases.modelOf(id: number): Model?
	local i = baseOf[id]
	return i and baseModel(i) or nil
end

function Bases.freeCount(): number
	local n = 0
	for i = 1, 7 do
		if not owners[i] then
			n += 1
		end
	end
	return n
end

function Bases.incubatorCount(id: number): number
	local p = S.PlayerData.get(id)
	if not p then
		return 0
	end
	return math.min(28, Formulas.incubatorCount(p.baseLevel, S.Monetization.has(id, "ExtraBase")))
end

function Bases.petSlotCount(id: number): number
	local p = S.PlayerData.get(id)
	return p and Formulas.baseLevel(p.baseLevel).petSlots or 0
end

-- World CFrame of incubator slot / pet pad / treadmill / collect pad
function Bases.slotCFrame(id: number, slot: number): CFrame?
	local m = Bases.modelOf(id)
	local mk = m and m.IncubatorSlots:FindFirstChild("Slot_" .. slot)
	return mk and mk.CFrame or nil
end

function Bases.petCFrame(id: number, n: number): CFrame?
	local m = Bases.modelOf(id)
	local mk = m and m.PetSlots:FindFirstChild("Pet_" .. n)
	return mk and mk.CFrame or nil
end

function Bases.anchorCFrame(id: number): CFrame?
	local m = Bases.modelOf(id)
	return m and m.PrimaryPart and m.PrimaryPart.CFrame or nil
end

function Bases.isInsideBase(index: number, position: Vector3, margin: number?): boolean
	local m = baseModel(index)
	local region = m and m:FindFirstChild("Region") :: BasePart?
	if not region then
		return false
	end
	local rel = region.CFrame:PointToObjectSpace(position)
	local half = region.Size / 2 + Vector3.new(margin or 0, 0, margin or 0)
	return math.abs(rel.X) <= half.X and math.abs(rel.Z) <= half.Z and rel.Y > -half.Y - 5 and rel.Y < half.Y + 10
end

-- Which base (index) a position is inside, if any.
function Bases.baseAt(position: Vector3): number?
	for i = 1, 7 do
		if Bases.isInsideBase(i, position) then
			return i
		end
	end
	return nil
end

function Bases.isInOwnBase(id: number): boolean
	local i = baseOf[id]
	local pos = S.Actors.position(id)
	return i ~= nil and pos ~= nil and Bases.isInsideBase(i, pos)
end

-- ===================== VISUALS =====================
local function clearVisuals(m: Model)
	m.Visuals:ClearAllChildren()
end

local function vpart(parent, size, cf, color, mat, collide)
	local p = Instance.new("Part")
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = mat
	p.CanCollide = collide == true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

function Bases.refreshVisuals(id: number)
	local index = baseOf[id]
	if not index then
		return
	end
	local m = baseModel(index)
	local p = S.PlayerData.get(id)
	if not m or not p then
		return
	end
	clearVisuals(m)
	local v = m.Visuals
	local cf = m.PrimaryPart.CFrame
	local level = p.baseLevel
	local style = LEVEL_STYLE[level] or LEVEL_STYLE[1]
	local size = GameConfig.World.BaseSize
	local halfX, halfZ = size.X / 2, size.Z / 2
	m.Floor.Color = style.fence:Lerp(C3(210, 200, 180), 0.6)
	m.Floor.Material = level >= 3 and M.Marble or M.Slate

	-- fences (leave the entrance open at local -Z)
	local fenceH = 2 + level * 0.4
	vpart(v, Vector3.new(size.X, fenceH, 1), cf * CFrame.new(0, fenceH / 2 + 1, halfZ), style.fence, style.mat, true)
	vpart(v, Vector3.new(1, fenceH, size.Z), cf * CFrame.new(-halfX, fenceH / 2 + 1, 0), style.fence, style.mat, true)
	vpart(v, Vector3.new(1, fenceH, size.Z), cf * CFrame.new(halfX, fenceH / 2 + 1, 0), style.fence, style.mat, true)
	vpart(v, Vector3.new(size.X / 2 - 8, fenceH, 1), cf * CFrame.new(-halfX + (size.X / 2 - 8) / 2, fenceH / 2 + 1, -halfZ), style.fence, style.mat, true)
	vpart(v, Vector3.new(size.X / 2 - 8, fenceH, 1), cf * CFrame.new(halfX - (size.X / 2 - 8) / 2, fenceH / 2 + 1, -halfZ), style.fence, style.mat, true)
	-- trim
	vpart(v, Vector3.new(size.X + 1, 0.4, 1.4), cf * CFrame.new(0, fenceH + 1.2, halfZ), style.trim, M.Metal)

	-- pillars at the corners (level 2+)
	if level >= 2 then
		for _, c in { Vector3.new(-halfX, 0, -halfZ), Vector3.new(halfX, 0, -halfZ), Vector3.new(-halfX, 0, halfZ), Vector3.new(halfX, 0, halfZ) } do
			local h = 6 + level
			vpart(v, Vector3.new(2.4, h, 2.4), cf * CFrame.new(c.X, h / 2 + 1, c.Z), style.fence, style.mat, true)
			vpart(v, Vector3.new(3, 0.6, 3), cf * CFrame.new(c.X, h + 1.3, c.Z), style.trim, M.Metal)
		end
	end
	-- banners (level 3+)
	if level >= 3 then
		for _, x in { -halfX + 0.8, halfX - 0.8 } do
			local banner = vpart(v, Vector3.new(0.2, 6, 3.5), cf * CFrame.new(x, 7, -10), style.trim, M.Fabric)
			banner.Transparency = 0.05
		end
	end
	-- entrance arch (level 4+)
	if level >= 4 then
		for side = -1, 1, 2 do
			vpart(v, Vector3.new(2, 14, 2), cf * CFrame.new(side * 8, 8, -halfZ), style.fence, style.mat, true)
		end
		vpart(v, Vector3.new(18, 2, 2.4), cf * CFrame.new(0, 15.5, -halfZ), style.trim, M.Metal)
	end
	-- torches (level 5+)
	if level >= 5 then
		for _, c in { Vector3.new(-halfX + 2, 0, -halfZ + 2), Vector3.new(halfX - 2, 0, -halfZ + 2), Vector3.new(-halfX + 2, 0, halfZ - 2), Vector3.new(halfX - 2, 0, halfZ - 2) } do
			local f = vpart(v, Vector3.new(1.2, 1.2, 1.2), cf * CFrame.new(c.X, 9 + level, c.Z), style.trim, M.Neon)
			f.Shape = Enum.PartType.Ball
			ModelFactory.addLight(f, style.trim, 18, 1.4)
		end
	end
	-- god statue (level 6+)
	if level >= 6 then
		local statue = ModelFactory.creature(level >= 8 and "Zeus" or (level == 7 and "Odin" or "Ra"), "Titan", "Golden")
		statue:PivotTo(cf * CFrame.new(0, 1, halfZ - 4) * CFrame.Angles(0, 0, 0))
		statue.Parent = v
	end
	-- divine aura (level 8)
	if level >= 8 then
		local aura = vpart(v, Vector3.new(size.X, 0.3, size.Z), cf * CFrame.new(0, 1.1, 0), style.trim, M.Neon)
		aura.Transparency = 0.85
		ModelFactory.addParticles(aura, style.trim, 6, { speed = 1, size = 0.4, life = 2 })
	end
	-- VIP decoration
	if S.Monetization.has(id, "VIP") then
		local crown = vpart(v, Vector3.new(3, 3, 3), cf * CFrame.new(0, 20, -halfZ), C3(255, 210, 60), M.Neon)
		crown.Shape = Enum.PartType.Ball
		ModelFactory.addLight(crown, C3(255, 210, 60), 20, 2)
		local vipSign = vpart(v, Vector3.new(10, 3, 0.5), cf * CFrame.new(0, 17, -halfZ - 0.5), C3(40, 30, 10), M.SmoothPlastic)
		S.WorldBuilder.sign(vipSign, Enum.NormalId.Back, "VIP", C3(255, 215, 80))
	end

	-- treadmill
	local tm = ModelFactory.treadmill(p.treadmillTier)
	tm.Name = "Treadmill"
	tm:PivotTo(m.TreadmillSpot.CFrame * CFrame.new(0, -0.5, 0))
	tm:SetAttribute("Owner", id)
	tm:SetAttribute("Tier", p.treadmillTier)
	local belt = tm:FindFirstChild("Belt") :: BasePart
	belt.AssemblyLinearVelocity = tm.PrimaryPart.CFrame.LookVector * -14 -- conveyor pushes runners backward
	local screen = tm:FindFirstChild("Screen") :: BasePart
	if screen then
		S.WorldBuilder.sign(screen, Enum.NormalId.Back, Formulas.treadmill(p.treadmillTier).name, C3(255, 255, 255))
	end
	tm.Parent = v

	-- incubator pedestals
	local count = Bases.incubatorCount(id)
	for slot = 1, count do
		local mk = m.IncubatorSlots:FindFirstChild("Slot_" .. slot)
		if mk then
			local ped = vpart(v, Vector3.new(4.2, 1, 4.2), mk.CFrame * CFrame.new(0, -0.3, 0), style.trim, M.Marble, true)
			ped.Shape = Enum.PartType.Cylinder
			ped.CFrame = mk.CFrame * CFrame.new(0, -0.3, 0) * CFrame.Angles(0, 0, math.rad(90))
			ped.Size = Vector3.new(1, 4.4, 4.4)
			ped.Name = "Pedestal_" .. slot
			local ring = vpart(v, Vector3.new(0.2, 3.6, 3.6), mk.CFrame * CFrame.new(0, 0.25, 0) * CFrame.Angles(0, 0, math.rad(90)), C3(255, 230, 150), M.Neon)
			ring.Shape = Enum.PartType.Cylinder
			ring.Transparency = 0.5
		end
	end
	-- pet pads
	for n = 1, Bases.petSlotCount(id) do
		local mk = m.PetSlots:FindFirstChild("Pet_" .. n)
		if mk then
			local pad = vpart(v, Vector3.new(0.4, 4, 4), mk.CFrame * CFrame.new(0, -0.35, 0) * CFrame.Angles(0, 0, math.rad(90)), style.fence:Lerp(C3(255, 255, 255), 0.3), M.Marble)
			pad.Shape = Enum.PartType.Cylinder
		end
	end
	m:SetAttribute("Level", level)
	m:SetAttribute("Protected", S.Theft.protectionReason(id) ~= nil)
	Bases.updateSign(id)
end

function Bases.updateSign(id: number)
	local index = baseOf[id]
	local m = index and baseModel(index)
	if not m then
		return
	end
	local p = S.PlayerData.get(id)
	local text = S.Actors.name(id) .. "\nNível " .. (p and p.baseLevel or 1)
	if p and p.title then
		text = S.Actors.name(id) .. "\n" .. p.title
	end
	m.OwnerSign:FindFirstChild("OwnerLabel", true).Text = text
	m.OwnerSign:FindFirstChild("OwnerLabelBack", true).Text = text
end

function Bases.updateVaultLabel(id: number)
	local index = baseOf[id]
	local m = index and baseModel(index)
	local p = S.PlayerData.get(id)
	if not m or not p then
		return
	end
	local text = S.Monetization.has(id, "AutoCollect") and "AUTO COLLECT\n✓" or ("COLETAR\n" .. NumberFormatter.format(p.vault))
	if lastVaultText[id] ~= text then
		lastVaultText[id] = text
		local label = m.VaultBoard:FindFirstChild("VaultLabel", true)
		if label then
			label.Text = text
		end
	end
end

local function resetBase(index: number)
	local m = baseModel(index)
	if not m then
		return
	end
	clearVisuals(m)
	m.Incubating:ClearAllChildren()
	m.PetDisplays:ClearAllChildren()
	m.OwnerSign:FindFirstChild("OwnerLabel", true).Text = "BASE LIVRE"
	m.OwnerSign:FindFirstChild("OwnerLabelBack", true).Text = "BASE LIVRE"
	m:SetAttribute("Owner", nil)
	m:SetAttribute("OwnerName", nil)
	m:SetAttribute("Protected", false)
	local label = m.VaultBoard:FindFirstChild("VaultLabel", true)
	if label then
		label.Text = "COLETAR\n0"
	end
end

function Bases.assign(id: number): number?
	if baseOf[id] then
		return baseOf[id]
	end
	-- players prefer the left side close to spawn; bots fill from the far end
	local order = S.Actors.isBot(id) and { 7, 4, 6, 3, 5, 2, 1 } or { 1, 5, 2, 6, 3, 7, 4 }
	for _, i in order do
		if not owners[i] then
			owners[i] = id
			baseOf[id] = i
			local m = baseModel(i)
			if m then
				m:SetAttribute("Owner", id)
				m:SetAttribute("OwnerName", S.Actors.name(id))
			end
			Bases.refreshVisuals(id)
			S.Eggs.renderBaseEggs(id)
			S.Pets.renderBase(id)
			S.PlayerData.dirty(id)
			return i
		end
	end
	return nil
end

function Bases.release(id: number)
	local i = baseOf[id]
	if i then
		owners[i] = nil
		baseOf[id] = nil
		lastVaultText[id] = nil
		resetBase(i)
	end
end

function Bases.spawnCFrame(id: number): CFrame?
	local cf = Bases.anchorCFrame(id)
	return cf and cf * CFrame.new(0, 4, -20) or nil
end

-- ===================== UPGRADE =====================
function Bases.upgrade(id: number): (boolean, string?)
	local p = S.PlayerData.get(id)
	if not p then
		return false, "Sem dados"
	end
	local nextLevel = p.baseLevel + 1
	local def = Balance.baseLevels[nextLevel]
	if not def then
		return false, "Sua base já está no nível máximo!"
	end
	if not S.Economy.spend(id, def.price) then
		return false, "GOLD insuficiente"
	end
	p.baseLevel = nextLevel
	Bases.refreshVisuals(id)
	S.Eggs.renderBaseEggs(id)
	S.Pets.renderBase(id)
	S.PlayerData.dirty(id)
	local m = Bases.modelOf(id)
	if m then
		Net.fireAll("Effect", { kind = "BaseUpgrade", position = m.PrimaryPart.Position, level = nextLevel })
	end
	S.Tutorial.progress(id, "UpgradeBase")
	return true, "Base melhorada para o nível " .. nextLevel .. "!"
end

function Bases.start()
	S.PlayerData.Loaded:Connect(function(id)
		Bases.assign(id)
	end)
	S.Actors.Removed:Connect(function(id)
		Bases.release(id)
	end)
	S.Net.handle("UpgradeBase", function(player)
		return Bases.upgrade(player.UserId)
	end)

	-- Players respawn at their base; collect-pad detection
	S.Actors.CharacterAdded:Connect(function(id, char)
		local cf = Bases.spawnCFrame(id)
		if cf and not S.Actors.isBot(id) then
			task.defer(function()
				local root = char:FindFirstChild("HumanoidRootPart") :: BasePart?
				if root then
					local st = S.Actors.state(id)
					if st then
						st.teleportGrace = os.clock() + 2
					end
					char:PivotTo(cf)
				end
			end)
		end
	end)

	task.spawn(function()
		while true do
			task.wait(0.3)
			for id, index in baseOf do
				local m = baseModel(index)
				local pos = S.Actors.position(id)
				if m and pos then
					local pad = m:FindFirstChild("CollectPad") :: BasePart
					local rel = pad.CFrame:PointToObjectSpace(pos)
					if math.abs(rel.X) < 4.5 and math.abs(rel.Z) < 4.5 and rel.Y < 8 then
						S.Economy.collectVault(id)
					end
				end
			end
		end
	end)
end

-- tween helper for clients is not needed server-side
Bases._tween = TweenService

return Bases
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000017"><Properties><string name="Name">Biomes</string><ProtectedString name="Source"><![CDATA[--[[
	Biomes — authoritative region access. Clients make locked gates solid locally; the server
	verifies every 0.3s that nobody (player or bot) is inside a biome above their Speed and pushes
	intruders back to the gate. Also tracks the current biome of each actor.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local Formulas = require(Shared.Util.Formulas)
local NumberFormatter = require(Shared.Util.NumberFormatter)
local Net = require(Shared.Util.Net)

local Biomes = {}
local S

function Biomes.init(sys)
	S = sys
end

function Biomes.biomeOf(id: number): number
	local pos = S.Actors.position(id)
	return pos and S.WorldBuilder.biomeAt(pos.Z) or 0
end

function Biomes.unlocked(id: number): number
	local p = S.PlayerData.get(id)
	return p and Formulas.unlockedBiome(p.speed) or 1
end

function Biomes.canEnter(id: number, biomeId: number): boolean
	return biomeId <= Biomes.unlocked(id)
end

function Biomes.start()
	task.spawn(function()
		while true do
			task.wait(0.3)
			for id in S.Actors.all() do
				local root = S.Actors.root(id)
				local st = S.Actors.state(id)
				if root and st then
					local b = S.WorldBuilder.biomeAt(root.Position.Z)
					if b > 0 and not Biomes.canEnter(id, b) then
						local z0 = S.WorldBuilder.biomeZ(b)
						st.teleportGrace = os.clock() + 2
						local char = S.Actors.character(id)
						if char then
							char:PivotTo(CFrame.new(root.Position.X * 0.3, root.Position.Y + 1, z0 - 8))
						end
						local player = S.Actors.player(id)
						if player then
							Net.fire(player, "Notify", { kind = "Warning", title = "Região bloqueada", text = "Requer " .. NumberFormatter.format(Formulas.biome(b).speedRequired) .. " Speed. Treine na esteira!" })
						end
					elseif b ~= st.currentBiome then
						st.currentBiome = b
					end
					if root.Position.Y > -10 then
						st.lastSafePosition = root.Position
					end
				end
			end
		end
	end)
end

return Biomes
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000018"><Properties><string name="Name">Collection</string><ProtectedString name="Source"><![CDATA[--[[
	Collection — Index (discovery of species / sizes / mutations), collection rewards
	(milestones, per-biome sets, per-mythology sets) and achievements (+ optional Roblox badges).
	Rewards are persistent and can only be claimed once (claimed ids saved in the profile).
]]

local BadgeService = game:GetService("BadgeService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local Creatures = require(Shared.Config.Creatures)
local GameConfig = require(Shared.Config.GameConfig)
local Formulas = require(Shared.Util.Formulas)
local NumberFormatter = require(Shared.Util.NumberFormatter)
local Net = require(Shared.Util.Net)

local Collection = {}
local S
local TOTAL = #Creatures.List

function Collection.init(sys)
	S = sys
end

local function notify(id: number, kind: string, title: string, text: string)
	local player = S.Actors.player(id)
	if player then
		Net.fire(player, "Notify", { kind = kind, title = title, text = text })
	end
end

function Collection.discoveredCount(profile): number
	local n = 0
	for species in profile.index do
		if Creatures.ById[species] then
			n += 1
		end
	end
	return n
end

local function mythologyComplete(profile, mythology: string): boolean
	for _, c in Creatures.List do
		if c.mythology == mythology and not profile.index[c.id] then
			return false
		end
	end
	return true
end

local function biomeComplete(profile, biome: number): boolean
	for slot = 1, 4 do
		if not profile.index[Creatures.ByBiome[biome][slot].id] then
			return false
		end
	end
	return true
end

-- Returns true if this species was never seen before.
function Collection.discover(id: number, pet): boolean
	local p = S.PlayerData.get(id)
	if not p then
		return false
	end
	local entry = p.index[pet.species]
	local isNew = entry == nil
	if not entry then
		entry = { s = {}, m = {}, n = 0 }
		p.index[pet.species] = entry
	end
	entry.n += 1
	entry.s[pet.size] = true
	entry.m[pet.mutation] = true
	p.stats.discovered = Collection.discoveredCount(p)
	p.stats.greekComplete = mythologyComplete(p, "Greek") and 1 or 0
	p.stats.norseComplete = mythologyComplete(p, "Norse") and 1 or 0
	p.stats.egyptianComplete = mythologyComplete(p, "Egyptian") and 1 or 0
	if isNew then
		local c = Creatures.ById[pet.species]
		notify(id, "Discovery", "NOVA CRIATURA DESCOBERTA!", (c and c.name or pet.species) .. " foi adicionada ao Index")
		S.Tutorial.progress(id, "Discover")
	end
	Collection.checkAchievements(id)
	S.PlayerData.dirty(id)
	return isNew
end

-- ===================== REWARDS =====================
function Collection.rewardList()
	local list = {}
	for _, m in GameConfig.IndexMilestones do
		table.insert(list, m)
	end
	for b = 1, 12 do
		table.insert(list, { id = "Biome_" .. b, biome = b, label = "Coleção completa: " .. Formulas.biome(b).name,
			reward = { type = "Gold", seconds = GameConfig.BiomeCompleteReward.seconds, minimum = GameConfig.BiomeCompleteReward.minimumPerBiome * (5 ^ (b - 1)), keys = (b % 4 == 0) and 1 or 0 } })
	end
	return list
end

local rewardById = {}
for _, r in Collection.rewardList() do
	rewardById[r.id] = r
end

function Collection.isReached(profile, r): boolean
	local count = Collection.discoveredCount(profile)
	if r.biome then
		return biomeComplete(profile, r.biome)
	elseif r.mythology then
		return mythologyComplete(profile, r.mythology)
	elseif r.count then
		return count >= r.count
	end
	return count / TOTAL * 100 >= r.percent
end

local function grant(id: number, reward): string
	local p = S.PlayerData.get(id)
	local parts = {}
	if reward.type == "Gold" then
		local amount = S.Economy.incomeSeconds(id, reward.seconds, reward.minimum)
		S.Economy.addGold(id, amount, "IndexReward")
		table.insert(parts, "+" .. NumberFormatter.format(amount) .. " GOLD")
	elseif reward.type == "Trail" then
		S.Trails.grant(id, reward.trail)
		table.insert(parts, "Trail " .. reward.trail)
	elseif reward.type == "SpecialEgg" then
		local ok = S.Eggs.grantEggToBase(id, S.Eggs.makeRecord(Formulas.unlockedBiome(p.speed), "special"))
		if ok then
			table.insert(parts, "Ovo Divino na sua base")
		else
			local amount = S.Economy.incomeSeconds(id, 1800, 10000)
			S.Economy.addGold(id, amount, "IndexRewardFallback")
			table.insert(parts, "+" .. NumberFormatter.format(amount) .. " GOLD (base cheia)")
		end
	end
	if reward.keys and reward.keys > 0 then
		p.keys += reward.keys
		table.insert(parts, "+" .. reward.keys .. " chave(s)")
	end
	if reward.title then
		p.title = reward.title
		S.Bases.updateSign(id)
		table.insert(parts, "Título: " .. reward.title)
	end
	return table.concat(parts, " • ")
end

function Collection.claim(id: number, rewardId: any): (boolean, string?)
	local p = S.PlayerData.get(id)
	local r = typeof(rewardId) == "string" and rewardById[rewardId]
	if not p or not r then
		return false, "Recompensa inválida"
	end
	if p.claimed[rewardId] then
		return false, "Já coletada"
	end
	if not Collection.isReached(p, r) then
		return false, "Ainda não alcançada"
	end
	p.claimed[rewardId] = true -- mark first: no double claims even if grant yields
	local text = grant(id, r.reward)
	S.PlayerData.dirty(id)
	return true, text
end

-- ===================== ACHIEVEMENTS =====================
local function statValue(p, stat: string): number
	if stat == "totalEarned" then
		return p.totalEarned
	end
	return p.stats[stat] or 0
end

function Collection.checkAchievements(id: number)
	local p = S.PlayerData.get(id)
	if not p then
		return
	end
	for _, a in GameConfig.Achievements do
		if not p.achievements[a.id] and statValue(p, a.stat) >= a.goal then
			p.achievements[a.id] = os.time()
			notify(id, "Achievement", "CONQUISTA: " .. a.name, a.desc)
			local player = S.Actors.player(id)
			if player and a.badgeId and a.badgeId > 0 then
				task.spawn(function()
					pcall(BadgeService.AwardBadge, BadgeService, player.UserId, a.badgeId)
				end)
			end
			S.PlayerData.dirty(id)
		end
	end
end

function Collection.start()
	S.Net.handle("ClaimIndexReward", function(player, payload)
		return Collection.claim(player.UserId, payload.id)
	end)
end

return Collection
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000019"><Properties><string name="Name">Economy</string><ProtectedString name="Source"><![CDATA[--[[
	Economy — GOLD income, vault collection, spending and offline earnings.

	Income/s = Σ petIncome(pet) × globalMultiplier (VIP, 2x Money pass, Money boost, Ra-type ability),
	computed centrally once per second for every actor (players and bots). Income accumulates in the
	base vault; the owner collects it by stepping on the gold pad (Auto Collect pass skips that).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Formulas = require(ReplicatedStorage.Shared.Util.Formulas)
local Net = require(ReplicatedStorage.Shared.Util.Net)

local Economy = {}
local S
local incomeCache = {} -- [id] = number

function Economy.init(sys)
	S = sys
end

local function boostActive(profile, name: string): boolean
	local t = profile.boosts and profile.boosts[name]
	return t ~= nil and t > os.time()
end
Economy.boostActive = boostActive

function Economy.modifiers(id: number, includeTemporary: boolean?)
	local p = S.PlayerData.get(id)
	local temp = includeTemporary ~= false
	return {
		vip = S.Monetization.has(id, "VIP"),
		moneyPass = S.Monetization.has(id, "DoubleMoney"),
		moneyBoost = temp and p ~= nil and boostActive(p, "money"),
		abilityMult = temp and S.Actors.buff(id, "IncomeBoost") or nil,
	}
end

function Economy.computeIncome(id: number, includeTemporary: boolean?): number
	local p = S.PlayerData.get(id)
	if not p then
		return 0
	end
	return Formulas.totalIncome(p.pets, Economy.modifiers(id, includeTemporary))
end

function Economy.incomeOf(id: number): number
	return incomeCache[id] or Economy.computeIncome(id)
end

function Economy.addGold(id: number, amount: number, _reason: string?)
	local p = S.PlayerData.get(id)
	if not p or amount ~= amount or amount <= 0 or amount == math.huge then
		return
	end
	p.gold += amount
	p.totalEarned += amount
	S.PlayerData.dirtyLight(id)
	S.Collection.checkAchievements(id)
end

function Economy.canAfford(id: number, price: number): boolean
	local p = S.PlayerData.get(id)
	return p ~= nil and p.gold >= price
end

function Economy.spend(id: number, price: number): boolean
	local p = S.PlayerData.get(id)
	if not p or price ~= price or price < 0 or p.gold < price then
		return false
	end
	p.gold -= price
	S.PlayerData.dirtyLight(id)
	return true
end

function Economy.collectVault(id: number): number
	local p = S.PlayerData.get(id)
	if not p or p.vault < 1 then
		return 0
	end
	local amount = math.floor(p.vault)
	p.vault -= amount
	p.gold += amount
	S.PlayerData.dirtyLight(id)
	local player = S.Actors.player(id)
	if player then
		Net.fire(player, "Effect", { kind = "Collect", amount = amount })
	end
	S.Tutorial.progress(id, "Collect")
	return amount
end

-- Called once when a profile loads; returns the gold granted.
function Economy.applyOffline(id: number, secondsAway: number): number
	if secondsAway < 60 then
		return 0
	end
	local income = Economy.computeIncome(id, false)
	local amount = Formulas.offlineEarnings(income, secondsAway)
	if amount > 0 then
		local p = S.PlayerData.get(id)
		p.gold += amount
		p.totalEarned += amount
	end
	return amount
end

-- Seconds-of-income helper used by products and rewards.
function Economy.incomeSeconds(id: number, seconds: number, minimum: number): number
	return math.max(minimum, math.floor(Economy.computeIncome(id, false) * seconds))
end

function Economy.start()
	S.Actors.Removed:Connect(function(id)
		incomeCache[id] = nil
	end)
	task.spawn(function()
		while true do
			local dt = task.wait(1)
			for id in S.Actors.all() do
				local p = S.PlayerData.get(id)
				if p then
					local income = Economy.computeIncome(id)
					incomeCache[id] = income
					local gained = income * dt
					if gained > 0 then
						if S.Monetization.has(id, "AutoCollect") then
							p.gold += gained
						else
							p.vault += gained
						end
						p.totalEarned += gained
					end
					S.PlayerData.dirtyLight(id)
					S.Bases.updateVaultLabel(id)
				end
			end
		end
	end)
	task.spawn(function()
		while true do
			task.wait(5)
			for id in S.Actors.all() do
				S.Collection.checkAchievements(id)
			end
		end
	end)
end

return Economy
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001A"><Properties><string name="Name">Eggs</string><ProtectedString name="Source"><![CDATA[--[[
	Eggs — the heart of STEAL AN GOD.

	World eggs live in nests (respawning per biome cycle), on the ground (dropped, 20s to recover),
	or are special/event eggs. Grabbing one attaches it to the character's back; carrying slows you
	down by the egg size. Entering your own base with an egg deposits it automatically into a free
	incubator. Incubating eggs are rendered on pedestals with a live countdown (client-driven).

	Base raids (stealing incubating eggs from other bases) are validated by Systems/Theft.
]]

local Workspace = game:GetService("Workspace")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Balance = require(Shared.Config.Balance)
local Creatures = require(Shared.Config.Creatures)
local GameConfig = require(Shared.Config.GameConfig)
local Formulas = require(Shared.Util.Formulas)
local WeightedRandom = require(Shared.Util.WeightedRandom)
local ModelFactory = require(Shared.Factory.ModelFactory)
local Net = require(Shared.Util.Net)

local Eggs = {}
local S

local worldEggs = {} -- [eggId] = {id, record, model, kind, nest, expiresAt}
local nests = {} -- array {id, biome, cframe, egg = eggId?, respawnAt}
local nextEggId = 0
local fullWarned = {}

local RARITY_LABEL = { "Comum", "Incomum", "Raro", "Épico", "Lendário", "Mítico", "Secreto", "Eterno", "Divino" }

function Eggs.init(sys)
	S = sys
end

-- ===================== RECORDS =====================
local function rollSize(minIndex: number?)
	local pool = {}
	for _, s in Balance.sizes do
		if s.index >= (minIndex or 1) then
			table.insert(pool, s)
		end
	end
	return WeightedRandom.pick(pool, function(s)
		return s.weight
	end).name
end

local function rollMutation(forceMutation: boolean?)
	local pool = {}
	for _, m in Balance.mutations do
		if not forceMutation or m.name ~= "None" then
			table.insert(pool, m)
		end
	end
	return WeightedRandom.pick(pool, function(m)
		return m.weight
	end).name
end
Eggs.rollMutation = rollMutation

-- variant: "normal" | "rare" | "special" | "event"
function Eggs.makeRecord(biome: number, variant: string?, opts)
	opts = opts or {}
	variant = variant or "normal"
	local special = variant == "special"
	return {
		uid = S.PlayerData.newUid(),
		biome = math.clamp(biome, 1, #Balance.biomes),
		variant = variant,
		size = rollSize(special and 3 or 1),
		mutation = rollMutation(special),
		event = opts.event,
		tier = opts.tier,
	}
end

function Eggs.displayName(record): string
	local size = Formulas.size(record.size).eggName
	if record.variant == "event" and record.event then
		for _, e in GameConfig.Events do
			if e.id == record.event then
				return "Ovo " .. e.name .. " (" .. size .. ")"
			end
		end
	end
	local b = Formulas.biome(record.biome)
	local prefix = (record.variant == "special" and "Ovo Divino") or (record.variant == "rare" and "Ovo Dourado") or "Ovo"
	return prefix .. " — " .. b.name .. " (" .. size .. ")"
end

function Eggs.rarityLabel(record): string
	if record.variant == "special" then
		return "Divino"
	elseif record.variant == "event" then
		return "Evento"
	elseif record.variant == "rare" then
		return RARITY_LABEL[math.clamp(math.floor((record.biome - 1) * 0.75) + 3, 1, 9)]
	end
	return RARITY_LABEL[math.clamp(math.floor((record.biome - 1) * 0.75) + 1, 1, 9)]
end

-- Possible content with chances (for egg info UI).
function Eggs.contents(record)
	if record.variant == "event" and record.event then
		local c = Creatures.Events[record.event]
		return { { species = c and c.id or "?", chance = 100 } }
	end
	local weights = Balance.speciesHatchWeights[record.variant] or Balance.speciesHatchWeights.normal
	local total = 0
	for _, w in weights do
		total += w
	end
	local list = {}
	for slot = 1, 4 do
		local c = Creatures.ByBiome[record.biome][slot]
		table.insert(list, { species = c.id, chance = math.floor(weights[slot] / total * 1000 + 0.5) / 10 })
	end
	return list
end

-- ===================== WORLD EGGS =====================
local function eggsFolder()
	return Workspace.Runtime.Eggs
end

local function addBillboard(model: Model, record, kind: string)
	local root = model.PrimaryPart
	local bb = Instance.new("BillboardGui")
	bb.Name = "EggInfo"
	bb.Size = UDim2.fromOffset(200, 54)
	bb.StudsOffsetWorldSpace = Vector3.new(0, 4.5 * Formulas.size(record.size).scale, 0)
	bb.MaxDistance = kind == "special" and 600 or 70
	bb.AlwaysOnTop = kind == "special" or kind == "event"
	bb.LightInfluence = 0
	local title = Instance.new("TextLabel")
	title.Name = "Title"
	title.Size = UDim2.new(1, 0, 0.55, 0)
	title.BackgroundTransparency = 1
	title.Font = GameConfig.Theme.Font
	title.TextScaled = true
	title.TextColor3 = Color3.new(1, 1, 1)
	title.TextStrokeTransparency = 0.2
	title.Text = Eggs.rarityLabel(record) .. " • " .. Formulas.size(record.size).eggName
	title.Parent = bb
	local sub = Instance.new("TextLabel")
	sub.Name = "Sub"
	sub.Position = UDim2.fromScale(0, 0.55)
	sub.Size = UDim2.new(1, 0, 0.45, 0)
	sub.BackgroundTransparency = 1
	sub.Font = GameConfig.Theme.FontBody
	sub.TextScaled = true
	sub.TextColor3 = Color3.fromRGB(255, 225, 120)
	sub.TextStrokeTransparency = 0.3
	sub.Text = record.mutation ~= "None" and (record.mutation .. " ✦") or Formulas.biome(record.biome).name
	sub.Parent = bb
	bb.Parent = root
end

local function setEggAttributes(model: Model, record)
	model:SetAttribute("EggName", Eggs.displayName(record))
	model:SetAttribute("Biome", record.biome)
	model:SetAttribute("Size", record.size)
	model:SetAttribute("Mutation", record.mutation)
	model:SetAttribute("Variant", record.variant)
	model:SetAttribute("EventId", record.event)
	model:SetAttribute("Rarity", Eggs.rarityLabel(record))
end

function Eggs.spawnWorldEgg(record, cf: CFrame, kind: string, opts)
	opts = opts or {}
	nextEggId += 1
	local id = nextEggId
	local eventColor = nil
	if record.variant == "event" and record.event then
		for _, e in GameConfig.Events do
			if e.id == record.event then
				eventColor = e.color
			end
		end
	end
	local model = ModelFactory.egg(record.biome, record.size, record.mutation, record.variant, eventColor)
	model.Name = "WorldEgg_" .. id
	model:PivotTo(cf)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.CanQuery = true
		end
	end
	setEggAttributes(model, record)
	model:SetAttribute("WorldEggId", id)
	model:SetAttribute("Kind", kind)
	addBillboard(model, record, kind)
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "StealPrompt"
	prompt.ActionText = "Roubar"
	prompt.ObjectText = Eggs.displayName(record)
	prompt.HoldDuration = 0.6
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.Parent = model.PrimaryPart
	prompt.Triggered:Connect(function(player)
		Eggs.tryPickup(player.UserId, id)
	end)
	CollectionService:AddTag(model, "WorldEgg")
	model.Parent = eggsFolder()
	local entry = { id = id, record = record, model = model, kind = kind, nest = opts.nest, expiresAt = opts.lifetime and (os.clock() + opts.lifetime) or nil, position = cf.Position }
	worldEggs[id] = entry
	return entry
end

function Eggs.removeWorldEgg(id: number)
	local e = worldEggs[id]
	if not e then
		return
	end
	worldEggs[id] = nil
	if e.model then
		e.model:Destroy()
	end
	if e.nest then
		e.nest.egg = nil
		local b = Formulas.biome(e.nest.biome)
		e.nest.respawnAt = os.clock() + b.nestRespawn * (0.8 + math.random() * 0.4)
	end
end

function Eggs.worldEggs()
	return worldEggs
end

function Eggs.nests()
	return nests
end

local function spawnNestEgg(nest)
	local variant = math.random() < Balance.rareEggChance and "rare" or "normal"
	local record = Eggs.makeRecord(nest.biome, variant)
	local entry = Eggs.spawnWorldEgg(record, nest.cframe, "nest", { nest = nest })
	nest.egg = entry.id
	return entry
end

-- ===================== CARRY =====================
local function attachCarryModel(id: number, record)
	local char = S.Actors.character(id)
	local torso = char and (char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso"))
	if not torso then
		return nil
	end
	local model = ModelFactory.egg(record.biome, record.size, record.mutation, record.variant)
	model.Name = "CarriedEgg"
	ModelFactory.unanchor(model)
	local scale = Formulas.size(record.size).scale
	model:PivotTo(torso.CFrame * CFrame.new(0, 0.2, 0.9 + scale * 0.9) * CFrame.new(0, -1.3 * scale, 0))
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = torso
	weld.Part1 = model.PrimaryPart
	weld.Parent = model.PrimaryPart
	model.Parent = char
	return model
end

function Eggs.isCarrying(id: number): boolean
	local st = S.Actors.state(id)
	return st ~= nil and st.carry ~= nil
end

function Eggs.setCarry(id: number, record, origin)
	local st = S.Actors.state(id)
	if not st then
		return false
	end
	st.carry = { record = record, origin = origin, model = attachCarryModel(id, record), since = os.clock() }
	local char = S.Actors.character(id)
	if char then
		char:SetAttribute("CarryingEgg", true)
	end
	S.PlayerData.dirty(id)
	return true
end

local function clearCarry(id: number)
	local st = S.Actors.state(id)
	if not st or not st.carry then
		return nil
	end
	local carry = st.carry
	st.carry = nil
	if carry.model then
		carry.model:Destroy()
	end
	local char = S.Actors.character(id)
	if char then
		char:SetAttribute("CarryingEgg", nil)
	end
	S.PlayerData.dirty(id)
	return carry
end

function Eggs.tryPickup(id: number, eggId: number): (boolean, string?)
	local e = worldEggs[eggId]
	local st = S.Actors.state(id)
	if not e or not st or not S.PlayerData.get(id) then
		return false, "Ovo indisponível"
	end
	if not S.Actors.alive(id) or S.Actors.isStuck(id) then
		return false, "Você não pode pegar agora"
	end
	if st.carry then
		return false, "Você já está carregando um ovo"
	end
	if S.Security.isSuspect(id) then
		return false, "Ação bloqueada"
	end
	if not S.Security.within(id, e.position, 12) then
		return false, "Muito longe"
	end
	if e.kind == "nest" and not S.Biomes.canEnter(id, e.record.biome) then
		return false, "Bioma bloqueado"
	end
	local record = e.record
	local kind = e.kind
	Eggs.removeWorldEgg(eggId)
	Eggs.setCarry(id, record, { kind = kind })
	local p = S.PlayerData.get(id)
	p.stats.eggsStolen += 1
	local player = S.Actors.player(id)
	if player then
		Net.fire(player, "Notify", { kind = "Egg", title = "VOCÊ ROUBOU UM OVO!", text = "Leve-o até a sua base! (" .. Eggs.displayName(record) .. ")" })
		Net.fire(player, "Effect", { kind = "Pickup", position = e.position, variant = record.variant })
	end
	if kind == "special" then
		Net.fireAll("Announce", { type = "SpecialEggTaken", by = S.Actors.name(id) })
		S.Events.onSpecialTaken()
	end
	S.Collection.checkAchievements(id)
	S.Tutorial.progress(id, "StealEgg")
	return true
end

-- Drop the carried egg (guardian hit, death, voluntary, caught). Base-stolen eggs go back home.
function Eggs.dropCarry(id: number, reason: string, position: Vector3?)
	local st = S.Actors.state(id)
	if not st or not st.carry then
		return
	end
	if reason ~= "caught" and reason ~= "leave" and S.Actors.buff(id, "EggShield") then
		return -- protected by Isis/Wadjet
	end
	local pos = position or S.Actors.position(id) or (st.lastSafePosition or Vector3.zero)
	local carry = clearCarry(id)
	if not carry then
		return
	end
	if carry.origin.kind == "base" then
		S.Theft.returnEgg(carry)
		return
	end
	if reason == "leave" and carry.origin.kind ~= "special" then
		return -- egg vanishes; nest already respawning
	end
	local ground = Vector3.new(pos.X, math.max(pos.Y - 2.5, 0.2), pos.Z)
	Eggs.spawnWorldEgg(carry.record, CFrame.new(ground), carry.origin.kind == "special" and "special" or "ground", { lifetime = Balance.protection.droppedEggSeconds })
	local player = S.Actors.player(id)
	if player and reason ~= "leave" then
		Net.fire(player, "Notify", { kind = "Warning", title = "Você derrubou o ovo!", text = "Recupere-o rápido antes que desapareça." })
	end
end

-- ===================== INCUBATORS =====================
function Eggs.freeSlot(id: number): number?
	local p = S.PlayerData.get(id)
	if not p then
		return nil
	end
	for slot = 1, S.Bases.incubatorCount(id) do
		if p.eggs[tostring(slot)] == nil then
			return slot
		end
	end
	return nil
end

-- Places a record into a free incubator. remaining = seconds left (keeps progress of stolen eggs).
function Eggs.deposit(id: number, record, remaining: number?): boolean
	local p = S.PlayerData.get(id)
	local slot = Eggs.freeSlot(id)
	if not p or not slot then
		return false
	end
	local now = os.time()
	local duration = Formulas.incubationSeconds(record.biome, record.size, S.Monetization.has(id, "DoubleGrowth"), record.variant == "special")
	if record.variant == "event" then
		duration = math.floor(duration * 0.6)
	end
	local left = remaining and math.min(remaining, duration) or duration
	record.duration = duration
	record.hatchAt = now + left
	record.ready = nil
	p.eggs[tostring(slot)] = record
	Eggs.renderBaseEggs(id)
	S.PlayerData.dirty(id)
	return true
end

function Eggs.grantEggToBase(id: number, record): boolean
	return Eggs.deposit(id, record)
end

local function tryDeposit(id: number)
	local st = S.Actors.state(id)
	if not st or not st.carry or not S.Bases.isInOwnBase(id) or S.Security.isSuspect(id) then
		return
	end
	local carry = st.carry
	local remaining = nil
	if carry.origin.kind == "base" then
		remaining = carry.origin.remaining
	end
	if not Eggs.freeSlot(id) then
		if not fullWarned[id] or os.clock() - fullWarned[id] > 8 then
			fullWarned[id] = os.clock()
			local player = S.Actors.player(id)
			if player then
				Net.fire(player, "Notify", { kind = "Warning", title = "Incubadoras cheias!", text = "Melhore sua base ou espere um ovo chocar." })
			end
		end
		return
	end
	clearCarry(id)
	if carry.origin.kind == "base" then
		S.Theft.completeRaid(id, carry)
	end
	Eggs.deposit(id, carry.record, remaining)
	local player = S.Actors.player(id)
	if player then
		Net.fire(player, "Notify", { kind = "Egg", title = "Ovo depositado!", text = "Incubando: " .. Eggs.displayName(carry.record) })
		Net.fire(player, "Effect", { kind = "Deposit", position = S.Actors.position(id) })
	end
	S.Tutorial.progress(id, "Deposit")
end

-- Rebuilds egg models on the pedestals of an actor's base.
function Eggs.renderBaseEggs(id: number)
	local m = S.Bases.modelOf(id)
	local p = S.PlayerData.get(id)
	if not m or not p then
		return
	end
	local folder = m.Incubating
	folder:ClearAllChildren()
	for slotKey, record in p.eggs do
		local slot = tonumber(slotKey)
		local cf = slot and S.Bases.slotCFrame(id, slot)
		if cf and not S.Theft.isBeingStolen(id, slotKey) then
			local model = ModelFactory.egg(record.biome, record.size, record.mutation, record.variant)
			model.Name = "Incubating_" .. slotKey
			model:PivotTo(cf * CFrame.new(0, 0.5, 0))
			for _, d in model:GetDescendants() do
				if d:IsA("BasePart") then
					d.CanQuery = true
				end
			end
			setEggAttributes(model, record)
			model:SetAttribute("Owner", id)
			model:SetAttribute("Slot", slotKey)
			model:SetAttribute("HatchAt", record.hatchAt)
			model:SetAttribute("Duration", record.duration)
			model:SetAttribute("Ready", record.ready == true)
			CollectionService:AddTag(model, "IncubatingEgg")
			-- countdown billboard (text updated client-side from attributes)
			local bb = Instance.new("BillboardGui")
			bb.Name = "Timer"
			bb.Size = UDim2.fromOffset(120, 44)
			bb.StudsOffsetWorldSpace = Vector3.new(0, 4 * Formulas.size(record.size).scale, 0)
			bb.MaxDistance = 60
			bb.LightInfluence = 0
			local label = Instance.new("TextLabel")
			label.Name = "Time"
			label.Size = UDim2.fromScale(1, 0.6)
			label.BackgroundTransparency = 1
			label.Font = GameConfig.Theme.Font
			label.TextScaled = true
			label.TextColor3 = Color3.new(1, 1, 1)
			label.TextStrokeTransparency = 0.2
			label.Text = ""
			label.Parent = bb
			local barBg = Instance.new("Frame")
			barBg.Name = "BarBg"
			barBg.Position = UDim2.fromScale(0.1, 0.68)
			barBg.Size = UDim2.fromScale(0.8, 0.22)
			barBg.BackgroundColor3 = Color3.fromRGB(30, 25, 60)
			barBg.BorderSizePixel = 0
			barBg.Parent = bb
			local bar = Instance.new("Frame")
			bar.Name = "Bar"
			bar.Size = UDim2.fromScale(0, 1)
			bar.BackgroundColor3 = Color3.fromRGB(255, 205, 70)
			bar.BorderSizePixel = 0
			bar.Parent = barBg
			Instance.new("UICorner").Parent = barBg
			Instance.new("UICorner").Parent = bar
			bb.Parent = model.PrimaryPart
			-- raid prompt (validated by Theft; hidden for the owner client-side)
			local prompt = Instance.new("ProximityPrompt")
			prompt.Name = "RaidPrompt"
			prompt.ActionText = "Roubar"
			prompt.ObjectText = "Ovo de " .. S.Actors.name(id)
			prompt.HoldDuration = 1.2
			prompt.MaxActivationDistance = 9
			prompt.RequiresLineOfSight = false
			prompt:SetAttribute("Owner", id)
			prompt.Parent = model.PrimaryPart
			prompt.Triggered:Connect(function(player)
				S.Theft.tryStealFromBase(player.UserId, id, slotKey)
			end)
			model.Parent = folder
		end
	end
end

-- ===================== LIFECYCLE =====================
function Eggs.start()
	-- collect nests from the map
	for _, biomeFolder in Workspace.Map:GetChildren() do
		local biomeId = biomeFolder:GetAttribute("BiomeId")
		local nestFolder = biomeFolder:FindFirstChild("Nests")
		if biomeId and nestFolder then
			for _, nm in nestFolder:GetChildren() do
				local point = nm:FindFirstChild("EggPoint")
				if point then
					table.insert(nests, { id = biomeId * 100 + (nm:GetAttribute("NestIndex") or 0), biome = biomeId, cframe = point.CFrame, egg = nil, respawnAt = 0 })
				end
			end
		end
	end
	for _, nest in nests do
		spawnNestEgg(nest)
	end

	S.Net.on("DropEgg", function(player)
		Eggs.dropCarry(player.UserId, "voluntary")
	end)

	S.Actors.Removed:Connect(function(id)
		Eggs.dropCarry(id, "leave")
		fullWarned[id] = nil
	end)
	S.Actors.CharacterAdded:Connect(function(id, char)
		local hum = char:WaitForChild("Humanoid", 5)
		if hum then
			hum.Died:Connect(function()
				Eggs.dropCarry(id, "died")
			end)
		end
	end)

	task.spawn(function()
		while true do
			task.wait(0.25)
			local now = os.clock()
			-- respawn nests
			for _, nest in nests do
				if not nest.egg and now >= nest.respawnAt then
					spawnNestEgg(nest)
				end
			end
			-- expire ground/special eggs
			for id, e in worldEggs do
				if e.expiresAt and now >= e.expiresAt then
					if e.kind == "special" then
						S.Events.onSpecialExpired()
					end
					Eggs.removeWorldEgg(id)
				end
			end
			-- deposit carriers that reached their base
			for id in S.Actors.all() do
				tryDeposit(id)
			end
		end
	end)
end

return Eggs
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001B"><Properties><string name="Name">Events</string><ProtectedString name="Source"><![CDATA[--[[
	Events — the global server clock for:
	  • SPECIAL EGG every 5 minutes: 15s countdown announcement, dramatic spawn, a beam marker
	    visible across the map; everybody races for it (no teleport).
	  • WORLD EVENTS (Eclipse Divino, Ragnarok, Ascensão Solar, Fúria dos Deuses): announcement,
	    timer, lighting/ambience change, waves of exclusive event eggs, end sequence.
	New events: add an entry to GameConfig.Events and (optionally) hooks to EVENT_HOOKS below.
]]

local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local Balance = require(Shared.Config.Balance)
local GameConfig = require(Shared.Config.GameConfig)
local Formulas = require(Shared.Util.Formulas)
local WeightedRandom = require(Shared.Util.WeightedRandom)
local Net = require(Shared.Util.Net)

local Events = {}
local S

Events.current = nil -- {id, name, endsAt}
Events.special = nil -- {eggId, position, biome, spawnedAt}
Events.nextSpecialAt = 0

local EVENT_HOOKS = {
	FuryOfGods = {
		onStart = function()
			S.Guardians.setFury(true)
		end,
		onEnd = function()
			S.Guardians.setFury(false)
		end,
	},
}

function Events.init(sys)
	S = sys
end

local function biomeFolder(b: number)
	return Workspace.Map:FindFirstChild("Biome_" .. b)
end

local function randomSpot(b: number): Vector3
	local f = biomeFolder(b)
	local spots = f and f:FindFirstChild("SpawnSpots")
	local children = spots and spots:GetChildren() or {}
	if #children > 0 then
		return children[math.random(1, #children)].Position
	end
	local z0, z1 = S.WorldBuilder.biomeZ(b)
	return Vector3.new(math.random(-30, 30), 1, math.random(z0 + 20, z1 - 20))
end

-- Biomes weighted by how many participants can reach them (so the race is fair for most).
local function chooseBiome(): number
	local weights = {}
	for b = 1, #Balance.biomes do
		weights[b] = b == 1 and 0.5 or 0
	end
	for id in S.Actors.all() do
		local p = S.PlayerData.get(id)
		if p then
			local u = Formulas.unlockedBiome(p.speed)
			for b = 1, u do
				weights[b] += (b == u) and 2 or 0.4
			end
		end
	end
	return WeightedRandom.index(weights)
end

-- ===================== SPECIAL EGG =====================
function Events.onSpecialTaken()
	Events.special = nil
end

function Events.onSpecialExpired()
	Events.special = nil
	Net.fireAll("Announce", { type = "SpecialEggGone" })
end

local function spawnSpecial()
	local b = chooseBiome()
	local pos = randomSpot(b)
	local record = S.Eggs.makeRecord(b, "special")
	local entry = S.Eggs.spawnWorldEgg(record, CFrame.new(pos + Vector3.new(0, 0.3, 0)), "special", { lifetime = Balance.specialEgg.lifetimeSeconds })
	-- vertical light beam marker
	local beam = Instance.new("Part")
	beam.Name = "SpecialBeam"
	beam.Anchored = true
	beam.CanCollide = false
	beam.CanQuery = false
	beam.Material = Enum.Material.Neon
	beam.Color = Color3.fromRGB(255, 235, 140)
	beam.Transparency = 0.55
	beam.Size = Vector3.new(3, 300, 3)
	beam.CFrame = CFrame.new(pos + Vector3.new(0, 150, 0))
	beam.Parent = entry.model
	Events.special = { eggId = entry.id, position = pos, biome = b, spawnedAt = os.clock() }
	Net.fireAll("Announce", { type = "SpecialEggSpawned", position = pos, biome = b, biomeName = Formulas.biome(b).name, size = record.size, mutation = record.mutation })
	S.BotBrain.onSpecialEgg(Events.special)
end

-- ===================== WORLD EVENTS =====================
local eventIndex = 0

local function runWorldEvent()
	eventIndex = eventIndex % #GameConfig.Events + 1
	local def = GameConfig.Events[eventIndex]
	local cfg = Balance.worldEvents
	local endsAt = os.time() + cfg.durationSeconds
	Events.current = { id = def.id, name = def.name, endsAt = endsAt }
	Net.fireAll("WorldState", { event = def.id, endsAt = endsAt })
	Net.fireAll("Announce", { type = "EventStart", event = def.id, name = def.name, desc = def.desc, endsAt = endsAt })
	local hooks = EVENT_HOOKS[def.id]
	if hooks and hooks.onStart then
		hooks.onStart()
	end
	local waves = math.floor(cfg.durationSeconds / cfg.waveSeconds)
	for _ = 1, waves do
		for _ = 1, cfg.eventEggsPerWave do
			local b = chooseBiome()
			local record = S.Eggs.makeRecord(b, "event", { event = def.id, tier = b })
			S.Eggs.spawnWorldEgg(record, CFrame.new(randomSpot(b) + Vector3.new(math.random(-6, 6), 0.3, math.random(-6, 6))), "event", { lifetime = cfg.waveSeconds + 30 })
		end
		Net.fireAll("Announce", { type = "EventWave", event = def.id, name = def.name })
		task.wait(cfg.waveSeconds)
	end
	if hooks and hooks.onEnd then
		hooks.onEnd()
	end
	Events.current = nil
	Net.fireAll("WorldState", { event = nil })
	Net.fireAll("Announce", { type = "EventEnd", name = def.name })
end

function Events.start()
	-- late joiners receive the current world state
	S.PlayerData.Loaded:Connect(function(id)
		local player = S.Actors.player(id)
		if player then
			task.delay(3, function()
				local cur = Events.current
				Net.fire(player, "WorldState", { event = cur and cur.id or nil, endsAt = cur and cur.endsAt or nil, nextSpecialAt = Events.nextSpecialAt })
				if Events.special then
					Net.fire(player, "Announce", { type = "SpecialEggSpawned", position = Events.special.position, biome = Events.special.biome, biomeName = Formulas.biome(Events.special.biome).name, quiet = true })
				end
			end)
		end
	end)

	-- special egg loop
	task.spawn(function()
		local cfg = Balance.specialEgg
		while true do
			Events.nextSpecialAt = os.time() + cfg.intervalSeconds
			Net.fireAll("WorldState", { event = Events.current and Events.current.id or nil, endsAt = Events.current and Events.current.endsAt or nil, nextSpecialAt = Events.nextSpecialAt })
			task.wait(cfg.intervalSeconds - cfg.warningSeconds)
			Net.fireAll("Announce", { type = "SpecialEggSoon", seconds = cfg.warningSeconds })
			task.wait(cfg.warningSeconds)
			if Events.special then
				S.Eggs.removeWorldEgg(Events.special.eggId)
				Events.special = nil
			end
			local ok, err = pcall(spawnSpecial)
			if not ok then
				warn("[Events] special egg failed:", err)
			end
		end
	end)

	-- world event loop
	task.spawn(function()
		task.wait(Balance.worldEvents.firstDelaySeconds)
		while true do
			local ok, err = pcall(runWorldEvent)
			if not ok then
				warn("[Events] world event failed:", err)
				Events.current = nil
			end
			task.wait(Balance.worldEvents.intervalSeconds - Balance.worldEvents.durationSeconds)
		end
	end)
end

return Events
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001C"><Properties><string name="Name">Guardians</string><ProtectedString name="Source"><![CDATA[--[[
	Guardians — one central AI loop (5 Hz) for every biome guardian.

	States: Sleeping → Patrolling ↔ Observing → Detecting → Chasing → Attacking → Returning
	  • Sleeping: periodic naps, detection radius halved (the "window" to steal)
	  • Patrolling/Observing: walks between the nests it protects, pauses to look around
	  • Detecting: brief "!" before the chase (gives a reaction window)
	  • Chasing: follows egg carriers (and nest intruders) up to the leash distance
	  • Attacking: knockback + the carried egg drops (recoverable for 20s)
	  • Returning: walks home ignoring targets for a few seconds
	Abilities can stun/slow guardians or distract them with decoys.
]]

local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local Balance = require(Shared.Config.Balance)
local Formulas = require(Shared.Util.Formulas)
local ModelFactory = require(Shared.Factory.ModelFactory)
local Net = require(Shared.Util.Net)

local Guardians = {}
local S

local list = {} -- guardian records
local decoys = {} -- {position, untilT, model}
local fury = false

function Guardians.init(sys)
	S = sys
end

function Guardians.setFury(on: boolean)
	fury = on
end

local function setState(g, state: string)
	if g.state ~= state then
		g.state = state
		g.stateSince = os.clock()
		g.model:SetAttribute("State", state)
	end
end

local function spawnGuardian(biomeId: number, index: number, points: { Vector3 })
	local model = ModelFactory.guardian(biomeId)
	model.Name = "Guardian_" .. biomeId .. "_" .. index
	local start = points[1] + Vector3.new(0, 6, 0)
	model:PivotTo(CFrame.new(start))
	model:SetAttribute("BiomeId", biomeId)
	model.Parent = Workspace.Runtime.Guardians
	local hrp = model:FindFirstChild("HumanoidRootPart") :: BasePart
	pcall(function()
		hrp:SetNetworkOwner(nil)
	end)
	local hum = model:FindFirstChildOfClass("Humanoid") :: Humanoid
	local center = Vector3.zero
	for _, p in points do
		center += p
	end
	center /= #points
	local g = {
		biome = biomeId, model = model, hrp = hrp, hum = hum, points = points, home = center,
		pointIndex = 1, state = "", stateSince = 0, target = nil, lastHit = 0,
		stunUntil = 0, slowUntil = 0, slowFactor = 0, nextNap = os.clock() + math.random(25, 60),
		ignoreUntil = 0, cfg = Formulas.biome(biomeId),
	}
	setState(g, "Patrolling")
	table.insert(list, g)
	return g
end

local function speedOf(g): number
	local now = os.clock()
	if g.stunUntil > now then
		return 0
	end
	local s = g.cfg.guardianSpeed
	if fury then
		s *= 1.2
	end
	if g.slowUntil > now then
		s *= 1 - g.slowFactor
	end
	if g.state == "Returning" then
		s *= 1.1
	elseif g.state == "Patrolling" then
		s *= 0.55
	end
	return s
end

-- Picks the best target in range: decoys first, then egg carriers, then nest intruders.
local function findTarget(g)
	local pos = g.hrp.Position
	local detect = g.cfg.guardianDetect * (g.state == "Sleeping" and 0.5 or 1)
	for _, d in decoys do
		if d.untilT > os.clock() and (d.position - pos).Magnitude < detect * 1.6 then
			return { decoy = d }
		end
	end
	local best, bestDist = nil, math.huge
	for id in S.Actors.all() do
		local root = S.Actors.root(id)
		if root and S.Actors.alive(id) then
			local dist = (root.Position - pos).Magnitude
			local st = S.Actors.state(id)
			local carrying = st and st.carry ~= nil
			local nearNest = (root.Position - g.home).Magnitude < 22
			local inBiome = S.WorldBuilder.biomeAt(root.Position.Z) == g.biome
			if inBiome and (carrying or nearNest) and dist < detect and dist < bestDist then
				best, bestDist = id, dist
			end
		end
	end
	return best and { actor = best } or nil
end

local function targetPosition(target): Vector3?
	if not target then
		return nil
	end
	if target.decoy then
		return target.decoy.untilT > os.clock() and target.decoy.position or nil
	end
	return S.Actors.position(target.actor)
end

local function attack(g, id: number)
	g.lastHit = os.clock()
	local st = S.Actors.state(id)
	if not st then
		return
	end
	if st.hitImmuneUntil > os.clock() then
		return
	end
	st.hitImmuneUntil = os.clock() + Balance.abilities.globalImmunitySeconds * 0.5
	Net.fireAll("Effect", { kind = "GuardianSlam", position = g.hrp.Position, biome = g.biome })
	if S.Actors.buff(id, "GuardShield") then
		S.Actors.clearBuff(id, "GuardShield")
		local player = S.Actors.player(id)
		if player then
			Net.fire(player, "Notify", { kind = "Info", title = "Escudo divino!", text = "Seu escudo bloqueou o golpe." })
		end
		return
	end
	local pos = S.Actors.position(id)
	if pos then
		local dir = (pos - g.hrp.Position) * Vector3.new(1, 0, 1)
		dir = dir.Magnitude > 0.1 and dir.Unit or Vector3.new(0, 0, -1)
		S.Abilities.knockback(id, dir * 75 + Vector3.new(0, 45, 0))
	end
	st.stunUntil = math.max(st.stunUntil, os.clock() + 0.8)
	S.Eggs.dropCarry(id, "guardian")
end

local function step(g, dt: number)
	local now = os.clock()
	if not g.model.Parent then
		return
	end
	g.hum.WalkSpeed = speedOf(g)
	g.model:SetAttribute("Stunned", g.stunUntil > now)
	local pos = g.hrp.Position

	if g.state == "Sleeping" then
		if now - g.stateSince > g.napLength then
			g.nextNap = now + math.random(30, 70)
			setState(g, "Patrolling")
		else
			local t = findTarget(g)
			if t and t.actor and (S.Actors.position(t.actor) - pos).Magnitude < g.cfg.guardianDetect * 0.35 then
				g.target = t
				setState(g, "Detecting")
			end
		end
		return
	end

	if g.state == "Patrolling" or g.state == "Observing" then
		if now > g.nextNap and math.random() < 0.02 then
			g.napLength = math.random(6, 12)
			g.hum:MoveTo(pos)
			setState(g, "Sleeping")
			return
		end
		if now > g.ignoreUntil then
			local t = findTarget(g)
			if t then
				g.target = t
				g.hum:MoveTo(pos)
				setState(g, "Detecting")
				return
			end
		end
		if g.state == "Observing" then
			if now - g.stateSince > g.observeFor then
				g.pointIndex = g.pointIndex % #g.points + 1
				setState(g, "Patrolling")
			else
				g.hrp.CFrame = g.hrp.CFrame * CFrame.Angles(0, math.rad(40) * dt, 0)
			end
			return
		end
		local goal = g.points[g.pointIndex]
		if (Vector3.new(goal.X, pos.Y, goal.Z) - pos).Magnitude < 5 then
			g.observeFor = math.random(15, 35) / 10
			setState(g, "Observing")
		else
			g.hum:MoveTo(goal)
		end
		return
	end

	if g.state == "Detecting" then
		if now - g.stateSince > 0.6 then
			setState(g, "Chasing")
		end
		return
	end

	if g.state == "Chasing" or g.state == "Attacking" then
		local tpos = targetPosition(g.target)
		local leash = g.cfg.guardianLeash
		if not tpos or (tpos - g.home).Magnitude > leash or (g.target.actor and S.WorldBuilder.biomeAt(tpos.Z) ~= g.biome) then
			g.target = nil
			g.ignoreUntil = now + 2
			setState(g, "Returning")
			return
		end
		-- a target that dropped its egg and left the nest area is no longer interesting
		if g.target.actor then
			local st = S.Actors.state(g.target.actor)
			if st and not st.carry and (tpos - g.home).Magnitude > 26 then
				g.target = nil
				setState(g, "Returning")
				return
			end
		end
		g.hum:MoveTo(tpos)
		local dist = (Vector3.new(tpos.X, pos.Y, tpos.Z) - pos).Magnitude
		if dist < 7.5 and now - g.lastHit > 1.4 and g.stunUntil <= now then
			setState(g, "Attacking")
			if g.target.decoy then
				g.target.decoy.untilT = 0
				g.target = nil
				setState(g, "Returning")
			else
				attack(g, g.target.actor)
				g.target = nil
				g.ignoreUntil = now + 3
				setState(g, "Returning")
			end
		elseif g.state == "Attacking" then
			setState(g, "Chasing")
		end
		return
	end

	if g.state == "Returning" then
		local nearest, nd = 1, math.huge
		for i, p in g.points do
			local d = (p - pos).Magnitude
			if d < nd then
				nearest, nd = i, d
			end
		end
		g.pointIndex = nearest
		if nd < 6 then
			setState(g, "Patrolling")
		else
			g.hum:MoveTo(g.points[nearest])
		end
	end
end

-- ===================== ABILITY HOOKS =====================
function Guardians.stunNear(position: Vector3, radius: number, seconds: number): number
	local n = 0
	for _, g in list do
		if (g.hrp.Position - position).Magnitude <= radius then
			g.stunUntil = math.max(g.stunUntil, os.clock() + seconds)
			g.target = nil
			g.ignoreUntil = os.clock() + seconds + 1
			setState(g, "Returning")
			n += 1
		end
	end
	return n
end

function Guardians.slowNear(position: Vector3, radius: number, factor: number, seconds: number): number
	local n = 0
	for _, g in list do
		if (g.hrp.Position - position).Magnitude <= radius then
			g.slowUntil = os.clock() + seconds
			g.slowFactor = math.clamp(factor, 0, 0.8)
			n += 1
		end
	end
	return n
end

function Guardians.addDecoy(position: Vector3, seconds: number, ownerId: number)
	local model = Instance.new("Model")
	model.Name = "Decoy"
	local char = S.Actors.character(ownerId)
	if char then
		for _, d in char:GetChildren() do
			if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" then
				local c = d:Clone()
				c:ClearAllChildren()
				c.Anchored = true
				c.CanCollide = false
				c.Transparency = 0.45
				c.Material = Enum.Material.ForceField
				c.Parent = model
			end
		end
		model:PivotTo(CFrame.new(position) * (char:GetPivot() - char:GetPivot().Position) * CFrame.new(-4, 0, 0))
	end
	model.Parent = Workspace.Runtime.Effects
	local d = { position = position + Vector3.new(-4, 0, 0), untilT = os.clock() + seconds, model = model }
	table.insert(decoys, d)
	task.delay(seconds, function()
		model:Destroy()
	end)
	return d
end

function Guardians.list()
	return list
end

-- Danger estimate for bots: distance to closest awake guardian chasing/near a point.
function Guardians.threatAt(position: Vector3): (number, any)
	local best, bestG = math.huge, nil
	for _, g in list do
		if g.state ~= "Sleeping" and g.stunUntil < os.clock() then
			local d = (g.hrp.Position - position).Magnitude
			if d < best then
				best, bestG = d, g
			end
		end
	end
	return best, bestG
end

function Guardians.start()
	for _, biomeFolder in Workspace.Map:GetChildren() do
		local biomeId = biomeFolder:GetAttribute("BiomeId")
		local gp = biomeFolder:FindFirstChild("GuardianPoints")
		if biomeId and gp then
			for _, gf in gp:GetChildren() do
				local points = {}
				for _, mk in gf:GetChildren() do
					table.insert(points, mk.Position)
				end
				table.sort(points, function(a, b)
					return a.Z < b.Z
				end)
				if #points > 0 then
					spawnGuardian(biomeId, tonumber(string.match(gf.Name, "%d+")) or 1, points)
				end
			end
		end
	end
	task.spawn(function()
		while true do
			local dt = task.wait(0.2)
			for i = #decoys, 1, -1 do
				if decoys[i].untilT < os.clock() then
					table.remove(decoys, i)
				end
			end
			for _, g in list do
				local ok, err = pcall(step, g, dt)
				if not ok then
					warn("[Guardians]", err)
				end
				-- recover a guardian that fell or got stuck far away
				if g.hrp.Position.Y < -20 or (g.hrp.Position - g.home).Magnitude > g.cfg.guardianLeash * 2 then
					g.model:PivotTo(CFrame.new(g.points[1] + Vector3.new(0, 6, 0)))
					setState(g, "Patrolling")
				end
			end
		end
	end)
end

return Guardians
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001D"><Properties><string name="Name">Hatch</string><ProtectedString name="Source"><![CDATA[--[[
	Hatch — turns finished eggs into creatures (online and offline).

	Species is rolled at hatch time from the egg's biome table (normal/rare/special weights) or is
	the event creature for event eggs. Size and mutation were rolled when the egg spawned (they are
	visible on the egg). Offline: on join, every egg whose hatchAt passed is hatched server-side.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local Balance = require(Shared.Config.Balance)
local Creatures = require(Shared.Config.Creatures)
local Formulas = require(Shared.Util.Formulas)
local WeightedRandom = require(Shared.Util.WeightedRandom)
local Net = require(Shared.Util.Net)

local Hatch = {}
local S
local readyWarned = {}

function Hatch.init(sys)
	S = sys
end

function Hatch.rollSpecies(record): string
	if record.variant == "event" and record.event then
		local c = Creatures.Events[record.event]
		if c then
			return c.id
		end
	end
	local weights = Balance.speciesHatchWeights[record.variant] or Balance.speciesHatchWeights.normal
	local slot = WeightedRandom.index(weights)
	return Creatures.ByBiome[record.biome][slot].id
end

-- Event Boost: event eggs get a second mutation roll, keeping the better one.
local function improveMutation(id: number, record): string
	local p = S.PlayerData.get(id)
	if record.variant == "event" and p and S.Economy.boostActive(p, "event") then
		local other = S.Eggs.rollMutation(false)
		if Formulas.mutation(other).mult > Formulas.mutation(record.mutation).mult then
			return other
		end
	end
	return record.mutation
end

-- Hatches one slot. Returns the pet or nil (capacity full).
function Hatch.hatchSlot(id: number, slotKey: string, silent: boolean?)
	local p = S.PlayerData.get(id)
	local record = p and p.eggs[slotKey]
	if not record or S.Theft.isBeingStolen(id, slotKey) then
		return nil
	end
	if #p.pets >= S.Pets.capacity(id) then
		if not record.ready then
			record.ready = true
			S.Eggs.renderBaseEggs(id)
			S.PlayerData.dirty(id)
		end
		if not silent and (not readyWarned[id] or os.clock() - readyWarned[id] > 20) then
			readyWarned[id] = os.clock()
			local player = S.Actors.player(id)
			if player then
				Net.fire(player, "Notify", { kind = "Warning", title = "Ovo pronto, mas sem espaço!", text = "Venda um pet ou melhore a base para liberar espaço." })
			end
		end
		return nil
	end
	local species = Hatch.rollSpecies(record)
	local pet = {
		uid = S.PlayerData.newUid(),
		species = species,
		size = record.size,
		mutation = improveMutation(id, record),
		tier = (record.variant == "event") and (record.tier or record.biome) or nil,
		at = os.time(),
	}
	p.eggs[slotKey] = nil
	local isNew = S.Pets.add(id, pet)
	p.stats.hatched += 1
	local c = Creatures.ById[species]
	if c and c.rarity == "Divine" then
		p.stats.divinePets += 1
	end
	S.Eggs.renderBaseEggs(id)
	S.PlayerData.dirty(id)
	S.Collection.checkAchievements(id)
	S.Tutorial.progress(id, "Hatch")
	if not silent then
		local cf = S.Bases.slotCFrame(id, tonumber(slotKey) :: number)
		Net.fireAll("Effect", { kind = "HatchBurst", position = cf and cf.Position, rarity = c and c.rarity, mythology = c and c.mythology, owner = id })
		local player = S.Actors.player(id)
		if player then
			Net.fire(player, "HatchReveal", {
				species = species, size = pet.size, mutation = pet.mutation, tier = pet.tier,
				income = Formulas.petIncome(pet), isNew = isNew, rarity = c and c.rarity,
			})
		end
	end
	return pet
end

function Hatch.reduceAll(id: number, seconds: number): number
	local p = S.PlayerData.get(id)
	if not p then
		return 0
	end
	local now = os.time()
	local n = 0
	for slotKey, record in p.eggs do
		if record.hatchAt and record.hatchAt > now and not S.Theft.isBeingStolen(id, slotKey) then
			local remaining = record.hatchAt - now
			local cut = math.min(seconds, math.floor(remaining * 0.5) + 1) -- never more than half at once
			record.hatchAt -= cut
			n += 1
		end
	end
	S.Eggs.renderBaseEggs(id)
	S.PlayerData.dirty(id)
	return n
end

function Hatch.hatchInstant(id: number): boolean
	local p = S.PlayerData.get(id)
	if not p then
		return false
	end
	local bestKey, bestLeft = nil, -1
	local now = os.time()
	for slotKey, record in p.eggs do
		local left = (record.hatchAt or now) - now
		if left > bestLeft and not S.Theft.isBeingStolen(id, slotKey) then
			bestKey, bestLeft = slotKey, left
		end
	end
	if not bestKey then
		return false
	end
	p.eggs[bestKey].hatchAt = now
	return Hatch.hatchSlot(id, bestKey) ~= nil or p.eggs[bestKey] ~= nil
end

-- Offline processing at join: hatch everything whose timer ran out while away.
function Hatch.processOffline(id: number)
	local p = S.PlayerData.get(id)
	local hatched = {}
	if not p then
		return hatched
	end
	local now = os.time()
	local keys = {}
	for slotKey, record in p.eggs do
		if record.hatchAt and record.hatchAt <= now then
			table.insert(keys, slotKey)
		end
	end
	table.sort(keys, function(a, b)
		return (p.eggs[a].hatchAt or 0) < (p.eggs[b].hatchAt or 0)
	end)
	for _, k in keys do
		local pet = Hatch.hatchSlot(id, k, true)
		if pet then
			table.insert(hatched, { species = pet.species, size = pet.size, mutation = pet.mutation })
		end
	end
	return hatched
end

function Hatch.start()
	S.PlayerData.Loaded:Connect(function(id, _profile, info)
		local hatched = Hatch.processOffline(id)
		local gold = S.Economy.applyOffline(id, info.secondsAway)
		if (info.secondsAway >= 60 and (gold > 0 or #hatched > 0)) then
			local player = S.Actors.player(id)
			if player then
				task.delay(2.5, function()
					Net.fire(player, "OfflineSummary", { seconds = math.min(info.secondsAway, Balance.economy.offlineCapSeconds), rawSeconds = info.secondsAway, gold = gold, hatched = hatched })
				end)
			end
		end
		S.PlayerData.dirty(id)
	end)
	S.Actors.Removed:Connect(function(id)
		readyWarned[id] = nil
	end)
	task.spawn(function()
		while true do
			task.wait(1)
			local now = os.time()
			for id in S.Actors.all() do
				local p = S.PlayerData.get(id)
				if p then
					for slotKey, record in p.eggs do
						if record.hatchAt and record.hatchAt <= now then
							Hatch.hatchSlot(id, slotKey)
						end
					end
				end
			end
		end
	end)
end

return Hatch
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001E"><Properties><string name="Name">Leaderboard</string><ProtectedString name="Source"><![CDATA[--[[
	Leaderboard — in-world ranking board at the shop plaza (top income / Speed of everyone in the
	server) and the data for the ranking panel. Refreshes every 10s.
]]

local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.Config.GameConfig)
local NumberFormatter = require(Shared.Util.NumberFormatter)

local Leaderboard = {}
local S
local cached = {}

function Leaderboard.init(sys)
	S = sys
end

local function collect()
	local rows = {}
	for id in S.Actors.all() do
		local p = S.PlayerData.get(id)
		if p then
			table.insert(rows, { name = S.Actors.name(id), income = S.Economy.incomeOf(id), speed = p.speed, pets = #p.pets, title = p.title })
		end
	end
	table.sort(rows, function(a, b)
		return a.income > b.income
	end)
	return rows
end

local function render(rows)
	local board = Workspace.Map:FindFirstChild("ShopPlaza") and Workspace.Map.ShopPlaza:FindFirstChild("Leaderboard")
	local gui = board and board:FindFirstChild("BoardGui")
	if not gui then
		return
	end
	gui:ClearAllChildren()
	local bg = Instance.new("Frame")
	bg.Size = UDim2.fromScale(1, 1)
	bg.BackgroundColor3 = GameConfig.Theme.Panel
	bg.Parent = gui
	local title = Instance.new("TextLabel")
	title.Size = UDim2.fromScale(1, 0.12)
	title.BackgroundTransparency = 1
	title.Text = "🏆 RANKING DO PANTEÃO"
	title.TextColor3 = GameConfig.Theme.Gold
	title.Font = GameConfig.Theme.Font
	title.TextScaled = true
	title.Parent = bg
	for i = 1, math.min(8, #rows) do
		local r = rows[i]
		local row = Instance.new("TextLabel")
		row.Position = UDim2.fromScale(0.04, 0.12 + i * 0.105)
		row.Size = UDim2.fromScale(0.92, 0.095)
		row.BackgroundColor3 = i == 1 and GameConfig.Theme.GoldDark or GameConfig.Theme.PanelLight
		row.BackgroundTransparency = 0.2
		row.Font = GameConfig.Theme.FontBody
		row.TextScaled = true
		row.TextColor3 = Color3.new(1, 1, 1)
		row.TextXAlignment = Enum.TextXAlignment.Left
		row.Text = string.format("  #%d  %s   💰 %s/s   ⚡ %s", i, r.name, NumberFormatter.format(r.income), NumberFormatter.format(r.speed))
		Instance.new("UICorner").Parent = row
		row.Parent = bg
	end
end

function Leaderboard.start()
	S.Net.handle("GetLeaderboard", function()
		return true, cached
	end)
	task.spawn(function()
		while true do
			cached = collect()
			pcall(render, cached)
			task.wait(10)
		end
	end)
end

return Leaderboard
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001F"><Properties><string name="Name">Monetization</string><ProtectedString name="Source"><![CDATA[--[[
	Monetization — Gamepasses, Developer Products (idempotent ProcessReceipt), VIP daily reward
	and the Divine Reliquary (paid random item with published odds + PolicyService compliance).

	Nothing is ever granted from a client event. Products only exist when their id is filled in
	Config/Monetization.luau; unregistered products are hidden/disabled in the shop.
]]

local Players = game:GetService("Players")
local MarketplaceService = game:GetService("MarketplaceService")
local PolicyService = game:GetService("PolicyService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config.Monetization)
local Balance = require(Shared.Config.Balance)
local Formulas = require(Shared.Util.Formulas)
local WeightedRandom = require(Shared.Util.WeightedRandom)
local Net = require(Shared.Util.Net)

local Monetization = {}
local S

local owned = {} -- [id] = {[passKey] = true}
local randomRestricted = {} -- [userId] = bool
local passById = {}
local productById = {}

for key, pass in Config.Gamepasses do
	if Config.isRegistered(pass) then
		passById[pass.id] = key
	end
end
for key, product in Config.Products do
	if Config.isRegistered(product) then
		productById[product.id] = key
	end
end

-- Validate odds table once (must total 100%).
do
	local total = 0
	for _, row in Config.ReliquaryTable do
		total += row.chance
	end
	assert(math.abs(total - 100) < 1e-6, "ReliquaryTable odds must sum to 100, got " .. total)
end

function Monetization.init(sys)
	S = sys
end

function Monetization.has(id: number, key: string): boolean
	local o = owned[id]
	return o ~= nil and o[key] == true
end

function Monetization.ownedList(id: number)
	local list = {}
	for k, v in owned[id] or {} do
		if v then
			table.insert(list, k)
		end
	end
	return list
end

function Monetization.isRandomRestricted(id: number): boolean
	return randomRestricted[id] == true
end

local function notify(id: number, title: string, text: string, kind: string?)
	local player = S.Actors.player(id)
	if player then
		Net.fire(player, "Notify", { kind = kind or "Purchase", title = title, text = text })
	end
end

local function applyPass(id: number, key: string)
	owned[id] = owned[id] or {}
	if owned[id][key] then
		return
	end
	owned[id][key] = true
	if key == "VIP" then
		S.Bases.refreshVisuals(id)
		local player = S.Actors.player(id)
		if player and player.Character then
			S.Trails.applyVipAura(id, player.Character)
		end
	elseif key == "ExtraBase" then
		S.Bases.refreshVisuals(id)
	end
	S.PlayerData.dirty(id)
end

local function refreshOwnership(player: Player)
	local id = player.UserId
	owned[id] = owned[id] or {}
	for key, pass in Config.Gamepasses do
		if Config.isRegistered(pass) then
			local ok, result = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, id, pass.id)
			if ok and result then
				applyPass(id, key)
			end
		end
	end
	local ok, policy = pcall(PolicyService.GetPolicyInfoForPlayerAsync, PolicyService, player)
	if ok and policy then
		randomRestricted[id] = policy.ArePaidRandomItemsRestricted == true
	else
		randomRestricted[id] = true -- fail closed: hide paid random items when policy is unknown
	end
	S.PlayerData.dirty(id)
end

-- ===================== REWARD HELPERS =====================
local function addBoost(id: number, boost: string, seconds: number)
	local p = S.PlayerData.get(id)
	local now = os.time()
	p.boosts[boost] = math.max(now, p.boosts[boost] or 0) + seconds
	S.PlayerData.dirty(id)
end
Monetization.addBoost = addBoost

-- Rolls and grants a reliquary result. Odds are EXACTLY the published table.
function Monetization.openReliquary(id: number)
	local row = WeightedRandom.pick(Config.ReliquaryTable, function(r)
		return r.chance
	end)
	local p = S.PlayerData.get(id)
	local text = row.label
	if row.reward == "GoldHour" then
		local amount = S.Economy.incomeSeconds(id, 3600, 25000)
		S.Economy.addGold(id, amount, "Reliquary")
		text = "+" .. amount .. " GOLD"
	elseif row.reward == "MoneyBoost30" then
		addBoost(id, "money", 1800)
	elseif row.reward == "TrainingBoost30" then
		addBoost(id, "training", 1800)
	elseif row.reward == "SpecialEgg" then
		local biome = Formulas.unlockedBiome(p.speed)
		local ok = S.Eggs.grantEggToBase(id, S.Eggs.makeRecord(biome, "special"))
		if not ok then
			local amount = S.Economy.incomeSeconds(id, 3600, 25000)
			S.Economy.addGold(id, amount, "ReliquaryFallback")
			text = "Base cheia — convertido em " .. amount .. " GOLD"
		end
	elseif row.reward == "CollectorTrail" then
		if table.find(p.trailsOwned, "Collector") then
			local amount = S.Economy.incomeSeconds(id, 10800, 100000)
			S.Economy.addGold(id, amount, "ReliquaryDupe")
			text = "Collector Trail repetido — +" .. amount .. " GOLD"
		else
			S.Trails.grant(id, "Collector")
		end
	end
	S.PlayerData.dirty(id)
	return row.reward, text
end

local function grantProduct(id: number, key: string): boolean
	local product = Config.Products[key]
	local p = S.PlayerData.get(id)
	if not product or not p then
		return false
	end
	if product.kind == "Gold" then
		local amount = S.Economy.incomeSeconds(id, product.seconds, product.minimum)
		S.Economy.addGold(id, amount, "Product")
		notify(id, "Compra concluída!", "+" .. amount .. " GOLD")
	elseif product.kind == "Boost" then
		addBoost(id, product.boost, product.seconds)
		notify(id, "Boost ativado!", product.name)
		if product.boost == "shield" then
			S.Bases.refreshVisuals(id)
		end
	elseif product.kind == "HatchInstant" then
		if not S.Hatch.hatchInstant(id) then
			addBoost(id, "money", 900)
			notify(id, "Nenhum ovo incubando", "Você recebeu 15 min de 2X Money no lugar.")
		end
	elseif product.kind == "Reliquary" then
		local _, text = Monetization.openReliquary(id)
		notify(id, "Divine Reliquary", text, "Rare")
	end
	return true
end

-- ===================== RECEIPTS =====================
local function processReceipt(receipt)
	local id = receipt.PlayerId
	local key = productById[receipt.ProductId]
	if not key then
		warn("[Monetization] Unknown product", receipt.ProductId)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local p = S.PlayerData.get(id)
	if not p then
		return Enum.ProductPurchaseDecision.NotProcessedYet -- player not loaded / left: retried later
	end
	if table.find(p.purchases, receipt.PurchaseId) then
		return Enum.ProductPurchaseDecision.PurchaseGranted -- already granted (idempotent)
	end
	local ok, err = pcall(grantProduct, id, key)
	if not ok then
		warn("[Monetization] grant failed", err)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	table.insert(p.purchases, receipt.PurchaseId)
	while #p.purchases > 80 do
		table.remove(p.purchases, 1)
	end
	if not S.PlayerData.saveNow(id) then
		-- Purchase id is recorded in memory, so a re-delivery in this session is idempotent;
		-- if the server dies before saving, Roblox re-delivers and the grant is (correctly) redone.
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

function Monetization.start()
	MarketplaceService.ProcessReceipt = processReceipt

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if purchased and passById[passId] then
			applyPass(player.UserId, passById[passId])
			notify(player.UserId, "Gamepass adquirido!", Config.Gamepasses[passById[passId]].name)
		end
	end)

	S.PlayerData.Loaded:Connect(function(id)
		local player = S.Actors.player(id)
		if player then
			task.spawn(refreshOwnership, player)
		end
	end)
	S.Actors.Removed:Connect(function(id)
		owned[id] = nil
		randomRestricted[id] = nil
	end)

	S.Net.handle("GetReliquaryInfo", function(player)
		local p = S.PlayerData.get(player.UserId)
		return true, {
			odds = Config.ReliquaryTable,
			restricted = randomRestricted[player.UserId] ~= false,
			registered = Config.isRegistered(Config.Products.DivineReliquary),
			keys = p and p.keys or 0,
		}
	end)

	S.Net.handle("OpenReliquaryKey", function(player)
		local id = player.UserId
		local p = S.PlayerData.get(id)
		if not p or p.keys < 1 then
			return false, "Você não tem chaves de relíquia."
		end
		p.keys -= 1
		local reward, text = Monetization.openReliquary(id)
		return true, { reward = reward, text = text }
	end)

	S.Net.handle("ClaimVipDaily", function(player)
		local id = player.UserId
		local p = S.PlayerData.get(id)
		if not p or not Monetization.has(id, "VIP") then
			return false, "Exclusivo VIP"
		end
		if os.time() - p.lastVipDaily < 20 * 3600 then
			return false, "Disponível em " .. math.ceil((20 * 3600 - (os.time() - p.lastVipDaily)) / 3600) .. "h"
		end
		p.lastVipDaily = os.time()
		local e = Balance.economy
		local amount = S.Economy.incomeSeconds(id, e.vipDailyGoldSecondsOfIncome, e.vipDailyGoldMinimum)
		S.Economy.addGold(id, amount, "VipDaily")
		p.keys += 1
		S.PlayerData.dirty(id)
		return true, "+" .. amount .. " GOLD e 1 chave de relíquia!"
	end)

	-- Daily login key (free alternative to the paid reliquary, available to everyone).
	S.PlayerData.Loaded:Connect(function(id, profile)
		local day = os.time() // 86400
		if profile.lastDaily ~= day then
			profile.lastDaily = day
			profile.keys += 1
			task.delay(8, function()
				notify(id, "Recompensa diária", "+1 Chave de Relíquia Divina (abra na Loja > Ovos Especiais)", "Reward")
			end)
		end
	end)
end

return Monetization
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000020"><Properties><string name="Name">Pets</string><ProtectedString name="Source"><![CDATA[--[[
	Pets — inventory, capacity, selling, the active divine companion and base display.

	All pets generate GOLD (Economy). Only ONE pet is equipped as the active companion: it follows
	the character and grants its ability (Abilities). Pets are displayed on the base pads sorted by
	income; clicking/pressing on a displayed pet opens its info card (client).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")
local Shared = ReplicatedStorage.Shared
local Creatures = require(Shared.Config.Creatures)
local Formulas = require(Shared.Util.Formulas)
local NumberFormatter = require(Shared.Util.NumberFormatter)
local ModelFactory = require(Shared.Factory.ModelFactory)
local Net = require(Shared.Util.Net)

local Pets = {}
local S
local companions = {} -- [id] = Model
local renderQueued = {}

function Pets.init(sys)
	S = sys
end

function Pets.capacity(id: number): number
	return S.Bases.petSlotCount(id)
end

function Pets.find(id: number, uid: string)
	local p = S.PlayerData.get(id)
	if not p then
		return nil, nil
	end
	for i, pet in p.pets do
		if pet.uid == uid then
			return pet, i
		end
	end
	return nil, nil
end

-- Adds a pet. Returns true if the species was newly discovered.
function Pets.add(id: number, pet): boolean
	local p = S.PlayerData.get(id)
	table.insert(p.pets, pet)
	local isNew = S.Collection.discover(id, pet)
	if not p.equippedPet then
		Pets.equip(id, pet.uid)
	end
	Pets.queueRender(id)
	return isNew
end

function Pets.sell(id: number, uid: any): (boolean, string?)
	if typeof(uid) ~= "string" then
		return false, "Pet inválido"
	end
	local p = S.PlayerData.get(id)
	local pet, index = Pets.find(id, uid)
	if not p or not pet then
		return false, "Pet não encontrado"
	end
	local value = Formulas.sellValue(pet)
	table.remove(p.pets, index)
	if p.equippedPet == uid then
		p.equippedPet = nil
		Pets.spawnCompanion(id)
	end
	S.Economy.addGold(id, value, "Sell")
	Pets.queueRender(id)
	S.PlayerData.dirty(id)
	return true, "Vendido por " .. NumberFormatter.format(value) .. " GOLD"
end

function Pets.equip(id: number, uid: any): (boolean, string?)
	local p = S.PlayerData.get(id)
	if not p then
		return false
	end
	if uid ~= nil and (typeof(uid) ~= "string" or not Pets.find(id, uid)) then
		return false, "Pet não encontrado"
	end
	p.equippedPet = uid
	Pets.spawnCompanion(id)
	S.PlayerData.dirty(id)
	return true
end

function Pets.equipped(id: number)
	local p = S.PlayerData.get(id)
	if not p or not p.equippedPet then
		return nil
	end
	return (Pets.find(id, p.equippedPet))
end

-- Best pet by income (used by bots and auto-equip).
function Pets.best(id: number)
	local p = S.PlayerData.get(id)
	local best, bestIncome = nil, -1
	for _, pet in p and p.pets or {} do
		local inc = Formulas.petIncome(pet)
		if inc > bestIncome then
			best, bestIncome = pet, inc
		end
	end
	return best
end

-- ===================== COMPANION =====================
function Pets.spawnCompanion(id: number)
	local old = companions[id]
	if old then
		old:Destroy()
		companions[id] = nil
	end
	local pet = Pets.equipped(id)
	local char = S.Actors.character(id)
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not pet or not root then
		return
	end
	local model = ModelFactory.creature(pet.species, pet.size, pet.mutation, { scale = 0.6 })
	model.Name = "Companion_" .. tostring(id)
	ModelFactory.unanchor(model)
	local primary = model.PrimaryPart :: BasePart
	primary.Massless = false
	model:PivotTo(root.CFrame * CFrame.new(3, 1, 3))
	local a0 = Instance.new("Attachment")
	a0.Parent = primary
	local a1 = Instance.new("Attachment")
	a1.Name = "SAG_CompanionTarget"
	a1.Position = Vector3.new(3.5, 0.5, 3)
	a1.Parent = root
	local align = Instance.new("AlignPosition")
	align.Attachment0 = a0
	align.Attachment1 = a1
	align.Responsiveness = 18
	align.MaxForce = 1e6
	align.Parent = primary
	local orient = Instance.new("AlignOrientation")
	orient.Attachment0 = a0
	orient.Attachment1 = a1
	orient.Responsiveness = 14
	orient.MaxTorque = 1e6
	orient.Parent = primary
	model:SetAttribute("Owner", id)
	CollectionService:AddTag(model, "Companion")
	model.Parent = workspace.Runtime.Pets
	local player = S.Actors.player(id)
	pcall(function()
		primary:SetNetworkOwner(player)
	end)
	companions[id] = model
	model.Destroying:Connect(function()
		if a1.Parent then
			a1:Destroy()
		end
	end)
end

-- ===================== BASE DISPLAY =====================
function Pets.queueRender(id: number)
	if renderQueued[id] then
		return
	end
	renderQueued[id] = true
	task.delay(0.3, function()
		renderQueued[id] = nil
		Pets.renderBase(id)
	end)
end

function Pets.renderBase(id: number)
	local m = S.Bases.modelOf(id)
	local p = S.PlayerData.get(id)
	if not m or not p then
		return
	end
	local folder = m.PetDisplays
	folder:ClearAllChildren()
	local sorted = table.clone(p.pets)
	table.sort(sorted, function(a, b)
		return Formulas.petIncome(a) > Formulas.petIncome(b)
	end)
	for n = 1, math.min(#sorted, Pets.capacity(id)) do
		local pet = sorted[n]
		local cf = S.Bases.petCFrame(id, n)
		if cf then
			local model = ModelFactory.creature(pet.species, pet.size, pet.mutation, { scale = 0.85 })
			model.Name = "Pet_" .. pet.uid
			model:PivotTo(cf * CFrame.new(0, -0.3, 0))
			local c = Creatures.ById[pet.species]
			model:SetAttribute("Owner", id)
			model:SetAttribute("Uid", pet.uid)
			model:SetAttribute("Species", pet.species)
			model:SetAttribute("Size", pet.size)
			model:SetAttribute("Mutation", pet.mutation)
			model:SetAttribute("Income", Formulas.petIncome(pet))
			model:SetAttribute("Rarity", c and c.rarity or "Common")
			CollectionService:AddTag(model, "PetDisplay")
			local prompt = Instance.new("ProximityPrompt")
			prompt.Name = "InspectPrompt"
			prompt.ActionText = "Ver"
			prompt.ObjectText = (pet.mutation ~= "None" and (pet.mutation .. " ") or "") .. pet.size .. " " .. (c and c.name or pet.species)
			prompt.HoldDuration = 0
			prompt.MaxActivationDistance = 8
			prompt.RequiresLineOfSight = false
			prompt.Style = Enum.ProximityPromptStyle.Default
			prompt:SetAttribute("Inspect", true)
			prompt.Parent = model.PrimaryPart
			model.Parent = folder
		end
	end
end

function Pets.start()
	S.Net.handle("EquipPet", function(player, payload)
		return Pets.equip(player.UserId, payload.uid)
	end)
	S.Net.handle("SellPet", function(player, payload)
		return Pets.sell(player.UserId, payload.uid)
	end)
	S.Actors.CharacterAdded:Connect(function(id)
		task.wait(0.5)
		Pets.spawnCompanion(id)
	end)
	S.Actors.Removed:Connect(function(id)
		if companions[id] then
			companions[id]:Destroy()
			companions[id] = nil
		end
	end)
end

return Pets
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000021"><Properties><string name="Name">PlayerData</string><ProtectedString name="Source"><![CDATA[--[[
	PlayerData — persistent profiles with session locking, retries, autosave, BindToClose,
	schema versioning/migration and offline progression.

	Profiles live in memory during the session; DataStore is written on autosave (every 90s),
	on leave and on shutdown — never every second. UpdateAsync is used everywhere so concurrent
	servers can't overwrite each other (session lock = {jobId, time}).

	Bots get an in-memory profile with the SAME shape (never saved).
]]

local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Balance = require(Shared.Config.Balance)
local Formulas = require(Shared.Util.Formulas)
local Signal = require(Shared.Util.Signal)
local Net = require(Shared.Util.Net)

local PlayerData = {}
PlayerData.Loaded = Signal.new() -- (id, profile, info{isNew, secondsAway})
PlayerData.Releasing = Signal.new() -- (id, profile) fired before final save

local S
local STORE_NAME = "SAG_Profiles_v1"
local SCHEMA_VERSION = 2
local AUTOSAVE_SECONDS = 90
local LOCK_STALE_SECONDS = 120

local store: DataStore? = nil
local profiles = {} -- [id] = profile
local saveable = {} -- [id] = true when backed by DataStore
local dirty = {} -- [id] = true -> push State
local loading = {} -- [userId] = true

-- ===================== TEMPLATE / MIGRATION =====================
local function template()
	return {
		version = SCHEMA_VERSION,
		gold = Balance.economy.startingGold,
		vault = 0,
		speed = 0,
		totalEarned = 0,
		treadmillTier = 1,
		trailsOwned = {},
		equippedTrail = nil,
		baseLevel = 1,
		eggs = {}, -- ["slot"] = egg record
		pets = {}, -- array of {uid, species, size, mutation, tier, at}
		equippedPet = nil,
		index = {}, -- [species] = {s = {Size=true}, m = {Mutation=true}, n = count}
		claimed = {}, -- index milestone ids
		achievements = {},
		stats = { eggsStolen = 0, hatched = 0, raids = 0, defenses = 0, divinePets = 0, discovered = 0, biomesUnlocked = 1,
			greekComplete = 0, norseComplete = 0, egyptianComplete = 0, robbed = 0 },
		settings = { music = true, sfx = true, vfx = "High", shake = true },
		boosts = {}, -- [name] = expiry os.time()
		purchases = {}, -- recent PurchaseIds (idempotency)
		keys = 0, -- free Divine Reliquary keys
		title = nil,
		tutorial = 1,
		tutDone = {},
		firstJoin = os.time(),
		lastSeen = os.time(),
		playtime = 0,
		lastDaily = 0,
		lastVipDaily = 0,
	}
end

local MIGRATIONS = {
	-- [fromVersion] = function(data) ... end
	[1] = function(data)
		data.keys = data.keys or 0
		data.lastVipDaily = data.lastVipDaily or 0
		data.version = 2
	end,
}

local function reconcile(data)
	local t = template()
	for k, v in t do
		if data[k] == nil then
			data[k] = v
		elseif typeof(v) == "table" and typeof(data[k]) == "table" and (k == "stats" or k == "settings") then
			for k2, v2 in v do
				if data[k][k2] == nil then
					data[k][k2] = v2
				end
			end
		end
	end
	return data
end

local function migrate(data)
	local guard = 0
	while (data.version or 1) < SCHEMA_VERSION and guard < 20 do
		local fn = MIGRATIONS[data.version or 1]
		if not fn then
			data.version = SCHEMA_VERSION
			break
		end
		fn(data)
		guard += 1
	end
	return reconcile(data)
end

-- ===================== DATASTORE IO =====================
local function retry(fn, attempts: number?)
	local tries = attempts or 5
	local delay = 1
	local lastErr
	for i = 1, tries do
		local ok, result = pcall(fn)
		if ok then
			return true, result
		end
		lastErr = result
		if i < tries then
			task.wait(delay)
			delay = math.min(delay * 2, 16)
		end
	end
	return false, lastErr
end

local function keyFor(userId: number)
	return "u_" .. userId
end

local function loadProfile(userId: number)
	if not store then
		return nil, "nostore"
	end
	local jobId = game.JobId ~= "" and game.JobId or "studio"
	for attempt = 1, 6 do
		local lockedByOther = false
		local ok, result = retry(function()
			return (store :: DataStore):UpdateAsync(keyFor(userId), function(old)
				old = old or {}
				local lock = old.lock
				if lock and lock.job ~= jobId and (os.time() - (lock.t or 0)) < LOCK_STALE_SECONDS then
					lockedByOther = true
					return nil -- abort write
				end
				old.lock = { job = jobId, t = os.time() }
				return old
			end)
		end, 4)
		if not ok then
			return nil, result
		end
		if not lockedByOther then
			local data = result and result.data
			return data or false -- false = new player
		end
		task.wait(attempt * 2) -- the other server should release soon
	end
	return nil, "locked"
end

local function writeProfile(userId: number, data, release: boolean)
	if not store then
		return false
	end
	local jobId = game.JobId ~= "" and game.JobId or "studio"
	local snapshot = table.clone(data)
	local ok, err = retry(function()
		return (store :: DataStore):UpdateAsync(keyFor(userId), function(old)
			old = old or {}
			if old.lock and old.lock.job ~= jobId and (os.time() - (old.lock.t or 0)) < LOCK_STALE_SECONDS then
				return nil -- another server owns the session; never overwrite
			end
			old.data = snapshot
			old.lock = (not release) and { job = jobId, t = os.time() } or nil
			return old
		end)
	end, 5)
	if not ok then
		warn("[PlayerData] save failed for", userId, err)
	end
	return ok
end

-- ===================== PUBLIC =====================
function PlayerData.get(id: number)
	return profiles[id]
end

function PlayerData.dirty(id: number)
	if profiles[id] then
		dirty[id] = true
	end
end

-- Light update: only money/speed fields (sent every economy tick without the full snapshot).
local dirtyLight = {}
function PlayerData.dirtyLight(id: number)
	if profiles[id] and not dirty[id] then
		dirtyLight[id] = true
	end
end

function PlayerData.isSaveable(id: number): boolean
	return saveable[id] == true
end

-- Builds the compact snapshot sent to the owning client.
function PlayerData.snapshot(id: number)
	local p = profiles[id]
	if not p then
		return nil
	end
	local now = os.time()
	local eggs = {}
	for slot, e in p.eggs do
		eggs[slot] = { biome = e.biome, size = e.size, mutation = e.mutation, variant = e.variant, event = e.event,
			hatchAt = e.hatchAt, duration = e.duration, ready = e.ready, stolen = S.Theft.isBeingStolen(id, slot) }
	end
	local pets = {}
	for _, pet in p.pets do
		table.insert(pets, { uid = pet.uid, species = pet.species, size = pet.size, mutation = pet.mutation, tier = pet.tier, income = Formulas.petIncome(pet) })
	end
	local boosts = {}
	for k, v in p.boosts do
		if v > now then
			boosts[k] = v
		end
	end
	local st = S.Actors.state(id)
	return {
		gold = p.gold, vault = p.vault, speed = p.speed, totalEarned = p.totalEarned,
		income = S.Economy.incomeOf(id), treadmillTier = p.treadmillTier,
		trailsOwned = p.trailsOwned, equippedTrail = p.equippedTrail,
		baseLevel = p.baseLevel, incubators = S.Bases.incubatorCount(id), petSlots = Formulas.baseLevel(p.baseLevel).petSlots,
		eggs = eggs, pets = pets, equippedPet = p.equippedPet,
		index = p.index, claimed = p.claimed, achievements = p.achievements, stats = p.stats,
		settings = p.settings, boosts = boosts, keys = p.keys, title = p.title, tutorial = p.tutorial, tutDone = p.tutDone,
		playtime = p.playtime, reliquaryRestricted = S.Monetization.isRandomRestricted(id),
		passes = S.Monetization.ownedList(id), trapsActive = S.Traps.activeCount(id),
		protected = S.Theft.protectionReason(id), baseIndex = S.Bases.baseIndexOf(id),
		carrying = st and st.carry and { biome = st.carry.record.biome, size = st.carry.record.size, mutation = st.carry.record.mutation, variant = st.carry.record.variant } or nil,
		unlockedBiome = Formulas.unlockedBiome(p.speed),
		saveable = saveable[id] == true,
		serverTime = now,
	}
end

function PlayerData.newUid(): string
	return string.sub(HttpService:GenerateGUID(false), 1, 13)
end

-- In-memory profile for a simulated participant.
function PlayerData.createBotProfile(id: number, seed)
	local p = template()
	if seed then
		for k, v in seed do
			p[k] = v
		end
	end
	profiles[id] = p
	return p
end

function PlayerData.removeBotProfile(id: number)
	profiles[id] = nil
	dirty[id] = nil
end

-- ===================== LIFECYCLE =====================
local function onPlayerAdded(player: Player)
	local userId = player.UserId
	if loading[userId] or profiles[userId] then
		return -- duplicate load protection
	end
	loading[userId] = true
	local data, err = loadProfile(userId)
	loading[userId] = nil
	if not player.Parent then
		-- left while loading: release lock untouched
		if data then
			writeProfile(userId, data, true)
		end
		return
	end
	local isNew = false
	if data == nil then
		if err == "locked" then
			player:Kick("Seus dados ainda estão abertos em outro servidor. Tente novamente em instantes.")
			return
		end
		warn("[PlayerData] DataStore unavailable (" .. tostring(err) .. ") — using a temporary profile for", player.Name)
		data = template()
		isNew = true
	elseif data == false then
		data = template()
		isNew = true
		saveable[userId] = true
	else
		data = migrate(data)
		saveable[userId] = true
	end
	if store == nil then
		saveable[userId] = nil
	end
	local secondsAway = isNew and 0 or math.max(0, os.time() - (data.lastSeen or os.time()))
	data.lastSeen = os.time()
	profiles[userId] = data
	S.Actors.register(userId, { kind = "Player", player = player, name = player.DisplayName })
	PlayerData.Loaded:Fire(userId, data, { isNew = isNew, secondsAway = secondsAway })
	PlayerData.dirty(userId)
	if not saveable[userId] then
		task.delay(4, function()
			Net.fire(player, "Notify", { kind = "Warning", title = "Progresso temporário", text = "DataStore indisponível (habilite API Services no Studio). O progresso desta sessão não será salvo." })
		end)
	end
end

local function release(player: Player)
	local userId = player.UserId
	local data = profiles[userId]
	if not data then
		return
	end
	PlayerData.Releasing:Fire(userId, data)
	data.lastSeen = os.time()
	S.Actors.unregister(userId)
	if saveable[userId] then
		writeProfile(userId, data, true)
	end
	profiles[userId] = nil
	saveable[userId] = nil
	dirty[userId] = nil
	dirtyLight[userId] = nil
end

function PlayerData.init(sys)
	S = sys
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok then
		store = result
	else
		warn("[PlayerData] DataStore unavailable:", result)
	end
end

function PlayerData.start()
	-- Character hookup for players
	local function hookCharacter(player: Player)
		player.CharacterAdded:Connect(function(char)
			task.wait() -- let the character finish parenting
			if profiles[player.UserId] then
				S.Actors.CharacterAdded:Fire(player.UserId, char)
			end
		end)
	end
	Players.PlayerAdded:Connect(function(player)
		hookCharacter(player)
		onPlayerAdded(player)
	end)
	Players.PlayerRemoving:Connect(release)
	for _, p in Players:GetPlayers() do
		hookCharacter(p)
		task.spawn(onPlayerAdded, p)
	end
	PlayerData.Loaded:Connect(function(id)
		local player = S.Actors.player(id)
		if player and player.Character then
			S.Actors.CharacterAdded:Fire(id, player.Character)
		end
	end)

	-- Settings (validated: only known keys and types are stored)
	S.Net.handle("SaveSettings", function(player, payload)
		local p = profiles[player.UserId]
		if not p then
			return false
		end
		if typeof(payload.music) == "boolean" then
			p.settings.music = payload.music
		end
		if typeof(payload.sfx) == "boolean" then
			p.settings.sfx = payload.sfx
		end
		if payload.vfx == "High" or payload.vfx == "Low" then
			p.settings.vfx = payload.vfx
		end
		if typeof(payload.shake) == "boolean" then
			p.settings.shake = payload.shake
		end
		return true
	end)

	-- Autosave
	task.spawn(function()
		while true do
			task.wait(AUTOSAVE_SECONDS)
			for _, player in Players:GetPlayers() do
				local id = player.UserId
				local data = profiles[id]
				if data and saveable[id] then
					data.lastSeen = os.time()
					task.spawn(writeProfile, id, data, false)
				end
			end
		end
	end)

	-- Playtime + state sync (throttled)
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc < 0.25 then
			return
		end
		local step = acc
		acc = 0
		for id in dirtyLight do
			dirtyLight[id] = nil
			local p = profiles[id]
			local player = S.Actors.player(id)
			if p and player and not dirty[id] then
				Net.fire(player, "State", { partial = true, gold = p.gold, vault = p.vault, speed = p.speed, totalEarned = p.totalEarned,
					income = S.Economy.incomeOf(id), unlockedBiome = Formulas.unlockedBiome(p.speed), serverTime = os.time() })
			end
		end
		for id in dirty do
			dirty[id] = nil
			local player = S.Actors.player(id)
			if player then
				local snap = PlayerData.snapshot(id)
				if snap then
					Net.fire(player, "State", snap)
				end
			end
		end
		for _, player in Players:GetPlayers() do
			local p = profiles[player.UserId]
			if p then
				p.playtime += step
			end
		end
	end)

	game:BindToClose(function()
		local threads = 0
		for _, player in Players:GetPlayers() do
			local id = player.UserId
			if profiles[id] and saveable[id] then
				threads += 1
				task.spawn(function()
					profiles[id].lastSeen = os.time()
					writeProfile(id, profiles[id], true)
					threads -= 1
				end)
			end
		end
		local deadline = os.clock() + 25
		while threads > 0 and os.clock() < deadline do
			task.wait(0.1)
		end
	end)
end

-- Persist immediately (used after purchases). Returns success.
function PlayerData.saveNow(id: number): boolean
	local data = profiles[id]
	if not data then
		return false
	end
	if not saveable[id] then
		return true -- nothing to persist (Studio without API access / bot)
	end
	return writeProfile(id, data, false)
end

return PlayerData
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000022"><Properties><string name="Name">Security</string><ProtectedString name="Source"><![CDATA[--[[
	Security — server-side sanity layer.
	  • logs rate-limit violations coming from Net
	  • tracks impossible movement (speed hacks / teleports) and marks the actor as "suspect"
	    for a few seconds: suspect actors cannot pick up, steal or deposit eggs
	  • provides distance validation helpers used by every gameplay system
	Never bans on heuristics — it blocks the invalid operation and protects the economy.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Net = require(ReplicatedStorage.Shared.Util.Net)
local Formulas = require(ReplicatedStorage.Shared.Util.Formulas)

local Security = {}
local S

local strikes = {} -- [player] = count
local suspectUntil = {} -- [id] = os.clock()
local lastPos = {} -- [id] = {pos, t}
local log = {}

local function record(kind: string, who: string, detail: string)
	local entry = string.format("[%s] %s %s: %s", os.date("!%H:%M:%S"), kind, who, detail)
	table.insert(log, entry)
	if #log > 200 then
		table.remove(log, 1)
	end
	warn("[Security]", entry)
end

function Security.init(sys)
	S = sys
	Net.onRateLimited = function(player, name)
		strikes[player] = (strikes[player] or 0) + 1
		if strikes[player] % 20 == 1 then
			record("RateLimit", player.Name, name .. " x" .. strikes[player])
		end
	end
end

function Security.isSuspect(id: number): boolean
	return (suspectUntil[id] or 0) > os.clock()
end

function Security.flag(id: number, reason: string)
	suspectUntil[id] = os.clock() + 8
	record("Flag", S.Actors.name(id), reason)
end

-- Distance check with latency tolerance.
function Security.within(id: number, position: Vector3, maxDistance: number): boolean
	local pos = S.Actors.position(id)
	if not pos then
		return false
	end
	return (pos - position).Magnitude <= maxDistance + (S.Actors.isBot(id) and 0 or 4)
end

function Security.recentLog()
	return table.clone(log)
end

function Security.start()
	Players.PlayerRemoving:Connect(function(p)
		strikes[p] = nil
		suspectUntil[p.UserId] = nil
		lastPos[p.UserId] = nil
	end)
	-- movement sanity (players only; bots are server-driven)
	task.spawn(function()
		while true do
			task.wait(0.5)
			local now = os.clock()
			for _, player in Players:GetPlayers() do
				local id = player.UserId
				local profile = S.PlayerData.get(id)
				local pos = S.Actors.position(id)
				if profile and pos then
					local prev = lastPos[id]
					if prev and now - prev.t > 0 then
						local horizontal = Vector3.new(pos.X - prev.pos.X, 0, pos.Z - prev.pos.Z).Magnitude
						local allowed = (Formulas.walkSpeed(profile.speed) * 1.6 + 60) * (now - prev.t)
						local st = S.Actors.state(id)
						local exempt = st and st.teleportGrace and st.teleportGrace > now
						if horizontal > allowed and not exempt then
							Security.flag(id, string.format("moved %.0f studs in %.2fs", horizontal, now - prev.t))
						end
					end
					lastPos[id] = { pos = pos, t = now }
				else
					lastPos[id] = nil
				end
			end
		end
	end)
end

return Security
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000023"><Properties><string name="Name">Speed</string><ProtectedString name="Source"><![CDATA[--[[
	Speed — treadmill training, walk speed application and treadmill purchases.

	Training is server-authoritative: an actor only gains Speed while standing on the belt of the
	treadmill IN THEIR OWN BASE and actively moving (players send a throttled TrainPing, bots are
	read directly). Gain per step = treadmill.perStep × trail mult × (2x pass) × (boost) × (ability).
	Real movement speed = log-scaled Speed, capped, minus carry penalty.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local Balance = require(Shared.Config.Balance)
local Formulas = require(Shared.Util.Formulas)
local NumberFormatter = require(Shared.Util.NumberFormatter)
local Net = require(Shared.Util.Net)

local Speed = {}
local S

function Speed.init(sys)
	S = sys
end

local function ownTreadmillBelt(id: number): BasePart?
	local m = S.Bases.modelOf(id)
	local tm = m and m.Visuals:FindFirstChild("Treadmill")
	return tm and tm:FindFirstChild("Belt") :: BasePart? or nil
end

function Speed.treadmillCFrame(id: number): CFrame?
	local belt = ownTreadmillBelt(id)
	return belt and belt.CFrame or nil
end

function Speed.isOnTreadmill(id: number): boolean
	local belt = ownTreadmillBelt(id)
	local pos = S.Actors.position(id)
	if not belt or not pos then
		return false
	end
	local rel = belt.CFrame:PointToObjectSpace(pos)
	return math.abs(rel.X) < belt.Size.X / 2 + 0.5 and math.abs(rel.Z) < belt.Size.Z / 2 + 0.5 and rel.Y > 0 and rel.Y < 7
end

local function isMoving(id: number): boolean
	local hum = S.Actors.humanoid(id)
	if not hum then
		return false
	end
	if S.Actors.isBot(id) then
		return hum.MoveDirection.Magnitude > 0.1
	end
	local st = S.Actors.state(id)
	return st ~= nil and os.clock() - st.lastTrainPing < 0.6
end

function Speed.trainingModifiers(id: number)
	local p = S.PlayerData.get(id)
	return {
		trainingPass = S.Monetization.has(id, "DoubleTraining"),
		trainingBoost = p ~= nil and S.Economy.boostActive(p, "training"),
		abilityMult = S.Actors.buff(id, "TrainBoost"),
	}
end

function Speed.gainPerStep(id: number): number
	local p = S.PlayerData.get(id)
	if not p then
		return 0
	end
	return Formulas.trainGain(p.treadmillTier, p.equippedTrail, Speed.trainingModifiers(id))
end

local function checkUnlock(id: number, before: number, after: number)
	local b0 = Formulas.unlockedBiome(before)
	local b1 = Formulas.unlockedBiome(after)
	if b1 > b0 then
		local p = S.PlayerData.get(id)
		p.stats.biomesUnlocked = math.max(p.stats.biomesUnlocked, b1)
		local biome = Formulas.biome(b1)
		local player = S.Actors.player(id)
		if player then
			Net.fire(player, "Notify", { kind = "Unlock", title = "NOVA REGIÃO DESBLOQUEADA!", text = biome.name })
			Net.fire(player, "Effect", { kind = "Unlock", biome = b1 })
		end
		S.Collection.checkAchievements(id)
		S.Tutorial.progress(id, "UnlockBiome")
		S.PlayerData.dirty(id)
	end
end

function Speed.addSpeed(id: number, amount: number)
	local p = S.PlayerData.get(id)
	if not p or amount <= 0 or amount ~= amount then
		return
	end
	local before = p.speed
	p.speed += amount
	checkUnlock(id, before, p.speed)
	S.PlayerData.dirtyLight(id)
end

function Speed.walkSpeedOf(id: number): number
	local p = S.PlayerData.get(id)
	local st = S.Actors.state(id)
	if not p or not st then
		return 16
	end
	if S.Actors.isStuck(id) then
		return 0
	end
	local carrySize = st.carry and st.carry.record.size or nil
	local relief = S.Actors.buff(id, "WeightRelief") or 0
	local mult = 1
	local burst = S.Actors.buff(id, "SpeedBurst")
	if burst then
		local carryingOnly = S.Actors.buff(id, "SpeedBurstCarryOnly")
		if not carryingOnly or st.carry then
			mult *= burst
		end
	end
	if not st.carry and Speed.isOnTreadmill(id) then
		return 16 -- treadmill running speed stays readable
	end
	return Formulas.walkSpeed(p.speed, carrySize, relief, mult)
end

function Speed.buyNext(id: number): (boolean, string?)
	local p = S.PlayerData.get(id)
	if not p then
		return false, "Sem dados"
	end
	local nextTier = p.treadmillTier + 1
	local def = Balance.treadmills[nextTier]
	if not def then
		return false, "Você já tem a melhor esteira!"
	end
	if not S.Economy.spend(id, def.price) then
		return false, "GOLD insuficiente"
	end
	p.treadmillTier = nextTier
	S.Bases.refreshVisuals(id)
	S.PlayerData.dirty(id)
	S.Tutorial.progress(id, "BuyTreadmill")
	return true, def.name .. " instalada! (+" .. NumberFormatter.format(def.perStep) .. " por passo)"
end

function Speed.start()
	S.Net.on("TrainPing", function(player, moving)
		local st = S.Actors.state(player.UserId)
		if st and moving == true then
			st.lastTrainPing = os.clock()
		end
	end)
	S.Net.handle("BuyTreadmill", function(player)
		return Speed.buyNext(player.UserId)
	end)

	-- training loop
	local stepTime = 1 / Balance.speed.stepsPerSecond
	task.spawn(function()
		while true do
			task.wait(stepTime)
			for id in S.Actors.all() do
				if S.PlayerData.get(id) and isMoving(id) and Speed.isOnTreadmill(id) and not S.Actors.isStuck(id) then
					local st = S.Actors.state(id)
					if st and not st.carry then
						Speed.addSpeed(id, Speed.gainPerStep(id))
						S.Tutorial.progress(id, "Train")
					end
				end
			end
		end
	end)

	-- walk speed loop
	task.spawn(function()
		while true do
			task.wait(0.2)
			for id in S.Actors.all() do
				local hum = S.Actors.humanoid(id)
				if hum and hum.Health > 0 then
					local ws = Speed.walkSpeedOf(id)
					if math.abs(hum.WalkSpeed - ws) > 0.05 then
						hum.WalkSpeed = ws
					end
					local stuck = S.Actors.isStuck(id)
					hum.UseJumpPower = false
					local jh = stuck and 0 or 7.2
					if hum.JumpHeight ~= jh then
						hum.JumpHeight = jh
					end
				end
			end
		end
	end)
end

return Speed
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000024"><Properties><string name="Name">Theft</string><ProtectedString name="Source"><![CDATA[--[[
	Theft — stealing incubating eggs from other bases, with anti-frustration protection.

	Rules
	  • only eggs still incubating can be stolen; hatched pets never
	  • the thief must physically carry the egg home; ownership changes ONLY on deposit
	  • the owner can catch the thief (get within catch radius) → the egg returns home
	  • if the owner leaves while the egg is in transit, the egg stays with the owner (no dupes)
	  • protection: new players (first 10 min of play), Base Shield product, and 3 min of
	    protection after being robbed 2 times within 5 minutes
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local Balance = require(Shared.Config.Balance)
local Net = require(Shared.Util.Net)

local Theft = {}
local S

local beingStolen = {} -- ["owner:slot"] = thiefId
local robbedLog = {} -- [ownerId] = {times}
local recoveryUntil = {} -- [ownerId] = os.time()
local alarmToken = {}

local P = Balance.protection

function Theft.init(sys)
	S = sys
end

local function key(owner: number, slot: string)
	return tostring(owner) .. ":" .. slot
end

function Theft.isBeingStolen(owner: number, slot: string): boolean
	return beingStolen[key(owner, tostring(slot))] ~= nil
end

function Theft.protectionReason(owner: number): string?
	local p = S.PlayerData.get(owner)
	if not p then
		return nil
	end
	if S.Economy.boostActive(p, "shield") then
		return "Escudo"
	end
	if (recoveryUntil[owner] or 0) > os.time() then
		return "Recuperação"
	end
	-- newcomer protection ends after 10 min of play or as soon as the newcomer completes a raid
	if not S.Actors.isBot(owner) and p.playtime < P.newPlayerSeconds and (p.stats.raids or 0) == 0 then
		return "Novato"
	end
	return nil
end

local function setAlarm(owner: number)
	local m = S.Bases.modelOf(owner)
	if not m then
		return
	end
	local token = {}
	alarmToken[owner] = token
	m:SetAttribute("Alarm", true)
	task.delay(6, function()
		if alarmToken[owner] == token and m.Parent then
			m:SetAttribute("Alarm", false)
		end
	end)
end

function Theft.tryStealFromBase(thief: number, owner: number, slot: any): (boolean, string?)
	slot = tostring(slot)
	local thiefPlayer = S.Actors.player(thief)
	local function deny(msg)
		if thiefPlayer then
			Net.fire(thiefPlayer, "Notify", { kind = "Warning", title = "Não foi possível roubar", text = msg })
		end
		return false, msg
	end
	if thief == owner then
		return false, "Esse ovo é seu"
	end
	local op = S.PlayerData.get(owner)
	local tp = S.PlayerData.get(thief)
	local st = S.Actors.state(thief)
	if not op or not tp or not st then
		return false, "indisponível"
	end
	local record = op.eggs[slot]
	if not record or beingStolen[key(owner, slot)] then
		return deny("Esse ovo não está disponível.")
	end
	if record.ready then
		return deny("Esse ovo já está chocando!")
	end
	if st.carry then
		return deny("Você já está carregando um ovo.")
	end
	if not S.Actors.alive(thief) or S.Actors.isStuck(thief) or S.Security.isSuspect(thief) then
		return deny("Você não pode roubar agora.")
	end
	local reason = Theft.protectionReason(owner)
	if reason then
		return deny("Base protegida (" .. reason .. ").")
	end
	local cf = S.Bases.slotCFrame(owner, tonumber(slot) :: number)
	if not cf or not S.Security.within(thief, cf.Position, 11) then
		return deny("Muito longe.")
	end
	beingStolen[key(owner, slot)] = thief
	local remaining = math.max(5, (record.hatchAt or os.time()) - os.time())
	S.Eggs.setCarry(thief, record, { kind = "base", owner = owner, slot = slot, remaining = remaining })
	S.Eggs.renderBaseEggs(owner)
	S.PlayerData.dirty(owner)
	setAlarm(owner)
	local ownerPlayer = S.Actors.player(owner)
	if ownerPlayer then
		Net.fire(ownerPlayer, "Notify", { kind = "Alarm", title = "SEU OVO ESTÁ SENDO ROUBADO!", text = S.Actors.name(thief) .. " pegou um ovo da sua base. Alcance-o para recuperar!" })
		Net.fire(ownerPlayer, "Effect", { kind = "Alarm" })
	end
	if thiefPlayer then
		Net.fire(thiefPlayer, "Notify", { kind = "Egg", title = "VOCÊ ROUBOU UM OVO!", text = "Fuja para a sua base antes que " .. S.Actors.name(owner) .. " te alcance!" })
	end
	S.BotBrain.onBaseRaided(owner, thief)
	return true
end

-- Thief deposited in their own base: ownership changes now.
function Theft.completeRaid(thief: number, carry)
	local origin = carry.origin
	local k = key(origin.owner, origin.slot)
	beingStolen[k] = nil
	local op = S.PlayerData.get(origin.owner)
	if op and op.eggs[origin.slot] == carry.record then
		op.eggs[origin.slot] = nil
		op.stats.robbed = (op.stats.robbed or 0) + 1
		S.Eggs.renderBaseEggs(origin.owner)
		S.PlayerData.dirty(origin.owner)
		-- anti-frustration
		local log = robbedLog[origin.owner] or {}
		local now = os.time()
		table.insert(log, now)
		while #log > 0 and now - log[1] > P.robbedWindowSeconds do
			table.remove(log, 1)
		end
		robbedLog[origin.owner] = log
		if #log >= P.robbedLimit then
			recoveryUntil[origin.owner] = now + P.protectSeconds
			robbedLog[origin.owner] = {}
			S.Bases.refreshVisuals(origin.owner)
			local ownerPlayer = S.Actors.player(origin.owner)
			if ownerPlayer then
				Net.fire(ownerPlayer, "Notify", { kind = "Info", title = "Proteção ativada", text = "Sua base está protegida contra roubos por 3 minutos." })
			end
		end
		local ownerPlayer = S.Actors.player(origin.owner)
		if ownerPlayer then
			Net.fire(ownerPlayer, "Notify", { kind = "Alarm", title = "Ovo perdido", text = S.Actors.name(thief) .. " levou seu ovo para a base dele." })
		end
	end
	local tp = S.PlayerData.get(thief)
	if tp then
		tp.stats.raids = (tp.stats.raids or 0) + 1
	end
	S.Collection.checkAchievements(thief)
end

-- Egg goes back to the owner's incubator (caught / dropped / thief left).
function Theft.returnEgg(carry)
	local origin = carry.origin
	beingStolen[key(origin.owner, origin.slot)] = nil
	if S.PlayerData.get(origin.owner) then
		S.Eggs.renderBaseEggs(origin.owner)
		S.PlayerData.dirty(origin.owner)
	end
end

function Theft.start()
	-- owner leaving: invalidate eggs in transit (egg stays saved with the owner)
	S.Actors.Removed:Connect(function(owner)
		for id in S.Actors.all() do
			local st = S.Actors.state(id)
			if st and st.carry and st.carry.origin.kind == "base" and st.carry.origin.owner == owner then
				S.Eggs.dropCarry(id, "caught")
				local p = S.Actors.player(id)
				if p then
					Net.fire(p, "Notify", { kind = "Warning", title = "O ovo sumiu", text = "O dono saiu do servidor e o ovo voltou para ele." })
				end
			end
		end
		for k in beingStolen do
			if string.sub(k, 1, #tostring(owner) + 1) == tostring(owner) .. ":" then
				beingStolen[k] = nil
			end
		end
		robbedLog[owner] = nil
		recoveryUntil[owner] = nil
	end)

	-- catching thieves
	task.spawn(function()
		while true do
			task.wait(0.2)
			for thief in S.Actors.all() do
				local st = S.Actors.state(thief)
				local carry = st and st.carry
				if carry and carry.origin.kind == "base" then
					local owner = carry.origin.owner
					local ownerPos = S.Actors.position(owner)
					local thiefPos = S.Actors.position(thief)
					if ownerPos and thiefPos and S.Actors.alive(owner) then
						local radius = S.Actors.buff(owner, "CatchReach") or P.catchRadius
						if (ownerPos - thiefPos).Magnitude <= radius then
							S.Eggs.dropCarry(thief, "caught")
							local op = S.PlayerData.get(owner)
							if op then
								op.stats.defenses = (op.stats.defenses or 0) + 1
							end
							S.Abilities.knockback(thief, (thiefPos - ownerPos).Unit * 60 + Vector3.new(0, 30, 0))
							local ownerPlayer = S.Actors.player(owner)
							if ownerPlayer then
								Net.fire(ownerPlayer, "Notify", { kind = "Reward", title = "DEFESA BEM-SUCEDIDA!", text = "Você recuperou seu ovo!" })
							end
							local thiefPlayer = S.Actors.player(thief)
							if thiefPlayer then
								Net.fire(thiefPlayer, "Notify", { kind = "Alarm", title = "Pego no flagra!", text = S.Actors.name(owner) .. " recuperou o ovo." })
							end
							S.Collection.checkAchievements(owner)
						end
					end
				end
			end
		end
	end)

	-- refresh protection flags on bases periodically (newcomer timer / recovery expiry)
	task.spawn(function()
		while true do
			task.wait(5)
			for id in S.Actors.all() do
				local m = S.Bases.modelOf(id)
				if m then
					local prot = Theft.protectionReason(id) ~= nil
					if m:GetAttribute("Protected") ~= prot then
						m:SetAttribute("Protected", prot)
						S.PlayerData.dirty(id)
					end
				end
			end
		end
	end)
end

return Theft
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000025"><Properties><string name="Name">Trails</string><ProtectedString name="Source"><![CDATA[--[[
	Trails — purchasable trails (GOLD) that multiply TREADMILL gains only, plus their visuals
	(Trail + light particles that follow the character) and the VIP aura/tag.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")
local Shared = ReplicatedStorage.Shared
local Balance = require(Shared.Config.Balance)
local Formulas = require(Shared.Util.Formulas)
local ModelFactory = require(Shared.Factory.ModelFactory)

local Trails = {}
local S

function Trails.init(sys)
	S = sys
end

local function rgb(a)
	return Color3.fromRGB(a[1], a[2], a[3])
end

function Trails.apply(id: number, character: Model?)
	character = character or S.Actors.character(id)
	if not character then
		return
	end
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return
	end
	for _, name in { "SAG_Trail", "SAG_TrailA0", "SAG_TrailA1", "SAG_TrailFX" } do
		local old = root:FindFirstChild(name)
		if old then
			old:Destroy()
		end
	end
	local p = S.PlayerData.get(id)
	local def = p and Formulas.trail(p.equippedTrail)
	if not def then
		return
	end
	local a0 = Instance.new("Attachment")
	a0.Name = "SAG_TrailA0"
	a0.Position = Vector3.new(0, 0.9, 0.4)
	a0.Parent = root
	local a1 = Instance.new("Attachment")
	a1.Name = "SAG_TrailA1"
	a1.Position = Vector3.new(0, -1.6, 0.4)
	a1.Parent = root
	local trail = Instance.new("Trail")
	trail.Name = "SAG_Trail"
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Color = ColorSequence.new(rgb(def.c1), rgb(def.c2))
	trail.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
	trail.Lifetime = 0.45
	trail.LightEmission = def.particles and 0.7 or 0.3
	trail.FaceCamera = true
	trail.WidthScale = NumberSequence.new(1, 0.2)
	trail.Parent = root
	if def.particles then
		local pe = ModelFactory.addParticles(root, rgb(def.c1), 6, { color2 = rgb(def.c2), size = 0.3, speed = 0.6, life = 0.7 })
		pe.Name = "SAG_TrailFX"
		pe.EmissionDirection = Enum.NormalId.Back
		CollectionService:AddTag(pe, "VFX")
	end
end

function Trails.applyVipAura(id: number, character: Model?)
	character = character or S.Actors.character(id)
	local head = character and character:FindFirstChild("Head")
	if not head or head:FindFirstChild("SAG_VipTag") then
		return
	end
	local tag = Instance.new("BillboardGui")
	tag.Name = "SAG_VipTag"
	tag.Size = UDim2.fromOffset(80, 26)
	tag.StudsOffset = Vector3.new(0, 2.6, 0)
	tag.AlwaysOnTop = false
	tag.MaxDistance = 80
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = "👑 VIP"
	label.TextScaled = true
	label.Font = Enum.Font.FredokaOne
	label.TextColor3 = Color3.fromRGB(255, 215, 70)
	label.TextStrokeTransparency = 0.3
	label.Parent = tag
	tag.Parent = head
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if root then
		local pe = ModelFactory.addParticles(root, Color3.fromRGB(255, 215, 80), 3, { size = 0.2, speed = 0.5 })
		pe.Name = "SAG_VipAura"
	end
end

function Trails.grant(id: number, trailId: string)
	local p = S.PlayerData.get(id)
	if not p or not Formulas.trail(trailId) then
		return
	end
	if not table.find(p.trailsOwned, trailId) then
		table.insert(p.trailsOwned, trailId)
	end
	p.equippedTrail = trailId
	Trails.apply(id)
	S.PlayerData.dirty(id)
	local player = S.Actors.player(id)
	if player then
		S.Net.fire(player, "Notify", { kind = "Trail", title = "Novo Trail!", text = Formulas.trail(trailId).name })
	end
end

function Trails.buy(id: number, trailId: any): (boolean, string?)
	if typeof(trailId) ~= "string" then
		return false, "Trail inválido"
	end
	local def = Formulas.trail(trailId)
	local p = S.PlayerData.get(id)
	if not def or not p or def.price < 0 then
		return false, "Trail indisponível"
	end
	if table.find(p.trailsOwned, trailId) then
		return false, "Você já possui este Trail"
	end
	if not S.Economy.spend(id, def.price) then
		return false, "GOLD insuficiente"
	end
	table.insert(p.trailsOwned, trailId)
	p.equippedTrail = trailId
	Trails.apply(id)
	S.PlayerData.dirty(id)
	S.Tutorial.progress(id, "BuyTrail")
	return true, def.name .. " equipado! (" .. def.mult .. "x treino)"
end

function Trails.equip(id: number, trailId: any): (boolean, string?)
	local p = S.PlayerData.get(id)
	if not p then
		return false
	end
	if trailId == nil or trailId == false then
		p.equippedTrail = nil
	elseif typeof(trailId) == "string" and table.find(p.trailsOwned, trailId) then
		p.equippedTrail = trailId
	else
		return false, "Você não possui este Trail"
	end
	Trails.apply(id)
	S.PlayerData.dirty(id)
	return true
end

-- Best affordable next trail (used by bots).
function Trails.nextTrail(id: number)
	local p = S.PlayerData.get(id)
	if not p then
		return nil
	end
	local best = Formulas.trail(p.equippedTrail)
	for _, t in Balance.trails do
		if not table.find(p.trailsOwned, t.id) and (not best or t.mult > best.mult) then
			return t
		end
	end
	return nil
end

function Trails.start()
	S.Net.handle("BuyTrail", function(player, payload)
		return Trails.buy(player.UserId, payload.id)
	end)
	S.Net.handle("EquipTrail", function(player, payload)
		return Trails.equip(player.UserId, payload.id)
	end)
	S.Actors.CharacterAdded:Connect(function(id, char)
		task.wait(0.2)
		Trails.apply(id, char)
		if S.Monetization.has(id, "VIP") then
			Trails.applyVipAura(id, char)
		end
	end)
end

return Trails
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000026"><Properties><string name="Name">Traps</string><ProtectedString name="Source"><![CDATA[--[[
	Traps — the divine snare. Each player owns 3 traps; placing one consumes it and it comes back
	when it is triggered, removed or expires (5 min, so no permanent blockades).

	• cannot be placed in safe areas: spawn plaza, shop plaza, OTHER players' bases, gates, nests
	• only triggers on characters CARRYING an egg who are not the owner (anti-grief)
	• holds the victim 4s (no egg drop: the owner gets a chance to catch them), then 8s immunity
	• Anubis/Forge Golem abilities grant immunity; Osiris/Nidhogg free you
]]

local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local Balance = require(Shared.Config.Balance)
local GameConfig = require(Shared.Config.GameConfig)
local ModelFactory = require(Shared.Factory.ModelFactory)
local Net = require(Shared.Util.Net)

local Traps = {}
local S
local T = Balance.traps
local W = GameConfig.World

local traps = {} -- [trapId] = {id, owner, position, model, expiresAt}
local nextId = 0
local holding = {} -- [actorId] = trapId currently holding them

function Traps.init(sys)
	S = sys
end

function Traps.activeCount(id: number): number
	local n = 0
	for _, t in traps do
		if t.owner == id then
			n += 1
		end
	end
	return n
end

function Traps.listFor(id: number)
	local out = {}
	for _, t in traps do
		if t.owner == id then
			table.insert(out, t)
		end
	end
	return out
end

-- Returns nil when allowed, otherwise the reason.
function Traps.placementBlocked(id: number, position: Vector3): string?
	if (position - W.SpawnPosition).Magnitude < 40 then
		return "Área segura (spawn)"
	end
	local plaza = Vector3.new(W.BaseOffsetX, 0, W.BaseRows[4])
	if (Vector3.new(position.X, 0, position.Z) - plaza).Magnitude < 45 then
		return "Área segura (loja)"
	end
	local inBase = S.Bases.baseAt(position)
	if inBase and inBase ~= S.Bases.baseIndexOf(id) then
		return "Não é possível colocar na base de outro jogador"
	end
	for b = 1, #Balance.biomes do
		local z0 = S.WorldBuilder.biomeZ(b)
		if math.abs(position.Z - z0) < 10 then
			return "Muito perto de um portão"
		end
	end
	for _, nest in S.Eggs.nests() do
		if (nest.cframe.Position - position).Magnitude < T.safeRadiusFromNest then
			return "Muito perto de um ninho"
		end
	end
	for _, t in traps do
		if (t.position - position).Magnitude < T.minSpacing then
			return "Muito perto de outra armadilha"
		end
	end
	return nil
end

function Traps.place(id: number): (boolean, string?)
	local pos = S.Actors.position(id)
	local p = S.PlayerData.get(id)
	if not pos or not p or not S.Actors.alive(id) then
		return false, "Indisponível"
	end
	if Traps.activeCount(id) >= T.maxActive then
		return false, "Máximo de " .. T.maxActive .. " armadilhas ativas"
	end
	local ground = Vector3.new(pos.X, pos.Y - 2.9, pos.Z)
	local reason = Traps.placementBlocked(id, ground)
	if reason then
		return false, reason
	end
	nextId += 1
	local model = ModelFactory.trap()
	model.Name = "Trap_" .. nextId
	model:PivotTo(CFrame.new(ground))
	model:SetAttribute("Owner", id)
	model:SetAttribute("OwnerName", S.Actors.name(id))
	model.Parent = Workspace.Runtime.Traps
	traps[nextId] = { id = nextId, owner = id, position = ground, model = model, expiresAt = os.clock() + T.lifetimeSeconds }
	S.PlayerData.dirty(id)
	S.Tutorial.progress(id, "Trap")
	return true, "Armadilha colocada (" .. Traps.activeCount(id) .. "/" .. T.maxActive .. ")"
end

local function removeTrap(trapId: number)
	local t = traps[trapId]
	if not t then
		return
	end
	traps[trapId] = nil
	if t.model then
		t.model:Destroy()
	end
	S.PlayerData.dirty(t.owner)
end

function Traps.remove(id: number, trapId: any): (boolean, string?)
	if trapId == nil then
		-- remove the nearest own trap
		local pos = S.Actors.position(id)
		local best, bd = nil, 20
		for tid, t in traps do
			if t.owner == id and pos and (t.position - pos).Magnitude < bd then
				best, bd = tid, (t.position - pos).Magnitude
			end
		end
		trapId = best
	end
	local t = typeof(trapId) == "number" and traps[trapId]
	if not t or t.owner ~= id then
		return false, "Nenhuma armadilha sua por perto"
	end
	removeTrap(trapId)
	return true, "Armadilha recolhida"
end

function Traps.releaseActor(id: number)
	holding[id] = nil
	local st = S.Actors.state(id)
	if st then
		st.trappedUntil = 0
	end
end

local function trigger(t, victim: number)
	local st = S.Actors.state(victim)
	if not st then
		return
	end
	local now = os.clock()
	st.trappedUntil = now + T.stunSeconds
	st.trapImmuneUntil = now + T.stunSeconds + T.immunitySeconds
	holding[victim] = t.id
	t.model:SetAttribute("Triggered", true)
	Net.fireAll("Effect", { kind = "TrapSnap", position = t.position })
	local vp = S.Actors.player(victim)
	if vp then
		Net.fire(vp, "Trapped", T.stunSeconds)
		Net.fire(vp, "Notify", { kind = "Alarm", title = "PRESO NUMA ARMADILHA!", text = "Armadilha de " .. S.Actors.name(t.owner) })
	end
	local op = S.Actors.player(t.owner)
	if op then
		Net.fire(op, "Notify", { kind = "Reward", title = "Sua armadilha pegou alguém!", text = S.Actors.name(victim) .. " está preso por " .. T.stunSeconds .. "s" })
	end
	-- trap returns to the owner after the snap animation
	local tid = t.id
	task.delay(1.2, function()
		removeTrap(tid)
	end)
end

function Traps.start()
	S.Net.handle("PlaceTrap", function(player)
		return Traps.place(player.UserId)
	end)
	S.Net.handle("RemoveTrap", function(player, payload)
		return Traps.remove(player.UserId, payload.id)
	end)
	S.Actors.Removed:Connect(function(id)
		for tid, t in traps do
			if t.owner == id then
				removeTrap(tid)
			end
		end
		holding[id] = nil
	end)
	task.spawn(function()
		while true do
			task.wait(0.15)
			local now = os.clock()
			for tid, t in traps do
				if now > t.expiresAt then
					removeTrap(tid)
				elseif not t.model:GetAttribute("Triggered") then
					for id in S.Actors.all() do
						if id ~= t.owner then
							local st = S.Actors.state(id)
							local pos = S.Actors.position(id)
							if st and pos and st.carry and st.trapImmuneUntil < now and not S.Actors.buff(id, "TrapWard")
								and (Vector3.new(pos.X, t.position.Y, pos.Z) - t.position).Magnitude < T.triggerRadius
								and math.abs(pos.Y - t.position.Y) < 6 then
								trigger(t, id)
								break
							end
						end
					end
				end
			end
		end
	end)
end

return Traps
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000027"><Properties><string name="Name">Tutorial</string><ProtectedString name="Source"><![CDATA[--[[
	Tutorial — short gameplay objectives (no wall of text). Progress is driven by REAL gameplay
	events reported by the systems (StealEgg, Deposit, Hatch, ...), in any order. The client shows
	the first unfinished objective with an arrow/beam to the target.
]]

local Tutorial = {}
local S

Tutorial.Steps = {
	{ key = "SeeBase", text = "Esta é a sua base! Seus ovos e criaturas ficam aqui." },
	{ key = "StealEgg", text = "Vá ao Bosque de Arcádia e ROUBE um ovo (segure E)." },
	{ key = "Deposit", text = "Volte para a sua base com o ovo para depositá-lo." },
	{ key = "Hatch", text = "Espere o ovo chocar na incubadora." },
	{ key = "Collect", text = "Pise na plataforma dourada para coletar o GOLD dos pets." },
	{ key = "Train", text = "Corra na esteira da sua base para ganhar Speed." },
	{ key = "BuyTrail", text = "Compre seu primeiro Trail (multiplica o treino)." },
	{ key = "UnlockBiome", text = "Alcance 150 Speed e desbloqueie a Costa do Mar Egeu." },
	{ key = "OpenIndex", text = "Abra o Index e veja todas as criaturas." },
	{ key = "RaidTip", text = "Dica: você pode roubar ovos que estão incubando em outras bases!" },
}
local valid = {}
for _, s in Tutorial.Steps do
	valid[s.key] = true
end

function Tutorial.init(sys)
	S = sys
end

function Tutorial.progress(id: number, key: string)
	local p = S.PlayerData.get(id)
	if not p or S.Actors.isBot(id) then
		return
	end
	p.tutDone = p.tutDone or {}
	if valid[key] and not p.tutDone[key] then
		p.tutDone[key] = true
		local n = 0
		for _, s in Tutorial.Steps do
			if p.tutDone[s.key] then
				n += 1
			end
		end
		p.tutorial = n + 1
		S.PlayerData.dirty(id)
	end
end

function Tutorial.start()
	S.Net.handle("TutorialStep", function(player, payload)
		-- only purely informational steps can be completed by the client
		local key = payload.key
		if key == "OpenIndex" or key == "RaidTip" or key == "SeeBase" then
			Tutorial.progress(player.UserId, key)
			return true
		end
		return false
	end)
	task.spawn(function()
		while true do
			task.wait(1)
			for id in S.Actors.all() do
				if not S.Actors.isBot(id) and S.Bases.isInOwnBase(id) then
					Tutorial.progress(id, "SeeBase")
				end
			end
		end
	end)
end

return Tutorial
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX0000002B"><Properties><string name="Name">World</string></Properties><Item class="ModuleScript" referent="RBX00000029"><Properties><string name="Name">BiomeDecor</string><ProtectedString name="Source"><![CDATA[--[[
	BiomeDecor — themed scenery for each of the 12 biomes. Everything is built from parts with a
	deterministic Random so the map is identical every time it is generated.
	Rule: nothing collidable is placed inside the avenue (|x| < AvenueWidth/2) so NPC navigation
	along the avenue never needs pathfinding.
]]

local ModelFactory = require(game:GetService("ReplicatedStorage").Shared.Factory.ModelFactory)

local C3 = Color3.fromRGB
local M = Enum.Material

local BiomeDecor = {}

local function part(parent, size, cf, color, mat, collide, shape)
	local p = Instance.new("Part")
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = mat or M.SmoothPlastic
	p.CanCollide = collide ~= false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if shape then
		p.Shape = shape
	end
	p.Parent = parent
	return p
end
BiomeDecor.part = part

local function wedge(parent, size, cf, color, mat)
	local w = Instance.new("WedgePart")
	w.Anchored = true
	w.Size = size
	w.CFrame = cf
	w.Color = color
	w.Material = mat or M.SmoothPlastic
	w.Parent = parent
	return w
end

-- ---------- reusable props ----------
local function tree(parent, pos: Vector3, rng: Random, trunkC, leafC, kind)
	local h = rng:NextNumber(8, 14)
	part(parent, Vector3.new(1.6, h, 1.6), CFrame.new(pos + Vector3.new(0, h / 2, 0)), trunkC, M.Wood)
	if kind == "pine" then
		for i = 0, 2 do
			local s = 9 - i * 2.5
			wedge(parent, Vector3.new(s, 4, s / 2), CFrame.new(pos + Vector3.new(0, h - 1 + i * 3, -s / 4)), leafC, M.Grass)
			wedge(parent, Vector3.new(s, 4, s / 2), CFrame.new(pos + Vector3.new(0, h - 1 + i * 3, s / 4)) * CFrame.Angles(0, math.pi, 0), leafC, M.Grass)
		end
	elseif kind == "palm" then
		for i = 1, 5 do
			local a = math.rad(i * 72)
			part(parent, Vector3.new(7, 0.4, 1.8), CFrame.new(pos + Vector3.new(math.cos(a) * 3, h, math.sin(a) * 3)) * CFrame.Angles(0, -a, math.rad(-15)), leafC, M.Grass, false)
		end
	else
		part(parent, Vector3.new(8, 8, 8), CFrame.new(pos + Vector3.new(0, h + 2, 0)), leafC, M.Grass, false, Enum.PartType.Ball)
		part(parent, Vector3.new(6, 6, 6), CFrame.new(pos + Vector3.new(2.5, h + 4, 1)), leafC:Lerp(C3(255, 255, 255), 0.08), M.Grass, false, Enum.PartType.Ball)
	end
end

local function column(parent, pos: Vector3, h: number, color, mat, broken)
	local height = broken and h * 0.6 or h
	part(parent, Vector3.new(height, 2.6, 2.6), CFrame.new(pos + Vector3.new(0, height / 2, 0)) * CFrame.Angles(0, 0, math.rad(90)), color, mat or M.Marble, true, Enum.PartType.Cylinder)
	part(parent, Vector3.new(3.4, 0.8, 3.4), CFrame.new(pos + Vector3.new(0, 0.4, 0)), color, mat or M.Marble)
	if not broken then
		part(parent, Vector3.new(3.4, 0.8, 3.4), CFrame.new(pos + Vector3.new(0, height + 0.4, 0)), color, mat or M.Marble)
	end
end
BiomeDecor.column = column

local function temple(parent, center: Vector3, w: number, d: number, h: number, color, roofColor, mat)
	part(parent, Vector3.new(w + 4, 2, d + 4), CFrame.new(center + Vector3.new(0, 1, 0)), color, mat or M.Marble)
	local cols = math.max(2, math.floor(w / 6))
	for i = 0, cols do
		local x = -w / 2 + i * (w / cols)
		column(parent, center + Vector3.new(x, 2, -d / 2), h, color, mat)
		column(parent, center + Vector3.new(x, 2, d / 2), h, color, mat)
	end
	part(parent, Vector3.new(w + 3, 1.5, d + 3), CFrame.new(center + Vector3.new(0, h + 3.5, 0)), color, mat or M.Marble)
	wedge(parent, Vector3.new(w + 3, 4, (d + 3) / 2), CFrame.new(center + Vector3.new(0, h + 6.25, -(d + 3) / 4)), roofColor, mat or M.Marble)
	wedge(parent, Vector3.new(w + 3, 4, (d + 3) / 2), CFrame.new(center + Vector3.new(0, h + 6.25, (d + 3) / 4)) * CFrame.Angles(0, math.pi, 0), roofColor, mat or M.Marble)
end
BiomeDecor.temple = temple

local function statue(parent, pos: Vector3, scale: number, color, mat, faceTowardX: boolean?)
	part(parent, Vector3.new(5, 3, 5), CFrame.new(pos + Vector3.new(0, 1.5, 0)), C3(200, 195, 185), M.Marble)
	local body = Instance.new("Model")
	body.Name = "Statue"
	local s = scale
	part(body, Vector3.new(2 * s, 3 * s, 1.2 * s), CFrame.new(pos + Vector3.new(0, 3 + 2.6 * s, 0)), color, mat)
	part(body, Vector3.new(0.8 * s, 2.6 * s, 0.8 * s), CFrame.new(pos + Vector3.new(-0.55 * s, 3 + 0.65 * s, 0)), color, mat)
	part(body, Vector3.new(0.8 * s, 2.6 * s, 0.8 * s), CFrame.new(pos + Vector3.new(0.55 * s, 3 + 0.65 * s, 0)), color, mat)
	part(body, Vector3.new(1.6 * s, 1.6 * s, 1.6 * s), CFrame.new(pos + Vector3.new(0, 3 + 4.9 * s, 0)), color, mat, true, Enum.PartType.Ball)
	part(body, Vector3.new(0.6 * s, 3.4 * s, 0.6 * s), CFrame.new(pos + Vector3.new(1.4 * s, 3 + 3.4 * s, 0)) * CFrame.Angles(0, 0, math.rad(-35)), color, mat)
	body.Parent = parent
	return body
end
BiomeDecor.statue = statue

local function rock(parent, pos: Vector3, rng: Random, color, mat)
	local s = rng:NextNumber(3, 8)
	part(parent, Vector3.new(s, s * 0.7, s * 0.9), CFrame.new(pos + Vector3.new(0, s * 0.3, 0)) * CFrame.Angles(rng:NextNumber(-0.3, 0.3), rng:NextNumber(0, 6), rng:NextNumber(-0.3, 0.3)), color, mat or M.Slate)
end

local function crystal(parent, pos: Vector3, rng: Random, color)
	local last
	for _ = 1, 3 do
		local h = rng:NextNumber(4, 10)
		local p = wedge(parent, Vector3.new(1.4, h, 1.4), CFrame.new(pos + Vector3.new(rng:NextNumber(-2, 2), h / 2, rng:NextNumber(-2, 2))) * CFrame.Angles(0, rng:NextNumber(0, 6), rng:NextNumber(-0.25, 0.25)), color, M.Neon)
		p.Transparency = 0.15
		p.CanCollide = false
		last = p
	end
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = 14
	light.Brightness = 1
	light.Parent = last
end

local function pyramid(parent, center: Vector3, size: number, color)
	local layers = 6
	for i = 0, layers - 1 do
		local s = size * (1 - i / layers)
		part(parent, Vector3.new(s, size / layers, s), CFrame.new(center + Vector3.new(0, (i + 0.5) * size / layers, 0)), color, M.Sandstone)
	end
	part(parent, Vector3.new(size / layers, size / layers, size / layers), CFrame.new(center + Vector3.new(0, size + size / layers * 0.5, 0)), C3(255, 210, 80), M.Metal)
end

local function obelisk(parent, pos: Vector3, h: number, color)
	part(parent, Vector3.new(3, h, 3), CFrame.new(pos + Vector3.new(0, h / 2, 0)), color, M.Sandstone)
	wedge(parent, Vector3.new(3, 3, 1.5), CFrame.new(pos + Vector3.new(0, h + 1.5, -0.75)), C3(255, 210, 80), M.Metal)
	wedge(parent, Vector3.new(3, 3, 1.5), CFrame.new(pos + Vector3.new(0, h + 1.5, 0.75)) * CFrame.Angles(0, math.pi, 0), C3(255, 210, 80), M.Metal)
end

local function hut(parent, pos: Vector3, rot: number)
	local cf = CFrame.new(pos) * CFrame.Angles(0, rot, 0)
	part(parent, Vector3.new(14, 7, 10), cf * CFrame.new(0, 3.5, 0), C3(120, 80, 50), M.WoodPlanks)
	wedge(parent, Vector3.new(15, 5, 6), cf * CFrame.new(0, 9.5, -3), C3(90, 60, 40), M.Wood)
	wedge(parent, Vector3.new(15, 5, 6), cf * CFrame.new(0, 9.5, 3) * CFrame.Angles(0, math.pi, 0), C3(90, 60, 40), M.Wood)
	part(parent, Vector3.new(3, 5, 0.4), cf * CFrame.new(0, 2.5, -5.1), C3(60, 40, 25), M.Wood)
end

local function water(parent, cf: CFrame, size: Vector3, color)
	local w = part(parent, size, cf, color, M.Glass, false)
	w.Transparency = 0.35
	w.Reflectance = 0.1
	w.CanQuery = false
	return w
end

local function cloud(parent, pos: Vector3, rng: Random)
	for i = 1, 4 do
		local s = rng:NextNumber(8, 14)
		local c = part(parent, Vector3.new(s, s * 0.6, s), CFrame.new(pos + Vector3.new(rng:NextNumber(-8, 8), rng:NextNumber(-1, 2), rng:NextNumber(-6, 6))), C3(255, 255, 255), M.SmoothPlastic, false, Enum.PartType.Ball)
		c.Transparency = 0.15
	end
end

local function torch(parent, pos: Vector3, color)
	part(parent, Vector3.new(0.6, 5, 0.6), CFrame.new(pos + Vector3.new(0, 2.5, 0)), C3(80, 60, 40), M.Wood)
	local f = part(parent, Vector3.new(1.2, 1.2, 1.2), CFrame.new(pos + Vector3.new(0, 5.4, 0)), color, M.Neon, false, Enum.PartType.Ball)
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = 16
	l.Brightness = 1.5
	l.Parent = f
	ModelFactory.addParticles(f, color, 5, { speed = 2, size = 0.3 })
end
BiomeDecor.torch = torch

-- Side positions avoid the avenue. side = -1 (left) or 1 (right)
local function sidePos(rng: Random, z0: number, length: number, minX: number, maxX: number)
	local side = rng:NextNumber() < 0.5 and -1 or 1
	return Vector3.new(side * rng:NextNumber(minX, maxX), 0, z0 + rng:NextNumber(8, length - 8))
end

-- ---------- per-biome builders ----------
-- ctx = {folder, z0, length, width, avenueHalf, rng}
local Builders = {}

Builders[1] = function(ctx) -- Arcadia
	local f, rng = ctx.folder, ctx.rng
	for _ = 1, 26 do
		tree(f, sidePos(rng, ctx.z0, ctx.length, ctx.avenueHalf + 8, ctx.width / 2 - 6), rng, C3(110, 75, 45), C3(90 + rng:NextInteger(0, 40), 170, 70))
	end
	for i = 0, 4 do
		column(f, Vector3.new(-ctx.avenueHalf - 4, 0, ctx.z0 + 25 + i * 45), 12, C3(235, 230, 215), M.Marble, i % 2 == 1)
		column(f, Vector3.new(ctx.avenueHalf + 4, 0, ctx.z0 + 25 + i * 45), 12, C3(235, 230, 215), M.Marble, i % 2 == 0)
	end
	temple(f, Vector3.new(-70, 0, ctx.z0 + 160), 18, 12, 10, C3(240, 235, 220), C3(200, 120, 90))
	-- fountain
	local center = Vector3.new(68, 0, ctx.z0 + 70)
	part(f, Vector3.new(2, 16, 16), CFrame.new(center + Vector3.new(0, 1, 0)) * CFrame.Angles(0, 0, math.rad(90)), C3(230, 225, 210), M.Marble, true, Enum.PartType.Cylinder)
	water(f, CFrame.new(center + Vector3.new(0, 2.1, 0)) * CFrame.Angles(0, 0, math.rad(90)), Vector3.new(0.4, 14, 14), C3(90, 180, 255)).Shape = Enum.PartType.Cylinder
	statue(f, center + Vector3.new(0, 2, 0), 0.8, C3(235, 230, 220), M.Marble)
end

Builders[2] = function(ctx) -- Aegean coast
	local f, rng = ctx.folder, ctx.rng
	water(f, CFrame.new(-ctx.width / 2 + 25, 0.3, ctx.z0 + ctx.length / 2), Vector3.new(50, 1, ctx.length), C3(40, 140, 220))
	water(f, CFrame.new(ctx.width / 2 - 25, 0.3, ctx.z0 + ctx.length / 2), Vector3.new(50, 1, ctx.length), C3(40, 140, 220))
	for i = 0, 5 do
		local z = ctx.z0 + 20 + i * 38
		part(f, Vector3.new(6, 1, 30), CFrame.new(-ctx.avenueHalf - 12, 0.6, z), C3(240, 220, 170), M.Sand, true)
		part(f, Vector3.new(6, 1, 30), CFrame.new(ctx.avenueHalf + 12, 0.6, z), C3(240, 220, 170), M.Sand, true)
	end
	temple(f, Vector3.new(66, 0, ctx.z0 + 120), 16, 12, 11, C3(230, 240, 250), C3(60, 120, 200))
	statue(f, Vector3.new(-62, 0, ctx.z0 + 60), 1.6, C3(60, 130, 200), M.Marble)
	for _ = 1, 10 do
		column(f, Vector3.new(-ctx.width / 2 + rng:NextNumber(8, 40), -2, ctx.z0 + rng:NextNumber(10, ctx.length - 10)), 9, C3(200, 220, 230), M.Marble, true)
	end
	for _ = 1, 12 do
		rock(f, sidePos(rng, ctx.z0, ctx.length, ctx.avenueHalf + 20, ctx.width / 2 - 4), rng, C3(160, 150, 130), M.Slate)
	end
end

Builders[3] = function(ctx) -- Labyrinth
	local f, rng = ctx.folder, ctx.rng
	local wallC = C3(150, 120, 90)
	-- maze walls on both sides (avenue stays open, nests sit in maze pockets)
	for side = -1, 1, 2 do
		for i = 0, 7 do
			local z = ctx.z0 + 15 + i * 28
			local len = rng:NextNumber(18, 34)
			part(f, Vector3.new(2, 12, len), CFrame.new(side * (ctx.avenueHalf + rng:NextNumber(26, 62)), 6, z), wallC, M.Cobblestone)
			part(f, Vector3.new(rng:NextNumber(12, 28), 12, 2), CFrame.new(side * (ctx.avenueHalf + rng:NextNumber(32, 64)), 6, z + rng:NextNumber(-8, 8)), wallC, M.Cobblestone)
		end
		part(f, Vector3.new(2, 14, ctx.length), CFrame.new(side * (ctx.width / 2 - 2), 7, ctx.z0 + ctx.length / 2), wallC:Lerp(C3(0, 0, 0), 0.2), M.Cobblestone)
	end
	for i = 0, 9 do
		torch(f, Vector3.new((i % 2 == 0 and -1 or 1) * (ctx.avenueHalf + 2), 0, ctx.z0 + 12 + i * 23), C3(255, 150, 60))
	end
	-- bull skull gate statue
	statue(f, Vector3.new(0, 0, ctx.z0 + ctx.length - 6) + Vector3.new(ctx.avenueHalf + 10, 0, 0), 1.4, C3(120, 80, 50), M.Slate)
end

Builders[4] = function(ctx) -- Olympus
	local f, rng = ctx.folder, ctx.rng
	for _ = 1, 16 do
		cloud(f, Vector3.new((rng:NextNumber() < 0.5 and -1 or 1) * rng:NextNumber(40, 95), rng:NextNumber(18, 40), ctx.z0 + rng:NextNumber(0, ctx.length)), rng)
	end
	temple(f, Vector3.new(-62, 0, ctx.z0 + 90), 26, 16, 16, C3(250, 245, 235), C3(255, 205, 80))
	temple(f, Vector3.new(62, 0, ctx.z0 + 170), 22, 14, 14, C3(250, 245, 235), C3(255, 205, 80))
	for i = 0, 3 do
		statue(f, Vector3.new((i % 2 == 0 and -1 or 1) * (ctx.avenueHalf + 9), 0, ctx.z0 + 35 + i * 55), 1.5, C3(255, 210, 90), M.Metal)
	end
	for i = 0, 5 do
		local bolt = part(f, Vector3.new(1, 22, 1), CFrame.new((i % 2 == 0 and -80 or 80), 30, ctx.z0 + 20 + i * 40) * CFrame.Angles(0, 0, math.rad(15)), C3(255, 250, 150), M.Neon, false)
		bolt.Transparency = 0.2
		local l = Instance.new("PointLight")
		l.Range = 30
		l.Color = C3(255, 245, 160)
		l.Parent = bolt
	end
end

Builders[5] = function(ctx) -- Midgard
	local f, rng = ctx.folder, ctx.rng
	for _ = 1, 30 do
		tree(f, sidePos(rng, ctx.z0, ctx.length, ctx.avenueHalf + 8, ctx.width / 2 - 6), rng, C3(90, 60, 40), C3(40, 100, 60), "pine")
	end
	hut(f, Vector3.new(-62, 0, ctx.z0 + 60), math.rad(90))
	hut(f, Vector3.new(64, 0, ctx.z0 + 130), math.rad(-90))
	hut(f, Vector3.new(-66, 0, ctx.z0 + 190), math.rad(90))
	for i = 0, 5 do
		local stone = part(f, Vector3.new(3, 8, 1.5), CFrame.new((i % 2 == 0 and -1 or 1) * (ctx.avenueHalf + 6), 4, ctx.z0 + 20 + i * 38), C3(120, 120, 125), M.Slate)
		local rune = part(f, Vector3.new(1.4, 3, 0.2), stone.CFrame * CFrame.new(0, 1, 0.8), C3(120, 210, 255), M.Neon, false)
		rune.Transparency = 0.1
	end
	for _ = 1, 8 do
		rock(f, sidePos(rng, ctx.z0, ctx.length, ctx.avenueHalf + 20, ctx.width / 2 - 4), rng, C3(110, 110, 105), M.Slate)
	end
end

Builders[6] = function(ctx) -- Jotunheim
	local f, rng = ctx.folder, ctx.rng
	for side = -1, 1, 2 do
		for i = 0, 5 do
			local h = rng:NextNumber(30, 60)
			wedge(f, Vector3.new(30, h, 24), CFrame.new(side * (ctx.width / 2 - 12), h / 2, ctx.z0 + 20 + i * 40) * CFrame.Angles(0, side > 0 and math.rad(-90) or math.rad(90), 0), C3(220, 235, 250), M.Snow)
		end
	end
	water(f, CFrame.new(-50, 0.25, ctx.z0 + 120), Vector3.new(36, 0.6, 60), C3(170, 220, 255)).Material = M.Ice
	water(f, CFrame.new(52, 0.25, ctx.z0 + 70), Vector3.new(30, 0.6, 40), C3(170, 220, 255)).Material = M.Ice
	for _ = 1, 14 do
		tree(f, sidePos(rng, ctx.z0, ctx.length, ctx.avenueHalf + 10, ctx.width / 2 - 30), rng, C3(80, 60, 50), C3(220, 240, 250), "pine")
	end
	for _ = 1, 6 do
		crystal(f, sidePos(rng, ctx.z0, ctx.length, ctx.avenueHalf + 15, ctx.width / 2 - 30), rng, C3(150, 220, 255))
	end
	statue(f, Vector3.new(ctx.avenueHalf + 18, 0, ctx.z0 + 200), 3, C3(170, 210, 240), M.Ice)
end

Builders[7] = function(ctx) -- Nidavellir
	local f, rng = ctx.folder, ctx.rng
	for side = -1, 1, 2 do
		part(f, Vector3.new(30, 50, ctx.length), CFrame.new(side * (ctx.width / 2 + 8), 25, ctx.z0 + ctx.length / 2), C3(60, 50, 50), M.Basalt)
		local lava = part(f, Vector3.new(14, 0.6, ctx.length - 20), CFrame.new(side * (ctx.avenueHalf + 52), 0.2, ctx.z0 + ctx.length / 2), C3(255, 100, 20), M.Neon, false)
		lava.CanQuery = false
	end
	for i = 0, 3 do
		local x = (i % 2 == 0 and -1 or 1) * 62
		local z = ctx.z0 + 30 + i * 55
		part(f, Vector3.new(14, 8, 10), CFrame.new(x, 4, z), C3(80, 70, 70), M.Brick)
		local fire = part(f, Vector3.new(6, 3, 4), CFrame.new(x, 9.5, z), C3(255, 120, 30), M.Neon, false)
		ModelFactory.addParticles(fire, C3(255, 140, 40), 8, { speed = 4, size = 0.4 })
		part(f, Vector3.new(4, 3, 2.5), CFrame.new(x + 9, 1.5, z), C3(90, 90, 100), M.Metal) -- anvil
	end
	for _ = 1, 10 do
		crystal(f, sidePos(rng, ctx.z0, ctx.length, ctx.avenueHalf + 8, ctx.width / 2 - 10), rng, (rng:NextNumber() < 0.5) and C3(255, 120, 60) or C3(120, 220, 255))
	end
end

Builders[8] = function(ctx) -- Asgard
	local f, rng = ctx.folder, ctx.rng
	local gold = C3(255, 205, 70)
	for side = -1, 1, 2 do
		for i = 0, 2 do
			local x = side * rng:NextNumber(55, 80)
			local z = ctx.z0 + 40 + i * 75
			part(f, Vector3.new(24, 26, 20), CFrame.new(x, 13, z), C3(240, 230, 200), M.Marble)
			part(f, Vector3.new(26, 3, 22), CFrame.new(x, 27.5, z), gold, M.Metal)
			wedge(f, Vector3.new(26, 10, 11), CFrame.new(x, 34, z - 5.5), gold, M.Metal)
			wedge(f, Vector3.new(26, 10, 11), CFrame.new(x, 34, z + 5.5) * CFrame.Angles(0, math.pi, 0), gold, M.Metal)
		end
	end
	-- Bifrost bridge (decorative, above avenue)
	for i = 0, 11 do
		local seg = part(f, Vector3.new(ctx.avenueHalf * 2 + 20, 1, 4), CFrame.new(0, 26, ctx.z0 + 60 + i * 4), Color3.fromHSV(i / 12, 0.7, 1), M.Neon, false)
		seg.Transparency = 0.3
	end
	for i = 0, 4 do
		statue(f, Vector3.new((i % 2 == 0 and -1 or 1) * (ctx.avenueHalf + 8), 0, ctx.z0 + 30 + i * 45), 1.8, gold, M.Metal)
	end
end

Builders[9] = function(ctx) -- Nile
	local f, rng = ctx.folder, ctx.rng
	water(f, CFrame.new(-60, 0.3, ctx.z0 + ctx.length / 2), Vector3.new(26, 0.8, ctx.length), C3(40, 160, 170))
	for _ = 1, 24 do
		tree(f, sidePos(rng, ctx.z0, ctx.length, ctx.avenueHalf + 6, ctx.width / 2 - 6), rng, C3(150, 110, 60), C3(80, 170, 70), "palm")
	end
	for i = 0, 2 do
		part(f, Vector3.new(12, 6, 12), CFrame.new(62, 3, ctx.z0 + 40 + i * 70), C3(220, 190, 140), M.Sandstone)
		part(f, Vector3.new(13, 1, 13), CFrame.new(62, 6.5, ctx.z0 + 40 + i * 70), C3(200, 170, 120), M.Sandstone)
	end
	statue(f, Vector3.new(ctx.avenueHalf + 10, 0, ctx.z0 + 120), 1.6, C3(220, 190, 130), M.Sandstone)
end

Builders[10] = function(ctx) -- Necropolis
	local f, rng = ctx.folder, ctx.rng
	pyramid(f, Vector3.new(-70, 0, ctx.z0 + 80), 44, C3(215, 185, 125))
	pyramid(f, Vector3.new(72, 0, ctx.z0 + 170), 38, C3(205, 175, 115))
	-- sphinx
	local sx = Vector3.new(64, 0, ctx.z0 + 50)
	part(f, Vector3.new(10, 8, 26), CFrame.new(sx + Vector3.new(0, 4, 0)), C3(215, 185, 125), M.Sandstone)
	part(f, Vector3.new(8, 9, 8), CFrame.new(sx + Vector3.new(0, 11, -11)), C3(215, 185, 125), M.Sandstone)
	part(f, Vector3.new(10, 6, 2), CFrame.new(sx + Vector3.new(0, 11, -9)), C3(60, 90, 160), M.Fabric)
	for i = 0, 7 do
		part(f, Vector3.new(4, 3, 6), CFrame.new((i % 2 == 0 and -1 or 1) * (ctx.avenueHalf + rng:NextNumber(10, 40)), 1.5, ctx.z0 + 15 + i * 27), C3(120, 110, 100), M.Slate) -- tombs
	end
	for i = 0, 3 do
		local portal = part(f, Vector3.new(1, 14, 10), CFrame.new((i % 2 == 0 and -1 or 1) * (ctx.width / 2 - 10), 7, ctx.z0 + 30 + i * 55), C3(140, 90, 255), M.Neon, false)
		portal.Transparency = 0.4
	end
end

Builders[11] = function(ctx) -- Duat
	local f, rng = ctx.folder, ctx.rng
	for side = -1, 1, 2 do
		local river = water(f, CFrame.new(side * (ctx.avenueHalf + 26), 0.3, ctx.z0 + ctx.length / 2), Vector3.new(16, 0.8, ctx.length), C3(60, 30, 110))
		river.Material = M.Neon
		river.Transparency = 0.5
		for i = 0, 3 do
			local h = rng:NextNumber(30, 50)
			part(f, Vector3.new(10, h, 10), CFrame.new(side * (ctx.width / 2 - 14), h / 2, ctx.z0 + 25 + i * 60), C3(40, 30, 55), M.Basalt)
			local eye = part(f, Vector3.new(6, 3, 0.5), CFrame.new(side * (ctx.width / 2 - 19.3), h - 6, ctx.z0 + 25 + i * 60), C3(80, 220, 255), M.Neon, false)
			eye.CFrame = eye.CFrame * CFrame.Angles(0, math.rad(90), 0)
		end
	end
	for _ = 1, 10 do
		crystal(f, sidePos(rng, ctx.z0, ctx.length, ctx.avenueHalf + 40, ctx.width / 2 - 22), rng, C3(160, 90, 255))
	end
end

Builders[12] = function(ctx) -- Solar temple
	local f, rng = ctx.folder, ctx.rng
	local gold = C3(255, 200, 60)
	for i = 0, 7 do
		obelisk(f, Vector3.new((i % 2 == 0 and -1 or 1) * (ctx.avenueHalf + 6), 0, ctx.z0 + 15 + i * 28), 22, C3(230, 200, 140))
	end
	-- giant temple at the end
	local tz = ctx.z0 + ctx.length - 30
	part(f, Vector3.new(ctx.width - 20, 4, 40), CFrame.new(0, 2, tz), C3(230, 200, 140), M.Sandstone)
	for i = -4, 4 do
		if math.abs(i) > 1 then
			column(f, Vector3.new(i * 10, 4, tz - 16), 26, gold, M.Metal)
		end
	end
	part(f, Vector3.new(ctx.width - 20, 4, 40), CFrame.new(0, 32, tz), gold, M.Metal)
	local sun = part(f, Vector3.new(2, 40, 40), CFrame.new(0, 60, tz + 10) * CFrame.Angles(0, math.rad(90), 0), C3(255, 180, 40), M.Neon, false, Enum.PartType.Cylinder)
	local light = Instance.new("PointLight")
	light.Range = 60
	light.Brightness = 3
	light.Color = C3(255, 200, 100)
	light.Parent = sun
	for i = 0, 5 do
		local ray = part(f, Vector3.new(2, 70, 2), CFrame.new(0, 60, tz + 10) * CFrame.Angles(0, 0, math.rad(i * 30)), C3(255, 220, 120), M.Neon, false)
		ray.Transparency = 0.6
	end
	for _ = 1, 8 do
		local portalPos = sidePos(rng, ctx.z0, ctx.length - 50, ctx.avenueHalf + 30, ctx.width / 2 - 20)
		local ring = part(f, Vector3.new(1, 12, 12), CFrame.new(portalPos + Vector3.new(0, 7, 0)) * CFrame.Angles(0, math.rad(90), 0), C3(255, 230, 150), M.Neon, false, Enum.PartType.Cylinder)
		ring.Transparency = 0.5
	end
end

function BiomeDecor.build(biomeId: number, ctx)
	local builder = Builders[biomeId]
	if builder then
		builder(ctx)
	end
end

return BiomeDecor
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000002A"><Properties><string name="Name">WorldBuilder</string><ProtectedString name="Source"><![CDATA[--[[
	WorldBuilder — generates the whole STEAL AN GOD map:
	  hub (spawn, 7 base plots, shop plaza, ranking board), the long avenue and the 12 biomes with
	  gates, nests, guardian patrol points and themed scenery.

	Runs automatically on server start when Workspace.Map is missing (or has an older build
	version). It can also be run in EDIT mode from the Studio command bar so the map is saved
	inside the place file — see tools/StudioWipeAndBuild.luau.
]]

local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Balance = require(Shared.Config.Balance)
local ModelFactory = require(Shared.Factory.ModelFactory)
local BiomeDecor = require(script.Parent.BiomeDecor)

local C3 = Color3.fromRGB
local M = Enum.Material
local W = GameConfig.World

local WorldBuilder = {}
WorldBuilder.BUILD_VERSION = 3

local part = BiomeDecor.part

local BIOME_FLOOR = {
	{ C3(110, 175, 80), M.Grass }, { C3(235, 215, 165), M.Sand }, { C3(130, 115, 100), M.Cobblestone },
	{ C3(245, 245, 250), M.Marble }, { C3(90, 140, 70), M.Grass }, { C3(235, 245, 255), M.Snow },
	{ C3(55, 45, 45), M.Basalt }, { C3(240, 225, 180), M.Marble }, { C3(225, 200, 140), M.Sand },
	{ C3(205, 175, 120), M.Sandstone }, { C3(45, 30, 65), M.Slate }, { C3(240, 205, 120), M.Sandstone },
}
local AVENUE_COLOR = {
	C3(200, 190, 170), C3(215, 205, 180), C3(150, 140, 125), C3(255, 235, 170), C3(130, 120, 110), C3(200, 220, 235),
	C3(90, 75, 70), C3(255, 215, 110), C3(210, 190, 150), C3(180, 160, 120), C3(80, 60, 110), C3(255, 215, 120),
}

function WorldBuilder.biomeZ(biomeId: number): (number, number)
	local z0 = W.HubLength + (biomeId - 1) * W.BiomeLength
	return z0, z0 + W.BiomeLength
end

function WorldBuilder.biomeAt(z: number): number
	if z < W.HubLength then
		return 0
	end
	return math.clamp(math.floor((z - W.HubLength) / W.BiomeLength) + 1, 1, #Balance.biomes)
end

local function folder(name: string, parent: Instance): Folder
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

local function marker(name: string, cf: CFrame, parent: Instance, size: Vector3?)
	local p = part(parent, size or Vector3.new(1, 1, 1), cf, C3(255, 255, 255), M.SmoothPlastic, false)
	p.Name = name
	p.Transparency = 1
	p.CanQuery = false
	p.CanTouch = false
	return p
end

local function sign(parentPart: BasePart, face: Enum.NormalId, text: string, color: Color3, textSize: number?)
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 20
	gui.LightInfluence = 0
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = color
	label.TextScaled = textSize == nil
	label.TextSize = textSize or 14
	label.Font = GameConfig.Theme.Font
	label.TextStrokeTransparency = 0.2
	label.Name = "Label"
	label.Parent = gui
	gui.Parent = parentPart
	return label
end
WorldBuilder.sign = sign

-- ===================== LIGHTING =====================
local function setupLighting()
	Lighting.ClockTime = 14
	Lighting.Brightness = 2.2
	Lighting.Ambient = C3(110, 110, 130)
	Lighting.OutdoorAmbient = C3(140, 140, 160)
	Lighting.EnvironmentDiffuseScale = 0.5
	Lighting.EnvironmentSpecularScale = 0.5
	Lighting.GlobalShadows = true
	if not Lighting:FindFirstChildOfClass("Atmosphere") then
		local a = Instance.new("Atmosphere")
		a.Density = 0.28
		a.Offset = 0.1
		a.Color = C3(200, 215, 240)
		a.Decay = C3(110, 120, 170)
		a.Glare = 0.2
		a.Haze = 1.2
		a.Parent = Lighting
	end
	if not Lighting:FindFirstChild("SAG_Bloom") then
		local b = Instance.new("BloomEffect")
		b.Name = "SAG_Bloom"
		b.Intensity = 0.6
		b.Size = 28
		b.Threshold = 1.6
		b.Parent = Lighting
		local cc = Instance.new("ColorCorrectionEffect")
		cc.Name = "SAG_Color"
		cc.Saturation = 0.12
		cc.Contrast = 0.05
		cc.Parent = Lighting
		local sr = Instance.new("SunRaysEffect")
		sr.Name = "SAG_SunRays"
		sr.Intensity = 0.04
		sr.Parent = Lighting
	end
end

-- ===================== HUB =====================
local function buildHub(map: Folder)
	local hub = folder("Hub", map)
	local floor = part(hub, Vector3.new(W.HubWidth, 2, W.HubLength + 40), CFrame.new(0, -1, (W.HubLength - 40) / 2), C3(120, 170, 95), M.Grass)
	floor.Name = "HubFloor"
	-- plaza tiles around avenue
	local plaza = part(hub, Vector3.new(W.AvenueWidth + 20, 0.2, W.HubLength + 40), CFrame.new(0, 0.1, (W.HubLength - 40) / 2), C3(225, 215, 195), M.Pavement)
	plaza.Name = "Plaza"

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "MainSpawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(16, 1, 16)
	spawn.CFrame = CFrame.new(W.SpawnPosition - Vector3.new(0, 4.5, 0))
	spawn.Color = C3(255, 210, 90)
	spawn.Material = M.Marble
	spawn.Duration = 0
	spawn.Neutral = true
	spawn.Parent = hub

	-- colossal statue behind spawn (outside the avenue)
	local back = Vector3.new(0, 0, -28)
	part(hub, Vector3.new(30, 4, 14), CFrame.new(back + Vector3.new(0, 2, 0)), C3(235, 230, 220), M.Marble)
	local st = BiomeDecor.statue(hub, back + Vector3.new(0, 4, 0), 3, C3(255, 210, 90), M.Metal)
	st.Name = "PantheonStatue"
	local title = part(hub, Vector3.new(44, 10, 1), CFrame.new(0, 34, -36), C3(30, 25, 60), M.SmoothPlastic, false)
	title.Name = "TitleBoard"
	sign(title, Enum.NormalId.Back, "STEAL AN GOD", GameConfig.Theme.Gold)
	sign(title, Enum.NormalId.Front, "STEAL AN GOD", GameConfig.Theme.Gold)

	-- lamp posts along the hub walkway
	for i = 0, 7 do
		local z = 20 + i * 42
		BiomeDecor.torch(hub, Vector3.new(-W.AvenueWidth / 2 - 3, 0, z), C3(255, 220, 140))
		BiomeDecor.torch(hub, Vector3.new(W.AvenueWidth / 2 + 3, 0, z), C3(255, 220, 140))
	end

	-- hub boundary walls
	local wallH = 40
	for side = -1, 1, 2 do
		local wall = part(hub, Vector3.new(2, wallH, W.HubLength + 40), CFrame.new(side * W.HubWidth / 2, wallH / 2, (W.HubLength - 40) / 2), C3(255, 255, 255), M.SmoothPlastic)
		wall.Transparency = 1
		wall.Name = "Boundary"
		-- connector between hub width and biome width
		local conn = part(hub, Vector3.new((W.HubWidth - W.BiomeWidth) / 2, wallH, 2), CFrame.new(side * (W.BiomeWidth / 2 + (W.HubWidth - W.BiomeWidth) / 4), wallH / 2, W.HubLength), C3(255, 255, 255), M.SmoothPlastic)
		conn.Transparency = 1
		conn.Name = "Boundary"
		-- decorative hedge
		part(hub, Vector3.new(4, 6, W.HubLength + 40), CFrame.new(side * (W.HubWidth / 2 - 2), 3, (W.HubLength - 40) / 2), C3(70, 130, 60), M.Grass)
	end
	local backWall = part(hub, Vector3.new(W.HubWidth, wallH, 2), CFrame.new(0, wallH / 2, -40), C3(255, 255, 255), M.SmoothPlastic)
	backWall.Transparency = 1
	backWall.Name = "Boundary"

	return hub
end

-- ===================== SHOP PLAZA (kiosks) =====================
local KIOSKS = {
	{ id = "Shop", label = "LOJA DIVINA", color = C3(255, 200, 60), offset = Vector3.new(-14, 0, -26) },
	{ id = "Trails", label = "TRAILS", color = C3(150, 120, 255), offset = Vector3.new(14, 0, -26) },
	{ id = "Upgrades", label = "MELHORIAS", color = C3(90, 200, 255), offset = Vector3.new(-14, 0, 0) },
	{ id = "Index", label = "INDEX", color = C3(90, 220, 140), offset = Vector3.new(14, 0, 0) },
	{ id = "Rewards", label = "RECOMPENSAS", color = C3(255, 120, 160), offset = Vector3.new(0, 0, 24) },
}

local function buildPlaza(map: Folder)
	local plaza = folder("ShopPlaza", map)
	local center = Vector3.new(W.BaseOffsetX, 0, W.BaseRows[4])
	part(plaza, Vector3.new(70, 0.4, 76), CFrame.new(center + Vector3.new(0, 0.2, 0)), C3(240, 230, 205), M.Marble).Name = "PlazaFloor"
	for _, k in KIOSKS do
		local pos = center + k.offset
		local kiosk = Instance.new("Model")
		kiosk.Name = "Kiosk_" .. k.id
		local base = part(kiosk, Vector3.new(10, 3, 6), CFrame.new(pos + Vector3.new(0, 1.5, 0)), C3(60, 50, 90), M.Marble)
		part(kiosk, Vector3.new(10.6, 0.6, 6.6), CFrame.new(pos + Vector3.new(0, 3.2, 0)), k.color, M.Metal)
		BiomeDecor.column(kiosk, pos + Vector3.new(-4.5, 3.5, 2.5), 7, C3(240, 235, 220), M.Marble)
		BiomeDecor.column(kiosk, pos + Vector3.new(4.5, 3.5, 2.5), 7, C3(240, 235, 220), M.Marble)
		local board = part(kiosk, Vector3.new(11, 3.5, 0.6), CFrame.new(pos + Vector3.new(0, 12.5, 2.5)), C3(30, 25, 60), M.SmoothPlastic)
		sign(board, Enum.NormalId.Front, k.label, k.color)
		sign(board, Enum.NormalId.Back, k.label, k.color)
		local orb = part(kiosk, Vector3.new(2, 2, 2), CFrame.new(pos + Vector3.new(0, 5, 0)), k.color, M.Neon, false, Enum.PartType.Ball)
		orb.Name = "Orb"
		ModelFactory.addLight(orb, k.color, 12, 1.5)
		local prompt = Instance.new("ProximityPrompt")
		prompt.ActionText = "Abrir"
		prompt.ObjectText = k.label
		prompt.HoldDuration = 0
		prompt.MaxActivationDistance = 12
		prompt.RequiresLineOfSight = false
		prompt:SetAttribute("OpenPanel", k.id)
		prompt.Parent = base
		kiosk.PrimaryPart = base
		kiosk.Parent = plaza
	end
	-- ranking board
	local boardPos = center + Vector3.new(30, 0, 0)
	local lb = part(plaza, Vector3.new(1, 22, 30), CFrame.new(boardPos + Vector3.new(0, 13, 0)), C3(25, 22, 50), M.SmoothPlastic)
	lb.Name = "Leaderboard"
	part(plaza, Vector3.new(1.4, 23, 31), CFrame.new(boardPos + Vector3.new(0.3, 13, 0)), C3(255, 205, 70), M.Metal)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "BoardGui"
	gui.Face = Enum.NormalId.Left
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 25
	gui.LightInfluence = 0
	gui.Parent = lb
	return plaza
end

-- ===================== BASE PLOTS =====================
function WorldBuilder.baseCFrames(): { CFrame }
	local list = {}
	for _, z in W.BaseRows do
		table.insert(list, CFrame.lookAt(Vector3.new(-W.BaseOffsetX, 0, z), Vector3.new(0, 0, z)))
	end
	for i = 1, 3 do
		local z = W.BaseRows[i]
		table.insert(list, CFrame.lookAt(Vector3.new(W.BaseOffsetX, 0, z), Vector3.new(0, 0, z)))
	end
	return list
end

-- Local layout (entrance at local -Z, facing the avenue)
WorldBuilder.BaseLayout = {
	incubatorCols = 7, incubatorRows = 4, incubatorSpacing = 6, incubatorStartZ = -26,
	petCols = 11, petRows = 5, petSpacingX = 6.5, petSpacingZ = 6, petStartZ = 3,
	treadmill = CFrame.new(-29, 0, -20),
	collectPad = CFrame.new(29, 0, -24),
	sign = CFrame.new(0, 0, -34),
}

local function buildBasePlot(index: number, cf: CFrame, parent: Folder)
	local L = WorldBuilder.BaseLayout
	local base = Instance.new("Model")
	base.Name = "Base_" .. index
	base:SetAttribute("BaseIndex", index)
	local size = W.BaseSize
	local floor = part(base, Vector3.new(size.X, 1, size.Z), cf * CFrame.new(0, 0.5, 0), C3(205, 195, 175), M.Slate)
	floor.Name = "Floor"
	local region = marker("Region", cf * CFrame.new(0, 8, 0), base, Vector3.new(size.X, 16, size.Z))
	region.Name = "Region"
	local anchor = marker("Anchor", cf, base)
	base.PrimaryPart = anchor

	-- Incubator slot markers
	local inc = folder("IncubatorSlots", base)
	local n = 0
	for r = 0, L.incubatorRows - 1 do
		for c = 0, L.incubatorCols - 1 do
			n += 1
			local x = (c - (L.incubatorCols - 1) / 2) * L.incubatorSpacing
			local z = L.incubatorStartZ + r * L.incubatorSpacing
			marker("Slot_" .. n, cf * CFrame.new(x, 1, z), inc)
		end
	end
	local pets = folder("PetSlots", base)
	n = 0
	for r = 0, L.petRows - 1 do
		for c = 0, L.petCols - 1 do
			n += 1
			local x = (c - (L.petCols - 1) / 2) * L.petSpacingX
			local z = L.petStartZ + r * L.petSpacingZ
			marker("Pet_" .. n, cf * CFrame.new(x, 1, z) * CFrame.Angles(0, math.pi, 0) * CFrame.Angles(0, math.pi, 0), pets)
		end
	end
	marker("TreadmillSpot", cf * L.treadmill * CFrame.new(0, 1, 0), base)
	-- collect pad (vault)
	local pad = part(base, Vector3.new(8, 0.6, 8), cf * L.collectPad * CFrame.new(0, 1.3, 0), C3(255, 205, 70), M.Neon, false)
	pad.Name = "CollectPad"
	pad.Transparency = 0.2
	pad.CanQuery = true
	local vaultBoard = part(base, Vector3.new(8, 4, 0.5), cf * L.collectPad * CFrame.new(0, 6, 4), C3(30, 25, 60), M.SmoothPlastic, false)
	vaultBoard.Name = "VaultBoard"
	local vaultLabel = sign(vaultBoard, Enum.NormalId.Front, "COLETAR\n0", GameConfig.Theme.Gold)
	vaultLabel.Name = "VaultLabel"
	vaultBoard.CFrame = vaultBoard.CFrame * CFrame.Angles(0, math.pi, 0)

	-- entrance sign
	local signPost = part(base, Vector3.new(24, 5, 1), cf * L.sign * CFrame.new(0, 12, 0), C3(30, 25, 60), M.SmoothPlastic, false)
	signPost.Name = "OwnerSign"
	local ownerLabel = sign(signPost, Enum.NormalId.Front, "BASE LIVRE", C3(255, 255, 255))
	ownerLabel.Name = "OwnerLabel"
	local ownerBack = sign(signPost, Enum.NormalId.Back, "BASE LIVRE", C3(255, 255, 255))
	ownerBack.Name = "OwnerLabelBack"
	folder("Visuals", base)
	folder("Incubating", base)
	folder("PetDisplays", base)
	base.Parent = parent
	return base
end

-- ===================== BIOMES =====================
local function nestModel(cf: CFrame, color: Color3): Model
	local m = Instance.new("Model")
	m.Name = "Nest"
	local hay = part(m, Vector3.new(0.6, 6, 6), cf * CFrame.new(0, 0.3, 0) * CFrame.Angles(0, 0, math.rad(90)), C3(200, 170, 90), M.Fabric, false, Enum.PartType.Cylinder)
	for i = 1, 8 do
		local a = math.rad(i * 45)
		part(m, Vector3.new(3.2, 0.8, 0.8), cf * CFrame.new(math.cos(a) * 2.8, 0.7, math.sin(a) * 2.8) * CFrame.Angles(0, -a + math.pi / 2, 0), C3(120, 85, 50), M.Wood, false)
	end
	local glow = part(m, Vector3.new(0.2, 5, 5), cf * CFrame.new(0, 0.62, 0) * CFrame.Angles(0, 0, math.rad(90)), color, M.Neon, false, Enum.PartType.Cylinder)
	glow.Transparency = 0.6
	m.PrimaryPart = hay
	return m
end

local function buildGate(biomeId: number, z: number, parent: Instance)
	local b = Balance.biomes[biomeId]
	local gate = Instance.new("Model")
	gate.Name = "Gate_" .. biomeId
	local archColor = (b.mythology == "Greek" and C3(240, 235, 220)) or (b.mythology == "Norse" and C3(110, 100, 95)) or C3(225, 195, 130)
	local trim = (b.mythology == "Greek" and C3(255, 210, 90)) or (b.mythology == "Norse" and C3(120, 210, 255)) or C3(255, 180, 40)
	local mat = (b.mythology == "Greek" and M.Marble) or (b.mythology == "Norse" and M.Slate) or M.Sandstone
	for side = -1, 1, 2 do
		part(gate, Vector3.new(6, 26, 6), CFrame.new(side * (W.AvenueWidth / 2 + 4), 13, z), archColor, mat)
		part(gate, Vector3.new(7, 2, 7), CFrame.new(side * (W.AvenueWidth / 2 + 4), 26.5, z), trim, M.Metal)
	end
	part(gate, Vector3.new(W.AvenueWidth + 14, 5, 6), CFrame.new(0, 29, z), archColor, mat)
	local board = part(gate, Vector3.new(W.AvenueWidth + 4, 4, 0.4), CFrame.new(0, 29, z - 3.2), C3(30, 25, 60), M.SmoothPlastic, false)
	local req = b.speedRequired
	local label = sign(board, Enum.NormalId.Front, string.upper(b.name), trim)
	label.Name = "GateLabel"
	sign(board, Enum.NormalId.Back, string.upper(b.name), trim)
	local barrier = part(gate, Vector3.new(W.BiomeWidth, 40, 1), CFrame.new(0, 20, z), trim, M.ForceField, false)
	barrier.Name = "Barrier"
	barrier.Transparency = req > 0 and 0.55 or 1
	barrier.CanQuery = false
	barrier:SetAttribute("RequiredSpeed", req)
	barrier:SetAttribute("BiomeId", biomeId)
	gate:SetAttribute("BiomeId", biomeId)
	gate:SetAttribute("RequiredSpeed", req)
	if req > 0 then
		local reqBoard = part(gate, Vector3.new(16, 6, 0.4), CFrame.new(0, 8, z - 1), C3(30, 25, 60), M.SmoothPlastic, false)
		reqBoard.Name = "RequirementBoard"
		reqBoard.Transparency = 0.2
		local l = sign(reqBoard, Enum.NormalId.Front, "REQUER " .. req .. " SPEED", C3(255, 255, 255))
		l.Name = "RequirementLabel"
	end
	gate.Parent = parent
	return gate
end

local function buildBiome(biomeId: number, map: Folder, rng: Random)
	local b = Balance.biomes[biomeId]
	local z0, z1 = WorldBuilder.biomeZ(biomeId)
	local bf = folder("Biome_" .. biomeId, map)
	bf:SetAttribute("BiomeId", biomeId)
	bf:SetAttribute("ZStart", z0)
	bf:SetAttribute("ZEnd", z1)
	bf:SetAttribute("Mythology", b.mythology)
	local fc = BIOME_FLOOR[biomeId]
	local floor = part(bf, Vector3.new(W.BiomeWidth, 2, W.BiomeLength), CFrame.new(0, -1, z0 + W.BiomeLength / 2), fc[1], fc[2])
	floor.Name = "Floor"
	local avenue = part(bf, Vector3.new(W.AvenueWidth, 0.2, W.BiomeLength), CFrame.new(0, 0.1, z0 + W.BiomeLength / 2), AVENUE_COLOR[biomeId], M.Pavement)
	avenue.Name = "Avenue"
	for side = -1, 1, 2 do
		local wall = part(bf, Vector3.new(2, 60, W.BiomeLength), CFrame.new(side * (W.BiomeWidth / 2 + 1), 30, z0 + W.BiomeLength / 2), C3(255, 255, 255), M.SmoothPlastic)
		wall.Transparency = 1
		wall.Name = "Boundary"
		-- curb
		part(bf, Vector3.new(1.2, 0.6, W.BiomeLength), CFrame.new(side * (W.AvenueWidth / 2 + 0.6), 0.3, z0 + W.BiomeLength / 2), AVENUE_COLOR[biomeId]:Lerp(C3(0, 0, 0), 0.25), M.Concrete, false)
	end
	buildGate(biomeId, z0, bf)

	local decor = folder("Decor", bf)
	BiomeDecor.build(biomeId, { folder = decor, z0 = z0, length = W.BiomeLength, width = W.BiomeWidth, avenueHalf = W.AvenueWidth / 2, rng = rng })

	-- Nests (alternate sides, outside the avenue)
	local nests = folder("Nests", bf)
	local maxOff = biomeId == 3 and 18 or 42
	for k = 1, W.NestsPerBiome do
		local side = (k % 2 == 0) and 1 or -1
		local x = side * (W.AvenueWidth / 2 + rng:NextNumber(10, maxOff))
		local z = z0 + 30 + (k - 1) * ((W.BiomeLength - 50) / (W.NestsPerBiome - 1))
		local cf = CFrame.new(x, 0.2, z)
		local nm = nestModel(cf, Color3.fromRGB(b.eggColor[1], b.eggColor[2], b.eggColor[3]))
		nm.Name = "Nest_" .. k
		nm:SetAttribute("BiomeId", biomeId)
		nm:SetAttribute("NestIndex", k)
		marker("EggPoint", cf * CFrame.new(0, 0.7, 0), nm)
		nm.Parent = nests
	end

	-- Guardian spawn + patrol points around the nests
	local guardians = folder("GuardianPoints", bf)
	local count = biomeId <= 4 and 1 or 2
	guardians:SetAttribute("Count", count)
	for g = 1, count do
		local gf = folder("Guardian_" .. g, guardians)
		for k = 1, W.NestsPerBiome do
			local include = count == 1 or ((g == 1) == (k % 2 == 1))
			if include then
				local nest = nests:FindFirstChild("Nest_" .. k) :: Model
				local p = nest.PrimaryPart.Position
				local towardAvenue = -math.sign(p.X) * 9
				marker("Patrol_" .. k, CFrame.new(p.X + towardAvenue, 0.5, p.Z + rng:NextNumber(-6, 6)), gf)
			end
		end
	end

	-- Special egg / event spawn spots (open ground)
	local spots = folder("SpawnSpots", bf)
	for s = 1, 6 do
		local side = (s % 2 == 0) and 1 or -1
		marker("Spot_" .. s, CFrame.new(side * (W.AvenueWidth / 2 + rng:NextNumber(4, 30)), 1, z0 + 20 + (s - 1) * 36), spots)
	end
	return bf
end

-- ===================== ENTRY =====================
function WorldBuilder.isBuilt(): boolean
	local map = Workspace:FindFirstChild("Map")
	return map ~= nil and map:GetAttribute("BuildVersion") == WorldBuilder.BUILD_VERSION and Workspace:FindFirstChild("Bases") ~= nil
end

function WorldBuilder.build(force: boolean?)
	if WorldBuilder.isBuilt() and not force then
		return Workspace.Map
	end
	for _, name in { "Map", "Bases", "Runtime" } do
		local old = Workspace:FindFirstChild(name)
		if old then
			old:Destroy()
		end
	end
	local baseplate = Workspace:FindFirstChild("Baseplate")
	if baseplate then
		baseplate:Destroy()
	end
	setupLighting()
	local rng = Random.new(20261105)
	local map = Instance.new("Folder")
	map.Name = "Map"
	buildHub(map)
	buildPlaza(map)
	for i = 1, #Balance.biomes do
		buildBiome(i, map, rng)
	end
	-- end wall
	local _, zEnd = WorldBuilder.biomeZ(#Balance.biomes)
	local endWall = part(map, Vector3.new(W.BiomeWidth, 80, 2), CFrame.new(0, 40, zEnd + 1), C3(255, 255, 255), M.SmoothPlastic)
	endWall.Transparency = 1
	endWall.Name = "Boundary"
	map:SetAttribute("BuildVersion", WorldBuilder.BUILD_VERSION)
	map.Parent = Workspace

	local bases = Instance.new("Folder")
	bases.Name = "Bases"
	for i, cf in WorldBuilder.baseCFrames() do
		buildBasePlot(i, cf, bases)
	end
	bases.Parent = Workspace

	local runtime = Instance.new("Folder")
	runtime.Name = "Runtime"
	for _, n in { "Eggs", "Guardians", "Bots", "Traps", "Pets", "Effects" } do
		folder(n, runtime)
	end
	runtime.Parent = Workspace
	return map
end

-- Runtime folders are recreated each server start (they are never saved meaningfully).
function WorldBuilder.ensureRuntime()
	local runtime = Workspace:FindFirstChild("Runtime")
	if runtime then
		runtime:Destroy()
	end
	runtime = Instance.new("Folder")
	runtime.Name = "Runtime"
	for _, n in { "Eggs", "Guardians", "Bots", "Traps", "Pets", "Effects" } do
		folder(n, runtime)
	end
	runtime.Parent = Workspace
	return runtime
end

return WorldBuilder
]]></ProtectedString></Properties></Item></Item></Item></Item><Item class="StarterPlayer" referent="RBX00000046"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX00000045"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX00000042"><Properties><string name="Name">Client</string><ProtectedString name="Source"><![CDATA[--[[
	STEAL AN GOD — the single client entry point (two-phase: init all, then start all).
]]

local Client = script
local State = require(Client.State)

local ORDER = {
	"Sound", "Panels", "Notifications", "Hud", "Effects", "World", "Input", "Training", "Tutorial",
	"ShopUI", "InventoryUI", "IndexUI", "UpgradesUI", "RewardsUI", "EventsUI", "SettingsUI", "PetInfoUI",
}

local C = { State = State }
for _, name in ORDER do
	local module = Client.Controllers:FindFirstChild(name) or Client.UI:FindFirstChild(name)
	C[name] = require(module)
end

State.start()
for _, name in ORDER do
	if typeof(C[name].init) == "function" then
		C[name].init(C)
	end
end
for _, name in ORDER do
	if typeof(C[name].start) == "function" then
		task.spawn(C[name].start)
	end
end
]]></ProtectedString></Properties><Item class="Folder" referent="RBX00000036"><Properties><string name="Name">Controllers</string></Properties><Item class="ModuleScript" referent="RBX0000002D"><Properties><string name="Name">Effects</string><ProtectedString name="Source"><![CDATA[--[[
	Effects — all client-side juice, kept cheap (distance culling, low update rates):
	  hatch bursts by rarity, mythology-themed ability VFX (Greek lightning/gold, Norse ice/runes,
	  Egyptian sand/solar fire), coin pops, camera shake, knockback, trap snap, guardian slam,
	  reveal highlights, incubator countdowns + wobble, pet idle bob, rainbow mutation cycling,
	  treadmill belt animation, base alarm/protection visuals, guardian state icons.
	Respects Settings: VFX quality (High/Low) and camera shake toggle.
]]

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local CollectionService = game:GetService("CollectionService")
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local NF = require(Shared.Util.NumberFormatter)
local Net = require(Shared.Util.Net)
local Kit = require(script.Parent.Parent.UI.Kit)

local Effects = {}
local C
local player = Players.LocalPlayer
local camera = Workspace.CurrentCamera
local shakeUntil, shakeIntensity = 0, 0
local lowVfx = false
local shakeEnabled = true
local fxFolder

local MYTH_COLORS = {
	Greek = { Color3.fromRGB(255, 230, 120), Color3.fromRGB(120, 190, 255) },
	Norse = { Color3.fromRGB(150, 220, 255), Color3.fromRGB(230, 250, 255) },
	Egyptian = { Color3.fromRGB(255, 190, 60), Color3.fromRGB(255, 110, 30) },
	Event = { Color3.fromRGB(255, 120, 220), Color3.fromRGB(150, 90, 255) },
}

function Effects.init(ctx)
	C = ctx
end

local function myRoot(): BasePart?
	local char = player.Character
	return char and char:FindFirstChild("HumanoidRootPart") :: BasePart? or nil
end

function Effects.shake(intensity: number)
	if not shakeEnabled then
		return
	end
	shakeIntensity = math.max(shakeIntensity, intensity)
	shakeUntil = os.clock() + 0.35 + intensity * 0.3
end

local function part(props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.Neon
	for k, v in props do
		(p :: any)[k] = v
	end
	p.Parent = fxFolder
	return p
end

local function burst(position: Vector3, color: Color3, color2: Color3?, amount: number, speed: number?, size: number?)
	if lowVfx then
		amount = math.floor(amount / 3)
	end
	local a = part({ Transparency = 1, Size = Vector3.one, CFrame = CFrame.new(position) })
	local pe = Instance.new("ParticleEmitter")
	pe.Color = ColorSequence.new(color, color2 or color)
	pe.LightEmission = 1
	pe.Speed = NumberRange.new((speed or 20) * 0.5, speed or 20)
	pe.SpreadAngle = Vector2.new(180, 180)
	pe.Lifetime = NumberRange.new(0.5, 1.2)
	pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size or 0.6), NumberSequenceKeypoint.new(1, 0) })
	pe.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	pe.Rate = 0
	pe.Drag = 3
	pe.Parent = a
	pe:Emit(amount)
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = 18
	light.Brightness = 4
	light.Parent = a
	TweenService:Create(light, TweenInfo.new(0.8), { Brightness = 0 }):Play()
	Debris:AddItem(a, 2)
end

local function ring(position: Vector3, color: Color3, radius: number, duration: number?)
	local r = part({ Shape = Enum.PartType.Cylinder, Color = color, Transparency = 0.2, Size = Vector3.new(0.4, 2, 2), CFrame = CFrame.new(position) * CFrame.Angles(0, 0, math.rad(90)) })
	TweenService:Create(r, TweenInfo.new(duration or 0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = Vector3.new(0.4, radius * 2, radius * 2), Transparency = 1 }):Play()
	Debris:AddItem(r, (duration or 0.5) + 0.1)
end

local function pillar(position: Vector3, color: Color3, height: number, duration: number?)
	local p = part({ Color = color, Transparency = 0.3, Size = Vector3.new(3, 0.5, 3), CFrame = CFrame.new(position) })
	TweenService:Create(p, TweenInfo.new(duration or 0.6), { Size = Vector3.new(0.5, height, 0.5), CFrame = CFrame.new(position + Vector3.new(0, height / 2, 0)), Transparency = 1 }):Play()
	Debris:AddItem(p, (duration or 0.6) + 0.1)
end

local function lightning(from: Vector3, to: Vector3, color: Color3)
	local segments = 6
	local last = from
	for i = 1, segments do
		local t = i / segments
		local point = from:Lerp(to, t) + (i < segments and Vector3.new(math.random(-3, 3), math.random(-2, 2), math.random(-3, 3)) or Vector3.zero)
		local len = (point - last).Magnitude
		local seg = part({ Color = color, Size = Vector3.new(0.35, 0.35, len), CFrame = CFrame.lookAt((last + point) / 2, point) })
		TweenService:Create(seg, TweenInfo.new(0.35), { Transparency = 1 }):Play()
		Debris:AddItem(seg, 0.4)
		last = point
	end
end

local function floatingText(position: Vector3, text: string, color: Color3)
	local a = part({ Transparency = 1, Size = Vector3.one, CFrame = CFrame.new(position) })
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(140, 40)
	bb.AlwaysOnTop = true
	bb.LightInfluence = 0
	bb.MaxDistance = 90
	bb.Parent = a
	local l = Kit.label({ Text = text, Parent = bb, TextColor3 = color, MaxTextSize = 30 })
	TweenService:Create(a, TweenInfo.new(1.2), { CFrame = CFrame.new(position + Vector3.new(0, 5, 0)) }):Play()
	TweenService:Create(l, TweenInfo.new(1.2), { TextTransparency = 1 }):Play()
	Debris:AddItem(a, 1.3)
end
Effects.floatingText = floatingText

-- ===================== ABILITY VFX =====================
local function abilityFx(e)
	if not e.position then
		return
	end
	local colors = MYTH_COLORS[e.mythology] or MYTH_COLORS.Event
	local c1, c2 = colors[1], colors[2]
	local pos = e.position
	C.Sound.play("Ability", pos)
	local kind = e.ability
	if kind == "Shockwave" or kind == "Frost" then
		ring(pos - Vector3.new(0, 2.5, 0), c1, e.radius or 25, 0.6)
		ring(pos - Vector3.new(0, 2, 0), c2, (e.radius or 25) * 0.7, 0.45)
		if e.mythology == "Greek" or e.mythology == "Event" then
			for _ = 1, 3 do
				lightning(pos + Vector3.new(math.random(-8, 8), 40, math.random(-8, 8)), pos + Vector3.new(math.random(-6, 6), -2, math.random(-6, 6)), c1)
			end
		elseif e.mythology == "Norse" then
			for i = 1, 6 do
				local a = math.rad(i * 60)
				local shard = part({ Shape = Enum.PartType.Block, Color = c2, Material = Enum.Material.Ice, Transparency = 0.2, Size = Vector3.new(1, 4, 1), CFrame = CFrame.new(pos + Vector3.new(math.cos(a) * 6, -2, math.sin(a) * 6)) })
				TweenService:Create(shard, TweenInfo.new(0.8), { Transparency = 1, Size = Vector3.new(0.4, 7, 0.4) }):Play()
				Debris:AddItem(shard, 0.9)
			end
		else
			burst(pos, c1, c2, 50, 30, 1.2) -- desert sandstorm
		end
		if (myRoot() and (myRoot().Position - pos).Magnitude < 60) then
			Effects.shake(0.4)
		end
	elseif kind == "SpeedBurst" or kind == "Dash" or kind == "Leap" then
		burst(pos, c1, c2, 25, 15, 0.5)
		ring(pos - Vector3.new(0, 2.5, 0), c1, 8, 0.35)
	elseif kind == "Reveal" then
		ring(pos, c1, math.min(e.radius or 60, 80), 1.2)
		pillar(pos, c2, 30, 0.9)
	elseif kind == "Decoy" then
		burst(pos, c2, Color3.fromRGB(200, 120, 255), 30, 10, 0.8)
	elseif kind == "HatchBoost" or kind == "IncomeBoost" or kind == "TrainBoost" then
		pillar(pos, c1, 26, 0.9)
		burst(pos + Vector3.new(0, 3, 0), c1, Color3.fromRGB(255, 255, 255), 30, 8, 0.5)
	else -- shields, wards, rescue, reach
		local bubble = part({ Shape = Enum.PartType.Ball, Color = c1, Material = Enum.Material.ForceField, Transparency = 0.2, Size = Vector3.new(2, 2, 2), CFrame = CFrame.new(pos) })
		TweenService:Create(bubble, TweenInfo.new(0.6), { Size = Vector3.new(9, 9, 9), Transparency = 1 }):Play()
		Debris:AddItem(bubble, 0.7)
	end
end

-- ===================== REVEAL HIGHLIGHTS =====================
local function reveal(data)
	local root = myRoot()
	if not root then
		return
	end
	local highlights = {}
	local function mark(model: Instance, color: Color3)
		local h = Instance.new("Highlight")
		h.FillColor = color
		h.OutlineColor = Color3.new(1, 1, 1)
		h.FillTransparency = 0.45
		h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		h.Parent = model
		table.insert(highlights, h)
	end
	local filter = data.filter
	if filter ~= "guardians" then
		for _, egg in CollectionService:GetTagged("WorldEgg") do
			local pp = egg.PrimaryPart
			if pp and (pp.Position - root.Position).Magnitude <= data.radius then
				local v = egg:GetAttribute("Variant")
				local ok = filter == "all" or (filter == "rare" and v ~= "normal") or (filter == "special" and (v == "special" or v == "event"))
				if ok then
					mark(egg, v == "special" and Color3.fromRGB(255, 240, 120) or (v == "event" and Color3.fromRGB(255, 120, 220) or Color3.fromRGB(120, 255, 160)))
				end
			end
		end
	end
	if filter == "all" or filter == "guardians" then
		for _, g in Workspace.Runtime.Guardians:GetChildren() do
			local pp = g.PrimaryPart
			if pp and (pp.Position - root.Position).Magnitude <= data.radius then
				mark(g, Color3.fromRGB(255, 70, 70))
			end
		end
	end
	task.delay(data.duration, function()
		for _, h in highlights do
			h:Destroy()
		end
	end)
	C.Notifications.toast("Info", "Visão divina", #highlights .. " alvo(s) revelado(s)")
end

-- ===================== WORLD ANIMATION LOOP =====================
local function updateIncubators(now: number, root: BasePart?)
	for _, egg in CollectionService:GetTagged("IncubatingEgg") do
		local pp = egg.PrimaryPart
		if pp and (not root or (pp.Position - root.Position).Magnitude < 140) then
			local hatchAt = egg:GetAttribute("HatchAt") or now
			local duration = math.max(1, egg:GetAttribute("Duration") or 1)
			local left = hatchAt - now
			local timer = pp:FindFirstChild("Timer")
			if timer then
				local label = timer:FindFirstChild("Time")
				local bar = timer:FindFirstChild("BarBg") and timer.BarBg:FindFirstChild("Bar")
				if egg:GetAttribute("Ready") then
					label.Text = "PRONTO! (sem espaço)"
					label.TextColor3 = Color3.fromRGB(255, 170, 60)
				elseif left > 0 then
					label.Text = NF.time(left)
					label.TextColor3 = Color3.new(1, 1, 1)
				else
					label.Text = "Chocando..."
				end
				if bar then
					bar.Size = UDim2.fromScale(math.clamp(1 - left / duration, 0, 1), 1)
				end
			end
			-- wobble near the end
			local base = egg:GetAttribute("BasePivot")
			if not base then
				egg:SetAttribute("BasePivot", egg:GetPivot())
				base = egg:GetPivot()
			end
			local frac = left / duration
			if frac < 0.2 and not lowVfx then
				local amp = (0.2 - frac) * 0.6
				egg:PivotTo(base * CFrame.Angles(0, 0, math.sin(now * 14) * amp))
			end
		end
	end
end

local function updatePets(now: number, root: BasePart?)
	if not root then
		return
	end
	for _, pet in CollectionService:GetTagged("PetDisplay") do
		local pp = pet.PrimaryPart
		if pp and (pp.Position - root.Position).Magnitude < 90 then
			local base = pet:GetAttribute("BasePivot")
			if not base then
				pet:SetAttribute("BasePivot", pet:GetPivot())
				base = pet:GetPivot()
			end
			local seed = (pp.Position.X + pp.Position.Z) * 0.3
			pet:PivotTo(base * CFrame.new(0, math.abs(math.sin(now * 2 + seed)) * 0.4, 0) * CFrame.Angles(0, math.sin(now * 0.7 + seed) * 0.35, 0))
		end
	end
	for _, m in CollectionService:GetTagged("RainbowModel") do
		local pp = m.PrimaryPart
		if pp and (pp.Position - root.Position).Magnitude < 90 and not lowVfx then
			local hue = (now * 0.25) % 1
			for _, d in m:GetDescendants() do
				if d:IsA("BasePart") and d.Transparency < 1 and not string.find(d.Name, "Eye") then
					d.Color = Color3.fromHSV((hue + (d.Size.X * 0.05)) % 1, 0.6, 1)
				end
			end
		end
	end
end

local function updateTreadmills(now: number, root: BasePart?)
	local bases = Workspace:FindFirstChild("Bases")
	if not bases or not root then
		return
	end
	for _, base in bases:GetChildren() do
		local tm = base:FindFirstChild("Visuals") and base.Visuals:FindFirstChild("Treadmill")
		if tm and tm.PrimaryPart and (tm.PrimaryPart.Position - root.Position).Magnitude < 120 then
			local belt = tm:FindFirstChild("Belt")
			if belt then
				for i = 1, 7 do
					local s = tm:FindFirstChild("Stripe" .. i)
					if s then
						local z = ((i / 7) + now * 0.18) % 1
						s.CFrame = belt.CFrame * CFrame.new(0, 0.18, -belt.Size.Z / 2 + z * belt.Size.Z)
					end
				end
			end
			for _, r in tm:GetChildren() do
				if CollectionService:HasTag(r, "SpinRing") then
					r.CFrame = r.CFrame * CFrame.Angles(math.rad(1.5), 0, 0)
				end
			end
		end
	end
end

local guardianIcons = {}
local function updateGuardians()
	for _, g in Workspace.Runtime.Guardians:GetChildren() do
		local head = g.PrimaryPart
		if head then
			local bb = guardianIcons[g]
			if not bb then
				bb = Instance.new("BillboardGui")
				bb.Size = UDim2.fromOffset(60, 60)
				bb.StudsOffset = Vector3.new(0, 12, 0)
				bb.MaxDistance = 110
				bb.LightInfluence = 0
				bb.AlwaysOnTop = true
				local l = Kit.label({ Text = "", Parent = bb, stroke = false })
				l.Name = "Icon"
				local nameL = Kit.label({ Text = g:GetAttribute("GuardianName") or "", Parent = bb, Size = UDim2.new(3, 0, 0.4, 0), Position = UDim2.new(-1, 0, 1, 0), MaxTextSize = 16, TextColor3 = Color3.fromRGB(255, 150, 150) })
				nameL.Name = "Name"
				bb.Parent = head
				guardianIcons[g] = bb
			end
			local state = g:GetAttribute("State")
			local icon = (g:GetAttribute("Stunned") and "💫") or (state == "Sleeping" and "💤") or (state == "Detecting" and "❗") or ((state == "Chasing" or state == "Attacking") and "😡") or (state == "Observing" and "👀") or ""
			bb.Icon.Text = icon
		end
	end
	for g, bb in guardianIcons do
		if not g.Parent then
			bb:Destroy()
			guardianIcons[g] = nil
		end
	end
end

local alarmLights = {}
local domes = {}
local function updateBases(now: number)
	local bases = Workspace:FindFirstChild("Bases")
	if not bases then
		return
	end
	for _, base in bases:GetChildren() do
		local anchor = base.PrimaryPart
		if anchor then
			local alarm = base:GetAttribute("Alarm") == true
			local light = alarmLights[base]
			if alarm and not light then
				local p = part({ Transparency = 1, Size = Vector3.one, CFrame = anchor.CFrame * CFrame.new(0, 14, 0) })
				local pl = Instance.new("PointLight")
				pl.Color = Color3.fromRGB(255, 40, 40)
				pl.Range = 50
				pl.Parent = p
				alarmLights[base] = p
				light = p
			elseif not alarm and light then
				light:Destroy()
				alarmLights[base] = nil
				light = nil
			end
			if light then
				light.PointLight.Brightness = 3 + math.sin(now * 12) * 3
			end
			local protected = base:GetAttribute("Protected") == true and base:GetAttribute("Owner") ~= nil
			local dome = domes[base]
			if protected and not dome then
				local size = base:FindFirstChild("Region") and base.Region.Size or Vector3.new(76, 16, 70)
				dome = part({ Shape = Enum.PartType.Ball, Material = Enum.Material.ForceField, Color = Color3.fromRGB(120, 200, 255), Transparency = 0.3, Size = Vector3.new(size.X * 1.1, size.X * 0.6, size.X * 1.1), CFrame = anchor.CFrame })
				domes[base] = dome
			elseif not protected and dome then
				dome:Destroy()
				domes[base] = nil
			end
		end
	end
end

local trapTweened = {}
local function updateTraps()
	for _, trap in Workspace.Runtime.Traps:GetChildren() do
		if trap:GetAttribute("Triggered") and not trapTweened[trap] then
			trapTweened[trap] = true
			for _, d in trap:GetChildren() do
				if d:IsA("BasePart") and d:GetAttribute("Angle") then
					local a = d:GetAttribute("Angle")
					TweenService:Create(d, TweenInfo.new(0.12), { CFrame = d.CFrame * CFrame.new(-math.cos(a) * 0.9 * 0, 0, 0) * CFrame.Angles(math.rad(-70), 0, 0) }):Play()
				end
			end
		end
	end
	for trap in trapTweened do
		if not trap.Parent then
			trapTweened[trap] = nil
		end
	end
end

local coinTimer = 0
local function coinPops(dt: number)
	coinTimer += dt
	if coinTimer < 3.5 then
		return
	end
	coinTimer = 0
	local d = C.State.get()
	if not d or not d.baseIndex then
		return
	end
	local base = Workspace.Bases:FindFirstChild("Base_" .. d.baseIndex)
	if not base then
		return
	end
	local pets = base.PetDisplays:GetChildren()
	for i = 1, math.min(3, #pets) do
		local pet = pets[math.random(1, #pets)]
		local pp = pet.PrimaryPart
		local inc = pet:GetAttribute("Income") or 0
		if pp and inc > 0 then
			floatingText(pp.Position + Vector3.new(0, 4, 0), "+" .. NF.format(inc * 3.5), Color3.fromRGB(255, 215, 70))
		end
		task.wait(0.15)
	end
end

function Effects.setQuality(quality: string)
	lowVfx = quality == "Low"
	for _, pe in CollectionService:GetTagged("VFX") do
		if pe:IsA("ParticleEmitter") then
			pe.Enabled = not lowVfx
		end
	end
end

function Effects.setShake(on: boolean)
	shakeEnabled = on
end

function Effects.start()
	fxFolder = Instance.new("Folder")
	fxFolder.Name = "SAG_ClientFX"
	fxFolder.Parent = Workspace
	CollectionService:GetInstanceAddedSignal("VFX"):Connect(function(pe)
		if lowVfx and pe:IsA("ParticleEmitter") then
			pe.Enabled = false
		end
	end)

	Net.listen("Effect", function(e)
		local kind = e.kind
		if kind == "HatchBurst" and e.position then
			local col = Kit.rarityColor(e.rarity)
			burst(e.position + Vector3.new(0, 2, 0), col, Color3.new(1, 1, 1), 40, 25, 0.8)
			ring(e.position, col, 10, 0.6)
			if e.rarity == "Mythic" or e.rarity == "Secret" or e.rarity == "Eternal" or e.rarity == "Divine" then
				pillar(e.position, col, 60, 1.4)
				burst(e.position + Vector3.new(0, 6, 0), col, Color3.fromRGB(255, 255, 255), 80, 40, 1.2)
				if e.owner == player.UserId then
					Effects.shake(1)
				end
			end
		elseif kind == "Ability" then
			abilityFx(e)
		elseif kind == "Pickup" and e.position then
			burst(e.position + Vector3.new(0, 2, 0), Color3.fromRGB(255, 230, 120), nil, 20, 12, 0.4)
			C.Sound.play("Pickup")
		elseif kind == "Deposit" and e.position then
			burst(e.position, Color3.fromRGB(120, 255, 160), nil, 20, 10, 0.4)
			C.Sound.play("Deposit")
		elseif kind == "Collect" then
			local root = myRoot()
			if root then
				floatingText(root.Position + Vector3.new(0, 4, 0), "+" .. NF.format(e.amount) .. " 💰", Color3.fromRGB(255, 215, 70))
				burst(root.Position, Color3.fromRGB(255, 215, 70), nil, 25, 14, 0.5)
			end
			C.Sound.play("Coins")
		elseif kind == "BaseUpgrade" and e.position then
			for i = -2, 2 do
				pillar(e.position + Vector3.new(i * 12, 0, 0), Color3.fromRGB(255, 215, 90), 40, 1.2)
			end
			burst(e.position + Vector3.new(0, 8, 0), Color3.fromRGB(255, 215, 90), Color3.new(1, 1, 1), 60, 30, 1)
			C.Sound.play("Unlock")
		elseif kind == "TrapSnap" and e.position then
			burst(e.position + Vector3.new(0, 1, 0), Color3.fromRGB(220, 220, 230), nil, 15, 10, 0.3)
			C.Sound.play("Trap", e.position)
		elseif kind == "GuardianSlam" and e.position then
			ring(e.position - Vector3.new(0, 4, 0), Color3.fromRGB(200, 170, 130), 14, 0.4)
			local root = myRoot()
			if root and (root.Position - e.position).Magnitude < 40 then
				Effects.shake(0.6)
			end
			C.Sound.play("GuardianAttack", e.position)
		elseif kind == "Alarm" then
			Effects.shake(0.3)
		elseif kind == "Unlock" then
			local root = myRoot()
			if root then
				pillar(root.Position, Color3.fromRGB(180, 120, 255), 50, 1.2)
			end
			C.Sound.play("Unlock")
		end
	end)

	Net.listen("Knockback", function(velocity: Vector3)
		local root = myRoot()
		if root then
			root.AssemblyLinearVelocity = velocity
		end
	end)

	Net.listen("Trapped", function(seconds: number)
		local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if hum then
			C.Notifications.toast("Alarm", "Preso!", "Livre em " .. seconds .. "s")
		end
		Effects.shake(0.5)
	end)

	Net.listen("Reveal", reveal)

	local acc = 0
	RunService.RenderStepped:Connect(function(dt)
		-- camera shake
		local now = os.clock()
		if now < shakeUntil then
			local m = shakeIntensity * (shakeUntil - now)
			camera.CFrame = camera.CFrame * CFrame.Angles(math.rad((math.random() - 0.5) * m), math.rad((math.random() - 0.5) * m), 0)
		else
			shakeIntensity = 0
		end
		acc += dt
		if acc >= 1 / 20 then
			local step = acc
			acc = 0
			local root = myRoot()
			local serverNow = C.State.now()
			updatePets(now, root)
			updateTreadmills(now, root)
			if math.floor(now * 5) ~= math.floor((now - step) * 5) then
				updateIncubators(serverNow, root)
				updateGuardians()
				updateBases(now)
				updateTraps()
			end
			task.spawn(coinPops, step)
		end
	end)
end

return Effects
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000002E"><Properties><string name="Name">Hud</string><ProtectedString name="Source"><![CDATA[--[[
	Hud — main heads-up display:
	  money + income/s, Speed, biome progress bar (current → next), side menu, ability button with
	  cooldown sweep, trap button (x/3), drop-egg button, carry indicator, protection badge,
	  event/special-egg timer and equipped trail. Works with mouse, touch and gamepad.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Shared = ReplicatedStorage.Shared
local Balance = require(Shared.Config.Balance)
local Creatures = require(Shared.Config.Creatures)
local GameConfig = require(Shared.Config.GameConfig)
local Formulas = require(Shared.Util.Formulas)
local NF = require(Shared.Util.NumberFormatter)
local Net = require(Shared.Util.Net)
local Kit = require(script.Parent.Parent.UI.Kit)

local Hud = {}
local C
local T = Kit.Theme
local ui = {}
local cooldownEnd = 0
local cooldownTotal = 1
local displayedGold = 0

function Hud.init(ctx)
	C = ctx
end

local function pill(parent, icon: string, color: Color3, pos: UDim2, size: UDim2)
	local f = Kit.new("Frame", { BackgroundColor3 = T.Panel, Position = pos, Size = size, Parent = parent })
	Kit.corner(f, 20)
	Kit.stroke(f, color, 3)
	Kit.gradient(f, T.PanelLight, T.Panel)
	local ic = Kit.new("Frame", { BackgroundColor3 = color, Size = UDim2.new(0, 46, 0, 46), Position = UDim2.new(0, -6, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), Parent = f })
	Kit.corner(ic, 23)
	Kit.stroke(ic, color:Lerp(Color3.new(0, 0, 0), 0.5), 2)
	Kit.label({ Text = icon, Parent = ic, Size = UDim2.fromScale(0.8, 0.8), Position = UDim2.fromScale(0.1, 0.1), stroke = false })
	local value = Kit.label({ Text = "0", Parent = f, Size = UDim2.new(1, -54, 0.62, 0), Position = UDim2.new(0, 48, 0.04, 0), TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 30, strokeThickness = 2 })
	local sub = Kit.label({ Text = "", Parent = f, Size = UDim2.new(1, -54, 0.34, 0), Position = UDim2.new(0, 48, 0.62, 0), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = color, Font = T.FontBody, MaxTextSize = 16 })
	return f, value, sub
end

local MENU = {
	{ id = "Shop", icon = "🛒", label = "Loja", color = T.Gold },
	{ id = "Inventory", icon = "🐉", label = "Pets", color = Color3.fromRGB(110, 200, 255) },
	{ id = "Index", icon = "📖", label = "Index", color = Color3.fromRGB(90, 220, 140) },
	{ id = "Trails", icon = "✨", label = "Trails", color = Color3.fromRGB(170, 120, 255) },
	{ id = "Upgrades", icon = "🏛", label = "Base", color = Color3.fromRGB(255, 150, 80) },
	{ id = "Rewards", icon = "🎁", label = "Prêmios", color = Color3.fromRGB(255, 110, 160) },
	{ id = "Events", icon = "🎉", label = "Eventos", color = Color3.fromRGB(255, 90, 90) },
	{ id = "Settings", icon = "⚙", label = "Config", color = Color3.fromRGB(160, 160, 190) },
}

local function build()
	local screen = Kit.screen("SAG_HUD", 1)
	Kit.autoScale(screen)
	ui.screen = screen

	-- money / income
	local goldPill, goldValue, incomeSub = pill(screen, "💰", T.Gold, UDim2.fromOffset(24, 14), UDim2.fromOffset(250, 58))
	ui.gold, ui.income, ui.goldPill = goldValue, incomeSub, goldPill
	local speedPill, speedValue, walkSub = pill(screen, "⚡", T.Accent, UDim2.fromOffset(24, 80), UDim2.fromOffset(250, 58))
	ui.speed, ui.walk, ui.speedPill = speedValue, walkSub, speedPill

	-- biome progress (top center)
	local bp = Kit.new("Frame", { BackgroundColor3 = T.Panel, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 12), Size = UDim2.fromOffset(420, 62), Parent = screen })
	Kit.corner(bp, 16)
	Kit.stroke(bp, T.Gold, 2.5)
	Kit.gradient(bp, T.PanelLight, T.Panel)
	ui.biomeName = Kit.label({ Text = "Bosque de Arcadia", Parent = bp, Size = UDim2.new(1, -20, 0, 26), Position = UDim2.fromOffset(10, 4), MaxTextSize = 24 })
	local barBg = Kit.new("Frame", { BackgroundColor3 = Color3.fromRGB(20, 16, 40), Position = UDim2.new(0, 12, 0, 34), Size = UDim2.new(1, -24, 0, 18), Parent = bp })
	Kit.corner(barBg, 9)
	ui.biomeBar = Kit.new("Frame", { BackgroundColor3 = T.Gold, Size = UDim2.fromScale(0, 1), Parent = barBg })
	Kit.corner(ui.biomeBar, 9)
	Kit.gradient(ui.biomeBar, Color3.fromRGB(255, 240, 150), T.GoldDark, 0)
	ui.biomeNext = Kit.label({ Text = "", Parent = barBg, Size = UDim2.fromScale(1, 1), Font = T.FontBody, MaxTextSize = 14, ZIndex = 2 })

	-- left menu
	local menu = Kit.new("Frame", { BackgroundTransparency = 1, Position = UDim2.new(0, 14, 0.5, -10), AnchorPoint = Vector2.new(0, 0.5), Size = UDim2.fromOffset(150, 380), Parent = screen })
	Kit.grid(menu, UDim2.fromOffset(68, 80), 8)
	ui.menuButtons = {}
	for i, m in MENU do
		local b = Kit.button({ Text = "", color = m.color, Size = UDim2.fromOffset(68, 68), LayoutOrder = i, Parent = menu, radius = 16, onClick = function()
			C.Panels.toggle(m.id)
		end })
		Kit.label({ Text = m.icon, Parent = b, Size = UDim2.fromScale(0.62, 0.62), Position = UDim2.fromScale(0.19, 0.06), stroke = false, ZIndex = 3 })
		Kit.label({ Text = m.label, Parent = b, Size = UDim2.new(1, 4, 0.34, 0), Position = UDim2.new(0, -2, 0.7, 0), ZIndex = 3, MaxTextSize = 15 })
		ui.menuButtons[m.id] = b
	end

	-- ability button (bottom right)
	local ab = Kit.new("TextButton", { Name = "Ability", Text = "", AutoButtonColor = false, BackgroundColor3 = T.Panel, AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -24, 1, -24), Size = UDim2.fromOffset(120, 120), Parent = screen })
	Kit.corner(ab, 60)
	ui.abilityStroke = Kit.stroke(ab, T.Gold, 4)
	Kit.gradient(ab, T.PanelLight, T.Panel)
	ui.abilityIcon = Kit.label({ Text = "✦", Parent = ab, Size = UDim2.fromScale(0.5, 0.4), Position = UDim2.fromScale(0.25, 0.12), stroke = false, ZIndex = 2 })
	ui.abilityName = Kit.label({ Text = "Sem pet", Parent = ab, Size = UDim2.fromScale(0.84, 0.24), Position = UDim2.fromScale(0.08, 0.54), MaxTextSize = 16, ZIndex = 2 })
	ui.abilityKey = Kit.label({ Text = "[Q]", Parent = ab, Size = UDim2.fromScale(0.5, 0.16), Position = UDim2.fromScale(0.25, 0.78), Font = T.FontBody, TextColor3 = T.TextDim, MaxTextSize = 13, ZIndex = 2 })
	ui.abilityCd = Kit.new("Frame", { BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.45, AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.fromScale(1, 0), ZIndex = 3, Parent = ab })
	Kit.corner(ui.abilityCd, 60)
	ui.abilityCdText = Kit.label({ Text = "", Parent = ab, Size = UDim2.fromScale(0.6, 0.35), Position = UDim2.fromScale(0.2, 0.3), ZIndex = 4, MaxTextSize = 36 })
	ab.Activated:Connect(function()
		Hud.useAbility()
	end)
	ui.ability = ab

	-- trap / drop buttons
	local trap, trapLabel = Kit.button({ Text = "🪤 0/3 [T]", color = Color3.fromRGB(150, 90, 60), AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -154, 1, -86), Size = UDim2.fromOffset(150, 52), Parent = screen, MaxTextSize = 20, onClick = function()
		Hud.placeTrap()
	end })
	ui.trap, ui.trapLabel = trap, trapLabel
	Kit.button({ Text = "Recolher [R]", color = Color3.fromRGB(110, 80, 60), AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -154, 1, -30), Size = UDim2.fromOffset(150, 48), Parent = screen, MaxTextSize = 18, onClick = function()
		Hud.removeTrap()
	end })
	local drop = Kit.button({ Text = "Soltar ovo [G]", color = T.Bad, AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -154, 1, -146), Size = UDim2.fromOffset(150, 48), Parent = screen, MaxTextSize = 18, onClick = function()
		Net.send("DropEgg")
	end })
	drop.Visible = false
	ui.drop = drop

	-- carry indicator
	local carry = Kit.new("Frame", { BackgroundColor3 = Color3.fromRGB(60, 30, 20), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -90), Size = UDim2.fromOffset(420, 46), Visible = false, Parent = screen })
	Kit.corner(carry, 14)
	Kit.stroke(carry, Color3.fromRGB(255, 170, 60), 3)
	ui.carryLabel = Kit.label({ Text = "", Parent = carry, Size = UDim2.new(1, -16, 1, -8), Position = UDim2.fromOffset(8, 4), MaxTextSize = 22 })
	ui.carry = carry

	-- right top: event timer + trail + protection
	local info = Kit.new("Frame", { BackgroundColor3 = T.Panel, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -16, 0, 12), Size = UDim2.fromOffset(250, 92), Parent = screen })
	Kit.corner(info, 14)
	Kit.stroke(info, Color3.fromRGB(255, 110, 200), 2.5)
	Kit.gradient(info, T.PanelLight, T.Panel)
	ui.eventLine = Kit.label({ Text = "", Parent = info, Size = UDim2.new(1, -16, 0, 28), Position = UDim2.fromOffset(8, 4), MaxTextSize = 20, TextColor3 = Color3.fromRGB(255, 150, 220) })
	ui.specialLine = Kit.label({ Text = "", Parent = info, Size = UDim2.new(1, -16, 0, 24), Position = UDim2.fromOffset(8, 34), MaxTextSize = 17, Font = T.FontBody })
	ui.trailLine = Kit.label({ Text = "", Parent = info, Size = UDim2.new(1, -16, 0, 22), Position = UDim2.fromOffset(8, 62), MaxTextSize = 15, Font = T.FontBody, TextColor3 = T.TextDim })
	ui.protect = Kit.label({ Text = "", Parent = screen, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -16, 0, 110), Size = UDim2.fromOffset(250, 26), MaxTextSize = 18, TextColor3 = T.Good })
end

-- ===================== ACTIONS =====================
function Hud.useAbility()
	Net.send("UseAbility")
end

function Hud.placeTrap()
	local ok, msg = Net.request("PlaceTrap", {})
	C.Notifications.toast(ok and "Info" or "Warning", ok and "Armadilha" or "Não foi possível", msg or "")
end

function Hud.removeTrap()
	local ok, msg = Net.request("RemoveTrap", {})
	C.Notifications.toast(ok and "Info" or "Warning", "Armadilha", msg or "")
end

function Hud.setCooldown(seconds: number)
	if seconds and seconds > 0 then
		cooldownEnd = os.clock() + seconds
		cooldownTotal = math.max(seconds, cooldownTotal)
		local _, creature = Hud.equippedAbility()
		if creature then
			cooldownTotal = creature.ab.cd
		end
	end
end

function Hud.equippedAbility()
	local d = C.State.get()
	if not d or not d.equippedPet then
		return nil, nil
	end
	for _, pet in d.pets do
		if pet.uid == d.equippedPet then
			local c = Creatures.ById[pet.species]
			return c and c.ab, c
		end
	end
	return nil, nil
end

-- ===================== REFRESH =====================
local function refresh(d)
	if not d then
		return
	end
	ui.income.Text = "+" .. NF.format(d.income or 0) .. "/s" .. ((d.vault or 0) >= 1 and ("  •  cofre " .. NF.format(d.vault)) or "")
	ui.speed.Text = NF.format(d.speed) .. " Speed"
	local unlocked = d.unlockedBiome or 1
	local b = Formulas.biome(unlocked)
	local nextB = Balance.biomes[unlocked + 1]
	ui.walk.Text = string.format("Velocidade %.0f", Formulas.walkSpeed(d.speed))
	ui.biomeName.Text = "🗺 " .. b.name .. " (" .. unlocked .. "/12)"
	if nextB then
		local p = math.clamp((d.speed - b.speedRequired) / (nextB.speedRequired - b.speedRequired), 0, 1)
		TweenService:Create(ui.biomeBar, TweenInfo.new(0.3), { Size = UDim2.fromScale(p, 1) }):Play()
		ui.biomeNext.Text = "Próximo: " .. nextB.name .. " — " .. NF.format(d.speed) .. " / " .. NF.format(nextB.speedRequired)
	else
		ui.biomeBar.Size = UDim2.fromScale(1, 1)
		ui.biomeNext.Text = "Todos os biomas desbloqueados!"
	end
	if not d.partial then
		local ab, creature = Hud.equippedAbility()
		if ab and creature then
			ui.abilityName.Text = ab.name
			ui.abilityStroke.Color = Kit.mythColor(creature.mythology)
			ui.abilityIcon.Text = (creature.mythology == "Greek" and "⚡") or (creature.mythology == "Norse" and "❄") or (creature.mythology == "Egyptian" and "☀") or "✦"
		else
			ui.abilityName.Text = "Equipe um pet"
			ui.abilityIcon.Text = "✦"
		end
		ui.trapLabel.Text = "🪤 " .. (d.trapsActive or 0) .. "/" .. Balance.traps.maxActive .. " [T]"
		ui.carry.Visible = d.carrying ~= nil
		ui.drop.Visible = d.carrying ~= nil
		if d.carrying then
			local pen = Balance.speed.carryPenaltyBySize[d.carrying.size] or 0
			ui.carryLabel.Text = "🥚 Carregando ovo " .. Formulas.size(d.carrying.size).eggName .. (d.carrying.mutation ~= "None" and (" " .. d.carrying.mutation) or "") .. "  (−" .. math.floor(pen * 100) .. "% velocidade) → volte à base!"
		end
		local trail = Formulas.trail(d.equippedTrail)
		ui.trailLine.Text = trail and ("Trail: " .. trail.name .. " (" .. trail.mult .. "x treino)") or "Sem Trail equipado"
		ui.protect.Text = d.protected and ("🛡 Base protegida: " .. d.protected) or ""
	end
end

function Hud.start()
	build()
	C.State.Changed:Connect(function(d, partial)
		d.partial = partial
		refresh(d)
		d.partial = nil
	end)
	Net.listen("Effect", function(e)
		if e.kind == "AbilityResult" then
			if e.ok then
				Hud.setCooldown(e.cooldown)
			elseif e.message then
				C.Notifications.toast("Warning", "Habilidade", e.message)
			end
		end
	end)
	-- per-frame: smooth gold counter, cooldown sweep, timers
	RunService.RenderStepped:Connect(function(dt)
		local d = C.State.get()
		if d then
			local target = d.gold or 0
			displayedGold += (target - displayedGold) * math.clamp(dt * 8, 0, 1)
			if math.abs(target - displayedGold) < 1 then
				displayedGold = target
			end
			ui.gold.Text = NF.format(displayedGold)
		end
		local left = cooldownEnd - os.clock()
		if left > 0 then
			ui.abilityCd.Size = UDim2.fromScale(1, math.clamp(left / cooldownTotal, 0, 1))
			ui.abilityCdText.Text = tostring(math.ceil(left))
		else
			ui.abilityCd.Size = UDim2.fromScale(1, 0)
			ui.abilityCdText.Text = ""
		end
		local now = C.State.now()
		local w = C.State.World
		if w.event and w.endsAt then
			local name = w.event
			for _, e in GameConfig.Events do
				if e.id == w.event then
					name = e.name
				end
			end
			ui.eventLine.Text = "🎉 " .. name .. " " .. NF.time(w.endsAt - now)
		else
			ui.eventLine.Text = "🎉 Nenhum evento ativo"
		end
		if w.nextSpecialAt then
			ui.specialLine.Text = "🥚 Ovo Divino em " .. NF.time(w.nextSpecialAt - now)
		end
	end)
end

return Hud
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000002F"><Properties><string name="Name">Input</string><ProtectedString name="Source"><![CDATA[--[[
	Input — keyboard + gamepad bindings (touch uses the on-screen HUD buttons).
	  Q / ButtonX  ability        T / ButtonY  place trap     R / DPadLeft  pick up trap
	  G / DPadDown drop egg       B / DPadUp   shop           Escape/ButtonB close panel
]]

local ContextActionService = game:GetService("ContextActionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Net = require(ReplicatedStorage.Shared.Util.Net)

local Input = {}
local C

function Input.init(ctx)
	C = ctx
end

local function bind(name: string, fn, ...)
	ContextActionService:BindAction(name, function(_, state)
		if state == Enum.UserInputState.Begin then
			fn()
		end
		return Enum.ContextActionResult.Pass
	end, false, ...)
end

function Input.start()
	bind("SAG_Ability", function()
		C.Hud.useAbility()
	end, Enum.KeyCode.Q, Enum.KeyCode.ButtonX)
	bind("SAG_Trap", function()
		C.Hud.placeTrap()
	end, Enum.KeyCode.T, Enum.KeyCode.ButtonY)
	bind("SAG_RemoveTrap", function()
		C.Hud.removeTrap()
	end, Enum.KeyCode.R, Enum.KeyCode.DPadLeft)
	bind("SAG_Drop", function()
		Net.send("DropEgg")
	end, Enum.KeyCode.G, Enum.KeyCode.DPadDown)
	bind("SAG_Shop", function()
		C.Panels.toggle("Shop")
	end, Enum.KeyCode.B, Enum.KeyCode.DPadUp)
	bind("SAG_Close", function()
		C.Panels.close()
	end, Enum.KeyCode.ButtonB)
end

return Input
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000030"><Properties><string name="Name">Notifications</string><ProtectedString name="Source"><![CDATA[--[[
	Notifications — organized feedback:
	  • toast queue (max 3 on screen, one enters at a time) for rewards, warnings, discoveries…
	  • big center announcements (special egg, world events) with their own queue
	  • the HATCH REVEAL cinematic (egg shake → crack → flash → creature + rarity banner)
	  • offline earnings summary when returning
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Shared = ReplicatedStorage.Shared
local Creatures = require(Shared.Config.Creatures)
local Formulas = require(Shared.Util.Formulas)
local NF = require(Shared.Util.NumberFormatter)
local Net = require(Shared.Util.Net)
local ModelFactory = require(Shared.Factory.ModelFactory)
local Kit = require(script.Parent.Parent.UI.Kit)

local Notifications = {}
local C
local T = Kit.Theme
local screen
local toastHolder
local toastQueue = {}
local visibleToasts = 0
local announceQueue = {}
local announcing = false
local revealQueue = {}
local revealing = false

local KIND_COLOR = {
	Reward = Color3.fromRGB(90, 220, 110), Warning = Color3.fromRGB(255, 170, 60), Alarm = Color3.fromRGB(255, 70, 80),
	Egg = Color3.fromRGB(255, 210, 90), Discovery = Color3.fromRGB(120, 220, 255), Unlock = Color3.fromRGB(180, 120, 255),
	Trail = Color3.fromRGB(200, 140, 255), Achievement = Color3.fromRGB(255, 205, 64), Purchase = Color3.fromRGB(255, 205, 64),
	Info = Color3.fromRGB(150, 180, 255), Rare = Color3.fromRGB(255, 120, 220),
}
local KIND_ICON = { Reward = "🎁", Warning = "⚠", Alarm = "🚨", Egg = "🥚", Discovery = "📖", Unlock = "🗺", Trail = "✨", Achievement = "🏆", Purchase = "💎", Info = "ℹ", Rare = "🌟" }

function Notifications.init(ctx)
	C = ctx
end

-- ===================== TOASTS =====================
local function showNextToast()
	if visibleToasts >= 3 or #toastQueue == 0 then
		return
	end
	local n = table.remove(toastQueue, 1)
	visibleToasts += 1
	local color = KIND_COLOR[n.kind] or T.Accent
	local f = Kit.new("Frame", { BackgroundColor3 = T.Panel, Size = UDim2.fromOffset(380, 70), Parent = toastHolder })
	Kit.corner(f, 14)
	Kit.stroke(f, color, 3)
	Kit.gradient(f, T.PanelLight, T.Panel)
	Kit.label({ Text = KIND_ICON[n.kind] or "✦", Parent = f, Size = UDim2.fromOffset(50, 50), Position = UDim2.fromOffset(8, 10), stroke = false })
	Kit.label({ Text = n.title, Parent = f, Size = UDim2.new(1, -70, 0, 30), Position = UDim2.fromOffset(62, 6), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = color, MaxTextSize = 22 })
	Kit.label({ Text = n.text or "", Parent = f, Size = UDim2.new(1, -70, 0, 28), Position = UDim2.fromOffset(62, 36), TextXAlignment = Enum.TextXAlignment.Left, Font = T.FontBody, MaxTextSize = 16 })
	local scale = Kit.new("UIScale", { Scale = 0.6, Parent = f })
	TweenService:Create(scale, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	C.Sound.play(n.kind == "Alarm" and "Alarm" or "Notify")
	task.delay(n.kind == "Alarm" and 4.5 or 3.4, function()
		TweenService:Create(scale, TweenInfo.new(0.2), { Scale = 0 }):Play()
		task.wait(0.22)
		f:Destroy()
		visibleToasts -= 1
		showNextToast()
	end)
	task.delay(0.35, showNextToast)
end

function Notifications.toast(kind: string, title: string, text: string?)
	-- de-duplicate identical messages already waiting
	for _, q in toastQueue do
		if q.title == title and q.text == text then
			return
		end
	end
	table.insert(toastQueue, { kind = kind, title = title, text = text })
	if #toastQueue > 8 then
		table.remove(toastQueue, 1)
	end
	showNextToast()
end

-- ===================== ANNOUNCEMENTS =====================
local function runAnnouncements()
	if announcing then
		return
	end
	announcing = true
	while #announceQueue > 0 do
		local a = table.remove(announceQueue, 1)
		local f = Kit.new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.28), Size = UDim2.fromOffset(640, 120), BackgroundColor3 = T.Panel, Parent = screen })
		Kit.corner(f, 20)
		Kit.stroke(f, a.color, 4)
		Kit.gradient(f, a.color:Lerp(T.Panel, 0.55), T.Panel)
		Kit.label({ Text = a.title, Parent = f, Size = UDim2.new(1, -30, 0, 58), Position = UDim2.fromOffset(15, 8), TextColor3 = Color3.new(1, 1, 1), MaxTextSize = 46, strokeThickness = 3 })
		Kit.label({ Text = a.text or "", Parent = f, Size = UDim2.new(1, -30, 0, 40), Position = UDim2.fromOffset(15, 70), Font = T.FontBody, MaxTextSize = 22 })
		local scale = Kit.new("UIScale", { Scale = 0.3, Parent = f })
		TweenService:Create(scale, TweenInfo.new(0.35, Enum.EasingStyle.Back), { Scale = 1 }):Play()
		C.Sound.play("EventStart")
		task.wait(a.duration or 3.5)
		TweenService:Create(scale, TweenInfo.new(0.25), { Scale = 0 }):Play()
		task.wait(0.3)
		f:Destroy()
	end
	announcing = false
end

function Notifications.announce(title: string, text: string?, color: Color3?, duration: number?)
	table.insert(announceQueue, { title = title, text = text, color = color or T.Gold, duration = duration })
	task.spawn(runAnnouncements)
end

-- ===================== HATCH REVEAL =====================
local function playReveal(data)
	local c = Creatures.ById[data.species]
	local rarityColor = Kit.rarityColor(data.rarity)
	local overlay = Kit.new("Frame", { BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = screen, ZIndex = 20 })
	TweenService:Create(overlay, TweenInfo.new(0.3), { BackgroundTransparency = 0.35 }):Play()
	local holder = Kit.new("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.45), Size = UDim2.fromOffset(360, 360), Parent = overlay, ZIndex = 21 })
	-- rays behind
	local rays = Kit.new("Frame", { BackgroundColor3 = rarityColor, BackgroundTransparency = 0.6, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(1.2, 1.2), Parent = holder, ZIndex = 21 })
	Kit.corner(rays, 400)
	Kit.new("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.5, 0.6), NumberSequenceKeypoint.new(1, 1) }), Parent = rays })
	-- egg phase
	local eggModel = ModelFactory.egg(c and c.biome > 0 and c.biome or 1, data.size, data.mutation, c and c.biome == 0 and "event" or "normal")
	local eggVp = Kit.viewport(holder, eggModel, { Size = UDim2.fromScale(0.8, 0.8), Position = UDim2.fromScale(0.1, 0.1) })
	eggVp.ZIndex = 22
	C.Sound.play("Hatch")
	for i = 1, 10 do
		local ang = (i % 2 == 0 and 1 or -1) * (4 + i * 1.2)
		eggVp.Rotation = ang
		task.wait(0.07 + (10 - i) * 0.01)
	end
	eggVp.Rotation = 0
	-- flash
	local flash = Kit.new("Frame", { BackgroundColor3 = Color3.new(1, 1, 1), Size = UDim2.fromScale(1, 1), Parent = overlay, ZIndex = 30 })
	TweenService:Create(flash, TweenInfo.new(0.6), { BackgroundTransparency = 1 }):Play()
	C.Effects.shake(data.rarity == "Divine" and 1.2 or 0.5)
	eggVp:Destroy()
	-- creature phase
	local model = ModelFactory.creature(data.species, data.size, data.mutation)
	local vp = Kit.viewport(holder, model, { Size = UDim2.fromScale(1, 1) })
	vp.ZIndex = 22
	local spin = 0
	local conn = game:GetService("RunService").RenderStepped:Connect(function(dt)
		spin += dt * 50
		rays.Rotation = spin
		local cam = vp.CurrentCamera
		if cam then
			local cf, size = model:GetBoundingBox()
			local dist = size.Magnitude * 1.3 + 1
			local a = math.rad(spin)
			cam.CFrame = CFrame.lookAt(cf.Position + Vector3.new(math.sin(a) * dist, dist * 0.25, math.cos(a) * dist), cf.Position)
		end
	end)
	local banner = Kit.new("Frame", { BackgroundColor3 = T.Panel, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0.7), Size = UDim2.fromOffset(520, 180), Parent = overlay, ZIndex = 23 })
	Kit.corner(banner, 18)
	Kit.stroke(banner, rarityColor, 4)
	Kit.gradient(banner, rarityColor:Lerp(T.Panel, 0.6), T.Panel)
	local title = (data.mutation ~= "None" and (data.mutation .. " ") or "") .. (data.size ~= "Normal" and (data.size .. " ") or "") .. (c and c.name or data.species)
	Kit.label({ Text = string.upper(data.rarity or "") .. (data.isNew and "  •  NOVA!" or ""), Parent = banner, Size = UDim2.new(1, -20, 0, 34), Position = UDim2.fromOffset(10, 6), TextColor3 = rarityColor, MaxTextSize = 30, ZIndex = 24, strokeThickness = 2.5 })
	Kit.label({ Text = title, Parent = banner, Size = UDim2.new(1, -20, 0, 44), Position = UDim2.fromOffset(10, 40), MaxTextSize = 40, ZIndex = 24, strokeThickness = 3 })
	Kit.label({ Text = "💰 +" .. NF.format(data.income) .. "/s   •   Tamanho: " .. Formulas.size(data.size).name .. "   •   Mutação: " .. data.mutation, Parent = banner, Size = UDim2.new(1, -20, 0, 28), Position = UDim2.fromOffset(10, 88), Font = T.FontBody, MaxTextSize = 20, ZIndex = 24 })
	if c then
		Kit.label({ Text = "✦ " .. c.ab.name .. ": " .. c.ab.desc, Parent = banner, Size = UDim2.new(1, -20, 0, 44), Position = UDim2.fromOffset(10, 120), Font = T.FontBody, TextColor3 = T.TextDim, MaxTextSize = 17, ZIndex = 24 })
	end
	local scale = Kit.new("UIScale", { Scale = 0.2, Parent = banner })
	TweenService:Create(scale, TweenInfo.new(0.4, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	local closed = false
	local btn = Kit.new("TextButton", { BackgroundTransparency = 1, Text = "", Size = UDim2.fromScale(1, 1), Parent = overlay, ZIndex = 40 })
	btn.Activated:Connect(function()
		closed = true
	end)
	local t0 = os.clock()
	while not closed and os.clock() - t0 < 5.5 do
		task.wait(0.1)
	end
	conn:Disconnect()
	overlay:Destroy()
end

local function runReveals()
	if revealing then
		return
	end
	revealing = true
	while #revealQueue > 0 do
		local ok, err = pcall(playReveal, table.remove(revealQueue, 1))
		if not ok then
			warn("[Reveal]", err)
		end
	end
	revealing = false
end

-- ===================== OFFLINE SUMMARY =====================
local function showOffline(data)
	local panel = Kit.panel(screen, "BEM-VINDO DE VOLTA!", T.Gold, UDim2.fromScale(0.42, 0.5))
	panel.frame.Visible = true
	panel.frame.ZIndex = 15
	local content = panel.content
	Kit.list(content, 8)
	Kit.label({ Text = "Você ficou fora por " .. NF.time(data.rawSeconds), Parent = content, Size = UDim2.new(1, 0, 0, 34), MaxTextSize = 26, LayoutOrder = 1 })
	Kit.label({ Text = "💰 Seus pets geraram " .. NF.format(data.gold) .. " GOLD (50%, até 8h)", Parent = content, Size = UDim2.new(1, 0, 0, 30), TextColor3 = T.Gold, MaxTextSize = 24, LayoutOrder = 2 })
	Kit.label({ Text = "🥚 Ovos chocados: " .. #data.hatched, Parent = content, Size = UDim2.new(1, 0, 0, 30), MaxTextSize = 22, LayoutOrder = 3 })
	local names = {}
	for i, h in data.hatched do
		if i > 6 then
			table.insert(names, "...")
			break
		end
		local c = Creatures.ById[h.species]
		table.insert(names, (h.mutation ~= "None" and (h.mutation .. " ") or "") .. (c and c.name or h.species))
	end
	if #names > 0 then
		Kit.label({ Text = "Novas criaturas: " .. table.concat(names, ", "), Parent = content, Size = UDim2.new(1, 0, 0, 56), Font = T.FontBody, MaxTextSize = 18, LayoutOrder = 4 })
	end
	Kit.button({ Text = "COLETAR!", color = T.Good, Size = UDim2.fromOffset(200, 54), Parent = content, LayoutOrder = 5, onClick = function()
		panel.frame:Destroy()
	end })
	panel.close.Activated:Connect(function()
		panel.frame:Destroy()
	end)
end

-- Logo splash when joining (falls back to text if the image id is empty).
local function splash()
	local GameConfig = require(Shared.Config.GameConfig)
	local holder = Kit.new("Frame", { BackgroundColor3 = Color3.fromRGB(14, 12, 30), Size = UDim2.fromScale(1, 1), ZIndex = 50, Parent = screen })
	local logo
	if GameConfig.Images.Logo ~= "" then
		logo = Kit.new("ImageLabel", { BackgroundTransparency = 1, Image = GameConfig.Images.Logo, ScaleType = Enum.ScaleType.Fit, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.45), Size = UDim2.fromScale(0.6, 0.6), ZIndex = 51, Parent = holder })
	else
		logo = Kit.label({ Text = "STEAL AN GOD", Parent = holder, TextColor3 = T.Gold, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.45), Size = UDim2.fromScale(0.6, 0.2), ZIndex = 51 })
	end
	Kit.label({ Text = "Roube ovos • Choque deuses • Domine o panteão", Parent = holder, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0.78), Size = UDim2.fromScale(0.6, 0.05), Font = T.FontBody, ZIndex = 51 })
	local scale = Kit.new("UIScale", { Scale = 0.8, Parent = logo })
	TweenService:Create(scale, TweenInfo.new(1.2, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	task.wait(2.8)
	TweenService:Create(holder, TweenInfo.new(0.6), { BackgroundTransparency = 1 }):Play()
	for _, d in holder:GetDescendants() do
		if d:IsA("ImageLabel") then
			TweenService:Create(d, TweenInfo.new(0.6), { ImageTransparency = 1 }):Play()
		elseif d:IsA("TextLabel") then
			TweenService:Create(d, TweenInfo.new(0.6), { TextTransparency = 1 }):Play()
		end
	end
	task.wait(0.7)
	holder:Destroy()
end

function Notifications.start()
	screen = Kit.screen("SAG_Notifications", 20)
	Kit.autoScale(screen)
	task.spawn(splash)
	toastHolder = Kit.new("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -16, 0, 150), Size = UDim2.fromOffset(390, 260), Parent = screen })
	Kit.list(toastHolder, 8)

	Net.listen("Notify", function(n)
		Notifications.toast(n.kind or "Info", n.title or "", n.text)
	end)
	Net.listen("HatchReveal", function(data)
		table.insert(revealQueue, data)
		task.spawn(runReveals)
	end)
	Net.listen("OfflineSummary", function(data)
		showOffline(data)
	end)
	Net.listen("Announce", function(a)
		if a.type == "SpecialEggSoon" then
			Notifications.announce("🥚 OVO DIVINO EM " .. a.seconds .. "s!", "Prepare-se para a disputa!", Color3.fromRGB(255, 230, 120), 3)
		elseif a.type == "SpecialEggSpawned" and not a.quiet then
			Notifications.announce("✨ UM OVO DIVINO APARECEU!", "Em " .. (a.biomeName or "?") .. " — siga o feixe de luz!", Color3.fromRGB(255, 230, 120), 4)
		elseif a.type == "SpecialEggTaken" then
			Notifications.toast("Rare", "Ovo Divino capturado!", (a.by or "Alguém") .. " pegou o Ovo Divino!")
		elseif a.type == "SpecialEggGone" then
			Notifications.toast("Info", "O Ovo Divino desapareceu", "Fique atento ao próximo!")
		elseif a.type == "EventStart" then
			Notifications.announce("🎉 " .. a.name, a.desc, Color3.fromRGB(255, 110, 200), 5)
		elseif a.type == "EventWave" then
			Notifications.toast("Rare", a.name, "Novos ovos de evento apareceram pelo mapa!")
		elseif a.type == "EventEnd" then
			Notifications.toast("Info", a.name .. " terminou", "Obrigado por participar!")
		end
	end)
end

return Notifications
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000031"><Properties><string name="Name">Panels</string><ProtectedString name="Source"><![CDATA[--[[
	Panels — one modal panel open at a time, with pop-in animation; shared ScreenGui.
]]

local TweenService = game:GetService("TweenService")
local Kit = require(script.Parent.Parent.UI.Kit)

local Panels = {}
local C
local registry = {} -- [name] = {frame, onOpen}
local current: string? = nil
Panels.screen = nil

function Panels.init(ctx)
	C = ctx
	Panels.screen = Kit.screen("SAG_Panels", 10)
	Kit.autoScale(Panels.screen)
end

function Panels.register(name: string, panel, onOpen)
	registry[name] = { frame = panel.frame, onOpen = onOpen }
	panel.close.Activated:Connect(function()
		Panels.close()
	end)
end

function Panels.open(name: string)
	local entry = registry[name]
	if not entry then
		return
	end
	if current and current ~= name then
		registry[current].frame.Visible = false
	end
	current = name
	entry.frame.Visible = true
	local scale = entry.frame:FindFirstChild("PopScale") or Kit.new("UIScale", { Name = "PopScale", Parent = entry.frame })
	scale.Scale = 0.85
	TweenService:Create(scale, TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	if entry.onOpen then
		task.spawn(entry.onOpen)
	end
end

function Panels.close()
	if current and registry[current] then
		registry[current].frame.Visible = false
	end
	current = nil
end

function Panels.toggle(name: string)
	if current == name then
		Panels.close()
	else
		Panels.open(name)
	end
end

function Panels.isOpen(name: string?): boolean
	if name then
		return current == name
	end
	return current ~= nil
end

return Panels
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000032"><Properties><string name="Name">Sound</string><ProtectedString name="Source"><![CDATA[--[[
	Sound — SFX and per-mythology ambient music with volume control and toggles.
	Sound ids come from GameConfig.Sounds (empty = silent). Never invent asset ids.
]]

local SoundService = game:GetService("SoundService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)

local Sound = {}
local C
local sfxOn, musicOn = true, true
local musicSound: Sound? = nil
local currentMusic = nil
local cache = {}

function Sound.init(ctx)
	C = ctx
end

function Sound.play(name: string, position: Vector3?)
	if not sfxOn then
		return
	end
	local id = GameConfig.Sounds[name]
	if not id or id == "" then
		return
	end
	if position then
		local a = Instance.new("Attachment")
		a.WorldPosition = position
		a.Parent = workspace.Terrain
		local s = Instance.new("Sound")
		s.SoundId = id
		s.Volume = 0.6
		s.RollOffMaxDistance = 120
		s.Parent = a
		s:Play()
		s.Ended:Connect(function()
			a:Destroy()
		end)
		task.delay(6, function()
			if a.Parent then
				a:Destroy()
			end
		end)
		return
	end
	local s = cache[name]
	if not s then
		s = Instance.new("Sound")
		s.SoundId = id
		s.Volume = 0.5
		s.Parent = SoundService
		cache[name] = s
	end
	s:Play()
end

function Sound.music(mythology: string)
	currentMusic = mythology
	local id = GameConfig.Sounds["Music" .. mythology] or ""
	if not musicSound then
		musicSound = Instance.new("Sound")
		musicSound.Name = "SAG_Music"
		musicSound.Looped = true
		musicSound.Volume = 0.25
		musicSound.Parent = SoundService
	end
	local m = musicSound :: Sound
	if m.SoundId ~= id then
		m:Stop()
		m.SoundId = id
	end
	if musicOn and id ~= "" and not m.IsPlaying then
		m:Play()
	end
end

function Sound.setEnabled(sfx: boolean, music: boolean)
	sfxOn = sfx
	musicOn = music
	local KitModule = require(script.Parent.Parent.UI.Kit)
	KitModule.sfxEnabled = sfx
	if musicSound then
		if music then
			Sound.music(currentMusic or "Hub")
		else
			musicSound:Stop()
		end
	end
end

function Sound.start()
	C.State.Changed:Connect(function(d, partial)
		if not partial and d.settings then
			Sound.setEnabled(d.settings.sfx ~= false, d.settings.music ~= false)
		end
	end)
end

return Sound
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000033"><Properties><string name="Name">Training</string><ProtectedString name="Source"><![CDATA[--[[
	Training — tells the server (throttled, 4/s) that the local player is actively running on
	THEIR OWN treadmill. The server validates position + rate and grants the Speed. Also shows
	floating "+Speed" numbers as the authoritative value grows.
]]

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local NF = require(ReplicatedStorage.Shared.Util.NumberFormatter)
local Net = require(ReplicatedStorage.Shared.Util.Net)

local Training = {}
local C
local player = Players.LocalPlayer
local lastSpeed = nil
local popAcc = 0
local gained = 0

function Training.init(ctx)
	C = ctx
end

local function ownBelt(): BasePart?
	local d = C.State.get()
	if not d or not d.baseIndex then
		return nil
	end
	local base = Workspace.Bases:FindFirstChild("Base_" .. d.baseIndex)
	local tm = base and base.Visuals:FindFirstChild("Treadmill")
	return tm and tm:FindFirstChild("Belt") :: BasePart? or nil
end

function Training.isOnTreadmill(): boolean
	local belt = ownBelt()
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not belt or not root then
		return false
	end
	local rel = belt.CFrame:PointToObjectSpace(root.Position)
	return math.abs(rel.X) < belt.Size.X / 2 + 0.5 and math.abs(rel.Z) < belt.Size.Z / 2 + 0.5 and rel.Y > 0 and rel.Y < 7
end

function Training.start()
	task.spawn(function()
		while true do
			task.wait(0.25)
			local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
			if hum and hum.MoveDirection.Magnitude > 0.1 and Training.isOnTreadmill() then
				Net.send("TrainPing", true)
			end
		end
	end)
	C.State.Changed:Connect(function(d)
		if lastSpeed and d.speed > lastSpeed then
			gained += d.speed - lastSpeed
		end
		lastSpeed = d.speed
	end)
	game:GetService("RunService").Heartbeat:Connect(function(dt)
		popAcc += dt
		if popAcc > 0.6 and gained > 0 then
			popAcc = 0
			local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			if root then
				C.Effects.floatingText(root.Position + Vector3.new(math.random(-2, 2), 3, 0), "+" .. NF.format(gained) .. " ⚡", Color3.fromRGB(120, 210, 255))
			end
			gained = 0
		end
	end)
end

return Training
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000034"><Properties><string name="Name">Tutorial</string><ProtectedString name="Source"><![CDATA[--[[
	Tutorial — one short objective at a time + a glowing beam from the player to the target.
	Disappears once all objectives are done (progress comes from the server).
]]

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Net = require(ReplicatedStorage.Shared.Util.Net)
local Kit = require(script.Parent.Parent.UI.Kit)

local Tutorial = {}
local C
local player = Players.LocalPlayer
local T = Kit.Theme

-- mirrors server/Systems/Tutorial.luau
local STEPS = {
	{ key = "SeeBase", text = "Esta é a sua base! Seus ovos e criaturas ficam aqui." },
	{ key = "StealEgg", text = "Vá ao Bosque de Arcádia e ROUBE um ovo (segure E)." },
	{ key = "Deposit", text = "Volte para a sua base com o ovo para depositá-lo." },
	{ key = "Hatch", text = "Espere o ovo chocar na incubadora." },
	{ key = "Collect", text = "Pise na plataforma dourada para coletar o GOLD dos pets." },
	{ key = "Train", text = "Corra na esteira da sua base para ganhar Speed." },
	{ key = "BuyTrail", text = "Compre seu primeiro Trail (multiplica o treino)." },
	{ key = "UnlockBiome", text = "Alcance 150 Speed e desbloqueie a Costa do Mar Egeu." },
	{ key = "OpenIndex", text = "Abra o Index e veja todas as criaturas." },
	{ key = "RaidTip", text = "Dica: você pode roubar ovos que estão incubando em outras bases!" },
}

local bar, textLabel, beam, a0, a1, targetPart
local currentKey = nil
local raidTipShownAt = nil

function Tutorial.init(ctx)
	C = ctx
end

local function baseModel()
	local d = C.State.get()
	return d and d.baseIndex and Workspace.Bases:FindFirstChild("Base_" .. d.baseIndex)
end

local function targetFor(key: string): Vector3?
	local base = baseModel()
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if key == "SeeBase" or key == "Deposit" or key == "Hatch" then
		return base and base.PrimaryPart and (base.PrimaryPart.CFrame * CFrame.new(0, 3, -14)).Position
	elseif key == "StealEgg" then
		local best, bd = nil, math.huge
		for _, egg in CollectionService:GetTagged("WorldEgg") do
			local pp = egg.PrimaryPart
			if pp and egg:GetAttribute("Biome") == 1 and root then
				local d = (pp.Position - root.Position).Magnitude
				if d < bd then
					best, bd = pp.Position, d
				end
			end
		end
		return best
	elseif key == "Collect" then
		local pad = base and base:FindFirstChild("CollectPad")
		return pad and pad.Position
	elseif key == "Train" or key == "UnlockBiome" then
		local tm = base and base.Visuals:FindFirstChild("Treadmill")
		return tm and tm.PrimaryPart and tm.PrimaryPart.Position
	elseif key == "BuyTrail" then
		local k = Workspace.Map.ShopPlaza:FindFirstChild("Kiosk_Trails")
		return k and k.PrimaryPart and k.PrimaryPart.Position
	end
	return nil
end

local function refresh(d)
	local done = d.tutDone or {}
	local step = nil
	local idx = d.tutorial or 1
	if idx > #STEPS then
		bar.Visible = false
		beam.Enabled = false
		currentKey = nil
		return
	end
	for _, s in STEPS do
		if not done[s.key] then
			step = s
			break
		end
	end
	step = step or STEPS[math.clamp(idx, 1, #STEPS)]
	currentKey = step.key
	bar.Visible = true
	textLabel.Text = "🎯 " .. step.text
	if step.key == "RaidTip" and not raidTipShownAt then
		raidTipShownAt = os.clock()
		task.delay(12, function()
			Net.request("TutorialStep", { key = "RaidTip" })
		end)
	end
end

function Tutorial.markIndexOpened()
	if currentKey == "OpenIndex" then
		Net.request("TutorialStep", { key = "OpenIndex" })
	end
end

function Tutorial.start()
	local screen = Kit.screen("SAG_Tutorial", 3)
	Kit.autoScale(screen)
	bar = Kit.new("Frame", { BackgroundColor3 = T.Panel, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 82), Size = UDim2.fromOffset(520, 44), Visible = false, Parent = screen })
	Kit.corner(bar, 14)
	Kit.stroke(bar, T.Good, 2.5)
	Kit.gradient(bar, T.PanelLight, T.Panel)
	textLabel = Kit.label({ Text = "", Parent = bar, Size = UDim2.new(1, -20, 1, -8), Position = UDim2.fromOffset(10, 4), MaxTextSize = 20 })

	targetPart = Instance.new("Part")
	targetPart.Anchored = true
	targetPart.CanCollide = false
	targetPart.CanQuery = false
	targetPart.Transparency = 1
	targetPart.Size = Vector3.one
	targetPart.Parent = Workspace
	a1 = Instance.new("Attachment")
	a1.Parent = targetPart
	beam = Instance.new("Beam")
	beam.Color = ColorSequence.new(Color3.fromRGB(120, 255, 160), Color3.fromRGB(255, 240, 140))
	beam.Width0 = 0.6
	beam.Width1 = 0.6
	beam.FaceCamera = true
	beam.LightEmission = 1
	beam.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	beam.TextureSpeed = 2
	beam.TextureLength = 4
	beam.Transparency = NumberSequence.new(0.2)
	beam.Attachment1 = a1
	beam.Enabled = false
	beam.Parent = targetPart

	C.State.Changed:Connect(function(d, partial)
		if not partial then
			refresh(d)
		end
	end)
	task.spawn(function()
		while true do
			task.wait(0.5)
			local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			local target = currentKey and targetFor(currentKey)
			if root and target then
				if not a0 or a0.Parent ~= root then
					a0 = Instance.new("Attachment")
					a0.Parent = root
					beam.Attachment0 = a0
				end
				targetPart.Position = target + Vector3.new(0, 2, 0)
				beam.Enabled = (target - root.Position).Magnitude > 10
			else
				beam.Enabled = false
			end
		end
	end)
end

return Tutorial
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000035"><Properties><string name="Name">World</string><ProtectedString name="Source"><![CDATA[--[[
	World — client-side world presentation:
	  • locked gates become solid for this player (server double-checks positions)
	  • per-biome lighting/atmosphere and mythology music; world-event lighting overrides
	  • special egg tracker (screen-edge arrow + distance)
	  • proximity prompt routing: kiosks open panels, pets open the info card, your own
	    incubating eggs don't show a "steal" prompt; egg info card when looking at an egg
]]

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local Balance = require(Shared.Config.Balance)
local Creatures = require(Shared.Config.Creatures)
local GameConfig = require(Shared.Config.GameConfig)
local Formulas = require(Shared.Util.Formulas)
local NF = require(Shared.Util.NumberFormatter)
local Net = require(Shared.Util.Net)
local Kit = require(script.Parent.Parent.UI.Kit)

local World = {}
local C
local player = Players.LocalPlayer
local T = Kit.Theme

local BIOME_LIGHT = {
	[0] = { ClockTime = 14, Ambient = Color3.fromRGB(110, 110, 130), Fog = Color3.fromRGB(200, 215, 240), Density = 0.28, Myth = "Hub" },
	{ ClockTime = 13, Ambient = Color3.fromRGB(110, 130, 100), Fog = Color3.fromRGB(210, 235, 200), Density = 0.25, Myth = "Greek" },
	{ ClockTime = 15, Ambient = Color3.fromRGB(100, 130, 150), Fog = Color3.fromRGB(180, 220, 245), Density = 0.25, Myth = "Greek" },
	{ ClockTime = 17.8, Ambient = Color3.fromRGB(80, 60, 50), Fog = Color3.fromRGB(110, 80, 60), Density = 0.42, Myth = "Greek" },
	{ ClockTime = 12, Ambient = Color3.fromRGB(150, 140, 110), Fog = Color3.fromRGB(255, 245, 220), Density = 0.3, Myth = "Greek" },
	{ ClockTime = 10, Ambient = Color3.fromRGB(100, 120, 100), Fog = Color3.fromRGB(190, 210, 200), Density = 0.32, Myth = "Norse" },
	{ ClockTime = 9, Ambient = Color3.fromRGB(120, 140, 170), Fog = Color3.fromRGB(220, 235, 255), Density = 0.45, Myth = "Norse" },
	{ ClockTime = 20, Ambient = Color3.fromRGB(120, 60, 40), Fog = Color3.fromRGB(90, 40, 30), Density = 0.4, Myth = "Norse" },
	{ ClockTime = 16, Ambient = Color3.fromRGB(140, 120, 90), Fog = Color3.fromRGB(255, 225, 170), Density = 0.3, Myth = "Norse" },
	{ ClockTime = 11, Ambient = Color3.fromRGB(130, 130, 100), Fog = Color3.fromRGB(245, 230, 190), Density = 0.3, Myth = "Egyptian" },
	{ ClockTime = 18.5, Ambient = Color3.fromRGB(110, 90, 70), Fog = Color3.fromRGB(200, 160, 110), Density = 0.38, Myth = "Egyptian" },
	{ ClockTime = 0.8, Ambient = Color3.fromRGB(70, 50, 110), Fog = Color3.fromRGB(50, 30, 80), Density = 0.5, Myth = "Egyptian" },
	{ ClockTime = 12.5, Ambient = Color3.fromRGB(170, 140, 80), Fog = Color3.fromRGB(255, 220, 140), Density = 0.32, Myth = "Egyptian" },
}

local currentBiome = -1
local eventActive = nil
local special = nil -- {position}
local arrow
local eggCard

function World.init(ctx)
	C = ctx
end

local function applyLighting(cfg, eventCfg)
	local atmo = Lighting:FindFirstChildOfClass("Atmosphere")
	local info = TweenInfo.new(2.5)
	if eventCfg then
		TweenService:Create(Lighting, info, { ClockTime = eventCfg.ClockTime, Brightness = eventCfg.Brightness, Ambient = eventCfg.Ambient, OutdoorAmbient = eventCfg.OutdoorAmbient }):Play()
		if atmo then
			TweenService:Create(atmo, info, { Color = eventCfg.FogColor, Density = 0.4 }):Play()
		end
		return
	end
	TweenService:Create(Lighting, info, { ClockTime = cfg.ClockTime, Ambient = cfg.Ambient, Brightness = 2.2, OutdoorAmbient = cfg.Ambient:Lerp(Color3.new(1, 1, 1), 0.15) }):Play()
	if atmo then
		TweenService:Create(atmo, info, { Color = cfg.Fog, Density = cfg.Density }):Play()
	end
end

local function eventLighting()
	if not eventActive then
		return nil
	end
	for _, e in GameConfig.Events do
		if e.id == eventActive then
			return e.lighting
		end
	end
	return nil
end

local function updateGates()
	local d = C.State.get()
	local speed = d and d.speed or 0
	local map = Workspace:FindFirstChild("Map")
	if not map then
		return
	end
	for _, biome in map:GetChildren() do
		local gate = biome:FindFirstChild("Gate_" .. tostring(biome:GetAttribute("BiomeId")))
		local barrier = gate and gate:FindFirstChild("Barrier")
		if barrier then
			local req = barrier:GetAttribute("RequiredSpeed") or 0
			local locked = speed < req
			barrier.CanCollide = locked
			barrier.Transparency = locked and 0.55 or 1
			local board = gate:FindFirstChild("RequirementBoard")
			if board then
				board.Transparency = locked and 0.2 or 1
				local label = board:FindFirstChild("RequirementLabel", true)
				if label then
					label.Text = locked and ("🔒 " .. NF.format(req) .. " SPEED") or ""
				end
			end
		end
	end
end

-- ===================== EGG INFO CARD =====================
local function showEggCard(model: Model)
	if not eggCard then
		return
	end
	local biome = model:GetAttribute("Biome") or 1
	local variant = model:GetAttribute("Variant") or "normal"
	local size = model:GetAttribute("Size") or "Normal"
	eggCard.Visible = true
	eggCard.Title.Text = model:GetAttribute("EggName") or "Ovo"
	local b = Formulas.biome(biome)
	local difficulty = ({ "Muito fácil", "Fácil", "Médio", "Médio", "Difícil", "Difícil", "Muito difícil", "Muito difícil", "Extremo", "Extremo", "Lendário", "Lendário" })[biome]
	local pen = Balance.speed.carryPenaltyBySize[size] or 0
	local lines = {
		"Raridade: " .. (model:GetAttribute("Rarity") or "?") .. "   •   Bioma: " .. b.name,
		"Tamanho: " .. Formulas.size(size).eggName .. " (x" .. Formulas.size(size).mult .. " renda, −" .. math.floor(pen * 100) .. "% velocidade)",
		"Mutação: " .. (model:GetAttribute("Mutation") or "None") .. "   •   Dificuldade: " .. difficulty,
	}
	local weights = Balance.speciesHatchWeights[variant] or Balance.speciesHatchWeights.normal
	local eventId = model:GetAttribute("EventId")
	local contents = {}
	if variant == "event" and eventId and Creatures.Events[eventId] then
		table.insert(contents, Creatures.Events[eventId].name .. " 100%")
	else
		local total = 0
		for _, w in weights do
			total += w
		end
		for slot = 1, 4 do
			local c = Creatures.ByBiome[biome][slot]
			table.insert(contents, c.name .. " " .. math.floor(weights[slot] / total * 1000 + 0.5) / 10 .. "%")
		end
	end
	table.insert(lines, "Pode conter: " .. table.concat(contents, ", "))
	eggCard.Body.Text = table.concat(lines, "\n")
end

local function buildUi()
	local screen = Kit.screen("SAG_World", 2)
	Kit.autoScale(screen)
	-- the arrow lives in an unscaled, inset-free screen so viewport coordinates map 1:1
	local arrowScreen = Kit.screen("SAG_Tracker", 3)
	arrowScreen.IgnoreGuiInset = true
	arrow = Kit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(70, 70), AnchorPoint = Vector2.new(0.5, 0.5), Visible = false, Parent = arrowScreen })
	Kit.label({ Text = "➤", Parent = arrow, Name = "Glyph", TextColor3 = Color3.fromRGB(255, 230, 120), stroke = true })
	Kit.label({ Text = "", Parent = arrow, Name = "Dist", Size = UDim2.fromOffset(120, 24), Position = UDim2.new(0.5, -60, 1, 0), MaxTextSize = 18 })
	eggCard = Kit.new("Frame", { BackgroundColor3 = T.Panel, AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -150), Size = UDim2.fromOffset(560, 130), Visible = false, Parent = screen })
	Kit.corner(eggCard, 14)
	Kit.stroke(eggCard, T.Gold, 2.5)
	Kit.gradient(eggCard, T.PanelLight, T.Panel)
	local title = Kit.label({ Text = "", Parent = eggCard, Size = UDim2.new(1, -20, 0, 30), Position = UDim2.fromOffset(10, 4), MaxTextSize = 24, TextColor3 = T.Gold })
	title.Name = "Title"
	local body = Kit.label({ Text = "", Parent = eggCard, Size = UDim2.new(1, -20, 1, -40), Position = UDim2.fromOffset(10, 36), Font = T.FontBody, MaxTextSize = 16, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top })
	body.Name = "Body"
end

local function handlePrompt(prompt: ProximityPrompt)
	-- hide the steal prompt on your own incubating eggs
	if prompt.Name == "RaidPrompt" and prompt:GetAttribute("Owner") == player.UserId then
		prompt.Enabled = false
	end
end

function World.start()
	buildUi()
	C.State.Changed:Connect(function(_, partial)
		updateGates()
	end)
	C.State.WorldChanged:Connect(function(w)
		eventActive = w.event
		applyLighting(BIOME_LIGHT[math.max(currentBiome, 0)], eventLighting())
	end)
	Net.listen("Announce", function(a)
		if a.type == "SpecialEggSpawned" then
			special = { position = a.position }
		elseif a.type == "SpecialEggTaken" or a.type == "SpecialEggGone" then
			special = nil
		end
	end)

	-- prompts
	for _, d in Workspace:GetDescendants() do
		if d:IsA("ProximityPrompt") then
			handlePrompt(d)
		end
	end
	Workspace.DescendantAdded:Connect(function(d)
		if d:IsA("ProximityPrompt") then
			task.defer(handlePrompt, d)
		end
	end)
	ProximityPromptService.PromptTriggered:Connect(function(prompt)
		local panel = prompt:GetAttribute("OpenPanel")
		if panel then
			C.Panels.open(panel)
		elseif prompt:GetAttribute("Inspect") then
			local model = prompt:FindFirstAncestorOfClass("Model")
			if model then
				C.PetInfoUI.show(model)
			end
		end
	end)
	ProximityPromptService.PromptShown:Connect(function(prompt)
		if prompt.Name == "StealPrompt" or prompt.Name == "RaidPrompt" then
			local model = prompt:FindFirstAncestorOfClass("Model")
			if model then
				showEggCard(model)
			end
		end
	end)
	ProximityPromptService.PromptHidden:Connect(function(prompt)
		if (prompt.Name == "StealPrompt" or prompt.Name == "RaidPrompt") and eggCard then
			eggCard.Visible = false
		end
	end)

	local acc = 0
	RunService.RenderStepped:Connect(function(dt)
		acc += dt
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if not root then
			return
		end
		if acc > 0.5 then
			acc = 0
			local z = root.Position.Z
			local W = GameConfig.World
			local b = z < W.HubLength and 0 or math.clamp(math.floor((z - W.HubLength) / W.BiomeLength) + 1, 1, 12)
			if b ~= currentBiome then
				currentBiome = b
				applyLighting(BIOME_LIGHT[b], eventLighting())
				C.Sound.music(BIOME_LIGHT[b].Myth)
				if b > 0 then
					C.Notifications.toast("Unlock", "Você entrou em", Formulas.biome(b).name)
				end
			end
		end
		-- special egg arrow
		if special and arrow then
			local cam = Workspace.CurrentCamera
			local pos, onScreen = cam:WorldToViewportPoint(special.position)
			local dist = (special.position - root.Position).Magnitude
			arrow.Visible = true
			arrow.Dist.Text = math.floor(dist) .. " studs"
			local vs = cam.ViewportSize
			if onScreen and pos.Z > 0 then
				arrow.Position = UDim2.fromOffset(pos.X, pos.Y - 60)
				arrow.Glyph.Rotation = 90
			else
				local dir = Vector2.new(pos.X - vs.X / 2, pos.Y - vs.Y / 2)
				if pos.Z < 0 then
					dir = -dir
				end
				if dir.Magnitude < 1 then
					dir = Vector2.new(0, -1)
				end
				dir = dir.Unit
				local edge = Vector2.new(vs.X / 2, vs.Y / 2) + dir * (math.min(vs.X, vs.Y) / 2 - 60)
				arrow.Position = UDim2.fromOffset(edge.X, edge.Y)
				arrow.Glyph.Rotation = math.deg(math.atan2(dir.Y, dir.X))
			end
		elseif arrow then
			arrow.Visible = false
		end
	end)
end

return World
]]></ProtectedString></Properties></Item></Item><Item class="ModuleScript" referent="RBX00000037"><Properties><string name="Name">State</string><ProtectedString name="Source"><![CDATA[--[[
	State — client-side mirror of the player's profile snapshot (read-only; the server is the
	authority). Merges partial money/speed updates and fires Changed.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Net = require(ReplicatedStorage.Shared.Util.Net)
local Signal = require(ReplicatedStorage.Shared.Util.Signal)

local State = {}
State.data = nil
State.Changed = Signal.new() -- (data, isPartial)
State.World = { event = nil, endsAt = nil, nextSpecialAt = nil }
State.WorldChanged = Signal.new()

function State.start()
	Net.listen("State", function(snap)
		if snap.partial then
			if State.data then
				for k, v in snap do
					if k ~= "partial" then
						State.data[k] = v
					end
				end
				State.Changed:Fire(State.data, true)
			end
		else
			State.data = snap
			State.Changed:Fire(State.data, false)
		end
	end)
	Net.listen("WorldState", function(ws)
		State.World.event = ws.event
		State.World.endsAt = ws.endsAt
		if ws.nextSpecialAt then
			State.World.nextSpecialAt = ws.nextSpecialAt
		end
		State.WorldChanged:Fire(State.World)
	end)
end

function State.get()
	return State.data
end

function State.now(): number
	return workspace:GetServerTimeNow()
end

function State.hasPass(key: string): boolean
	local d = State.data
	return d ~= nil and d.passes ~= nil and table.find(d.passes, key) ~= nil
end

return State
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX00000041"><Properties><string name="Name">UI</string></Properties><Item class="ModuleScript" referent="RBX00000038"><Properties><string name="Name">EventsUI</string><ProtectedString name="Source"><![CDATA[--[[
	EventsUI — current world event (timer + description), the next Divine Egg countdown and the
	list of all world events with what they bring.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Shared = ReplicatedStorage.Shared
local Creatures = require(Shared.Config.Creatures)
local GameConfig = require(Shared.Config.GameConfig)
local NF = require(Shared.Util.NumberFormatter)
local Kit = require(script.Parent.Kit)

local EventsUI = {}
local C
local T = Kit.Theme
local panel, header, specialLabel, body

function EventsUI.init(ctx)
	C = ctx
end

function EventsUI.render()
	for _, ch in body:GetChildren() do
		if ch:IsA("GuiObject") then
			ch:Destroy()
		end
	end
	for i, e in GameConfig.Events do
		local f = Kit.card(body, e.color, i)
		f.Size = UDim2.new(1, -10, 0, 96)
		local exclusive = Creatures.Events[e.id]
		Kit.label({ Text = "🎉 " .. e.name .. (C.State.World.event == e.id and "  (AGORA!)" or ""), Parent = f, Size = UDim2.new(1, -20, 0, 30), Position = UDim2.fromOffset(10, 4), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = e.color, MaxTextSize = 24 })
		Kit.label({ Text = e.desc, Parent = f, Size = UDim2.new(1, -20, 0, 30), Position = UDim2.fromOffset(10, 34), TextXAlignment = Enum.TextXAlignment.Left, Font = T.FontBody, MaxTextSize = 15 })
		Kit.label({ Text = "Criatura exclusiva: " .. (exclusive and (exclusive.name .. " (" .. exclusive.rarity .. ")") or "—"), Parent = f, Size = UDim2.new(1, -20, 0, 24), Position = UDim2.fromOffset(10, 66), TextXAlignment = Enum.TextXAlignment.Left, Font = T.FontBody, TextColor3 = T.Gold, MaxTextSize = 15 })
	end
end

function EventsUI.start()
	panel = Kit.panel(C.Panels.screen, "🎉 EVENTOS", Color3.fromRGB(255, 90, 90))
	header = Kit.label({ Text = "", Parent = panel.content, Size = UDim2.new(1, 0, 0, 30), MaxTextSize = 24 })
	specialLabel = Kit.label({ Text = "", Parent = panel.content, Position = UDim2.fromOffset(0, 32), Size = UDim2.new(1, 0, 0, 26), Font = T.FontBody, MaxTextSize = 18, TextColor3 = Color3.fromRGB(255, 230, 120) })
	body = Kit.scroll(panel.content, { Position = UDim2.fromOffset(0, 66), Size = UDim2.new(1, 0, 1, -66) })
	Kit.list(body, 8)
	Kit.padding(body, 4)
	C.Panels.register("Events", panel, EventsUI.render)
	RunService.Heartbeat:Connect(function()
		if not panel.frame.Visible then
			return
		end
		local w = C.State.World
		local now = C.State.now()
		if w.event and w.endsAt then
			local name = w.event
			for _, e in GameConfig.Events do
				if e.id == w.event then
					name = e.name
				end
			end
			header.Text = "Evento ativo: " .. name .. " — termina em " .. NF.time(w.endsAt - now)
		else
			header.Text = "Nenhum evento ativo no momento"
		end
		specialLabel.Text = w.nextSpecialAt and ("🥚 Próximo Ovo Divino em " .. NF.time(w.nextSpecialAt - now) .. " (a cada 5 minutos)") or ""
	end)
end

return EventsUI
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000039"><Properties><string name="Name">IndexUI</string><ProtectedString name="Source"><![CDATA[--[[
	IndexUI — the collection book. Tabs per mythology (+ Eventos); each biome is a row of 4
	creatures. Discovered creatures show in 3D with their rarity color; unknown ones are dark
	silhouettes. Shows completion %, per mythology/biome counts, discovered sizes & mutations,
	description, ability and base income. Collection rewards are claimed in the Rewards panel.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local Balance = require(Shared.Config.Balance)
local Creatures = require(Shared.Config.Creatures)
local Formulas = require(Shared.Util.Formulas)
local NF = require(Shared.Util.NumberFormatter)
local ModelFactory = require(Shared.Factory.ModelFactory)
local Kit = require(script.Parent.Kit)

local IndexUI = {}
local C
local T = Kit.Theme
local panel, body, summary, detail
local tab = "Greek"

function IndexUI.init(ctx)
	C = ctx
end

local function countDiscovered(index, filter)
	local n, total = 0, 0
	for _, c in Creatures.List do
		if filter(c) then
			total += 1
			if index[c.id] then
				n += 1
			end
		end
	end
	return n, total
end

local function showDetail(c, entry)
	detail.Visible = true
	for _, ch in detail:GetChildren() do
		if not ch:IsA("UIListLayout") and not ch:IsA("UIPadding") and not ch:IsA("UICorner") and not ch:IsA("UIStroke") then
			ch:Destroy()
		end
	end
	local known = entry ~= nil
	local vp = Kit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 140), LayoutOrder = 1, Parent = detail })
	Kit.viewport(vp, ModelFactory.creature(c.id, "Normal", "None"), { silhouette = not known })
	Kit.label({ Text = known and c.name or "???", Parent = detail, Size = UDim2.new(1, 0, 0, 28), MaxTextSize = 24, LayoutOrder = 2 })
	Kit.label({ Text = c.rarity .. " • " .. (c.biome > 0 and Formulas.biome(c.biome).name or "Evento"), Parent = detail, Size = UDim2.new(1, 0, 0, 20), TextColor3 = Kit.rarityColor(c.rarity), MaxTextSize = 16, LayoutOrder = 3 })
	Kit.label({ Text = known and c.desc or "Ainda não descoberta. Choque um ovo deste bioma para encontrá-la!", Parent = detail, Size = UDim2.new(1, 0, 0, 40), Font = T.FontBody, MaxTextSize = 14, LayoutOrder = 4 })
	Kit.label({ Text = "✦ " .. c.ab.name .. ": " .. c.ab.desc, Parent = detail, Size = UDim2.new(1, 0, 0, 40), Font = T.FontBody, TextColor3 = Kit.mythColor(c.mythology), MaxTextSize = 14, LayoutOrder = 5 })
	local base = Formulas.speciesBaseIncome(c.id, 1)
	Kit.label({ Text = "Renda base: " .. NF.format(base) .. "/s" .. (c.biome == 0 and " (escala com o bioma do evento)" or ""), Parent = detail, Size = UDim2.new(1, 0, 0, 20), Font = T.FontBody, TextColor3 = T.Gold, MaxTextSize = 14, LayoutOrder = 6 })
	if known then
		local sizes, muts = {}, {}
		for _, s in Balance.sizes do
			table.insert(sizes, (entry.s[s.name] and "✔" or "✖") .. s.name)
		end
		for _, m in Balance.mutations do
			if m.name ~= "None" then
				table.insert(muts, (entry.m[m.name] and "✔" or "✖") .. m.name)
			end
		end
		Kit.label({ Text = "Tamanhos: " .. table.concat(sizes, " ") .. "\nMutações: " .. table.concat(muts, " ") .. "\nObtidos: " .. entry.n, Parent = detail, Size = UDim2.new(1, 0, 0, 66), Font = T.FontBody, MaxTextSize = 13, LayoutOrder = 7 })
	end
end

function IndexUI.render()
	local d = C.State.get()
	if not d or not panel.frame.Visible then
		return
	end
	local index = d.index or {}
	for _, ch in body:GetChildren() do
		if ch:IsA("GuiObject") then
			ch:Destroy()
		end
	end
	local all, total = countDiscovered(index, function()
		return true
	end)
	local parts = { string.format("📖 %d / %d  (%.0f%%)", all, total, all / total * 100) }
	for _, m in { "Greek", "Norse", "Egyptian", "Event" } do
		local n, t = countDiscovered(index, function(c)
			return c.mythology == m
		end)
		table.insert(parts, ({ Greek = "Gregos", Norse = "Nórdicos", Egyptian = "Egípcios", Event = "Eventos" })[m] .. " " .. n .. "/" .. t)
	end
	summary.Text = table.concat(parts, "   •   ")

	local order = 0
	local function section(title: string, list)
		order += 1
		local n = 0
		for _, c in list do
			if index[c.id] then
				n += 1
			end
		end
		Kit.label({ Text = title .. "  (" .. n .. "/" .. #list .. ")", Parent = body, Size = UDim2.new(1, -10, 0, 28), TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 22, LayoutOrder = order })
		order += 1
		local row = Kit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, -10, 0, 130), LayoutOrder = order, Parent = body })
		Kit.list(row, 8, true)
		for i, c in list do
			local entry = index[c.id]
			local rc = Kit.rarityColor(c.rarity)
			local cell = Kit.new("TextButton", { Text = "", AutoButtonColor = false, BackgroundColor3 = T.PanelLight, Size = UDim2.fromOffset(120, 128), LayoutOrder = i, Parent = row })
			Kit.corner(cell, 12)
			Kit.stroke(cell, entry and rc or Color3.fromRGB(70, 70, 90), 2.5)
			local vpHolder = Kit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0.72, 0), Parent = cell })
			Kit.viewport(vpHolder, ModelFactory.creature(c.id, "Normal", "None"), { silhouette = entry == nil })
			Kit.label({ Text = entry and c.name or "???", Parent = cell, Size = UDim2.new(1, -6, 0.15, 0), Position = UDim2.new(0, 3, 0.7, 0), MaxTextSize = 14 })
			Kit.label({ Text = c.rarity, Parent = cell, Size = UDim2.new(1, -6, 0.13, 0), Position = UDim2.new(0, 3, 0.85, 0), Font = T.FontBody, TextColor3 = rc, MaxTextSize = 12 })
			cell.Activated:Connect(function()
				Kit.playClick()
				showDetail(c, entry)
			end)
		end
	end
	if tab == "Event" then
		local list = {}
		for _, c in Creatures.List do
			if c.biome == 0 then
				table.insert(list, c)
			end
		end
		section("🎉 Criaturas de Evento", list)
	else
		for b = 1, 12 do
			local biome = Formulas.biome(b)
			if biome.mythology == tab then
				local list = {}
				for slot = 1, 4 do
					table.insert(list, Creatures.ByBiome[b][slot])
				end
				section("🗺 " .. biome.name, list)
			end
		end
	end
end

function IndexUI.start()
	panel = Kit.panel(C.Panels.screen, "📖 INDEX DO PANTEÃO", Color3.fromRGB(90, 220, 140))
	summary = Kit.label({ Text = "", Parent = panel.content, Size = UDim2.new(1, 0, 0, 24), MaxTextSize = 18, Font = T.FontBody })
	local tabHolder = Kit.new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 28), Size = UDim2.new(0.66, 0, 0, 40), Parent = panel.content })
	local setTab = Kit.tabs(tabHolder, { "Gregos", "Nórdicos", "Egípcios", "Eventos" }, function(name)
		tab = ({ Gregos = "Greek", ["Nórdicos"] = "Norse", ["Egípcios"] = "Egyptian", Eventos = "Event" })[name]
		IndexUI.render()
	end, Color3.fromRGB(90, 220, 140))
	body = Kit.scroll(panel.content, { Position = UDim2.fromOffset(0, 76), Size = UDim2.new(0.66, -8, 1, -76) })
	Kit.list(body, 6)
	detail = Kit.new("Frame", { BackgroundColor3 = T.Panel, Position = UDim2.new(0.66, 4, 0, 30), Size = UDim2.new(0.34, -4, 1, -30), Visible = false, Parent = panel.content })
	Kit.corner(detail, 14)
	Kit.stroke(detail, Color3.fromRGB(90, 220, 140), 2)
	Kit.padding(detail, 8)
	Kit.list(detail, 4)
	C.Panels.register("Index", panel, function()
		setTab(({ Greek = "Gregos", Norse = "Nórdicos", Egyptian = "Egípcios", Event = "Eventos" })[tab])
		C.Tutorial.markIndexOpened()
	end)
	C.State.Changed:Connect(function(_, partial)
		if not partial then
			IndexUI.render()
		end
	end)
end

return IndexUI
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000003A"><Properties><string name="Name">InventoryUI</string><ProtectedString name="Source"><![CDATA[--[[
	InventoryUI — your creatures: 3D cards (ViewportFrame) sorted by income, with rarity border,
	size, mutation, income/s; selecting one shows its ability and lets you EQUIP it as the active
	divine companion or SELL it. Capacity is shown (pets / pet slots).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local Creatures = require(Shared.Config.Creatures)
local Formulas = require(Shared.Util.Formulas)
local NF = require(Shared.Util.NumberFormatter)
local Net = require(Shared.Util.Net)
local ModelFactory = require(Shared.Factory.ModelFactory)
local Kit = require(script.Parent.Kit)

local InventoryUI = {}
local C
local T = Kit.Theme
local panel, grid, details, capLabel
local selected = nil

function InventoryUI.init(ctx)
	C = ctx
end

local function petTitle(pet)
	local c = Creatures.ById[pet.species]
	return (pet.mutation ~= "None" and (pet.mutation .. " ") or "") .. (pet.size ~= "Normal" and (pet.size .. " ") or "") .. (c and c.name or pet.species)
end

local function showDetails(pet)
	selected = pet and pet.uid
	for _, ch in details:GetChildren() do
		if not ch:IsA("UIListLayout") then
			ch:Destroy()
		end
	end
	if not pet then
		Kit.label({ Text = "Selecione um pet", Parent = details, Size = UDim2.new(1, 0, 0, 40), MaxTextSize = 22 })
		return
	end
	local d = C.State.get()
	local c = Creatures.ById[pet.species]
	local rc = Kit.rarityColor(c and c.rarity)
	local vpHolder = Kit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 150), LayoutOrder = 1, Parent = details })
	Kit.viewport(vpHolder, ModelFactory.creature(pet.species, pet.size, pet.mutation))
	Kit.label({ Text = petTitle(pet), Parent = details, Size = UDim2.new(1, 0, 0, 30), MaxTextSize = 24, LayoutOrder = 2 })
	Kit.label({ Text = (c and c.rarity or "?") .. " • " .. (c and c.mythology or ""), Parent = details, Size = UDim2.new(1, 0, 0, 22), TextColor3 = rc, MaxTextSize = 18, LayoutOrder = 3 })
	Kit.label({ Text = "💰 " .. NF.format(pet.income) .. "/s   •   Tamanho x" .. Formulas.size(pet.size).mult .. "   •   Mutação x" .. Formulas.mutation(pet.mutation).mult, Parent = details, Size = UDim2.new(1, 0, 0, 22), Font = T.FontBody, MaxTextSize = 15, LayoutOrder = 4 })
	if c then
		Kit.label({ Text = "✦ " .. c.ab.name .. " (recarga " .. c.ab.cd .. "s)\n" .. c.ab.desc, Parent = details, Size = UDim2.new(1, 0, 0, 52), Font = T.FontBody, TextColor3 = Kit.mythColor(c.mythology), MaxTextSize = 15, LayoutOrder = 5 })
		Kit.label({ Text = c.desc, Parent = details, Size = UDim2.new(1, 0, 0, 36), Font = T.FontBody, TextColor3 = T.TextDim, MaxTextSize = 14, LayoutOrder = 6 })
	end
	local equipped = d and d.equippedPet == pet.uid
	local row = Kit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 46), LayoutOrder = 7, Parent = details })
	Kit.list(row, 8, true)
	local eb = Kit.button({ Text = equipped and "EQUIPADO" or "EQUIPAR", color = T.Accent, Size = UDim2.new(0.5, -4, 1, 0), Parent = row, LayoutOrder = 1, onClick = function()
		local ok, msg = Net.request("EquipPet", { uid = pet.uid })
		if not ok then
			C.Notifications.toast("Warning", "Pet", msg or "")
		end
	end })
	Kit.setButtonEnabled(eb, not equipped, T.Accent)
	Kit.button({ Text = "VENDER " .. NF.format(Formulas.sellValue(pet)), color = T.Bad, Size = UDim2.new(0.5, -4, 1, 0), Parent = row, LayoutOrder = 2, MaxTextSize = 18, onClick = function()
		local ok, msg = Net.request("SellPet", { uid = pet.uid })
		C.Notifications.toast(ok and "Reward" or "Warning", "Venda", msg or "")
		showDetails(nil)
	end })
end

function InventoryUI.render()
	local d = C.State.get()
	if not d or not panel.frame.Visible then
		return
	end
	for _, ch in grid:GetChildren() do
		if ch:IsA("GuiObject") then
			ch:Destroy()
		end
	end
	capLabel.Text = "Pets: " .. #d.pets .. " / " .. (d.petSlots or 0) .. "   •   Renda total: " .. NF.format(d.income) .. "/s"
	local pets = table.clone(d.pets)
	table.sort(pets, function(a, b)
		return a.income > b.income
	end)
	local found = nil
	for i, pet in pets do
		local c = Creatures.ById[pet.species]
		local rc = Kit.rarityColor(c and c.rarity)
		local cell = Kit.new("TextButton", { Text = "", AutoButtonColor = false, BackgroundColor3 = T.PanelLight, LayoutOrder = i, Parent = grid })
		Kit.corner(cell, 12)
		Kit.stroke(cell, rc, d.equippedPet == pet.uid and 4 or 2)
		Kit.gradient(cell, rc:Lerp(T.PanelLight, 0.7), T.Panel)
		if i <= 40 then -- cap viewport count for performance
			local vpHolder = Kit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0.66, 0), Parent = cell })
			Kit.viewport(vpHolder, ModelFactory.creature(pet.species, pet.size, pet.mutation))
		end
		Kit.label({ Text = c and c.name or pet.species, Parent = cell, Size = UDim2.new(1, -6, 0.17, 0), Position = UDim2.new(0, 3, 0.64, 0), MaxTextSize = 15 })
		Kit.label({ Text = NF.format(pet.income) .. "/s", Parent = cell, Size = UDim2.new(1, -6, 0.16, 0), Position = UDim2.new(0, 3, 0.82, 0), TextColor3 = T.Gold, Font = T.FontBody, MaxTextSize = 13 })
		if d.equippedPet == pet.uid then
			Kit.label({ Text = "★", Parent = cell, Size = UDim2.fromOffset(24, 24), Position = UDim2.fromOffset(4, 2), TextColor3 = T.Gold, stroke = false })
		end
		if pet.mutation ~= "None" then
			Kit.label({ Text = pet.mutation, Parent = cell, Size = UDim2.new(0.6, 0, 0, 16), Position = UDim2.new(0.4, -4, 0, 4), TextColor3 = Color3.fromRGB(255, 220, 120), Font = T.FontBody, MaxTextSize = 12, TextXAlignment = Enum.TextXAlignment.Right })
		end
		cell.Activated:Connect(function()
			Kit.playClick()
			showDetails(pet)
		end)
		if pet.uid == selected then
			found = pet
		end
	end
	showDetails(found)
end

function InventoryUI.start()
	panel = Kit.panel(C.Panels.screen, "🐉 SEUS PETS", Color3.fromRGB(110, 200, 255))
	capLabel = Kit.label({ Text = "", Parent = panel.content, Size = UDim2.new(0.62, 0, 0, 28), MaxTextSize = 20, TextXAlignment = Enum.TextXAlignment.Left })
	grid = Kit.scroll(panel.content, { Position = UDim2.fromOffset(0, 34), Size = UDim2.new(0.62, -8, 1, -34) })
	Kit.grid(grid, UDim2.fromOffset(110, 130), 8)
	Kit.padding(grid, 4)
	details = Kit.new("Frame", { BackgroundColor3 = T.Panel, Position = UDim2.new(0.62, 4, 0, 0), Size = UDim2.new(0.38, -4, 1, 0), Parent = panel.content })
	Kit.corner(details, 14)
	Kit.stroke(details, T.Accent, 2)
	Kit.padding(details, 10)
	Kit.list(details, 6)
	C.Panels.register("Inventory", panel, InventoryUI.render)
	C.State.Changed:Connect(function(_, partial)
		if not partial then
			InventoryUI.render()
		end
	end)
end

return InventoryUI
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000003B"><Properties><string name="Name">Kit</string><ProtectedString name="Source"><![CDATA[--[[
	Kit — the STEAL AN GOD UI toolkit: themed panels, buttons, labels, cards, tabs, viewports.
	Visual identity: deep celestial navy panels, gold trims, mythology accent colors, chunky
	rounded type (FredokaOne). Everything scales with UIScale for phone/tablet/console/PC.
]]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)

local Kit = {}
local T = GameConfig.Theme
Kit.Theme = T

local clickSound: Sound? = nil

function Kit.new(className: string, props, children)
	local inst = Instance.new(className)
	for k, v in props or {} do
		if k ~= "Parent" then
			(inst :: any)[k] = v
		end
	end
	for _, child in children or {} do
		child.Parent = inst
	end
	if props and props.Parent then
		inst.Parent = props.Parent
	end
	return inst
end

function Kit.corner(parent: Instance, radius: number?)
	return Kit.new("UICorner", { CornerRadius = UDim.new(0, radius or 12), Parent = parent })
end

function Kit.stroke(parent: Instance, color: Color3?, thickness: number?)
	return Kit.new("UIStroke", { Color = color or T.Gold, Thickness = thickness or 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = parent })
end

function Kit.textStroke(parent: Instance, thickness: number?)
	return Kit.new("UIStroke", { Color = Color3.fromRGB(20, 12, 40), Thickness = thickness or 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual, Parent = parent })
end

function Kit.gradient(parent: Instance, c1: Color3, c2: Color3, rotation: number?)
	return Kit.new("UIGradient", { Color = ColorSequence.new(c1, c2), Rotation = rotation or 90, Parent = parent })
end

function Kit.padding(parent: Instance, px: number)
	return Kit.new("UIPadding", { PaddingTop = UDim.new(0, px), PaddingBottom = UDim.new(0, px), PaddingLeft = UDim.new(0, px), PaddingRight = UDim.new(0, px), Parent = parent })
end

function Kit.label(props)
	local l = Kit.new("TextLabel", {
		BackgroundTransparency = 1,
		Font = props.Font or T.Font,
		TextColor3 = props.TextColor3 or T.Text,
		TextScaled = props.TextScaled ~= false,
		TextSize = props.TextSize or 18,
		Text = props.Text or "",
		Size = props.Size or UDim2.fromScale(1, 1),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Center,
		TextYAlignment = props.TextYAlignment or Enum.TextYAlignment.Center,
		TextWrapped = true,
		RichText = props.RichText == true,
		ZIndex = props.ZIndex or 1,
		Name = props.Name or "Label",
		LayoutOrder = props.LayoutOrder or 0,
		Parent = props.Parent,
	})
	if props.stroke ~= false then
		Kit.textStroke(l, props.strokeThickness or 1.5)
	end
	if props.MaxTextSize then
		Kit.new("UITextSizeConstraint", { MaxTextSize = props.MaxTextSize, Parent = l })
	end
	return l
end

function Kit.playClick()
	if not clickSound then
		clickSound = Instance.new("Sound")
		clickSound.SoundId = GameConfig.Sounds.UIClick
		clickSound.Volume = 0.4
		clickSound.Parent = game:GetService("SoundService")
	end
	if clickSound.SoundId ~= "" and Kit.sfxEnabled ~= false then
		clickSound:Play()
	end
end
Kit.sfxEnabled = true

-- Big glossy button. color = base color.
function Kit.button(props)
	local color = props.color or T.Gold
	local b = Kit.new("TextButton", {
		Name = props.Name or "Button",
		AutoButtonColor = false,
		BackgroundColor3 = color,
		Size = props.Size or UDim2.fromOffset(160, 48),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		Text = "",
		LayoutOrder = props.LayoutOrder or 0,
		ZIndex = props.ZIndex or 1,
		Parent = props.Parent,
	})
	Kit.corner(b, props.radius or 12)
	Kit.gradient(b, color:Lerp(Color3.new(1, 1, 1), 0.25), color:Lerp(Color3.new(0, 0, 0), 0.25))
	Kit.stroke(b, color:Lerp(Color3.new(0, 0, 0), 0.5), 2.5)
	local label = Kit.label({ Text = props.Text or "", Parent = b, Size = UDim2.fromScale(0.9, 0.8), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = (props.ZIndex or 1) + 1, MaxTextSize = props.MaxTextSize or 28, Name = "Label" })
	local scale = Kit.new("UIScale", { Parent = b })
	b.MouseEnter:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.12), { Scale = 1.06 }):Play()
	end)
	b.MouseLeave:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.12), { Scale = 1 }):Play()
	end)
	b.Activated:Connect(function()
		Kit.playClick()
		scale.Scale = 0.92
		TweenService:Create(scale, TweenInfo.new(0.18, Enum.EasingStyle.Back), { Scale = 1 }):Play()
		if props.onClick then
			props.onClick()
		end
	end)
	return b, label
end

function Kit.setButtonEnabled(b: GuiButton, enabled: boolean, color: Color3?)
	b.Active = enabled
	b.AutoButtonColor = false
	b.BackgroundColor3 = enabled and (color or b.BackgroundColor3) or Color3.fromRGB(90, 90, 110)
	local g = b:FindFirstChildOfClass("UIGradient")
	if g then
		g.Enabled = enabled
	end
end

-- Modal panel with header + close. Returns {frame, content, title, close}
function Kit.panel(screen: Instance, title: string, accent: Color3?, size: UDim2?)
	accent = accent or T.Gold
	local frame = Kit.new("Frame", {
		Name = "Panel_" .. title,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.52),
		Size = size or UDim2.fromScale(0.62, 0.72),
		BackgroundColor3 = T.Panel,
		Visible = false,
		Parent = screen,
	})
	Kit.new("UISizeConstraint", { MaxSize = Vector2.new(980, 680), MinSize = Vector2.new(320, 260), Parent = frame })
	Kit.corner(frame, 18)
	Kit.stroke(frame, accent, 3)
	Kit.gradient(frame, T.PanelLight, T.Panel, 90)
	local header = Kit.new("Frame", { Name = "Header", Size = UDim2.new(1, 0, 0, 56), BackgroundColor3 = accent, Parent = frame })
	Kit.corner(header, 18)
	Kit.gradient(header, accent:Lerp(Color3.new(1, 1, 1), 0.2), accent:Lerp(Color3.new(0, 0, 0), 0.35))
	-- square off the header bottom
	Kit.new("Frame", { Size = UDim2.new(1, 0, 0, 18), Position = UDim2.new(0, 0, 1, -18), BackgroundColor3 = accent:Lerp(Color3.new(0, 0, 0), 0.3), BorderSizePixel = 0, Parent = header })
	local titleLabel = Kit.label({ Text = title, Parent = header, Size = UDim2.new(1, -120, 0.8, 0), Position = UDim2.new(0, 20, 0.1, 0), TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 34, strokeThickness = 2.5 })
	local close = Kit.button({ Text = "✕", color = T.Bad, Size = UDim2.fromOffset(44, 44), Position = UDim2.new(1, -10, 0, 6), AnchorPoint = Vector2.new(1, 0), Parent = header, ZIndex = 3 })
	local content = Kit.new("Frame", { Name = "Content", BackgroundTransparency = 1, Position = UDim2.new(0, 14, 0, 66), Size = UDim2.new(1, -28, 1, -80), Parent = frame })
	return { frame = frame, content = content, title = titleLabel, close = close }
end

function Kit.scroll(parent: Instance, props)
	local s = Kit.new("ScrollingFrame", {
		Name = props and props.Name or "Scroll",
		BackgroundTransparency = 1,
		Size = props and props.Size or UDim2.fromScale(1, 1),
		Position = props and props.Position or UDim2.new(),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 8,
		ScrollBarImageColor3 = T.Gold,
		BorderSizePixel = 0,
		Parent = parent,
	})
	return s
end

function Kit.grid(parent: Instance, cellSize: UDim2, padding: number?)
	return Kit.new("UIGridLayout", { CellSize = cellSize, CellPadding = UDim2.fromOffset(padding or 10, padding or 10), SortOrder = Enum.SortOrder.LayoutOrder, HorizontalAlignment = Enum.HorizontalAlignment.Center, Parent = parent })
end

function Kit.list(parent: Instance, padding: number?, horizontal: boolean?)
	return Kit.new("UIListLayout", { Padding = UDim.new(0, padding or 8), SortOrder = Enum.SortOrder.LayoutOrder, FillDirection = horizontal and Enum.FillDirection.Horizontal or Enum.FillDirection.Vertical, HorizontalAlignment = horizontal and Enum.HorizontalAlignment.Left or Enum.HorizontalAlignment.Center, VerticalAlignment = horizontal and Enum.VerticalAlignment.Center or Enum.VerticalAlignment.Top, Parent = parent })
end

function Kit.card(parent: Instance, color: Color3?, order: number?)
	local f = Kit.new("Frame", { BackgroundColor3 = T.PanelLight, LayoutOrder = order or 0, Parent = parent })
	Kit.corner(f, 14)
	Kit.stroke(f, color or T.Accent, 2)
	return f
end

-- Tabs bar: returns setTab(name) and container
function Kit.tabs(parent: Instance, names: { string }, onChange, accent: Color3?)
	local bar = Kit.new("Frame", { Name = "Tabs", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 40), Parent = parent })
	Kit.list(bar, 6, true)
	local buttons = {}
	local function set(name)
		for n, b in buttons do
			Kit.setButtonEnabled(b, true, n == name and (accent or T.Gold) or T.PanelLight)
		end
		onChange(name)
	end
	for i, name in names do
		local b = Kit.button({ Text = name, color = T.PanelLight, Size = UDim2.new(1 / #names, -6, 1, 0), LayoutOrder = i, Parent = bar, MaxTextSize = 20, onClick = function()
			set(name)
		end })
		buttons[name] = b
	end
	return set, bar
end

-- ViewportFrame showing a model (cloned). Spins slowly if spin=true.
function Kit.viewport(parent: Instance, model: Model, props)
	local vp = Kit.new("ViewportFrame", {
		BackgroundTransparency = 1,
		Size = props and props.Size or UDim2.fromScale(1, 1),
		Position = props and props.Position or UDim2.new(),
		LightColor = Color3.fromRGB(255, 245, 230),
		Ambient = Color3.fromRGB(170, 170, 190),
		LightDirection = Vector3.new(-1, -1, -1),
		Parent = parent,
	})
	local world = Kit.new("WorldModel", { Parent = vp })
	model.Parent = world
	local cf, size = model:GetBoundingBox()
	local cam = Kit.new("Camera", { FieldOfView = 40, Parent = vp })
	local dist = size.Magnitude * 1.25 + 1
	cam.CFrame = CFrame.lookAt(cf.Position + Vector3.new(dist * 0.35, dist * 0.25, -dist), cf.Position)
	vp.CurrentCamera = cam
	if props and props.silhouette then
		vp.ImageColor3 = Color3.new(0, 0, 0)
		vp.ImageTransparency = 0.15
	end
	return vp
end

function Kit.autoScale(screen: ScreenGui)
	local scale = Kit.new("UIScale", { Parent = screen })
	local cam = workspace.CurrentCamera
	local function update()
		local v = cam.ViewportSize
		local s = math.min(v.X / 1280, v.Y / 760)
		scale.Scale = math.clamp(s, 0.55, 1.25)
	end
	cam:GetPropertyChangedSignal("ViewportSize"):Connect(update)
	update()
	return scale
end

function Kit.screen(name: string, order: number?): ScreenGui
	local player = Players.LocalPlayer
	local existing = player.PlayerGui:FindFirstChild(name)
	if existing then
		existing:Destroy()
	end
	local sg = Kit.new("ScreenGui", { Name = name, ResetOnSpawn = false, IgnoreGuiInset = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = order or 0, Parent = player.PlayerGui })
	return sg
end

function Kit.rarityColor(rarity: string?): Color3
	local Balance = require(ReplicatedStorage.Shared.Config.Balance)
	for _, r in Balance.rarities do
		if r.name == rarity then
			return Color3.fromRGB(r.color[1], r.color[2], r.color[3])
		end
	end
	return Color3.fromRGB(200, 200, 200)
end

function Kit.mythColor(m: string?): Color3
	return (m == "Greek" and T.Greek) or (m == "Norse" and T.Norse) or (m == "Egyptian" and T.Egyptian) or T.Event
end

return Kit
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000003C"><Properties><string name="Name">PetInfoUI</string><ProtectedString name="Source"><![CDATA[--[[
	PetInfoUI — card shown when inspecting a pet displayed in a base (ProximityPrompt "Ver"):
	income/s, rarity, size, mutation, ability, description; owners can equip it from here.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local Creatures = require(Shared.Config.Creatures)
local Formulas = require(Shared.Util.Formulas)
local NF = require(Shared.Util.NumberFormatter)
local Net = require(Shared.Util.Net)
local ModelFactory = require(Shared.Factory.ModelFactory)
local Kit = require(script.Parent.Kit)

local PetInfoUI = {}
local C
local T = Kit.Theme
local panel

function PetInfoUI.init(ctx)
	C = ctx
end

function PetInfoUI.show(model: Model)
	local species = model:GetAttribute("Species")
	local c = species and Creatures.ById[species]
	if not c then
		return
	end
	local content = panel.content
	for _, ch in content:GetChildren() do
		if not ch:IsA("UIListLayout") then
			ch:Destroy()
		end
	end
	local size = model:GetAttribute("Size") or "Normal"
	local mutation = model:GetAttribute("Mutation") or "None"
	local mine = model:GetAttribute("Owner") == Players.LocalPlayer.UserId
	panel.title.Text = (mutation ~= "None" and (mutation .. " ") or "") .. (size ~= "Normal" and (size .. " ") or "") .. c.name
	local vp = Kit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 160), LayoutOrder = 1, Parent = content })
	Kit.viewport(vp, ModelFactory.creature(species, size, mutation))
	Kit.label({ Text = c.rarity .. " • " .. c.mythology, Parent = content, Size = UDim2.new(1, 0, 0, 26), TextColor3 = Kit.rarityColor(c.rarity), MaxTextSize = 22, LayoutOrder = 2 })
	Kit.label({ Text = "💰 " .. NF.format(model:GetAttribute("Income") or 0) .. "/s   •   Tamanho " .. size .. " (x" .. Formulas.size(size).mult .. ")   •   " .. mutation .. " (x" .. Formulas.mutation(mutation).mult .. ")", Parent = content, Size = UDim2.new(1, 0, 0, 24), Font = T.FontBody, MaxTextSize = 17, LayoutOrder = 3 })
	Kit.label({ Text = "✦ " .. c.ab.name .. " — " .. c.ab.desc, Parent = content, Size = UDim2.new(1, 0, 0, 44), Font = T.FontBody, TextColor3 = Kit.mythColor(c.mythology), MaxTextSize = 16, LayoutOrder = 4 })
	Kit.label({ Text = c.desc, Parent = content, Size = UDim2.new(1, 0, 0, 36), Font = T.FontBody, TextColor3 = T.TextDim, MaxTextSize = 15, LayoutOrder = 5 })
	if mine then
		Kit.button({ Text = "EQUIPAR COMO COMPANHEIRO", color = T.Accent, Size = UDim2.new(0.8, 0, 0, 48), Parent = content, LayoutOrder = 6, MaxTextSize = 20, onClick = function()
			local ok, msg = Net.request("EquipPet", { uid = model:GetAttribute("Uid") })
			C.Notifications.toast(ok and "Reward" or "Warning", "Companheiro", ok and (c.name .. " equipado!") or (msg or ""))
		end })
	end
	C.Panels.open("PetInfo")
end

function PetInfoUI.start()
	panel = Kit.panel(C.Panels.screen, "PET", T.Accent, UDim2.fromScale(0.4, 0.62))
	Kit.list(panel.content, 6)
	C.Panels.register("PetInfo", panel)
end

return PetInfoUI
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000003D"><Properties><string name="Name">RewardsUI</string><ProtectedString name="Source"><![CDATA[--[[
	RewardsUI — collection rewards (Index milestones, biome sets, mythology sets) with claim
	buttons, achievements, VIP daily reward and the server ranking.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local Creatures = require(Shared.Config.Creatures)
local GameConfig = require(Shared.Config.GameConfig)
local Formulas = require(Shared.Util.Formulas)
local NF = require(Shared.Util.NumberFormatter)
local Net = require(Shared.Util.Net)
local Kit = require(script.Parent.Kit)

local RewardsUI = {}
local C
local T = Kit.Theme
local panel, body
local tab = "Coleção"

function RewardsUI.init(ctx)
	C = ctx
end

local function discovered(index)
	local n = 0
	for id in index do
		if Creatures.ById[id] then
			n += 1
		end
	end
	return n
end

local function reached(d, r)
	local idx = d.index or {}
	if r.biome then
		for slot = 1, 4 do
			if not idx[Creatures.ByBiome[r.biome][slot].id] then
				return false
			end
		end
		return true
	elseif r.mythology then
		for _, c in Creatures.List do
			if c.mythology == r.mythology and not idx[c.id] then
				return false
			end
		end
		return true
	elseif r.count then
		return discovered(idx) >= r.count
	end
	return discovered(idx) / #Creatures.List * 100 >= r.percent
end

local function rewardText(rw)
	local t = {}
	if rw.type == "Gold" then
		table.insert(t, "GOLD (" .. NF.time(rw.seconds) .. " de renda, mín. " .. NF.format(rw.minimum or rw.minimumPerBiome or 0) .. ")")
	elseif rw.type == "Trail" then
		table.insert(t, "Trail " .. rw.trail)
	elseif rw.type == "SpecialEgg" then
		table.insert(t, "Ovo Divino")
	end
	if rw.keys and rw.keys > 0 then
		table.insert(t, rw.keys .. " chave(s)")
	end
	if rw.title then
		table.insert(t, "Título \"" .. rw.title .. "\"")
	end
	return table.concat(t, " + ")
end

local function row(order, title, sub, buttonText, enabled, color, onClick)
	local f = Kit.card(body, color, order)
	f.Size = UDim2.new(1, -10, 0, 64)
	Kit.label({ Text = title, Parent = f, Size = UDim2.new(0.68, 0, 0, 28), Position = UDim2.fromOffset(12, 4), TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 20, TextColor3 = color })
	Kit.label({ Text = sub, Parent = f, Size = UDim2.new(0.68, 0, 0, 26), Position = UDim2.fromOffset(12, 32), TextXAlignment = Enum.TextXAlignment.Left, Font = T.FontBody, MaxTextSize = 14 })
	if buttonText then
		local b = Kit.button({ Text = buttonText, color = color, Size = UDim2.new(0.28, 0, 0, 44), Position = UDim2.new(1, -10, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5), Parent = f, MaxTextSize = 18, onClick = function()
			if enabled then
				onClick()
			end
		end })
		Kit.setButtonEnabled(b, enabled, color)
	end
end

local function collectionRewards()
	local list = {}
	for _, m in GameConfig.IndexMilestones do
		table.insert(list, m)
	end
	for b = 1, 12 do
		table.insert(list, { id = "Biome_" .. b, biome = b, label = "Coleção completa: " .. Formulas.biome(b).name, reward = { type = "Gold", seconds = GameConfig.BiomeCompleteReward.seconds, minimum = GameConfig.BiomeCompleteReward.minimumPerBiome * (5 ^ (b - 1)), keys = (b % 4 == 0) and 1 or 0 } })
	end
	return list
end

function RewardsUI.render()
	local d = C.State.get()
	if not d or not panel.frame.Visible then
		return
	end
	for _, ch in body:GetChildren() do
		if ch:IsA("GuiObject") then
			ch:Destroy()
		end
	end
	if tab == "Coleção" then
		for i, r in collectionRewards() do
			local claimed = d.claimed and d.claimed[r.id]
			local ok = reached(d, r)
			row(i, r.label, rewardText(r.reward), claimed and "COLETADO ✓" or (ok and "COLETAR" or "Bloqueado"), ok and not claimed, ok and T.Good or Color3.fromRGB(150, 150, 170), function()
				local success, msg = Net.request("ClaimIndexReward", { id = r.id })
				C.Notifications.toast(success and "Reward" or "Warning", r.label, msg or "")
			end)
		end
	elseif tab == "Conquistas" then
		for i, a in GameConfig.Achievements do
			local got = d.achievements and d.achievements[a.id]
			row(i, (a.icon or "🏆") .. " " .. a.name, a.desc, got and "CONQUISTADO ✓" or nil, false, got and T.Gold or Color3.fromRGB(150, 150, 170), function() end)
		end
	elseif tab == "Diário" then
		local vip = C.State.hasPass("VIP")
		row(1, "👑 Recompensa diária VIP", "10 min de renda em GOLD + 1 chave de relíquia (a cada 20h)", vip and "COLETAR" or "Exclusivo VIP", vip, T.Gold, function()
			local success, msg = Net.request("ClaimVipDaily", {})
			C.Notifications.toast(success and "Reward" or "Warning", "VIP", msg or "")
		end)
		row(2, "🗝 Chaves de Relíquia: " .. (d.keys or 0), "Ganhe 1 chave por dia ao entrar. Abra na Loja > Ovos Especiais.", "ABRIR LOJA", true, T.Accent, function()
			C.Panels.open("Shop")
		end)
		if d.title then
			row(3, "🏷 Seu título: " .. d.title, "Exibido na placa da sua base", nil, false, T.Gold, function() end)
		end
	elseif tab == "Ranking" then
		local ok, rows = Net.request("GetLeaderboard", {})
		if ok and rows then
			for i, r in rows do
				row(i, "#" .. i .. "  " .. r.name .. (r.title and ("  [" .. r.title .. "]") or ""), "💰 " .. NF.format(r.income) .. "/s   •   ⚡ " .. NF.format(r.speed) .. " Speed   •   🐉 " .. r.pets .. " pets", nil, false, i == 1 and T.Gold or T.Accent, function() end)
			end
		end
	end
end

function RewardsUI.start()
	panel = Kit.panel(C.Panels.screen, "🎁 RECOMPENSAS", Color3.fromRGB(255, 110, 160))
	Kit.tabs(panel.content, { "Coleção", "Conquistas", "Diário", "Ranking" }, function(name)
		tab = name
		RewardsUI.render()
	end, Color3.fromRGB(255, 110, 160))
	body = Kit.scroll(panel.content, { Position = UDim2.fromOffset(0, 50), Size = UDim2.new(1, 0, 1, -50) })
	Kit.list(body, 8)
	Kit.padding(body, 4)
	C.Panels.register("Rewards", panel, RewardsUI.render)
	C.State.Changed:Connect(function(_, partial)
		if not partial and tab ~= "Ranking" then
			RewardsUI.render()
		end
	end)
end

return RewardsUI
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000003E"><Properties><string name="Name">SettingsUI</string><ProtectedString name="Source"><![CDATA[--[[
	SettingsUI — music, SFX, visual-effects quality (High/Low particle budget) and camera shake.
	Saved in the profile through the validated SaveSettings action.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Net = require(ReplicatedStorage.Shared.Util.Net)
local Kit = require(script.Parent.Kit)

local SettingsUI = {}
local C
local T = Kit.Theme
local panel, body
local settings = { music = true, sfx = true, vfx = "High", shake = true }

function SettingsUI.init(ctx)
	C = ctx
end

local function apply()
	C.Sound.setEnabled(settings.sfx, settings.music)
	C.Effects.setQuality(settings.vfx)
	C.Effects.setShake(settings.shake)
end

local function save()
	apply()
	Net.request("SaveSettings", { music = settings.music, sfx = settings.sfx, vfx = settings.vfx, shake = settings.shake })
	SettingsUI.render()
end

function SettingsUI.render()
	for _, ch in body:GetChildren() do
		if ch:IsA("GuiObject") then
			ch:Destroy()
		end
	end
	local rows = {
		{ "🎵 Música", settings.music and "LIGADA" or "DESLIGADA", settings.music, function()
			settings.music = not settings.music
			save()
		end },
		{ "🔊 Efeitos sonoros", settings.sfx and "LIGADOS" or "DESLIGADOS", settings.sfx, function()
			settings.sfx = not settings.sfx
			save()
		end },
		{ "✨ Qualidade de efeitos", settings.vfx == "High" and "ALTA" or "BAIXA (dispositivos fracos)", settings.vfx == "High", function()
			settings.vfx = settings.vfx == "High" and "Low" or "High"
			save()
		end },
		{ "📳 Tremor de câmera", settings.shake and "LIGADO" or "DESLIGADO", settings.shake, function()
			settings.shake = not settings.shake
			save()
		end },
	}
	for i, r in rows do
		local f = Kit.card(body, T.Accent, i)
		f.Size = UDim2.new(1, -10, 0, 64)
		Kit.label({ Text = r[1], Parent = f, Size = UDim2.new(0.55, 0, 1, -10), Position = UDim2.fromOffset(14, 5), TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 22 })
		Kit.button({ Text = r[2], color = r[3] and T.Good or T.Bad, Size = UDim2.new(0.4, 0, 0, 46), Position = UDim2.new(1, -10, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5), Parent = f, MaxTextSize = 18, onClick = r[4] })
	end
	local d = C.State.get()
	if d and not d.saveable then
		Kit.label({ Text = "⚠ Progresso temporário: o DataStore não está disponível neste servidor.", Parent = body, Size = UDim2.new(1, -10, 0, 40), TextColor3 = T.Bad, MaxTextSize = 16, LayoutOrder = 99, Font = T.FontBody })
	end
end

function SettingsUI.start()
	panel = Kit.panel(C.Panels.screen, "⚙ CONFIGURAÇÕES", Color3.fromRGB(160, 160, 190), UDim2.fromScale(0.45, 0.55))
	body = Kit.scroll(panel.content)
	Kit.list(body, 8)
	Kit.padding(body, 4)
	C.Panels.register("Settings", panel, SettingsUI.render)
	local loaded = false
	C.State.Changed:Connect(function(d, partial)
		if not partial and d.settings and not loaded then
			loaded = true
			settings.music = d.settings.music ~= false
			settings.sfx = d.settings.sfx ~= false
			settings.vfx = d.settings.vfx == "Low" and "Low" or "High"
			settings.shake = d.settings.shake ~= false
			apply()
		end
	end)
end

return SettingsUI
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000003F"><Properties><string name="Name">ShopUI</string><ProtectedString name="Source"><![CDATA[--[[
	ShopUI — "Loja Divina" (tabs: Gamepasses, Produtos, Speed, Trails, Boosts, Ovos Especiais) and
	the standalone Trails panel (kiosk/HUD). Robux items open the official Roblox purchase prompt;
	items whose id is not configured show as "Indisponível" (never a fake button).
	The Divine Reliquary shows every reward and its exact chance BEFORE purchase, and is hidden
	for players whose policy restricts paid random items (they can open it with free keys).
]]

local Players = game:GetService("Players")
local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local Balance = require(Shared.Config.Balance)
local Monetization = require(Shared.Config.Monetization)
local Formulas = require(Shared.Util.Formulas)
local NF = require(Shared.Util.NumberFormatter)
local Net = require(Shared.Util.Net)
local Kit = require(script.Parent.Kit)

local ShopUI = {}
local C
local T = Kit.Theme
local player = Players.LocalPlayer
local shop, trailsPanel
local body
local currentTab = "Gamepasses"

local PASS_ICON = { Crown = "👑", Coins = "💰", Egg = "🥚", Magnet = "🧲", Nest = "🪺", Bolt = "⚡" }

function ShopUI.init(ctx)
	C = ctx
end

local function clear(container)
	for _, ch in container:GetChildren() do
		if not ch:IsA("UIGridLayout") and not ch:IsA("UIListLayout") and not ch:IsA("UIPadding") then
			ch:Destroy()
		end
	end
end

-- Generic item card
local function itemCard(parent, order, data)
	local card = Kit.card(parent, data.color or T.Gold, order)
	Kit.label({ Text = data.icon or "✦", Parent = card, Size = UDim2.new(0, 64, 0, 64), Position = UDim2.fromOffset(10, 10), stroke = false })
	Kit.label({ Text = data.name, Parent = card, Size = UDim2.new(1, -90, 0, 30), Position = UDim2.fromOffset(80, 8), TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 24, TextColor3 = data.color or T.Gold })
	Kit.label({ Text = data.desc or "", Parent = card, Size = UDim2.new(1, -90, 0, 52), Position = UDim2.fromOffset(80, 38), TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, Font = T.FontBody, MaxTextSize = 15 })
	local btn, label = Kit.button({ Text = data.buttonText, color = data.enabled and (data.buttonColor or T.Good) or Color3.fromRGB(90, 90, 110), Size = UDim2.new(1, -20, 0, 42), Position = UDim2.new(0, 10, 1, -50), Parent = card, MaxTextSize = 20, onClick = function()
		if data.enabled and data.onBuy then
			data.onBuy()
		end
	end })
	Kit.setButtonEnabled(btn, data.enabled, data.buttonColor or T.Good)
	return card, btn, label
end

local function request(action, payload)
	local ok, msg = Net.request(action, payload)
	C.Notifications.toast(ok and "Purchase" or "Warning", ok and "Sucesso!" or "Ops!", msg or "")
	return ok
end

-- ===================== TABS =====================
local Tabs = {}

function Tabs.Gamepasses(container)
	local d = C.State.get()
	local order = 0
	for key, pass in Monetization.Gamepasses do
		order += 1
		local owned = d and d.passes and table.find(d.passes, key) ~= nil
		local registered = Monetization.isRegistered(pass)
		itemCard(container, order, {
			icon = PASS_ICON[pass.icon] or "💎", name = pass.name, desc = pass.desc, color = T.Gold,
			buttonText = owned and "ADQUIRIDO ✓" or (registered and ("R$ " .. pass.price) or "Indisponível"),
			enabled = registered and not owned,
			onBuy = function()
				MarketplaceService:PromptGamePassPurchase(player, pass.id)
			end,
		})
	end
end

local function productCards(container, kinds)
	local order = 0
	local d = C.State.get()
	local income = d and d.income or 0
	for key, product in Monetization.Products do
		if kinds[product.kind] and key ~= "DivineReliquary" then
			order += 1
			local registered = Monetization.isRegistered(product)
			local desc = product.desc
			if product.kind == "Gold" then
				desc = "+" .. NF.format(math.max(product.minimum, income * product.seconds)) .. " GOLD agora • " .. product.desc
			end
			local active = product.boost and d and d.boosts and d.boosts[product.boost]
			if active then
				desc = desc .. "\nAtivo por mais " .. NF.time(active - C.State.now())
			end
			itemCard(container, order, {
				icon = (product.kind == "Gold" and "💰") or (product.boost == "shield" and "🛡") or (product.kind == "HatchInstant" and "🐣") or "⚡",
				name = product.name, desc = desc, color = Color3.fromRGB(110, 200, 255),
				buttonText = registered and ("R$ " .. product.price) or "Indisponível", enabled = registered,
				onBuy = function()
					MarketplaceService:PromptProductPurchase(player, product.id)
				end,
			})
		end
	end
end

function Tabs.Produtos(container)
	productCards(container, { Gold = true })
end

function Tabs.Boosts(container)
	productCards(container, { Boost = true, HatchInstant = true })
end

function Tabs.Speed(container)
	local d = C.State.get()
	if not d then
		return
	end
	local current = Formulas.treadmill(d.treadmillTier)
	local nextT = Balance.treadmills[d.treadmillTier + 1]
	itemCard(container, 1, {
		icon = "🏃", name = "Sua esteira: " .. current.name, desc = "+" .. NF.format(current.perStep) .. " Speed por passo (antes de Trail e bônus).", color = T.Accent,
		buttonText = "EQUIPADA", enabled = false,
	})
	if nextT then
		itemCard(container, 2, {
			icon = "⬆", name = nextT.name, desc = "+" .. NF.format(nextT.perStep) .. " Speed por passo. Visual exclusivo e efeitos próprios.", color = T.Gold,
			buttonText = NF.format(nextT.price) .. " GOLD", enabled = d.gold >= nextT.price, buttonColor = T.Gold,
			onBuy = function()
				request("BuyTreadmill", {})
				task.wait(0.3)
				ShopUI.render()
			end,
		})
	end
	productCards(container, { Boost = true })
	for _, ch in container:GetChildren() do
		if ch:IsA("Frame") and ch.LayoutOrder > 0 and ch.LayoutOrder < 10 then
			ch.LayoutOrder += 10
		end
	end
end

local function trailsList(container)
	local d = C.State.get()
	if not d then
		return
	end
	local all = table.clone(Balance.trails)
	for _, t in Balance.rewardTrails do
		table.insert(all, t)
	end
	for i, t in all do
		local owned = table.find(d.trailsOwned, t.id) ~= nil
		local equipped = d.equippedTrail == t.id
		local color = Color3.fromRGB(t.c1[1], t.c1[2], t.c1[3])
		local card = itemCard(container, i, {
			icon = "✨", name = t.name .. "  (" .. t.mult .. "x)", color = color,
			desc = "Raridade: " .. t.rarity .. "\nMultiplica a Speed ganha na esteira por " .. t.mult .. "x." .. (t.price < 0 and "\nRecompensa do Index (75%)." or ""),
			buttonText = equipped and "EQUIPADO" or (owned and "EQUIPAR" or (t.price < 0 and "Recompensa" or (NF.format(t.price) .. " GOLD"))),
			enabled = (owned and not equipped) or (not owned and t.price >= 0 and d.gold >= t.price),
			buttonColor = owned and T.Accent or T.Gold,
			onBuy = function()
				if owned then
					request("EquipTrail", { id = t.id })
				else
					request("BuyTrail", { id = t.id })
				end
				task.wait(0.3)
				ShopUI.render()
				ShopUI.renderTrails()
			end,
		})
		local swatch = Kit.new("Frame", { BackgroundColor3 = color, Size = UDim2.fromOffset(60, 8), Position = UDim2.fromOffset(12, 76), Parent = card })
		Kit.corner(swatch, 4)
		Kit.gradient(swatch, color, Color3.fromRGB(t.c2[1], t.c2[2], t.c2[3]), 0)
	end
end

function Tabs.Trails(container)
	trailsList(container)
end

Tabs["Ovos Especiais"] = function(container)
	local d = C.State.get()
	local ok, info = Net.request("GetReliquaryInfo", {})
	if not ok or not info then
		return
	end
	local product = Monetization.Products.DivineReliquary
	local canBuyPaid = info.registered and not info.restricted
	itemCard(container, 1, {
		icon = "🏺", name = "Divine Reliquary", color = Color3.fromRGB(255, 140, 220),
		desc = "Uma relíquia mitológica aleatória. Probabilidades exatas listadas abaixo (somam 100%).",
		buttonText = info.restricted and "Indisponível na sua região" or (info.registered and ("R$ " .. product.price) or "Indisponível"),
		enabled = canBuyPaid,
		onBuy = function()
			MarketplaceService:PromptProductPurchase(player, product.id)
		end,
	})
	for i, row in info.odds do
		itemCard(container, 10 + i, {
			icon = "🎲", name = string.format("%.1f%%", row.chance), color = Color3.fromRGB(255, 140, 220),
			desc = row.label, buttonText = "Probabilidade real", enabled = false,
		})
	end
	itemCard(container, 2, {
		icon = "🗝", name = "Abrir com Chave (grátis)", color = T.Good,
		desc = "Você tem " .. (d and d.keys or 0) .. " chave(s). Chaves são ganhas no login diário, no Index e com VIP. Mesmas probabilidades.",
		buttonText = "ABRIR (1 chave)", enabled = (d and d.keys or 0) > 0,
		onBuy = function()
			local success, res = Net.request("OpenReliquaryKey", {})
			if success then
				C.Notifications.toast("Rare", "Relíquia aberta!", res.text)
			else
				C.Notifications.toast("Warning", "Relíquia", res)
			end
			task.wait(0.3)
			ShopUI.render()
		end,
	})
end

function ShopUI.render()
	if not body then
		return
	end
	clear(body)
	local fn = Tabs[currentTab]
	if fn then
		fn(body)
	end
end

function ShopUI.renderTrails()
	if trailsPanel and trailsPanel.frame.Visible then
		clear(trailsPanel.body)
		trailsList(trailsPanel.body)
	end
end

function ShopUI.start()
	shop = Kit.panel(C.Panels.screen, "🛒 LOJA DIVINA", T.Gold)
	local setTab = Kit.tabs(shop.content, { "Gamepasses", "Produtos", "Speed", "Trails", "Boosts", "Ovos Especiais" }, function(name)
		currentTab = name
		ShopUI.render()
	end)
	body = Kit.scroll(shop.content, { Position = UDim2.fromOffset(0, 50), Size = UDim2.new(1, 0, 1, -50) })
	Kit.grid(body, UDim2.fromOffset(300, 150), 10)
	Kit.padding(body, 4)
	C.Panels.register("Shop", shop, function()
		setTab(currentTab)
	end)

	trailsPanel = Kit.panel(C.Panels.screen, "✨ TRAILS", Color3.fromRGB(170, 120, 255))
	trailsPanel.body = Kit.scroll(trailsPanel.content)
	Kit.grid(trailsPanel.body, UDim2.fromOffset(300, 150), 10)
	Kit.padding(trailsPanel.body, 4)
	C.Panels.register("Trails", trailsPanel, function()
		clear(trailsPanel.body)
		trailsList(trailsPanel.body)
	end)

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function()
		task.wait(1)
		ShopUI.render()
	end)
	C.State.Changed:Connect(function(_, partial)
		if not partial and shop.frame.Visible and currentTab ~= "Ovos Especiais" then
			ShopUI.render()
		end
	end)
end

return ShopUI
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000040"><Properties><string name="Name">UpgradesUI</string><ProtectedString name="Source"><![CDATA[--[[
	UpgradesUI — base expansion and treadmill upgrades (GOLD), showing the next level benefits.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local Balance = require(Shared.Config.Balance)
local Formulas = require(Shared.Util.Formulas)
local NF = require(Shared.Util.NumberFormatter)
local Net = require(Shared.Util.Net)
local Kit = require(script.Parent.Kit)

local UpgradesUI = {}
local C
local T = Kit.Theme
local panel, body

function UpgradesUI.init(ctx)
	C = ctx
end

local function card(order, title, lines, buttonText, enabled, color, onClick)
	local f = Kit.card(body, color, order)
	f.Size = UDim2.new(1, -10, 0, 150)
	Kit.label({ Text = title, Parent = f, Size = UDim2.new(1, -20, 0, 32), Position = UDim2.fromOffset(10, 8), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = color, MaxTextSize = 26 })
	Kit.label({ Text = table.concat(lines, "\n"), Parent = f, Size = UDim2.new(0.62, -10, 0, 96), Position = UDim2.fromOffset(10, 44), TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, Font = T.FontBody, MaxTextSize = 17 })
	local b = Kit.button({ Text = buttonText, color = color, Size = UDim2.new(0.34, 0, 0, 56), Position = UDim2.new(1, -10, 1, -12), AnchorPoint = Vector2.new(1, 1), Parent = f, MaxTextSize = 22, onClick = function()
		if enabled then
			onClick()
		end
	end })
	Kit.setButtonEnabled(b, enabled, color)
end

function UpgradesUI.render()
	local d = C.State.get()
	if not d or not panel.frame.Visible then
		return
	end
	for _, ch in body:GetChildren() do
		if ch:IsA("GuiObject") then
			ch:Destroy()
		end
	end
	local lvl = Formulas.baseLevel(d.baseLevel)
	local nextLvl = Balance.baseLevels[d.baseLevel + 1]
	local lines = {
		"Nível atual: " .. d.baseLevel .. "/" .. #Balance.baseLevels .. "  •  Incubadoras: " .. d.incubators .. "  •  Espaços de pets: " .. lvl.petSlots,
	}
	if nextLvl then
		table.insert(lines, "Próximo nível: +" .. (nextLvl.incubators - lvl.incubators) .. " incubadoras, +" .. (nextLvl.petSlots - lvl.petSlots) .. " espaços de pets")
		table.insert(lines, "Novo visual: cercas, pilares, estandartes, arcos, tochas e estátuas divinas")
	else
		table.insert(lines, "Sua base está no nível máximo — um verdadeiro templo!")
	end
	card(1, "🏛 EXPANDIR BASE", lines, nextLvl and (NF.format(nextLvl.price) .. " GOLD") or "MÁXIMO", nextLvl ~= nil and d.gold >= nextLvl.price, Color3.fromRGB(255, 150, 80), function()
		local ok, msg = Net.request("UpgradeBase", {})
		C.Notifications.toast(ok and "Reward" or "Warning", "Base", msg or "")
	end)
	local tm = Formulas.treadmill(d.treadmillTier)
	local nextTm = Balance.treadmills[d.treadmillTier + 1]
	local tl = { "Atual: " .. tm.name .. " (+" .. NF.format(tm.perStep) .. " Speed por passo)" }
	if nextTm then
		table.insert(tl, "Próxima: " .. nextTm.name .. " (+" .. NF.format(nextTm.perStep) .. " por passo)")
		table.insert(tl, "Ganho real/passo com seu Trail: " .. NF.format(Formulas.trainGain(d.treadmillTier + 1, d.equippedTrail, {})))
	else
		table.insert(tl, "Você tem a esteira mais poderosa do panteão!")
	end
	card(2, "🏃 ESTEIRA", tl, nextTm and (NF.format(nextTm.price) .. " GOLD") or "MÁXIMO", nextTm ~= nil and d.gold >= nextTm.price, T.Accent, function()
		local ok, msg = Net.request("BuyTreadmill", {})
		C.Notifications.toast(ok and "Reward" or "Warning", "Esteira", msg or "")
	end)
end

function UpgradesUI.start()
	panel = Kit.panel(C.Panels.screen, "🏛 MELHORIAS", Color3.fromRGB(255, 150, 80), UDim2.fromScale(0.55, 0.6))
	body = Kit.scroll(panel.content)
	Kit.list(body, 10)
	Kit.padding(body, 4)
	C.Panels.register("Upgrades", panel, UpgradesUI.render)
	C.State.Changed:Connect(function()
		UpgradesUI.render()
	end)
end

return UpgradesUI
]]></ProtectedString></Properties></Item></Item></Item></Item></Item></roblox>
